; Meridian (working title). The repo root is res://, so the charter paths (sim/, render/, ui/, ...) map straight onto it.
; Simulation & Engine holds this file until Tools & Pipeline takes over the project settings.

config_version=5

[application]

config/name="Orb Combat EX"
; A run from the project (the engine's editor build: every check, bench and headless run) keeps its data in a "dev" folder; a built program keeps the player's folder as before (Tools, 2026-11-28;
; tools/userdata-guard-check.mjs holds these two lines).
config/use_custom_user_dir.editor=true
config/custom_user_dir_name.editor="Godot/app_userdata/Orb Combat EX dev"
run/main_scene="res://render/boot_entry.tscn"
config/features=PackedStringArray("4.7")

[audio]

general/default_playback_type.web=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

globe_r={
"type": "float",
"value": 0.0
}
