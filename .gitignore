# Dependencies and logs
node_modules/
*.log

# Godot caches
.godot/
.import/

# Orb's private notes (name franchise inspirations; never published)
.private/

# Claude Code local state (per machine, never shared)
.claude/settings.local.json
.claude/worktrees/

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
build/
/build_info.json

# Raw music hand-backs from Orb (large; chosen takes are encoded and committed separately)
audio/music/incoming/*.wav
audio/music/incoming/*.mp3
__pycache__/

# Orb's homework folder: review sheets, questionnaires and Orb's answers. Local only (it can hold in-progress character art).
homework/

# HUD mock sheets stay private (Orb, homework 8): keep them in homework/mocks/ui/
docs/ui/img/run/
docs/ui/mock/
docs/ui/img/*-mock.png
