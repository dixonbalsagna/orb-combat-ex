# Dependencies and logs
node_modules/
*.log

# Godot caches
.godot/
.import/

# Orb's private notes (name franchise inspirations; never published)
.private/

# Claude Code local state (per machine, never shared)
.claude/settings.local.json
.claude/worktrees/

# OS clutter
Thumbs.db
desktop.ini
.DS_Store
build/
/build_info.json

# Raw music hand-backs from Orb (large; chosen takes are encoded and committed separately)
audio/music/incoming/*.wav
audio/music/incoming/*.mp3
__pycache__/

# Orb's homework folder: review sheets, questionnaires and Orb's answers. Local only (it can hold in-progress character art).
homework/

# HUD mock sheets stay private (Orb, homework 8): keep them in homework/mocks/ui/
docs/ui/img/run/
docs/ui/mock/
docs/ui/img/*-mock.png

# Tools' "Make my report folder.cmd" names this PC's repository path: generated per LAN folder by tools/preview/lan-report.mjs --write-cmd, never committed
docs/tools/shortcuts/Make my report folder.cmd

# Real-thumb captures of the right stick (tools/capture): raw files hold anonymous codes and stick samples; only the summary tables are committed
tools/capture/raw/

# UI run stills from the demo that show grey-box fighters (in-progress character art never goes on a public page); text records stay tracked
docs/ui/runs/397a7adf/**/*.png

# Tools run stills (large, many show fighters); the few tracked earlier stay tracked
docs/tools/img/

# Camera stills (many show fighters; in-progress character art never goes on a public page)
docs/camera/img/close-brawl/
docs/camera/img/cross-ko/
docs/camera/img/damage-inset/
docs/camera/img/launch-director/
docs/camera/img/split-unequal/
docs/camera/img/swing/
docs/camera/img/vkeep/
docs/camera/img/vkeep-energy/
