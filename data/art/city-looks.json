      "pier_w": 0.05,
      "spandrel": {
        "h": 0.45,
        "lum_offset": -0.02
      },
      "fits": "downtown shafts under 40 floors; mid_rise_east"
    },
    "punched": {
      "name": "Punched windows with spandrels",
      "what": "separate panes in a regular grid with a darker band under each row: reads as stone or brick, a heavier and older building",
      "pane_w": 0.38,
      "pane_h": 0.5,
      "spandrel": {
        "h": 0.3,
        "lum_offset": -0.03
      },
      "fits": "mid_rise_west; the older downtown towers"
    },
    "fins": {
      "name": "Vertical fins",
      "what": "tall glass between projecting fins one pane apart: a strongly vertical read, the tallest shafts",
      "pane_w": 0.78,
      "fin": {
        "w": 0.14,
        "pitch": 0.25,
        "lum_offset": -0.03,
        "sun_side_offset": 0.03
      },
      "fits": "downtown shafts of 40 floors or more; a few mid_rise slabs"
    }
  },
  "base_and_crown": {
    "base": {
      "floors": 1.6,
      "note": "a tall lobby storey under the shaft, in the wall's mid tone less 0.03 (never darker: its join with the shaft is a long edge), with the trim as a lintel line and no ribbon: punched panes only",
      "wall_lum_offset": -0.03
    },
    "crown": {
      "floors": 2,
      "note": "the top two floors set back 6 percent each side, a cornice band in the trim tone (wall mid plus 0.03), panes at the tint's bright glass; lit panes are Rendering's and are not raised (a flash change)",
      "setback": 0.06,
      "cornice_lum_offset": 0.03
    }
  },
