{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "meridian/combat-moveset",
 "title": "a generated moveset (Combat; tools/movegen)",
 "description": "moveset.<fighter>.json, written by tools/movegen/movegen.mjs (docs/combat/moveset-generator.md section 5.2): the generator's version, seed and inputs hash, then every cell of the five stances by button, in the order of cells.json. A cell is of one kind: strikes (moves assembled from the grammar's parts), string (the held X's bursts, blows named from another cell), run (mashed runs of point-blank bolts, with an arm for each), travel (a zip, step, charge or pursuit with a blow on arrival), table (energy pieces), special (looks of a special's frame), context (a list, not generated) or frame (a signature frame, not generated). A kit row's cell outside his kit is empty and says so in `kit`. Parked until data/combat/movesets/ exists: not loaded, not hashed. Cross-checks are the generator's own (--check): every move is a valid shape, matches no banned row, never row or sequence rule; every id in the lock is here with its shape; a string's and a run's blows are moves of the cell they name. Policy: closed, except keys starting with an underscore.",
 "type": "object",
 "required": ["schema", "_target", "_about", "fighter", "generator", "cells"],
 "properties": {
  "schema": {"const": "combat.moveset/1"},
  "fighter": {"$ref": "#/$defs/key"},
  "generator": {
   "type": "object",
   "required": ["version", "seed", "inputs"],
   "properties": {
    "version": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "inputs": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "the first 16 hex digits of a SHA-256 of the inputs (parts, identity, cells, his packs' rows, the re-aims he uses) and the lock rows"}
   },
   "additionalProperties": false
  },
  "cells": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {"pattern": "^(martial|manoeuvre|energy|defensive|charging)\\.[xyab](\\.[a-z][a-z0-9_]*)?$"},
   "additionalProperties": {"$ref": "#/$defs/cell"}
  }
 },
 "patternProperties": {"^_": true},
 "additionalProperties": false,
 "$defs": {
  "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
  "word": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
  "words": {"type": "array", "items": {"$ref": "#/$defs/word"}},
  "id": {"type": "string", "pattern": "^mv\\.[a-z][a-z0-9_]*\\.[a-z]+\\.[xyab](\\.[a-z][a-z0-9_]*)?\\.[0-9]{2}$"},
  "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
  "asks": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"}},
  "quotas": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
  "status": {"enum": ["posed", "derived", "waiting"]},
  "cell": {
   "type": "object",
   "required": ["kind"],
   "properties": {
    "kind": {"enum": ["strikes", "string", "run", "travel", "table", "special", "context", "frame"]},
    "valid": {"type": "integer", "minimum": 0},
    "refused": {"type": "array", "items": {"type": "object"}},
    "quotas": {"$ref": "#/$defs/quotas"},
    "moves": {"type": "array"},
    "temporary": {"const": true},
    "kit": {"type": "string"},
    "from": {"type": "string"},
    "loop": {"const": true},
    "special": {"type": "string"},
    "what": {"type": "string"},
    "state": {"type": "string"},
    "pressed": {"type": "array", "items": {"type": "string"}},
    "held": {"type": "array", "items": {"type": "string"}},
    "slots": {"type": "array"},
    "readings": {"type": "object"},
    "asks": {"$ref": "#/$defs/asks"}
   },
   "patternProperties": {"^_": true},
   "additionalProperties": false,
   "allOf": [
    {"if": {"properties": {"kind": {"enum": ["strikes", "string", "run", "travel", "table", "special"]}}}, "then": {"required": ["valid", "quotas", "moves"]}},
    {"if": {"properties": {"kind": {"const": "strikes"}}}, "then": {"properties": {"moves": {"items": {"$ref": "#/$defs/strike"}}}, "required": ["refused"]}},
    {"if": {"properties": {"kind": {"const": "string"}}}, "then": {"properties": {"moves": {"items": {"$ref": "#/$defs/burst"}}}, "required": ["from"]}},
    {"if": {"properties": {"kind": {"const": "run"}}}, "then": {"properties": {"moves": {"items": {"$ref": "#/$defs/run"}}}, "required": ["from"]}},
    {"if": {"properties": {"kind": {"const": "travel"}}}, "then": {"properties": {"moves": {"items": {"$ref": "#/$defs/travel"}}}, "required": ["refused"]}},
    {"if": {"properties": {"kind": {"const": "table"}}}, "then": {"properties": {"moves": {"items": {"$ref": "#/$defs/table"}}}, "required": ["refused"]}},
    {"if": {"properties": {"kind": {"const": "special"}}, "required": ["special"]}, "then": {"properties": {"moves": {"items": {"$ref": "#/$defs/special"}}}, "required": ["what", "state"]}},
    {"if": {"properties": {"kind": {"const": "context"}}}, "then": {"required": ["pressed", "held", "asks"]}},
    {"if": {"properties": {"kind": {"const": "frame"}}}, "then": {"required": ["slots", "readings", "asks"]}}
   ]
  },
  "strike": {
   "type": "object",
   "required": ["id", "limb", "tip", "path", "target", "weight", "arms", "forms", "step", "sends", "links", "beat", "keys", "ground", "status", "flags", "legal", "asks", "review"],
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "limb": {"$ref": "#/$defs/word"},
    "tip": {"$ref": "#/$defs/word"},
    "path": {"$ref": "#/$defs/word"},
    "target": {"$ref": "#/$defs/word"},
    "weight": {"enum": ["light", "medium", "heavy"]},
    "arms": {"enum": [0, 1, 2]},
    "forms": {"$ref": "#/$defs/words"},
    "step": {"$ref": "#/$defs/words"},
    "sends": {"enum": ["across", "up", "down", "turned"]},
    "links": {"$ref": "#/$defs/words"},
    "beat": {"type": "integer", "minimum": 1},
    "keys": {
     "type": "object",
     "required": ["level"],
     "properties": {
      "level": {"enum": ["posed", "hand_state", "re_aim", "hand_state_re_aim", "re_aim_edge", "hand_state_re_aim_edge", "stand_in", "new"]},
      "from": {"type": "string", "pattern": "^strike\\.[a-z0-9_]+$"},
      "set": {"type": "string"},
      "wave": {"$ref": "#/$defs/word"},
      "hand": {"$ref": "#/$defs/word"},
      "aim": {"$ref": "#/$defs/word"},
      "layer": {"$ref": "#/$defs/word"}
     },
     "additionalProperties": false,
     "if": {"properties": {"level": {"const": "new"}}},
     "then": {"maxProperties": 2},
     "else": {"required": ["from", "set", "wave"]}
    },
    "ground": {"$ref": "#/$defs/word"},
    "status": {"$ref": "#/$defs/status"},
    "flags": {"$ref": "#/$defs/words"},
    "legal": {"$ref": "#/$defs/words"},
    "asks": {"$ref": "#/$defs/asks"},
    "review": {"enum": ["locked", "stand-in"]},
    "wind": {"type": "string"},
    "own": {"const": true},
    "drive": {"$ref": "#/$defs/word"},
    "name": {"type": "string", "minLength": 1},
    "as": {"$ref": "#/$defs/word"}
   },
   "additionalProperties": false,
   "if": {"properties": {"weight": {"const": "heavy"}}},
   "then": {"required": ["drive", "name"]}
  },
  "burst": {
   "type": "object",
   "required": ["id", "lean", "blows", "slots", "status", "asks", "review"],
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "lean": {"$ref": "#/$defs/word"},
    "blows": {"$ref": "#/$defs/ids", "minItems": 1},
    "slots": {"$ref": "#/$defs/words"},
    "status": {"$ref": "#/$defs/status"},
    "asks": {"$ref": "#/$defs/asks"},
    "review": {"const": "new"}
   },
   "additionalProperties": false
  },
  "run": {
   "type": "object",
   "required": ["id", "blows", "arms", "status", "asks", "review"],
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "blows": {"$ref": "#/$defs/ids", "minItems": 1},
    "arms": {"type": "array", "items": {"enum": ["lead", "free"]}},
    "status": {"$ref": "#/$defs/status"},
    "asks": {"$ref": "#/$defs/asks"},
    "review": {"const": "new"}
   },
   "additionalProperties": false
  },
  "entry": {
   "type": "object",
   "required": ["id", "set"],
   "properties": {"id": {"type": "string", "pattern": "^entry\\.[a-z0-9_]+$"}, "set": {"type": "string"}},
   "additionalProperties": false
  },
  "travel": {
   "type": "object",
   "required": ["id", "kind", "band", "direction", "entry", "exit", "blow", "forms", "status", "flags", "legal", "asks", "review"],
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "kind": {"$ref": "#/$defs/word"},
    "band": {"$ref": "#/$defs/word"},
    "direction": {"$ref": "#/$defs/word"},
    "entry": {"$ref": "#/$defs/entry"},
    "exit": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/entry"}]},
    "blow": {
     "type": "object",
     "required": ["move", "limb", "tip", "path", "target", "weight", "set"],
     "properties": {
      "move": {"$ref": "#/$defs/id"},
      "limb": {"$ref": "#/$defs/word"},
      "tip": {"$ref": "#/$defs/word"},
      "path": {"$ref": "#/$defs/word"},
      "target": {"$ref": "#/$defs/word"},
      "weight": {"enum": ["light", "medium", "heavy"]},
      "set": {"type": ["string", "null"]}
     },
     "additionalProperties": false
    },
    "forms": {"$ref": "#/$defs/words"},
    "status": {"enum": ["posed", "derived"]},
    "flags": {"$ref": "#/$defs/words"},
    "legal": {"$ref": "#/$defs/words"},
    "asks": {"$ref": "#/$defs/asks"},
    "review": {"const": "new"}
   },
   "additionalProperties": false
  },
  "table": {
   "type": "object",
   "required": ["id", "hand", "release", "body", "delivery", "forms", "keys", "status", "asks", "review"],
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "hand": {"$ref": "#/$defs/word"},
    "release": {"$ref": "#/$defs/word"},
    "body": {"$ref": "#/$defs/word"},
    "delivery": {"$ref": "#/$defs/word"},
    "forms": {"$ref": "#/$defs/words"},
    "keys": {
     "type": "object",
     "required": ["set", "hand"],
     "properties": {
      "set": {"type": ["string", "null"]},
      "hand": {"type": ["string", "null"]},
      "strike": {"type": "string", "pattern": "^strike\\.[a-z0-9_]+$"},
      "strikeNow": {"type": "string", "pattern": "^strike\\.[a-z0-9_]+$"}
     },
     "additionalProperties": false
    },
    "status": {"$ref": "#/$defs/status"},
    "asks": {"$ref": "#/$defs/asks"},
    "review": {"const": "new"},
    "target": {"$ref": "#/$defs/word"},
    "limb": {"const": "hand"},
    "path": {"$ref": "#/$defs/word"}
   },
   "additionalProperties": false,
   "dependentRequired": {"target": ["limb", "path"]}
  },
  "special": {
   "type": "object",
   "required": ["id", "look", "forms", "status", "asks", "review"],
   "properties": {
    "id": {"$ref": "#/$defs/id"},
    "look": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "forms": {"$ref": "#/$defs/words"},
    "status": {"const": "waiting"},
    "asks": {"$ref": "#/$defs/asks"},
    "review": {"const": "new"}
   },
   "additionalProperties": false
  }
 }
}
