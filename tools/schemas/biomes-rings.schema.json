{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/biomes-rings",
  "title": "biomes.rings/1",
  "description": "data/biomes/rings.json: the ring picker's numbers (docs/world/shifting-arena-design.md window 4; WorldRingPick): the three sizes in columns, the minimum a ring holds by size, how many candidates are tried, and the scoring weights. Every key required. Version field: schema. Policy: closed except keys starting with an underscore.",
  "type": "object",
  "required": [
    "schema",
    "sizes",
    "minimum",
    "candidates",
    "stride",
    "biomeShare",
    "ref",
    "mustAt",
    "avoidWeight",
    "homeBonus",
    "coastRef",
    "turn"
  ],
  "properties": {
    "schema": {
      "const": "biomes.rings/1"
    },
    "_about": {
      "type": "string"
    },
    "sizes": {
      "type": "object",
      "required": [
        "close",
        "half",
        "whole"
      ],
      "additionalProperties": false,
      "properties": {
        "close": {
          "type": "integer",
          "minimum": 600,
          "maximum": 4800,
          "multipleOf": 8,
          "description": "The ring's columns (a column is 32 units of arc), a multiple of 8: the ground's largest stride."
        },
        "half": {
          "type": "integer",
          "minimum": 600,
          "maximum": 4800,
          "multipleOf": 8,
          "description": "The ring's columns (a column is 32 units of arc), a multiple of 8: the ground's largest stride."
        },
        "whole": {
          "type": "integer",
          "minimum": 600,
          "maximum": 4800,
          "multipleOf": 8,
          "description": "The ring's columns (a column is 32 units of arc), a multiple of 8: the ground's largest stride."
        }
      },
      "description": "Game Design's three sizes in columns: close 1,200, half 2,400, whole 4,800."
    },
    "minimum": {
      "type": "object",
      "required": [
        "close",
        "half",
        "whole"
      ],
      "additionalProperties": false,
      "properties": {
        "close": {
          "type": "object",
          "required": [
            "cities",
            "towns",
            "biomes",
            "land"
          ],
          "additionalProperties": false,
          "properties": {
            "cities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Standing cities the ring holds."
            },
            "towns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "Standing towns the ring holds."
            },
            "biomes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7,
              "description": "Kinds of ground of at least biomeShare of the ring."
            },
            "land": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The share of the ring that is not water."
            }
          }
        },
        "half": {
          "type": "object",
          "required": [
            "cities",
            "towns",
            "biomes",
            "land"
          ],
          "additionalProperties": false,
          "properties": {
            "cities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Standing cities the ring holds."
            },
            "towns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "Standing towns the ring holds."
            },
            "biomes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7,
              "description": "Kinds of ground of at least biomeShare of the ring."
            },
            "land": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The share of the ring that is not water."
            }
          }
        },
        "whole": {
          "type": "object",
          "required": [
            "cities",
            "towns",
            "biomes",
            "land"
          ],
          "additionalProperties": false,
          "properties": {
            "cities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Standing cities the ring holds."
            },
            "towns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "Standing towns the ring holds."
            },
            "biomes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7,
              "description": "Kinds of ground of at least biomeShare of the ring."
            },
            "land": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The share of the ring that is not water."
            }
          }
        }
      },
      "description": "What a ring of each size must hold."
    },
    "candidates": {
      "type": "object",
      "required": [
        "close",
        "half",
        "whole"
      ],
      "additionalProperties": false,
      "properties": {
        "close": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Rings tried."
        },
        "half": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Rings tried."
        },
        "whole": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Rings tried."
        }
      },
      "description": "How many candidate rings are tried for a claim at each size."
    },
    "stride": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "Columns between the coarse read's samples."
    },
    "biomeShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The share of a ring a kind of ground needs to count as seen."
    },
    "ref": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1,
      "description": "The share (or count) at which a suit counts in full."
    },
    "mustAt": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The least value a must-cross feature may have."
    },
    "avoidWeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "description": "How much of an avoided feature's value comes off the score."
    },
    "homeBonus": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "description": "Added to the score when the ring holds the claim's home place."
    },
    "coastRef": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 20,
      "description": "Coast crossings that count as a full coast."
    },
    "turn": {
      "type": "object",
      "required": [
        "on",
        "maxTurns",
        "gapSeconds",
        "driftDeg",
        "bearings",
        "carryUnits",
        "viewUnits",
        "moveMax",
        "minDeg",
        "warmCols",
        "fallbackDeg"
      ],
      "additionalProperties": false,
      "properties": {
        "on": {
          "enum": [
            0,
            1
          ],
          "description": "The calm-moment turn: 0 off, 1 on."
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "Turns a fight (Game Design: 4)."
        },
        "gapSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 600,
          "description": "Fight seconds between turns (Game Design: 60)."
        },
        "driftDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "description": "The most the ring's axis may move in all, in degrees (Game Design: 40)."
        },
        "bearings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 10,
            "description": "A candidate turn in degrees: none over 10 (Game Design)."
          },
          "description": "The candidate bearings."
        },
        "carryUnits": {
          "type": "number",
          "minimum": 1000,
          "maximum": 40000,
          "description": "How far each way from the pair the ground and its marks and buildings stay."
        },
        "viewUnits": {
          "type": "number",
          "minimum": 1000,
          "maximum": 40000,
          "description": "How far each way a turn counts the places it brings into view."
        },
        "moveMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000,
          "description": "The most the ground under a fighter may move at a turn, in units (Game Design: 300): a turn about a mispredicted pivot is scaled down to it."
        },
        "minDeg": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "description": "The least angle a turn is scaled to (Game Design: 2 degrees)."
        },
        "warmCols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4800,
          "description": "The columns of each of a decided turn's rings the sim reads a tick, unless Encounter's pick brings its own (16 to 32). 32 reads a Whole ring in 150 ticks."
        },
        "fallbackDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "The bearing in degrees of the second ring a decided turn warms (a landing off the pivot falls back to it), unless Encounter's pick brings its own; 0 for none."
        }
      }
    }
  },
  "additionalProperties": false
}
