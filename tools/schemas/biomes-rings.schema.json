{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/biomes-rings",
  "title": "biomes.rings/1",
  "description": "data/biomes/rings.json: the ring picker's numbers (docs/world/shifting-arena-design.md window 4; WorldRingPick): the three sizes in columns, the minimum a ring holds by size, how many candidates are tried, and the scoring weights. Every key required. Version field: schema. Policy: closed except keys starting with an underscore.",
  "type": "object",
  "required": [
    "schema",
    "sizes",
    "minimum",
    "candidates",
    "stride",
    "biomeShare",
    "ref",
    "mustAt",
    "avoidWeight",
    "homeBonus",
    "coastRef"
  ],
  "properties": {
    "schema": {
      "const": "biomes.rings/1"
    },
    "_about": {
      "type": "string"
    },
    "sizes": {
      "type": "object",
      "required": [
        "close",
        "half",
        "whole"
      ],
      "additionalProperties": false,
      "properties": {
        "close": {
          "type": "integer",
          "minimum": 600,
          "maximum": 4800,
          "multipleOf": 8,
          "description": "The ring's columns (a column is 32 units of arc), a multiple of 8: the ground's largest stride."
        },
        "half": {
          "type": "integer",
          "minimum": 600,
          "maximum": 4800,
          "multipleOf": 8,
          "description": "The ring's columns (a column is 32 units of arc), a multiple of 8: the ground's largest stride."
        },
        "whole": {
          "type": "integer",
          "minimum": 600,
          "maximum": 4800,
          "multipleOf": 8,
          "description": "The ring's columns (a column is 32 units of arc), a multiple of 8: the ground's largest stride."
        }
      },
      "description": "Game Design's three sizes in columns: close 1,200, half 2,400, whole 4,800."
    },
    "minimum": {
      "type": "object",
      "required": [
        "close",
        "half",
        "whole"
      ],
      "additionalProperties": false,
      "properties": {
        "close": {
          "type": "object",
          "required": [
            "cities",
            "towns",
            "biomes",
            "land"
          ],
          "additionalProperties": false,
          "properties": {
            "cities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Standing cities the ring holds."
            },
            "towns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "Standing towns the ring holds."
            },
            "biomes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7,
              "description": "Kinds of ground of at least biomeShare of the ring."
            },
            "land": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The share of the ring that is not water."
            }
          }
        },
        "half": {
          "type": "object",
          "required": [
            "cities",
            "towns",
            "biomes",
            "land"
          ],
          "additionalProperties": false,
          "properties": {
            "cities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Standing cities the ring holds."
            },
            "towns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "Standing towns the ring holds."
            },
            "biomes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7,
              "description": "Kinds of ground of at least biomeShare of the ring."
            },
            "land": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The share of the ring that is not water."
            }
          }
        },
        "whole": {
          "type": "object",
          "required": [
            "cities",
            "towns",
            "biomes",
            "land"
          ],
          "additionalProperties": false,
          "properties": {
            "cities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "Standing cities the ring holds."
            },
            "towns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "Standing towns the ring holds."
            },
            "biomes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7,
              "description": "Kinds of ground of at least biomeShare of the ring."
            },
            "land": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The share of the ring that is not water."
            }
          }
        }
      },
      "description": "What a ring of each size must hold."
    },
    "candidates": {
      "type": "object",
      "required": [
        "close",
        "half",
        "whole"
      ],
      "additionalProperties": false,
      "properties": {
        "close": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Rings tried."
        },
        "half": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Rings tried."
        },
        "whole": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Rings tried."
        }
      },
      "description": "How many candidate rings are tried for a claim at each size."
    },
    "stride": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "Columns between the coarse read's samples."
    },
    "biomeShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The share of a ring a kind of ground needs to count as seen."
    },
    "ref": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1,
      "description": "The share (or count) at which a suit counts in full."
    },
    "mustAt": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The least value a must-cross feature may have."
    },
    "avoidWeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "description": "How much of an avoided feature's value comes off the score."
    },
    "homeBonus": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "description": "Added to the score when the ring holds the claim's home place."
    },
    "coastRef": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 20,
      "description": "Coast crossings that count as a full coast."
    }
  },
  "additionalProperties": false
}
