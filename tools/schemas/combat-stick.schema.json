{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/combat-stick",
  "title": "combat.stick/1",
  "description": "docs/combat/pending/stick/README.md: data/combat/stick.json, the right stick's pieces and the look of its beams. Read only with switches.rightStick on. Policy: closed except keys starting with an underscore.",
  "type": "object",
  "required": ["schema", "beam", "pools"],
  "patternProperties": { "^_": {} },
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "combat.stick/1" },
    "beam": {
      "type": "object",
      "required": ["snap", "levels", "aimDeg", "fighters"],
      "patternProperties": { "^_": {} },
      "additionalProperties": false,
      "properties": {
        "snap": {
          "type": "object",
          "required": ["windupTicks", "ki", "lengthTicks", "worthOfHeavy", "power", "widthMul", "struggle"],
          "additionalProperties": false,
          "properties": {
            "windupTicks": { "type": "integer", "minimum": 1 },
            "ki": { "type": "number", "minimum": 0 },
            "lengthTicks": { "type": "integer", "minimum": 1 },
            "worthOfHeavy": { "type": "number", "exclusiveMinimum": 0 },
            "power": { "type": "number", "exclusiveMinimum": 0 },
            "widthMul": { "type": "number", "exclusiveMinimum": 0 },
            "struggle": { "const": false }
          }
        },
        "levels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["level", "atTicks", "lengthTicks", "worthOfHeavy", "ki", "power"],
            "additionalProperties": false,
            "properties": {
              "level": { "type": "integer", "minimum": 1, "maximum": 3 },
              "atTicks": { "type": "integer", "minimum": 1 },
              "lengthTicks": { "type": "integer", "minimum": 1 },
              "worthOfHeavy": { "type": "number", "exclusiveMinimum": 0 },
              "ki": { "type": "number", "minimum": 0 },
              "power": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "aimDeg": {
          "type": "object",
          "required": ["toward", "up", "down", "away"],
          "additionalProperties": false,
          "properties": {
            "toward": { "type": "number" },
            "up": { "type": "number" },
            "down": { "type": "number" },
            "away": { "type": "number" }
          }
        },
        "fighters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["widthMul", "sweepDegPerSec"],
            "additionalProperties": false,
            "properties": {
              "widthMul": { "type": "number", "exclusiveMinimum": 0 },
              "sweepDegPerSec": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "pools": {
      "type": "object",
      "minProperties": 1,
      "description": "Per fighter (his recipes pool key): recipe pools, the row shape of data/combat/recipes.json.",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "pattern": "^stick\\.(quick\\.(up|down|downAir|toward|away)|(charged|guard|move|beam)\\.(up|down|toward|away))$" },
        "required": [
          "stick.quick.up", "stick.quick.down", "stick.quick.downAir", "stick.quick.toward", "stick.quick.away",
          "stick.charged.up", "stick.charged.down", "stick.charged.toward", "stick.charged.away",
          "stick.guard.up", "stick.guard.down", "stick.guard.toward", "stick.guard.away",
          "stick.move.up", "stick.move.down", "stick.move.toward", "stick.move.away",
          "stick.beam.up", "stick.beam.down", "stick.beam.toward", "stick.beam.away"
        ],
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^strike\\." },
              "status": { "enum": ["posed", "derived"] }
            }
          }
        }
      }
    }
  }
}
