{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/vfx-energy",
  "title": "vfx energy look (version 1)",
  "description": "data/vfx/energy.json: the signature beams' layers and each fighter's flavour (docs/vfx/beam-look.md). Presentation only: read by render/vfx/beam_look.gd, never by the sim. Version field: version. Policy: closed except keys starting with an underscore. A flavour is keyed by the roster id in lower case (protagonist, rival, reference), `rival_short` for the Anti-hero's short beam; `hz` is the ripple rate at any point of the beam and may not pass 2 (Legal fx03); a layer's `lum_amp` is the most its alpha moves with the shimmer and may not pass 0.2.",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "beam": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "properties": {
            "width_k": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            },
            "hue_shift": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "hz": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2
            },
            "wavelength": {
              "type": "number",
              "minimum": 20,
              "maximum": 600
            },
            "flow": {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            "turb": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "heel": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "seed": {
              "type": "number"
            },
            "wob_k": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "fil": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "soft_k": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            },
            "hue_shift_tritan": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "hue_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "pat": {
              "enum": [
                0,
                1,
                2
              ]
            },
            "pat_k": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.03
            },
            "pat_a": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "pat_scale": {
              "type": "number",
              "minimum": 30,
              "maximum": 300
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      },
      "additionalProperties": false,
      "properties": {}
    },
    "layers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "k",
          "px",
          "alpha",
          "soft",
          "turb_k",
          "lum_amp",
          "sat",
          "val",
          "lighten",
          "flow_k",
          "wob"
        ],
        "properties": {
          "k": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "px": {
            "type": "number",
            "minimum": 0
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "soft": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "turb_k": {
            "type": "number",
            "minimum": 0
          },
          "lum_amp": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.2
          },
          "sat": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "val": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1.2
          },
          "lighten": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.2
          },
          "flow_k": {
            "type": "number",
            "minimum": 0
          },
          "wob": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "len_k": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2
          },
          "pat_w": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "calm": {
      "type": "object",
      "properties": {
        "strength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "rise_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "cap": {
      "type": "number",
      "minimum": 0
    },
    "rates": {
      "type": "object",
      "patternProperties": {
        "^_": true,
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "required": [
            "hz",
            "calm_hz",
            "strokes_only"
          ],
          "properties": {
            "hz": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "calm_hz": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "strokes_only": {
              "type": "boolean"
            },
            "what": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scar": {
      "type": "object",
      "description": "The scar a beam leaves in the air as its tail draws back (render/vfx/beam_scar.gd, shaders/beam_scar.gdshader, docs/vfx/beam-scar.md): a thin dark cut with a bright lane-coloured rim that cools, healing slowly by thinning and by pieces dropping out with hard edges (never a fade). All keys optional: beam_scar.gd falls back to the same defaults.",
      "properties": {
        "heal_s": {
          "type": "number",
          "maximum": 20,
          "exclusiveMinimum": 0.5
        },
        "hw_k": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0.02
        },
        "hw_px": {
          "type": "number",
          "maximum": 12,
          "exclusiveMinimum": 0.5
        },
        "rim_px": {
          "type": "number",
          "maximum": 8,
          "exclusiveMinimum": 0.5
        },
        "alpha_core": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0.05
        },
        "alpha_rim": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0.05
        },
        "dark": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        },
        "cell": {
          "type": "number",
          "maximum": 600,
          "exclusiveMinimum": 20
        },
        "cool_s": {
          "type": "number",
          "maximum": 6,
          "exclusiveMinimum": 0.1
        },
        "grow_s": {
          "type": "number",
          "maximum": 2,
          "exclusiveMinimum": 0.02
        },
        "cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "additionalProperties": false
    },
    "struggle": {
      "type": "object",
      "description": "The beam struggle carried by the beams themselves (render/vfx/beam_struggle.gd, docs/vfx/beam-struggle.md): the winner's beam thicker, a swell down each beam to the meeting point on every pulse, a bigger one down the presser's beam on a surge, a pinch on a stray, and the meeting point swelling slowly. All keys optional: beam_struggle.gd falls back to the same defaults.",
      "properties": {
        "push_k": {
          "type": "number",
          "maximum": 0.8,
          "minimum": 0
        },
        "ease_s": {
          "type": "number",
          "maximum": 3,
          "exclusiveMinimum": 0.02
        },
        "wave_ticks": {
          "type": "number",
          "maximum": 60,
          "exclusiveMinimum": 2
        },
        "surge_amp": {
          "type": "number",
          "maximum": 2,
          "minimum": 0
        },
        "sharp_k": {
          "type": "number",
          "maximum": 3,
          "minimum": 1
        },
        "beat_amp": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        },
        "stray_amp": {
          "type": "number",
          "minimum": -0.8,
          "maximum": 0
        },
        "wave_half": {
          "type": "number",
          "maximum": 0.5,
          "exclusiveMinimum": 0.01
        },
        "wave_half_max": {
          "type": "number",
          "maximum": 600,
          "exclusiveMinimum": 10
        },
        "lum": {
          "type": "number",
          "maximum": 0.1,
          "minimum": 0
        },
        "knot_amp": {
          "type": "number",
          "maximum": 1.5,
          "minimum": 0
        },
        "knot_s": {
          "type": "number",
          "maximum": 10,
          "exclusiveMinimum": 0.1
        },
        "knot_surge": {
          "type": "number",
          "maximum": 0.5,
          "minimum": 0
        },
        "knot_decay_s": {
          "type": "number",
          "maximum": 20,
          "exclusiveMinimum": 0.1
        },
        "calm_gap": {
          "type": "number",
          "maximum": 120,
          "minimum": 0
        },
        "amp_calm": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        },
        "flare_k": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        },
        "flare_ease_s": {
          "type": "number",
          "maximum": 5,
          "exclusiveMinimum": 0.02
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
