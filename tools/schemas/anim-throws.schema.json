{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-throws",
  "title": "anim-throws (schema \"anim.throws/1\")",
  "description": "data/anim/throws.json: Inferred by the EP with Tools' helper from Animation's file; Animation tightens values.. A shape check inferred from the file (docs/tools/pending/infer-schema.cjs): every key present is required, a key outside is refused unless it starts with an underscore, a number is bounded only below by zero where all its values are, a colour is a hex string; the owner tightens the values. Version field: schema. Policy: closed except keys starting with an underscore.",
  "type": "object",
  "required": [
    "schema",
    "sends",
    "grip",
    "wrists_apart_min"
  ],
  "properties": {
    "schema": {
      "const": "anim.throws/1"
    },
    "sends": {
      "type": "object",
      "required": [
        "across_toward",
        "across_away",
        "across_none",
        "down",
        "up"
      ],
      "properties": {
        "across_toward": {
          "type": "object",
          "required": [
            "protagonist",
            "antihero"
          ],
          "properties": {
            "protagonist": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Protagonist's throw (a sequence of a wave: rule anim-throws-sequence)."
            },
            "antihero": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Anti-hero's throw."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "across_away": {
          "type": "object",
          "required": [
            "protagonist",
            "antihero"
          ],
          "properties": {
            "protagonist": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Protagonist's throw (a sequence of a wave: rule anim-throws-sequence)."
            },
            "antihero": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Anti-hero's throw."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "across_none": {
          "type": "object",
          "required": [
            "protagonist",
            "antihero"
          ],
          "properties": {
            "protagonist": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Protagonist's throw (a sequence of a wave: rule anim-throws-sequence)."
            },
            "antihero": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Anti-hero's throw."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "down": {
          "type": "object",
          "required": [
            "protagonist",
            "antihero"
          ],
          "properties": {
            "protagonist": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Protagonist's throw (a sequence of a wave: rule anim-throws-sequence)."
            },
            "antihero": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Anti-hero's throw."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "up": {
          "type": "object",
          "required": [
            "protagonist",
            "antihero"
          ],
          "properties": {
            "protagonist": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Protagonist's throw (a sequence of a wave: rule anim-throws-sequence)."
            },
            "antihero": {
              "type": "string",
              "pattern": "^[a-z]+[0-9]*[.][a-z0-9_.]+$",
              "description": "The Anti-hero's throw."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      },
      "description": "The throws by the send's direction (all five)."
    },
    "grip": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z]+[0-9]*[.][a-z0-9_.]+)$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "hand_r": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "The body part of the rival the hand takes hold of."
          },
          "hand_l": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "The body part of the rival the hand takes hold of."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      },
      "patternProperties": {
        "^_": true
      },
      "description": "Throw sequence to where its hands take hold (every throw of sends, and no other: rule anim-throws-grip)."
    },
    "wrists_apart_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "The least the wrists are apart for a hold, in units."
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
