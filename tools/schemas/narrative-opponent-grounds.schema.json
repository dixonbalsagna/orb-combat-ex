{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/narrative-opponent-grounds",
  "title": "narrative.opponent_grounds/1",
  "description": "data/narrative/opponent_grounds.json: the ground each story opponent claims, read by sim/world/ringpick.gd (docs/narrative/opponent-grounds.md). Version field: schema. Policy: closed except keys starting with an underscore. Feature names are the picker's vocabulary: the grammar is checked here, the names against ringpick.gd in tools/lib/xref-grounds.js (rule opponent-grounds-feature); each opponent has a home of their own (rule opponent-grounds-home). A claim's `line` is checked by the narrative lint (4 to 12 words).",
  "type": "object",
  "required": [
    "schema",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "narrative.opponent_grounds/1"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallbacks": {
      "type": "object"
    },
    "legal_ln04": {
      "type": "string"
    },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "RIVAL",
          "EMPRESS",
          "CYBORG",
          "PROTAGONIST"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "home",
          "suits",
          "must_cross",
          "avoids",
          "size"
        ],
        "properties": {
          "home": {
            "type": "string",
            "minLength": 1,
            "description": "The opponent's home place name: colour and set piece, never numbers (rule opponent-grounds-home: each opponent has their own, and it is the name in the homes data once that is in the tree)."
          },
          "suits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "feature",
                "w"
              ],
              "properties": {
                "feature": {
                  "type": "string",
                  "pattern": "^[a-z][a-z_]*(?::[a-z_]+(?:>=[0-9]+[.][0-9]+)?)?(?:[|][a-z][a-z_]*(?::[a-z_]+(?:>=[0-9]+[.][0-9]+)?)?)*$",
                  "description": "A feature of the ring picker (sim/world/ringpick.gd featureValue; rule opponent-grounds-feature): \"a|b\" is the larger of the two; \"biome:plains>=0.33\" is full at that share."
                },
                "w": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                }
              },
              "additionalProperties": false
            }
          },
          "must_cross": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z_]*(?::[a-z_]+(?:>=[0-9]+[.][0-9]+)?)?(?:[|][a-z][a-z_]*(?::[a-z_]+(?:>=[0-9]+[.][0-9]+)?)?)*$",
              "description": "A feature the ring must have (the picker's vocabulary)."
            }
          },
          "avoids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z_]*(?::[a-z_]+(?:>=[0-9]+[.][0-9]+)?)?(?:[|][a-z][a-z_]*(?::[a-z_]+(?:>=[0-9]+[.][0-9]+)?)?)*$",
              "description": "A feature the ring should not have (the picker's vocabulary)."
            }
          },
          "size": {
            "type": "object",
            "required": [
              "early",
              "mid",
              "boss"
            ],
            "properties": {
              "early": {
                "enum": [
                  "close",
                  "half",
                  "whole"
                ]
              },
              "mid": {
                "enum": [
                  "close",
                  "half",
                  "whole"
                ]
              },
              "boss": {
                "enum": [
                  "close",
                  "half",
                  "whole"
                ]
              }
            },
            "additionalProperties": false
          },
          "why": {
            "type": "string"
          },
          "line": {
            "type": "string"
          },
          "legal": {
            "type": "string"
          }
        },
        "patternProperties": {
          "^_": {}
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false
}
