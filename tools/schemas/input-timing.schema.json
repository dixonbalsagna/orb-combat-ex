{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/input-timing",
  "title": "input timing (schema 1)",
  "description": "data/input/timing.json: every tick value of the input scheme: hold thresholds, the perfect-block windows, buffers and lockouts, the attack queue, the mode toggle, touch gestures, stick and trigger settings, and the hit-stop table (docs/controls/input-schema.md section 5; it carries over feel-schema.md's hit-stop, hold and stick values). Times are whole ticks at 60 per second unless a key says otherwise (px, dp, ki, fractions). Version field: schema. Policy: closed except keys starting with an underscore; hitstopTicks takes underscore comment keys. An unfunded signature is refused at once, so there is no unfunded-expiry key (I2c). chordWindow, stateTicks and awayDead are required; dodge.lungeTicks and stick.fullAt are optional (code defaults 12 and 0.9) until Controls' data carries them. Cross-references (timing-order, timing-perfect, timing-hold, timing-hitstop-order, timing-hitstop-budget) are checked by tools/lib/xref-input.js.",
  "type": "object",
  "required": [
    "schema",
    "ticksPerSecond",
    "tapHold",
    "perfectBlock",
    "dodge",
    "attackQueue",
    "mode",
    "touch",
    "stick",
    "hitstopTicks"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "ticksPerSecond": {
      "const": 60
    },
    "tapHold": {
      "type": "object",
      "required": [
        "holdStart",
        "transformConfirm",
        "encoreConfirm",
        "encoreOffer",
        "chordWindow"
      ],
      "properties": {
        "holdStart": {
          "type": "integer",
          "minimum": 1
        },
        "transformConfirm": {
          "type": "integer",
          "minimum": 1
        },
        "encoreConfirm": {
          "type": "integer",
          "minimum": 1
        },
        "encoreOffer": {
          "type": "integer",
          "minimum": 1
        },
        "chordWindow": {
          "type": "integer",
          "minimum": 1,
          "description": "Ticks within which the controls of a chord must all be down (I2c)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "perfectBlock": {
      "type": "object",
      "required": [
        "lightWindow",
        "heavyWindow",
        "buffer",
        "touchBufferBonus",
        "antiMashLockout",
        "assistFactor"
      ],
      "properties": {
        "lightWindow": {
          "type": "integer",
          "minimum": 1
        },
        "heavyWindow": {
          "type": "integer",
          "minimum": 1
        },
        "buffer": {
          "type": "integer",
          "minimum": 0
        },
        "touchBufferBonus": {
          "type": "integer",
          "minimum": 0
        },
        "antiMashLockout": {
          "type": "integer",
          "minimum": 0
        },
        "assistFactor": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "dodge": {
      "type": "object",
      "required": [
        "buffer",
        "stateTicks"
      ],
      "properties": {
        "buffer": {
          "type": "integer",
          "minimum": 0
        },
        "stateTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "Ticks the dodge state lasts (I2c)."
        },
        "lungeTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "The free lunge (today's dash) that goes with a dodge, in ticks (12 by default in code until the director moves the fighter itself)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "attackQueue": {
      "type": "object",
      "required": [
        "max",
        "expiry",
        "upgradeWindow",
        "heavyKi",
        "signatureKi"
      ],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "expiry": {
          "type": "integer",
          "minimum": 1
        },
        "upgradeWindow": {
          "type": "integer",
          "minimum": 1
        },
        "heavyKi": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "signatureKi": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "toggleCooldown"
      ],
      "properties": {
        "toggleCooldown": {
          "type": "integer",
          "minimum": 0
        },
        "style": {
          "enum": [
            "hold",
            "toggle"
          ],
          "description": "How the mode control works by default: hold (momentary energy, the default) or toggle (the old latch, the accessibility setting)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "aim": {
      "type": "object",
      "description": "The stick as an aim (docs/controls/agency-input.md 1b, sim/input/aim.gd): the 8-sector snap and the latch of the launch direction. Optional: the code defaults are these values.",
      "properties": {
        "deadZone": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "The stick must pass this fraction of full deflection to aim (0.35; the move dead zone is 0.2)."
        },
        "latchTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "The latest aim within this many ticks of the launch decision still counts (12)."
        },
        "snapMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "The director snaps to a target within this many 45-degree sectors (1)."
        },
        "dwellTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "The zip's exit read: a stick direction counts as held if it was the sector for at least this many of the last exitWindow ticks (3)."
        },
        "exitWindow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "The exit read looks back this many ticks (12; the sample ring holds 12)."
        },
        "nudgeStart": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "The brawl's nudge ramp (SimAim.nudge_ramp): a fresh push of the stick starts at this share of full (0.4)."
        },
        "nudgeTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "... and the nudge rises to full over this many ticks (12); letting go is instant."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "stance": {
      "type": "object",
      "description": "The stance buttons (docs/controls/lunge-control.md A2, sim/input/stance.gd, layout.gd). Optional: the code defaults are these values.",
      "properties": {
        "releaseGrace": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "A released stance button keeps the stance mask this many ticks, so a flutter of the finger does not flicker the stance (2). The mask only: the button's own fields end at once."
        },
        "oneshotTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "With one-shot arming on, a tap on a stance button arms the stance for the next blow, and it lapses unspent after this many ticks (90)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "haptics": {
      "type": "object",
      "description": "The pulses the host plays on a pad or a phone when UI asks (docs/controls/haptics.md, sim/input/haptics.gd). Optional: the code defaults are these values. Never the only cue.",
      "properties": {
        "minGapMs": {
          "type": "integer",
          "minimum": 0,
          "description": "A second request for the same slot inside this many milliseconds is dropped (80)."
        },
        "padMinMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "The shortest pad pulse: a motor needs about 20 to 40 ms to spin up, so a shorter step is lengthened to this (20)."
        },
        "handheldMinMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "The shortest phone vibration (10)."
        },
        "launch_open": {
          "type": "object",
          "description": "A launch has opened for him (the lit B): a thump, then a ring 90 ms later (Audio's shape).",
          "properties": {
            "pad": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "weak": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The high-frequency motor, 0 to 1."
                  },
                  "strong": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The low-frequency motor, 0 to 1."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The pulse's length, raised to padMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A pad's steps: up to four, each played at its own time."
            },
            "handheld": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The vibration's length, raised to handheldMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A phone's steps."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "form_prompt": {
          "type": "object",
          "description": "His form is ready: a soft thump.",
          "properties": {
            "pad": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "weak": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The high-frequency motor, 0 to 1."
                  },
                  "strong": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The low-frequency motor, 0 to 1."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The pulse's length, raised to padMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A pad's steps: up to four, each played at its own time."
            },
            "handheld": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The vibration's length, raised to handheldMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A phone's steps."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "struggle_pulse": {
          "type": "object",
          "description": "The beam struggle's beat, for both players: a low thud.",
          "properties": {
            "pad": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "weak": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The high-frequency motor, 0 to 1."
                  },
                  "strong": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The low-frequency motor, 0 to 1."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The pulse's length, raised to padMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A pad's steps: up to four, each played at its own time."
            },
            "handheld": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The vibration's length, raised to handheldMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A phone's steps."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "struggle_surge": {
          "type": "object",
          "description": "A player's own surge in the struggle.",
          "properties": {
            "pad": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "weak": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The high-frequency motor, 0 to 1."
                  },
                  "strong": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The low-frequency motor, 0 to 1."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The pulse's length, raised to padMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A pad's steps: up to four, each played at its own time."
            },
            "handheld": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The vibration's length, raised to handheldMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A phone's steps."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "struggle_lose": {
          "type": "object",
          "description": "The loser's end of a struggle.",
          "properties": {
            "pad": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "weak": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The high-frequency motor, 0 to 1."
                  },
                  "strong": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "The low-frequency motor, 0 to 1."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The pulse's length, raised to padMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A pad's steps: up to four, each played at its own time."
            },
            "handheld": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000,
                    "description": "Milliseconds after the request (0)."
                  },
                  "ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "description": "The vibration's length, raised to handheldMinMs; 0 leaves the step out."
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^_": true
                }
              },
              "description": "A phone's steps."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "switches": {
      "type": "object",
      "description": "Parked behaviours (docs/controls/brake-and-grapple.md): each is off until its owner switches it on. Optional: absent is off.",
      "properties": {
        "airBrakeGuard": {
          "type": "boolean",
          "description": "While the host says a Simple slot's fighter is sent, Guard held sets stanceMask bit 8, the air brake's (off)."
        },
        "grappleReads": {
          "type": "boolean",
          "description": "SimPressRead.a_read drops the shove and the clinch-by-mash; the grapple's catch_read and brace_read replace them (off)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "read": {
      "type": "object",
      "description": "The press reader (docs/controls/agency-input.md 1a, sim/input/press_read.gd): how holds, mashes and taps in time with the blows are told apart, and the contact debounce. Optional: the code defaults are these values.",
      "properties": {
        "logSize": {
          "type": "integer",
          "minimum": 3,
          "description": "Attack presses the press log keeps: the fight alchemist's read (5)."
        },
        "holdTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "A button down this long is a hold; defaults to tapHold.holdStart."
        },
        "beatHalf": {
          "type": "integer",
          "minimum": 0,
          "description": "A press within this many ticks of a blow's contact is on the beat (4: an 8-tick window)."
        },
        "touchBeatHalf": {
          "type": "integer",
          "minimum": 0,
          "description": "The same on touch (5: 10 ticks)."
        },
        "rhythmOf": {
          "type": "integer",
          "minimum": 1,
          "description": "Rhythm looks at the last N presses ..."
        },
        "rhythmNeed": {
          "type": "integer",
          "minimum": 1,
          "description": "... and needs this many of them on the beat."
        },
        "mashPresses": {
          "type": "integer",
          "minimum": 2,
          "description": "A mash is this many presses ..."
        },
        "mashGap": {
          "type": "integer",
          "minimum": 1,
          "description": "... with every gap this many ticks or fewer."
        },
        "mashClear": {
          "type": "integer",
          "minimum": 1,
          "description": "A mash is over after this many ticks without a press."
        },
        "staleTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "A log older than this reads as nothing."
        },
        "mixShort": {
          "type": "integer",
          "minimum": 1,
          "description": "The alchemist's short mix window, in presses."
        },
        "assistFactor": {
          "type": "integer",
          "minimum": 1,
          "description": "Accessibility: the beat window is multiplied by this."
        },
        "perfectStreak": {
          "type": "integer",
          "minimum": 1,
          "description": "This many perfect presses in a row make a timed string."
        },
        "expireTicks": {
          "type": "integer",
          "minimum": 1,
          "description": "The whole window of presses lapses after this many ticks with no press (90; agency-pass.md section 20), not press by press."
        },
        "powerShare": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Heavies over this percent of the presses present make the power style; up to it, combo; none, blur (60)."
        },
        "steadyPresses": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "description": "A steady mash is this many presses in a row, evenly spaced and each on a blow's contact (4; section 20)."
        },
        "blurBeatHalf": {
          "type": "integer",
          "minimum": 0,
          "description": "Each of those presses within this many ticks of a blow's contact (2; the combo's timed press is beatHalf, 4)."
        },
        "blurBeatBonus": {
          "type": "integer",
          "minimum": 0,
          "description": "Added to blurBeatHalf on touch or at 30 fps; the assist factor doubles the result (2)."
        },
        "debounce": {
          "type": "integer",
          "minimum": 0,
          "description": "A press of an attack button within this many ticks of its own release is the same press."
        },
        "zipMashPresses": {
          "type": "integer",
          "minimum": 2,
          "description": "A zip's speed reading: the starter and this many minus one more presses (3) ..."
        },
        "zipMashGap": {
          "type": "integer",
          "minimum": 1,
          "description": "... each within this many ticks of the one before (10)."
        },
        "burstStart": {
          "type": "integer",
          "minimum": 1,
          "description": "A light (X) held this many LIVE ticks starts the burst; the classifier's hold for X (8; Game Design is ruling between 4, 8 and more). Replaces holdLight."
        },
        "windupMedium": {
          "type": "integer",
          "minimum": 1,
          "description": "Y, the medium: a tap lands when this wind-up ends (12 live ticks); still down at wind-up plus grace it is the charged medium."
        },
        "windupHeavy": {
          "type": "integer",
          "minimum": 1,
          "description": "B, the heavy, in the martial stance: its wind-up (28)."
        },
        "windupContext": {
          "type": "integer",
          "minimum": 1,
          "description": "A: the shove's wind-up (12); held to wind-up plus grace it is the tackle's coil."
        },
        "windupGrace": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "A release in this many ticks after the wind-up's end is still a tap, on every device (4)."
        },
        "pairWindow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Two adjacent face buttons within this many ticks are one pair (3; doubled by the assist setting)."
        },
        "pairFresh": {
          "type": "integer",
          "minimum": 0,
          "description": "... and neither button was pressed in this many ticks before (8)."
        },
        "flurryGapX": {
          "type": "integer",
          "minimum": 1,
          "description": "The pace of the X flurry: a press of the same button within this many ticks continues it (12)."
        },
        "flurryGapY": {
          "type": "integer",
          "minimum": 1,
          "description": "The pace of the Y flurry (16)."
        },
        "flurryGapB": {
          "type": "integer",
          "minimum": 1,
          "description": "The pace of the B flurry (34)."
        },
        "flurryNeedSlow": {
          "type": "integer",
          "minimum": 2,
          "description": "Presses that make a Y or B flurry (2); X uses mashPresses."
        },
        "mixupSwitches": {
          "type": "integer",
          "minimum": 1,
          "description": "Changes of button in one chain of X, Y and B presses that make a mix-up (2)."
        },
        "simpleMediumStart": {
