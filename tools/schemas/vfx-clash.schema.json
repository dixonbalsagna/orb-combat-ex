{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/vfx-clash",
  "title": "vfx beam clash look (version 1)",
  "description": "data/vfx/clash.json: the meeting point of a beam clash as rippling glowing air, composed per fighter, form and state (docs/vfx/clash-look.md). Presentation only: read by render/vfx/clash_look.gd and clash_view.gd, never by the sim. Version field: version. Policy: closed except keys starting with an underscore. A fighter is a row of `fighters` keyed by his roster id in lower case; a missing row is `default`.",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "enabled": {
      "type": "boolean",
      "description": "Off: BeamView draws the old flare."
    },
    "frame": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius_per_power": {
          "type": "number",
          "minimum": 0
        },
        "radius_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ring_n": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ring_n_per_power": {
          "type": "number",
          "minimum": 0
        },
        "ring_hz": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "ring_hz_calm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "front_hz": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "distort": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "distort_calm": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "lens": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "keep_r": {
          "type": "number",
          "minimum": 0
        },
        "keep_y": {
          "type": "number"
        },
        "glow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "glow_cap": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.95
        },
        "lighten": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.15
        },
        "core_r": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        },
        "core_per_knot": {
          "type": "number",
          "minimum": 0
        },
        "lean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ease_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "burst_ticks": {
          "type": "number",
          "minimum": 0
        },
        "burst_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "burst_gap": {
          "type": "number",
          "minimum": 0
        },
        "burst_gap_calm": {
          "type": "number",
          "minimum": 0
        },
        "burst_amp": {
          "type": "number",
          "minimum": 0
        },
        "calm_strength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "calm_rise_s": {
          "type": "number",
          "minimum": 0
        },
        "spikes": {
          "type": "number",
          "minimum": 0
        },
        "spikes_per_power": {
          "type": "number",
          "minimum": 0
        },
        "rise_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fall_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z_off": {
          "type": "number",
          "minimum": -20,
          "maximum": 20,
          "description": "The air's depth against the beams' own prisms (units toward the camera): below 0 the two beam heads press in front of the air, above 0 the air covers their ends (the first build)."
        },
        "strip_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How clear the shine keeps the two beams' strip through the meeting point (1 clear, 0 over the beams)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      },
      "description": "The air's size, rates and strengths. A rate is how often a point of the disc sees a ring crest or a front pass, in Hz: 2 or slower (Legal fx03), 1.5 or slower under Reduce flashing (fx04). glow_cap is the brightest the glow's colour reaches (it is mixed over the scene, never white)."
    },
    "power": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "number",
          "minimum": 0
        },
        "step": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      },
      "description": "A side's power: tier times `tier` plus his form step times `step`, at most `max`."
    },
    "fronts": {
      "type": "object",
      "description": "A front's name to the shader's id (0 wall, 1 lances, 2 wire, 3 sputter, 4 plain).",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      },
      "patternProperties": {
        "^_": true
      }
    },
    "textures": {
      "type": "object",
      "description": "A texture's name to the shader's id (0 none, 1 boil, 2 facets).",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2
      },
      "patternProperties": {
        "^_": true
      }
    },
    "fighters": {
      "type": "object",
      "description": "The rows, by roster id.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "front": {
            "type": "string",
            "description": "How this side's pressure moves: a key of `fronts`."
          },
          "texture": {
            "type": "string",
            "description": "The texture inside it: a key of `textures`. Missing: the fighter's beam pattern (energy.json)."
          },
          "lane": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "His lane colour when it is not his aura's (a fighter not yet on the roster, or one whose aura is a fire colour Art swaps)."
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "What erupts from his side; missing: his second tint, lightened."
          },
          "hue_shift": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "ring_k": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "spike_k": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3
          },
          "forms": {
            "type": "object",
            "description": "Keyed by the form step he has taken (a string of the integer): the keys to change in that form.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "front": {
                  "type": "string",
                  "description": "How this side's pressure moves: a key of `fronts`."
                },
                "texture": {
                  "type": "string",
                  "description": "The texture inside it: a key of `textures`. Missing: the fighter's beam pattern (energy.json)."
                },
                "lane": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "description": "His lane colour when it is not his aura's (a fighter not yet on the roster, or one whose aura is a fire colour Art swaps)."
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$",
                  "description": "What erupts from his side; missing: his second tint, lightened."
                },
                "hue_shift": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "ring_k": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3
                },
                "spike_k": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3
                }
              },
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          },
          "situations": {
            "type": "array",
            "description": "Each entry whose condition holds changes the row, in order. The open slot for a fighter's special cases.",
            "items": {
              "type": "object",
              "properties": {
                "read": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){0,3}$",
                  "description": "A dotted path off the fighter: tier, form.step, form.branch ..."
                },
                "is": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "set": {
                  "type": "object",
                  "properties": {
                    "front": {
                      "type": "string",
                      "description": "How this side's pressure moves: a key of `fronts`."
                    },
                    "texture": {
                      "type": "string",
                      "description": "The texture inside it: a key of `textures`. Missing: the fighter's beam pattern (energy.json)."
                    },
                    "lane": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$",
                      "description": "His lane colour when it is not his aura's (a fighter not yet on the roster, or one whose aura is a fire colour Art swaps)."
                    },
                    "accent": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$",
                      "description": "What erupts from his side; missing: his second tint, lightened."
                    },
                    "hue_shift": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "ring_k": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "spike_k": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "scale": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 3
                    }
                  },
                  "additionalProperties": false,
                  "patternProperties": {
                    "^_": true
                  }
                }
              },
              "required": [
                "read",
                "set"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      },
      "patternProperties": {
        "^_": true
      }
    },
    "press": {
      "type": "object",
      "description": "The press: each clash beam's head flares, bells out into a flat sheet and sheds eddies that roll back along it (docs/vfx/clash-look.md). eddy_v / eddy_wl is the rate a point of the beam sees an eddy go by, in Hz: 0.9 or slower (checked in effects_check).",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      },
      "properties": {
        "flare_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "sheet_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "eddy_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6
        },
        "eddy_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "eddy_wl": {
          "type": "number",
          "minimum": 60
        },
        "reach": {
          "type": "number",
          "minimum": 0
        },
        "hue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surge_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calm_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "shockwave": {
      "type": "object",
      "properties": {
        "grow_r0": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grow_r1": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ring_gap_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "knot_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ring_life_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ring_alpha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "skirt_puffs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_reach": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "air_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "release_delay": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "release_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "second_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "second_delay": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "release_alpha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dome_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dome_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dome_puffs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "release_r": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "f_end": {
          "type": "object",
          "properties": {
            "win": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "break": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "draw": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "back": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      },
      "description": "The clash's shockwave (docs/vfx/clash-shockwave.md; Legal RL-246)."
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
