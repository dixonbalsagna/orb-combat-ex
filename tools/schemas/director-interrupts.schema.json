  "required": [
    "schema",
    "perfectBlock",
    "dodgeCancel",
    "burst",
    "reversal",
    "blockedString",
    "arrival",
    "stale",
    "bands",
    "blast",
    "signature",
    "buried",
    "beamPlays"
  ],
  "properties": {
