{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/fighter-wounds",
  "title": "wounds/1 (D1a as built, docs/architecture/d1-roster-data.md sections 3 and 7b)",
  "description": "data/fighters/<id>/wounds.json: the per-fighter wound numbers, loaded into a WoundsDef (sim/core/fighter_data.gd). Version field: schema. Policy: closed at every level, except keys starting with an underscore. Integer fields (units and ticks) must be integral; other numbers carry at most 15 significant digits (checked by the validator). Cross-references (a block's armWearCap below stageAt[1] (block-cap) and its shotArmWearCap below stageAt[2] (block-shot-cap); stage thresholds strictly increase, family weights match the region count) are checked by tools/lib/xref.js. The stricter brink (brinkLimbs), the act-1 damping and the overtime ramp are part of the shape.",
  "type": "object",
  "required": [
    "schema",
    "regions",
    "stageAt",
    "wearPerDamage",
    "fade",
    "focusWear",
    "family",
    "penalties",
    "cripple",
    "profile",
    "rally",
    "act1Damping",
    "overtime",
    "guardWearSplit",
    "lastStand",
    "block"
  ],
  "properties": {
    "schema": {
      "const": "wounds/1"
    },
    "regions": {
      "type": "object",
      "required": [
        "head",
        "core",
        "arms",
        "legs"
      ],
      "propertyNames": {
        "pattern": "^(head|core|arms|legs|mantle)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "brink",
          "spill"
        ],
        "properties": {
          "brink": {
            "type": "boolean"
          },
          "spill": {
            "type": "boolean",
            "description": "Pitch A: the region wears to battered and stops; wear past battered spills into the core."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      },
      "patternProperties": {
        "^_": true
      }
    },
    "stageAt": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "description": "Wear thresholds for the three stages, in units; strictly increasing (checked by tools/lib/xref.js)."
    },
    "wearPerDamage": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fade": {
      "type": "object",
      "required": [
        "out",
        "breath",
        "breathAfterTicks",
        "hidden",
        "hiddenFloor"
      ],
      "properties": {
        "out": {
          "type": "integer",
          "minimum": 0
        },
        "breath": {
          "type": "integer",
          "minimum": 0
        },
        "breathAfterTicks": {
          "type": "integer",
          "minimum": 0
        },
        "hidden": {
          "type": "integer",
          "minimum": 0
        },
        "hiddenFloor": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "focusWear": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "family": {
      "type": "object",
      "required": [
        "light",
        "heavy",
        "guard",
        "spread"
      ],
      "additionalProperties": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "number",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^_": true
      },
      "description": "Region pick weights per hit family, in region order (head, core, arms, legs)."
    },
    "penalties": {
      "type": "object",
      "required": [
        "coreKiRegen",
        "legsSpeed",
        "legsLockBreak",
        "staggerTicks",
        "dazeTicks",
        "armsGuardMul",
        "armsBrokenMul",
        "headParryNarrow",
        "headDefence",
        "legsSlip",
        "armsBrokenLightMul",
        "legsBrokenGuardScale"
      ],
      "properties": {
        "coreKiRegen": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "legsSpeed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "legsLockBreak": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "staggerTicks": {
          "type": "integer",
          "minimum": 0
        },
        "dazeTicks": {
          "type": "integer",
          "minimum": 0
        },
        "armsGuardMul": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "armsBrokenMul": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "headParryNarrow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "headDefence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "legsSlip": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "armsBrokenLightMul": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "legsBrokenGuardScale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "cripple": {
      "type": "object",
      "description": "Pitch A, the crippling moment: which limbs can break, which blows can break them, and the keyed roll.",
      "required": [
        "regions",
        "blows",
        "base",
        "tierAhead",
        "lateAct",
        "lateBonus",
        "defensive",
        "maxPerFighter",
        "surgePower",
        "legWeight"
      ],
      "properties": {
        "regions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "head",
              "arms",
              "legs",
              "mantle"
            ]
          }
        },
        "blows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "heavy",
              "beam",
              "guard_break",
              "chain"
            ]
          }
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tierAhead": {
          "type": "number"
        },
        "lateAct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "lateBonus": {
          "type": "number"
        },
        "defensive": {
          "type": "number"
        },
        "maxPerFighter": {
          "type": "integer",
          "minimum": 0
        },
        "surgePower": {
          "type": "number",
          "minimum": 0
        },
        "legWeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The legs' weight against the arms (1) when the crippling pick chooses among eligible limbs."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "plain"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "rally": {
      "type": "object",
      "required": [
        "rallyWear",
        "coolTicks"
      ],
      "properties": {
        "rallyWear": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "coolTicks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "act1Damping": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 2,
      "description": "Wear is multiplied by this while the act index is 1: below 1 it slows act 1, above 1 it speeds it."
    },
    "overtime": {
      "type": "object",
      "required": [
        "startTicks",
        "perMin",
        "cap"
      ],
      "description": "k x min(cap, 1 + perMin x minutes past start).",
      "properties": {
        "startTicks": {
          "type": "integer",
          "minimum": 0
        },
        "perMin": {
          "type": "number",
          "minimum": 0
        },
        "cap": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "guardWearSplit": {
      "type": "object",
      "required": [
        "arms",
        "legs"
      ],
      "description": "How the wear of a hit into a raised guard is split between the arms and the legs. Each share is 0 to 1 and the two sum to 1 (checked by tools/lib/xref-fight.js, with a small epsilon).",
      "properties": {
        "arms": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "legs": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "lastStand": {
      "type": "object",
      "required": [
        "windowS"
      ],
      "description": "The last stand (spec-wounds section 1b, point 7): one free signature at the fighter's first brink of a match.",
      "properties": {
        "windowS": {
          "type": "number",
          "minimum": 0,
          "description": "The window in seconds of his free time; 0 switches it off. The loader requires a whole number of ticks."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "block": {
      "type": "object",
      "required": [
        "streamArmShare",
        "armWearCap",
        "shotArmShare",
        "shotArmWearCap"
      ],
      "properties": {
        "streamArmShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The share of a blocked light or flurry blow's chip wear that goes to the arms; the rest is soaked (melee-press-feel.md section 9d, ruling 1)."
        },
        "armWearCap": {
          "type": "integer",
          "minimum": 0,
          "description": "No blocked blow takes the arms' wear past this, in wear units; below battered (stageAt[1]), so blocking alone never batters an arm (rule block-cap)."
        },
        "shotArmShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The share of a blocked shot's chip wear that goes to the arms (a blocked shot wears the arms by its own share and cap, apart from blocked blows)."
        },
        "shotArmWearCap": {
          "type": "integer",
          "minimum": 0,
          "description": "No blocked shot takes the arms' wear past this, in wear units; below broken (stageAt[2]; rule block-shot-cap)."
        }
      },
      "description": "Blocked blows and shots, and the arms.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
