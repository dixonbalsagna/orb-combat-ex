            "plume": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "star": {
              "type": "boolean"
            },
            "ejecta": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "skirt": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "ring": {
