    "variants": {
      "type": "object",
      "description": "Window 5: the ten gen 2 signature variants' debris, by the row's name in data/combat/sigvariants.json, one list of emitters for each of the row's fx kinds (render/vfx/biome.gd `variant`). The cross-check against sigvariants.json's rows is in effects_check.",
      "required": [
        "per_tick_cap",
        "rows"
      ],
      "properties": {
        "per_tick_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "rows": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "dust",
                "steam",
                "shards",
                "plates",
                "powder",
                "spray",
                "fire",
                "embers",
                "ash",
                "sparks"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/emitter"
              }
            }
          }
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
