      },
      "additionalProperties": false
    },
    "steam": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "grow": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "life": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "vy": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "col": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
