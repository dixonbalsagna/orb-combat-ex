{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/vfx-biome",
  "title": "vfx biome effects (version 2)",
  "description": "data/vfx/biome.json: how an impact, a landing, a skid, a crater and a knockback slide are drawn in each biome (render/vfx/biome.gd, docs/vfx/biome-fx.md), in Art's plume language (docs/art/biomes.md section 5): a column of overlapping faceted puffs, one burst star, ejecta on arcs, a skirt of low puffs. The colours, heights and widths are Art's (data/art/biomes.json, `plume`, by the fine biome's name); this file holds the composition and each plume kind's ejecta (`kinds`, by Art's plume kind). `tier_k` is the share of the effect for the causer's tier 1 to 4 (pillar 4). Presentation only: read by render/vfx/biome.gd, never by the sim. Version field: version. Policy: closed except keys starting with an underscore. Cross-checks (every plume kind of Art's data has ejecta, or is `water`) are in effects_check.",
  "type": "object",
  "required": [
    "version",
    "tier_k",
    "scale",
    "column",
    "skirt",
    "star",
    "steam",
    "ring",
    "events",
    "kinds",
    "ambient",
    "scorch",
    "variants",
    "fire"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "tier_k": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 4
      }
    },
    "scale": {
      "type": "object",
      "properties": {
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "per_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "properties": {
        "puff_h": {
          "type": "number",
          "minimum": 20,
          "maximum": 200
        },
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "taper": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "size_k": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.5
        },
        "grow": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "life": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "rise": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "drift": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        }
      },
      "additionalProperties": false
    },
    "skirt": {
      "type": "object",
      "properties": {
        "n": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "size_k": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "vx": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "vy": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "life": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "star": {
      "type": "object",
      "properties": {
        "r_k": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "r_max": {
          "type": "number",
          "minimum": 10,
          "maximum": 300
        },
        "life": {
          "type": "number",
          "minimum": 0.005,
          "maximum": 0.05
