            "ring"
          ],
          "description": "What an event draws: the column's share (0 none), whether the burst star is made, and the ejecta's, the skirt's shares.",
          "properties": {
            "plume": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "star": {
              "type": "boolean"
            },
            "ejecta": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "skirt": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "ring": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "bounce": {
          "type": "object",
          "required": [
            "plume",
