        "bounce",
        "leave",
        "slide_end",
        "skid_tick"
      ],
      "additionalProperties": false
    },
    "kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/emitter"
        }
      }
    },
    "ambient": {
      "type": "object",
      "description": "Ambient life (window 2): what floats in the air of each biome, by recipe.",
      "required": [
        "span",
        "by_biome",
        "recipes"
      ],
      "properties": {
        "span": {
          "type": "object",
          "properties": {
            "base": {
              "type": "number",
              "minimum": 100,
              "maximum": 3000
            },
            "per_sep": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "max": {
              "type": "number",
              "minimum": 300,
              "maximum": 6000
            }
          },
          "additionalProperties": false
        },
        "by_biome": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z_]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "recipes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "cap",
              "emit"
            ],
            "properties": {
              "cap": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "emit": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "rate",
                    "size",
                    "life",
                    "cols"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "snow",
                        "leaf",
                        "ash"
                      ]
                    },
                    "rate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "size": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "life": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "vx": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "vy": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "h": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    },
                    "grav": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "drag": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 0.2
                    },
                    "cols": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "type": "string",
                        "pattern": "^(#[0-9a-fA-F]{6}|lit|mid|shade|ej0|ej1)$"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "scorch": {
      "type": "object",
      "description": "Window 3: what a beam's ground scorch throws up in each plume kind's ground.",
      "required": [
        "per_tick_cap",
        "kinds"
      ],
      "properties": {
        "per_tick_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
