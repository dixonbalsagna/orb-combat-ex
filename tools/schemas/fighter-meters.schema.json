{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/fighter-meters",
  "title": "meters/1 (D1a as built, docs/architecture/d1-roster-data.md sections 5 and 7b)",
  "description": "data/fighters/<id>/meters.json: which meters a fighter has (D1a reads only that: hasAnguish, hasMenace) and the numbers that document today's rules, wired in D1b. Version field: schema. Policy: closed except keys starting with an underscore. `effects` is a closed list of effect keys that code implements, each with the fields it needs: regen_bonus and regen_penalty need perPoint (regen_penalty may add a cap, the most penalty it applies), damage_mul needs cap, composure needs below and cap, comeback needs cap, beam_power needs perPoint (docs/architecture/d1-roster-data.md section 5.1). Cross-references (the start value lies inside the range) are checked by tools/lib/xref.js.",
  "type": "object",
  "required": [
    "schema",
    "meters"
  ],
  "properties": {
    "schema": {
      "const": "meters/1"
    },
    "meters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/meter"
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  },
  "$defs": {
    "meter": {
      "type": "object",
      "required": [
        "range",
        "start",
        "visible",
        "sources",
        "decay",
        "effects"
      ],
      "properties": {
        "range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "start": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "amount",
              "whose"
            ],
            "properties": {
              "event": {
                "enum": [
                  "destroyed",
                  "destroyed_power",
                  "crater",
                  "emptied",
                  "region_broken",
                  "brink",
                  "failed_to_protect"
                ]
              },
              "amount": {
                "type": "number"
              },
              "cap": {
                "type": "number"
              },
              "whose": {
                "enum": [
                  "self",
                  "opponent",
                  "any"
                ]
              },
              "within": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minBh": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sizes": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          }
        },
        "decay": {
          "type": "object",
          "required": [
            "rate",
            "delayTicks"
          ],
          "properties": {
            "rate": {
              "type": "number",
              "minimum": 0
            },
            "delayTicks": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "enum": [
                  "regen_bonus",
                  "regen_penalty",
                  "damage_mul",
                  "composure",
                  "comeback",
                  "beam_power"
                ]
              },
              "perPoint": {
                "type": "number"
              },
              "cap": {
                "type": "number"
              },
              "below": {
                "type": "number"
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "key": {
                      "enum": [
                        "regen_bonus",
                        "regen_penalty"
                      ]
                    }
                  },
                  "required": [
                    "key"
                  ]
                },
                "then": {
                  "required": [
                    "perPoint"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "key": {
                      "const": "damage_mul"
                    }
                  },
                  "required": [
                    "key"
                  ]
                },
                "then": {
                  "required": [
                    "cap"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "key": {
                      "const": "composure"
                    }
                  },
                  "required": [
                    "key"
                  ]
                },
                "then": {
                  "required": [
                    "below",
                    "cap"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "key": {
                      "const": "comeback"
                    }
                  },
                  "required": [
                    "key"
                  ]
                },
                "then": {
                  "required": [
                    "cap"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "key": {
                      "const": "beam_power"
                    }
                  },
                  "required": [
                    "key"
                  ]
                },
                "then": {
                  "required": [
                    "perPoint"
                  ]
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  }
}
