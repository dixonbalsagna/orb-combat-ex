              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The tick. (a sound synthesised in impacts.json: beat-cue-sound)"
            },
            "gain_db": {
              "type": "number",
              "minimum": -60,
              "maximum": 24,
              "description": "Gain."
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "description": "Priority."
            },
            "bus": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*$",
              "description": "Bus. (a bus of mix.json: beat-cue-bus)"
            },
            "cls": {
              "type": "string",
              "minLength": 1,
              "description": "Class."
            },
            "cap": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap."
            },
            "caption": {
              "type": "string",
              "description": "Caption."
            }
