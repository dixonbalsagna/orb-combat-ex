{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/audio-beat-cues",
  "title": "audio beat cues (schema 1)",
  "description": "audio/data/beat_cues.json: the beat (docs/audio/brawl-beat.md): the perfect follow-up's tick, spark, notes, close, link shimmer and droop, the held X's settle, the mashed Y's grind, the Y's charge hum and full tick, the launcher's rest. Kept apart from brawl_cues.json so that file keeps its shape; audio/audio_brawl.gd merges the two. Cross-references in tools/lib/xref-beat-cues.js (beat-cue-sound, beat-cue-bus, beat-cue-order). Version field: schema. Policy: closed except keys starting with an underscore (and the `note` string beside the numbers).",
  "type": "object",
  "required": [
    "schema",
    "perfect",
    "held",
    "grind",
    "rest",
    "charge_y",
    "note"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "perfect": {
      "type": "object",
      "required": [
        "bus",
        "land",
        "own",
        "foe",
        "link",
        "gain_db",
        "priority",
        "cls",
        "cap",
        "tick",
        "broken",
        "spark_clear"
      ],
      "properties": {
        "bus": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$",
          "description": "The bus every perfect-chain sound plays on (Alert: the launcher ping's duck does not take it). (a bus of mix.json: beat-cue-bus)"
        },
        "land": {
          "type": "object",
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "type": "integer",
              "minimum": 0,
              "description": "Ticks before the follow-up's landing it is looked for."
            },
            "after": {
              "type": "integer",
              "minimum": 0,
              "description": "Ticks after the landing it is looked for."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "own": {
          "type": "object",
          "required": [
            "ratios",
            "by_strength",
            "close",
            "spark"
          ],
          "properties": {
            "ratios": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": "The pitch ratios of the chain's notes, rising (beat-cue-order)."
            },
            "by_strength": {
              "type": "object",
              "required": [
                "light",
                "medium",
                "heavy"
              ],
              "properties": {
                "light": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
                  "description": "The note for a light follow-up. (a sound synthesised in impacts.json: beat-cue-sound)"
                },
                "medium": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
                  "description": "For a medium. (a sound synthesised in impacts.json: beat-cue-sound)"
                },
                "heavy": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
                  "description": "For a heavy. (a sound synthesised in impacts.json: beat-cue-sound)"
                }
              },
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            },
            "close": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The closing note. (a sound synthesised in impacts.json: beat-cue-sound)"
            },
            "spark": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The spark at the tap. (a sound synthesised in impacts.json: beat-cue-sound)"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "foe": {
          "type": "object",
          "required": [
            "ratios",
            "note",
            "close",
            "spark"
          ],
          "properties": {
            "ratios": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": "The opponent's ratios, rising (beat-cue-order)."
            },
            "note": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The opponent's note (a sound name: this key is the note, not a comment). (a sound synthesised in impacts.json: beat-cue-sound)"
            },
            "close": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The opponent's closing note. (a sound synthesised in impacts.json: beat-cue-sound)"
            },
            "spark": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The spark. (a sound synthesised in impacts.json: beat-cue-sound)"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "link": {
          "type": "object",
          "required": [
            "sound",
            "gain_db"
          ],
          "properties": {
            "sound": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The link's shimmer. (a sound synthesised in impacts.json: beat-cue-sound)"
            },
            "gain_db": {
              "type": "number",
              "minimum": -60,
              "maximum": 24,
              "description": "Gain, dB."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "gain_db": {
          "type": "object",
          "required": [
            "spark",
            "note",
            "close"
          ],
          "properties": {
            "spark": {
              "type": "number",
              "minimum": -60,
              "maximum": 24,
              "description": "Gain."
            },
            "note": {
              "type": "number",
              "minimum": -60,
              "maximum": 24,
              "description": "Gain."
            },
            "close": {
              "type": "number",
              "minimum": -60,
              "maximum": 24,
              "description": "Gain."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "priority": {
          "type": "object",
          "required": [
            "spark",
            "note",
            "close",
            "tick",
            "break"
          ],
          "properties": {
            "spark": {
              "type": "integer",
              "minimum": 0,
              "description": "Priority."
            },
            "note": {
              "type": "integer",
              "minimum": 0,
              "description": "Priority."
            },
            "close": {
              "type": "integer",
              "minimum": 0,
              "description": "Priority."
            },
            "tick": {
              "type": "integer",
              "minimum": 0,
              "description": "Priority."
            },
            "break": {
              "type": "integer",
              "minimum": 0,
              "description": "Priority."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "cls": {
          "type": "object",
          "required": [
            "spark",
            "note",
            "close",
            "link",
            "tick",
            "break"
          ],
          "properties": {
            "spark": {
              "type": "string",
              "minLength": 1,
              "description": "Class."
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "Class."
            },
            "close": {
              "type": "string",
              "minLength": 1,
              "description": "Class."
            },
            "link": {
              "type": "string",
              "minLength": 1,
              "description": "Class."
            },
            "tick": {
              "type": "string",
              "minLength": 1,
              "description": "Class."
            },
            "break": {
              "type": "string",
              "minLength": 1,
              "description": "Class."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "cap": {
          "type": "object",
          "required": [
            "spark",
            "note",
            "close",
            "link",
            "tick",
            "break"
          ],
          "properties": {
            "spark": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap."
            },
            "note": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap."
            },
            "close": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap."
            },
            "link": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap."
            },
            "tick": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap."
            },
            "break": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "tick": {
          "type": "object",
          "required": [
            "sound",
            "gain_db",
            "caption"
          ],
          "properties": {
            "sound": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The tick. (a sound synthesised in impacts.json: beat-cue-sound)"
            },
            "gain_db": {
              "type": "number",
              "minimum": -60,
              "maximum": 24,
              "description": "Gain."
            },
            "caption": {
              "type": "string",
              "description": "The caption (\"\" for none)."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "broken": {
          "type": "object",
          "required": [
            "sound",
            "gain_db",
            "texts"
          ],
          "properties": {
            "sound": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The droop. (a sound synthesised in impacts.json: beat-cue-sound)"
            },
            "gain_db": {
              "type": "number",
              "minimum": -60,
              "maximum": 24,
              "description": "Gain."
            },
            "texts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "The cue texts that break the chain."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "spark_clear": {
          "type": "object",
          "required": [
            "ticks",
            "look_ahead",
            "max_wait"
          ],
          "properties": {
            "ticks": {
              "type": "integer",
              "minimum": 0,
              "description": "Ticks the spark waits clear."
            },
            "look_ahead": {
              "type": "integer",
              "minimum": 0,
              "description": "How far ahead it looks."
            },
            "max_wait": {
              "type": "integer",
              "minimum": 0,
              "description": "The longest it waits (at least ticks: beat-cue-order)."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "note": {
          "type": "string",
          "description": "A note for the next person (Audio keeps one beside its numbers)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "held": {
      "type": "object",
      "required": [
        "after_gap_ticks",
        "complete_blows",
        "lite_gap_max",
        "pitch_from_gap",
        "pitch_st_per_tick",
        "pitch_min_st",
        "gain_db"
      ],
      "properties": {
        "after_gap_ticks": {
          "type": "integer",
          "minimum": 0,
          "description": "Ticks."
        },
        "complete_blows": {
          "type": "integer",
          "minimum": 1,
          "description": "Blows."
        },
        "lite_gap_max": {
          "type": "integer",
          "minimum": 0,
          "description": "Ticks."
        },
        "pitch_from_gap": {
          "type": "integer",
          "minimum": 0,
          "description": "Ticks."
        },
        "pitch_st_per_tick": {
          "type": "number",
          "description": "Semitones a tick."
        },
        "pitch_min_st": {
          "type": "number",
          "description": "Semitones."
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 24,
          "description": "Gain."
        },
        "note": {
          "type": "string",
          "description": "A note for the next person (Audio keeps one beside its numbers)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "grind": {
      "type": "object",
      "required": [
        "sound",
        "window_ticks",
        "after",
        "step_db",
        "drop_st_per_blow",
        "max_drop_st"
      ],
      "properties": {
        "sound": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
          "description": "The grind. (a sound synthesised in impacts.json: beat-cue-sound)"
        },
        "window_ticks": {
          "type": "integer",
          "minimum": 1,
          "description": "Ticks."
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "description": "Medium blows before it starts."
        },
        "step_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 24,
          "description": "Step, dB."
        },
        "drop_st_per_blow": {
          "type": "number",
          "minimum": 0,
          "description": "Semitones."
        },
        "max_drop_st": {
          "type": "number",
          "minimum": 0,
          "description": "Most semitones."
        },
        "note": {
          "type": "string",
          "description": "A note for the next person (Audio keeps one beside its numbers)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "rest": {
      "type": "object",
      "required": [
        "sound",
        "gain_db",
        "priority",
        "cls",
        "cap",
        "caption"
      ],
      "properties": {
        "sound": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
          "description": "The launcher's rest. (a sound synthesised in impacts.json: beat-cue-sound)"
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 24,
          "description": "Gain."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "description": "Priority."
        },
        "cls": {
          "type": "string",
          "minLength": 1,
          "description": "Class."
        },
        "cap": {
          "type": "integer",
          "minimum": 1,
          "description": "Cap."
        },
        "caption": {
          "type": "string",
          "description": "Caption."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "charge_y": {
      "type": "object",
      "required": [
        "hum",
        "full"
      ],
      "properties": {
        "hum": {
          "type": "object",
          "required": [
            "sound",
            "gain_db",
            "priority",
            "cls",
            "cap",
