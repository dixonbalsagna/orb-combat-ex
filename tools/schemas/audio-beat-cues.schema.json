          ],
          "properties": {
            "sound": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
              "description": "The hum. (a sound synthesised in impacts.json: beat-cue-sound)"
            },
            "gain_db": {
              "type": "number",
              "minimum": -60,
              "maximum": 24,
              "description": "Gain."
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "description": "Priority."
            },
            "cls": {
              "type": "string",
              "minLength": 1,
              "description": "Class."
            },
            "cap": {
              "type": "integer",
              "minimum": 1,
              "description": "Cap."
            },
            "stop_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Fade, ms."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
