{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-wave-entrymap",
  "title": "anim.wave.entrymap/1 (no schema field)",
  "description": "data/anim/waves/<wave>.entrymap.json: the review map of a parked wave's entries (generated by render/anim/tools/wave_gen.mjs): one row per entry, with when the sim picks it, the ticks, what the sim needs and the Legal constraints. Policy: closed except keys starting with an underscore. Cross-references (every row is an entry of the wave's entries file and agrees with it on direction, ground, path, poses and phase names; every pose is in the wave's poses file) are checked by tools/lib/xref-fight.js (wave-entry, wave-pose).",
  "type": "object",
  "required": [
    "wave",
    "kind",
    "entries",
    "skipped"
  ],
  "properties": {
    "wave": {
      "type": "string",
      "pattern": "^(wave|protag|rival|guard)[0-9]+$"
    },
    "kind": {
      "const": "entries"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "combat",
          "name",
          "direction",
          "ground",
          "path",
          "when",
          "ticks",
          "favours",
          "sim",
          "legal",
          "look",
          "lab",
          "alt",
          "poses",
          "phases",
          "newPoses",
          "derive"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
          },
          "combat": {
            "type": "string",
            "pattern": "^entry\\.[a-z0-9_]+$",
            "description": "The Combat entry id it realises."
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_~]*$"
          },
          "direction": {
            "enum": [
              "rush",
              "stand",
              "retreat"
            ]
          },
          "ground": {
            "enum": [
              "ok",
              "no",
              "only",
              "plant"
            ]
          },
          "path": {
            "enum": [
              "straight",
              "arc",
              "ground",
              "spiral",
              "step",
              "none",
              "back"
            ]
          },
          "when": {
            "description": "In words: when the sim picks this entry.",
            "type": "string",
            "minLength": 1
          },
          "ticks": {
            "type": "object",
            "required": [
              "travel",
              "start",
              "arrive"
            ],
            "properties": {
              "travel": {
                "anyOf": [
                  {
                    "const": "c"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ],
                "description": "c: the whole approach; or a fixed tick count."
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "arrive": {
                "type": "integer",
                "minimum": 0
              },
              "counterStep": {
                "type": "integer",
                "minimum": 0
              },
              "holdOutOfReach": {
                "type": "integer",
                "minimum": 0
              },
              "recoverIfNobodyComes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          },
          "favours": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          },
          "sim": {
            "description": "What the sim needs to play it (today, a path on the rush, fight lanes ...).",
            "type": "string",
            "minLength": 1
          },
          "legal": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          },
          "look": {
            "type": "string",
            "minLength": 1
          },
          "lab": {
            "type": "object",
            "required": [
              "d0",
              "shape"
            ],
            "properties": {
              "d0": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shape": {
                "enum": [
                  "straight",
                  "arc",
                  "rising",
                  "ground",
                  "spiral",
                  "none",
                  "back",
                  "hop"
                ]
              },
              "apex": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "advance": {
                "type": "number",
                "minimum": 0
              }
            },
            "description": "The lab hints: the start distance (u), the path shape the lab draws, and an apex or an advance where the shape has one.",
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          },
          "alt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "poses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            }
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "The phase names, in order (the last part of each pose id)."
          },
          "newPoses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "New poses this entry needs, in words."
          },
          "derive": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Live poses it derives from."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
