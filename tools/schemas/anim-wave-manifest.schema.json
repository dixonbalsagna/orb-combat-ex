{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-wave-manifest",
  "title": "anim.wave.manifest/1 (no schema field)",
  "description": "data/anim/waves/<wave>.manifest.json: the review manifest of a parked strike wave (generated by render/anim/tools/wave_gen.mjs). One row per strike: its key set, the Combat strike it realises, reach and ticks, and the Legal constraints it satisfies. Render only. Policy: closed except keys starting with an underscore. Cross-references (every strike id is a key set of the wave's keysets file and every pose is in its poses file; limb, limb2 and target match the key set; offset is at most reach; ids are unique) are checked by tools/lib/xref-fight.js (wave-*).",
  "type": "object",
  "required": [
    "wave",
    "strikes",
    "skipped"
  ],
  "properties": {
    "wave": {
      "type": "string",
      "pattern": "^(wave|protag|rival)[0-9]+$"
    },
    "strikes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "combat",
          "name",
          "weight",
          "target",
          "limb",
          "limb2",
          "offset",
          "reach",
          "band",
          "ticks",
          "ground",
          "uses",
          "from",
          "legal",
          "look",
          "orig",
          "poses",
          "alt",
          "tip",
          "path",
          "flags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
          },
          "combat": {
            "type": "string",
            "pattern": "^strike\\.[a-z0-9_]+$",
            "description": "The Combat strike id it realises."
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_~]*$"
          },
          "weight": {
            "enum": [
              "light",
              "heavy",
              "any"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          },
          "limb": {
            "enum": [
              "hand_r",
              "hand_l",
              "foot_r",
              "foot_l",
              "elbow_r",
              "elbow_l",
              "knee_r",
              "knee_l",
              "shoulder_r",
              "shoulder_l",
              "head"
            ]
          },
          "limb2": {
            "anyOf": [
              {
                "enum": [
                  "hand_r",
                  "hand_l",
                  "foot_r",
                  "foot_l",
                  "elbow_r",
                  "elbow_l",
                  "knee_r",
                  "knee_l",
                  "shoulder_r",
                  "shoulder_l",
                  "head"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "offset": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Where the approach ends, centre to centre (u)."
          },
          "reach": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "How far the blow reaches, centre to centre (u); at least offset."
          },
          "band": {
            "enum": [
              "long",
              "mid",
              "close"
            ]
          },
          "ticks": {
            "type": "object",
            "required": [
              "load",
              "follow",
              "recover"
            ],
            "properties": {
              "load": {
                "type": "integer",
                "minimum": 1
              },
              "follow": {
                "type": "integer",
                "minimum": 1
              },
              "recover": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          },
          "ground": {
            "enum": [
              "ok",
              "plant",
              "only",
              "no"
            ],
            "description": "Whether the strike needs the ground (ok: either; plant: feet planted; only: ground only; no: never on the ground)."
          },
          "uses": {
            "type": "object",
            "required": [],
            "properties": {
              "arms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "legs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "head": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ],
            "description": "The key set of keysets.json it derives from, or null."
          },
          "legal": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          },
          "look": {
            "type": "string",
            "minLength": 1
          },
          "orig": {
            "type": "string",
            "minLength": 1
          },
          "poses": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "description": "Load, contact, follow."
          },
          "flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "leap",
                "spin",
                "multi_turn",
                "travelling",
                "clasped",
                "wrists_together",
                "two_hand_chamber",
                "cupped_at_hip",
                "hip_chamber",
                "drawn_to_hip_then_thrust",
                "held_raise_overhead",
                "passes_through"
              ]
            },
            "description": "The pose flags this key set shows, read off its three key poses (render/anim/tools/waves/flags.mjs; docs/combat/pending/movegen/README.md section 3): the twelve flags Legal's banned shapes name. An empty list means none of them is shown. travelling and passes_through are never set from the poses (a motion and the contact solve's)."
          },
          "tip": {
            "enum": [
              "fist",
              "blade",
              "palm",
              "heel",
              "plate",
              "ball",
              "instep",
              "edge",
              "sole",
              "point",
              "cap",
              "brow"
            ],
            "description": "The striking surface as posed (docs/animation/moveset-parts.md): hand fist, blade, palm, heel (the back or bottom of the fist), plate (the forearm leads); foot ball, heel, instep, edge, sole; elbow point; knee cap; shoulder plate; head brow."
          },
          "path": {
            "enum": [
              "line",
              "arc_in",
              "arc_out",
              "rise",
              "drop",
              "spin"
            ],
            "description": "The angle the limb travels: line, arc_in (toward the centre line), arc_out (away from it), rise, drop, spin (one turn)."
          },
          "alt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "What the second take (a `~b` variant) does differently, or null."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Strikes left out, with the reason (\"tail_jab (held)\")."
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
