{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/ui-hints",
  "title": "ui control hints (schema 1)",
  "description": "ui/data/hints.json: the on-screen control hints shown during play and the YOU labels (docs/ui/hud-spec.md section 22). A scheme is a list of rows (an action or a group of actions, and a short word); the HUD shows the scheme its control_scheme option names and falls back to `today`, so `today` is required. Each new control layout (ADR 0008) is one more scheme with no code change. Version field: schema. Policy: closed except keys starting with an underscore. Cross-references (every action named exists in glyphs.json actions; each control_scheme option choice is a scheme) are checked by tools/lib/xref-fight.js.",
  "type": "object",
  "required": [
    "schema",
    "you",
    "intro_seconds",
    "schemes"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "note": {
      "type": "string"
    },
    "you": {
      "type": "object",
      "required": [
        "single",
        "pair"
      ],
      "properties": {
        "single": {
          "type": "string",
          "minLength": 1
        },
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "intro_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "schemes": {
      "type": "object",
      "required": [
        "today"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "rows"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "label"
              ],
              "properties": {
                "action": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "actions": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "label_toggle": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The word for a player whose style for this action is toggle (Settings: Guard, Manoeuvre stance and Charging stance, hold or toggle)."
                },
                "only_when_avail": {
                  "type": "boolean"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "action"
                  ]
                },
                {
                  "required": [
                    "actions"
                  ]
                }
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
