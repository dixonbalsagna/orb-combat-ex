        },
        "same": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\{action\\}"
            },
            {
              "pattern": "\\{control\\}"
            }
          ]
        },
        "cancelled": {
          "type": "string",
          "minLength": 1
        },
        "reset_done": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\{layout\\}"
            }
          ]
        },
        "swap": {
          "type": "string",
          "minLength": 1
        },
        "cancel": {
          "type": "string",
          "minLength": 1
        },
        "move_steps": {
          "type": "object",
          "required": [
            "up",
            "left",
            "down",
            "right"
          ],
          "properties": {
            "up": {
              "type": "string",
              "minLength": 1
            },
            "left": {
              "type": "string",
              "minLength": 1
            },
            "down": {
              "type": "string",
              "minLength": 1
            },
            "right": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "layouts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "helps": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "helps_toggle": {
          "type": "object",
          "description": "The help of an action for a player whose style for it is toggle (Settings: hold or toggle), where it differs from `helps`.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "controls": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "chord": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\{control\\}"
            },
            {
              "pattern": "\\{other\\}"
            }
          ]
        },
        "taken": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\{control\\}"
            },
            {
              "pattern": "\\{other\\}"
            }
          ]
        },
        "twice": {
          "type": "string",
          "minLength": 1
        },
        "shared": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^{}]+$",
          "description": "A plain sentence (no {tokens}) about the two players sharing a keyboard layout."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
