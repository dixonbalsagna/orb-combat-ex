{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/fight-mood",
  "title": "fight.mood/1 (M1 final shape, docs/architecture/mood-style.md)",
  "description": "data/fight/mood.json: the fight-mood component's numbers (impulses, casualty input, decay and guard rates, act floors, bands, aggression and crowd outputs). Every number is an integer: the component is integer-exact (units, ticks), so there is no float parity to care about. The mood in points is raw / unitPerPoint, over range / unitPerPoint points. Version field: schema. Policy: closed except keys starting with an underscore. Cross-references (bands and act floors ordered, one act floor per act, band thresholds inside the range) are checked by tools/lib/xref-fight.js.",
  "type": "object",
  "required": [
    "schema",
    "unitPerPoint",
    "range",
    "impulses",
    "aggressiveMul",
    "casualty",
    "rates",
    "actFloors",
    "bands",
    "act",
    "aggression",
    "crowd",
    "actBeats"
  ],
  "properties": {
    "schema": {
      "const": "fight.mood/1"
    },
    "unitPerPoint": {
      "type": "integer",
      "minimum": 1
    },
    "range": {
      "type": "integer",
      "minimum": 1
    },
    "impulses": {
      "type": "object",
      "required": [
        "strike",
        "heavyStrike",
        "chainLink",
        "parry",
        "clash",
        "beamLands",
        "regionBroken",
        "buildingLaunch",
        "buildingChain",
        "form",
        "finisherStart",
        "taunt",
        "landmarkFall",
        "brawlLight",
        "brawlMedium",
        "blocked",
        "skillStrike",
        "brawlHeavy",
        "flurryClose",
        "guardBreak",
        "knockback"
      ],
      "properties": {
        "strike": {
          "type": "integer",
          "minimum": 0
        },
        "heavyStrike": {
          "type": "integer",
          "minimum": 0
        },
        "chainLink": {
          "type": "integer",
          "minimum": 0
        },
        "parry": {
          "type": "integer",
          "minimum": 0
        },
        "clash": {
          "type": "integer",
          "minimum": 0
        },
        "beamLands": {
          "type": "integer",
          "minimum": 0
        },
        "regionBroken": {
          "type": "integer",
          "minimum": 0
        },
        "buildingLaunch": {
          "type": "integer",
          "minimum": 0
        },
        "buildingChain": {
          "type": "integer",
          "minimum": 0
        },
        "form": {
          "type": "integer",
          "minimum": 0
        },
        "finisherStart": {
          "type": "integer",
          "minimum": 0
        },
        "taunt": {
          "type": "integer",
          "minimum": 0
        },
        "landmarkFall": {
          "type": "integer",
          "minimum": 0,
          "description": "The mood impulse for a landmark falling (600 units is +10 points); dormant until D1."
        },
        "brawlLight": {
          "type": "integer",
          "minimum": 0
        },
        "brawlMedium": {
          "type": "integer",
          "minimum": 0,
          "description": "The mood a landed medium blow of a brawl feeds (brawlLight is the light one, brawlHeavy the heavy one)."
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "skillStrike": {
          "type": "integer",
          "minimum": 0
        },
        "brawlHeavy": {
          "type": "integer",
          "minimum": 0
        },
        "flurryClose": {
          "type": "integer",
          "minimum": 0
        },
        "guardBreak": {
          "type": "integer",
          "minimum": 0
        },
        "knockback": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "aggressiveMul": {
      "type": "object",
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "casualty": {
      "type": "object",
      "required": [
        "perPerson",
        "capPerTick",
        "popRef"
      ],
      "properties": {
        "perPerson": {
          "type": "integer",
          "minimum": 0
        },
        "capPerTick": {
          "type": "integer",
          "minimum": 0
        },
        "popRef": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "rates": {
      "type": "object",
      "required": [
        "bothAggressive",
        "decay",
        "bothGuarded",
        "proportional"
      ],
      "properties": {
        "bothAggressive": {
          "type": "integer",
          "minimum": 0
        },
        "decay": {
          "type": "integer",
          "minimum": 0
        },
        "bothGuarded": {
          "type": "integer",
          "minimum": 0
        },
        "proportional": {
          "type": "object",
          "required": [
            "on",
            "base",
            "perMille"
          ],
          "description": "A rate that grows with the mood (M1b): on switches it, base and perMille are integers of at least 0.",
          "properties": {
            "on": {
              "type": "boolean"
            },
            "base": {
              "type": "integer",
              "minimum": 0
            },
            "perMille": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "actFloors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "The mood floor of each act, one entry per act (act.max); strictly increasing."
    },
    "bands": {
      "type": "object",
      "required": [
        "tense",
        "frenzied",
        "dwellTicks"
      ],
      "properties": {
        "tense": {
          "type": "integer",
          "minimum": 1
        },
        "frenzied": {
          "type": "integer",
          "minimum": 1
        },
        "dwellTicks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "act": {
      "type": "object",
      "required": [
        "max"
      ],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "aggression": {
      "type": "object",
      "required": [
        "base",
        "perAct",
        "bandBonus",
        "max"
      ],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "perAct": {
          "type": "integer",
          "minimum": 0
        },
        "bandBonus": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "crowd": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "enum": [
          "excited",
          "nervous",
          "fleeing"
        ]
      },
      "uniqueItems": true
    },
    "actBeats": {
      "type": "object",
      "required": [
        "every",
        "oncePerMatch",
        "formSteps"
      ],
      "description": "Which events raise the act: every occurrence, or once per match; formSteps switches the form track on (Q10).",
      "properties": {
        "every": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "regionBreak",
              "form"
            ]
          }
        },
        "oncePerMatch": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "limbBattered",
              "coreBruised",
              "coreBattered"
            ]
          }
        },
        "formSteps": {
          "type": "boolean",
          "description": "Q10: when true the act is 1 + the larger of (form steps, wound beats) + the every beats; when false it is 1 + every beat."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
