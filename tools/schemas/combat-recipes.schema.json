{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/combat-recipes",
  "title": "combat.recipes/1",
  "description": "data/combat/recipes.json: the alchemist recipes (docs/combat/alchemist-recipes.md section 5; docs/director/alchemy-plan.md): the three styles (blur, combo, power) with the read that picks the base or timed version and the pools they draw from, the flow and direction rules, the blur patterns, the last-press endings, and per fighter the pools of pieces with their status. The director's own numbers are not here (Encounter's data/director/alchemy.json). Version field: schema. Policy: closed except keys starting with an underscore. Cross-references (the styles' heaviesInFive cover 0 to 5 with no overlap; every pool a style names exists for every fighter; every pool id is a strike of a wave manifest unless it is waiting, and no waiting id is in one; a blur step can be filled by a piece of the fighter's blur pools) are checked by tools/lib/xref-fight.js (recipes-*).",
  "type": "object",
  "required": [
    "schema",
    "styles",
    "flow",
    "direction",
    "blurPatterns",
    "patternRule",
    "lastPress",
    "pools",
    "pieces"
  ],
  "properties": {
    "schema": {
      "const": "combat.recipes/1"
    },
    "styles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "heaviesInFive",
          "base",
          "timed"
        ],
        "properties": {
          "id": {
            "enum": [
              "blur",
              "combo",
              "power"
            ]
          },
          "heaviesInFive": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "description": "The least and most heavies in a string of five this style takes."
          },
          "base": {
            "type": "object",
            "required": [
              "read"
            ],
            "description": "The base version: the read that picks it and the pools it draws from.",
            "properties": {
              "read": {
                "type": "string",
                "minLength": 1
              },
              "pool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "towardPool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "linkPool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accentPool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lastPool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ender": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          },
          "timed": {
            "type": "object",
            "required": [
              "read"
            ],
            "description": "The timed version.",
            "properties": {
              "read": {
                "type": "string",
                "minLength": 1
              },
              "plays": {
                "type": "string",
                "minLength": 1
              },
              "endsIn": {
                "type": "string",
                "minLength": 1
              },
              "pool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "towardPool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "linkPool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accentPool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lastPool": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ender": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      }
    },
    "flow": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "patternProperties": {
        "^_": true
      }
    },
    "direction": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "patternProperties": {
        "^_": true
      }
    },
    "blurPatterns": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "enum": [
                "hand",
                "foot",
                "elbow",
                "knee",
                "shoulder",
                "head",
                "own"
              ]
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z_]*$"
            }
          ],
          "items": false,
          "description": "[limb, target]: the limb (hand, foot, elbow, knee, shoulder, head or own) and a socket of data/anim/sockets.json."
        },
        "description": "Five steps."
      },
      "patternProperties": {
        "^_": true
      }
    },
    "patternGates": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "description": "Optional. When a blur pattern may be drawn, read at the string's first blow; a pattern with no row is always open. stick: the stick toward; ground: both fighters on the ground; fighters: only these fighters' strings draw it.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "stick": {
            "const": "toward",
            "description": "Open only with the stick toward at that press."
          },
          "ground": {
            "const": true,
            "description": "Open only with both fighters on the ground."
          },
          "fighters": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "Keys of pools whose strings draw it."
          }
        },
        "anyOf": [
          {
            "required": [
              "stick"
            ]
          },
          {
            "required": [
              "ground"
            ]
          },
          {
            "required": [
              "fighters"
            ]
          }
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      },
      "patternProperties": {
        "^_": true
      }
    },
    "patternRule": {
      "type": "string",
      "minLength": 1
    },
    "beat": {
      "type": "object",
      "description": "Optional. The beat point of a light or a skill strike: ticks after its contact at which the next press is on the beat, by the piece's path (20 to 28); `default` serves a piece with no path.",
      "properties": {
        "default": {
          "type": "integer",
          "minimum": 20,
          "maximum": 28
        },
        "line": {
          "type": "integer",
          "minimum": 20,
          "maximum": 28
        },
        "arc_in": {
          "type": "integer",
          "minimum": 20,
          "maximum": 28
        },
        "arc_out": {
          "type": "integer",
          "minimum": 20,
          "maximum": 28
        },
        "rise": {
          "type": "integer",
          "minimum": 20,
          "maximum": 28
        },
        "drop": {
          "type": "integer",
          "minimum": 20,
          "maximum": 28
        },
        "spin": {
          "type": "integer",
          "minimum": 20,
          "maximum": 28
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "brawl": {
      "type": "object",
      "description": "Optional. Which pool each kind of press in the martial arts stance draws on (a pool name every fighter has).",
      "properties": {
        "light": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "lightToward": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "flurry": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "juggle": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "medium": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "mediumHeld": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "reversal": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "heavy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "heavyHeld": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "launcher": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "bolt": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "blast": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "burstFast": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "burstMid": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "burstSlow": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "burstFloor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "lift": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "burst": {
      "type": "object",
      "required": [
        "slots",
        "pools",
        "rules",
        "close",
        "samples"
      ],
      "properties": {
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "open",
              "fast",
              "mid",
              "slow"
            ]
          },
          "description": "The class of each blow of a burst, in order: open (the light the press threw), then fast, mid or slow by the gap before it."
        },
        "pools": {
          "type": "object",
          "required": [
            "fast",
            "mid",
            "slow"
          ],
          "properties": {
            "fast": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
            },
            "mid": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
            },
            "slow": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
            }
          },
          "description": "The pool each class of gap draws on (a pool every fighter has).",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "description": "What keeps a short gap from reading as a stutter: judged on the pieces table.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "rule"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "same": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "limb",
                    "path",
                    "target",
                    "tip"
                  ]
                },
                "description": "The parts a run must not share more than `max` times."
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "description": "At most this many in a row sharing the parts."
              },
              "once": {
                "type": "boolean",
                "description": "No piece twice in one burst."
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          }
        },
        "close": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "line",
                "arc_in",
                "arc_out",
                "rise",
                "drop",
                "spin"
              ]
            }
          },
          "patternProperties": {
            "^_": true
          },
          "description": "A fighter to the paths his last blow may take."
        },
        "samples": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "toward",
                "away",
                "none",
                "down",
                "up"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^strike\\.[a-z0-9_]+$"
              }
            },
            "description": "A lean of the stick to one whole burst (a piece for each slot)."
          },
          "patternProperties": {
            "^_": true
          },
          "description": "A fighter to one whole burst for each lean of the stick."
        }
      },
      "description": "A held X (docs/design/brawl-second-pass.md section 3): lights that slow on a curve.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "fallback": {
      "type": "object",
      "required": [
        "steps",
        "lower"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "step",
              "what"
            ],
            "properties": {
              "step": {
                "enum": [
                  "pool",
                  "repeat",
                  "lower"
                ]
              },
              "what": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          },
          "description": "The steps, tried in order."
        },
        "lower": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "light",
              "lightToward",
              "flurry",
              "skill",
              "juggle",
              "medium",
              "mediumHeld",
              "reversal",
              "heavy",
              "heavyHeld",
              "launcher",
              "bolt",
              "blast",
              "burstFast",
              "burstMid",
              "burstSlow",
              "burstFloor",
              "lift"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
          },
          "description": "A brawl kind to the pool one strength down, for the step `lower`."
        },
        "onTheTier": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "heavies",
              "heavy",
              "mashedB",
              "launcher",
              "bySend"
            ],
            "properties": {
              "heavies": {
                "type": "integer",
                "minimum": 0,
                "description": "How many heavies the tier has."
              },
              "heavy": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "pool",
                    "repeat",
                    "lower"
                  ]
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "How many times each step is reached."
              },
              "mashedB": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "pool",
                    "repeat",
                    "lower"
                  ]
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "How many times each step is reached."
              },
              "launcher": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "pool",
                    "repeat",
                    "lower"
                  ]
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "How many times each step is reached."
              },
              "bySend": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "enum": [
                    "across",
                    "up",
                    "down",
                    "turned"
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "pool",
                      "repeat",
                      "lower"
                    ]
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "description": "How many times each step is reached."
                },
                "description": "A send to how often each step is reached when the stick asks for it."
              }
            },
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          },
          "patternProperties": {
            "^_": true
          },
          "description": "How often each step is reached with B on the heavy tier's posed pieces, by fighter (the count is made on the pieces table): heavy (a tapped or mashed B), mashedB (two heavies running), launcher and bySend."
        }
      },
      "description": "What a press throws when its pool has nothing it may throw. No press is silent.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "launcher": {
      "type": "object",
      "required": [
        "aim",
        "noStick",
        "bySend",
        "bySendLower"
      ],
      "properties": {
        "aim": {
          "type": "object",
          "required": [
            "up",
            "down",
            "toward",
            "away"
          ],
          "properties": {
            "up": {
              "enum": [
                "across",
                "up",
                "down",
                "turned"
              ]
            },
            "down": {
              "enum": [
                "across",
                "up",
                "down",
                "turned"
              ]
            },
            "toward": {
              "enum": [
                "across",
                "up",
                "down",
                "turned"
              ]
            },
            "away": {
              "enum": [
                "across",
                "up",
                "down",
                "turned"
              ]
            }
          },
          "description": "The stick's quarter to the send wanted.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "noStick": {
          "enum": [
            "planner"
          ],
          "description": "With no stick the launch planner's pick decides the send."
        },
        "bySend": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "across",
                "up",
                "down",
                "turned"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^strike\\.[a-z0-9_]+$"
              }
            },
            "description": "A send to the strikes that send that way."
          },
          "patternProperties": {
            "^_": true
          },
          "description": "A fighter to his tier's launcher pieces by where each sends (each in his brawl.launcher pool and with that send in its row's sends)."
        },
        "bySendLower": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
