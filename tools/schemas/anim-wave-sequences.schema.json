{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-wave-sequences",
  "title": "anim.wave.sequences/1",
  "description": "data/anim/waves/<wave>.sequences.json: sequences of poses for Encounter's step 3 cue events (generated by render/anim/tools/wave_gen.mjs; played only with --step3-cues). A sequence is phases of poses over `dur` ticks. Names may carry a variant (`s3.burst~b`). Render only, outside the sim's data hash. Version field: schema. Policy: closed except keys starting with an underscore. Cross-references (every phase pose is in the wave's poses file; the phases' fixed ticks fit in dur) are checked by tools/lib/xref-fight.js (wave-pose, wave-seq-dur).",
  "type": "object",
  "required": [
    "schema",
    "sequences"
  ],
  "properties": {
    "schema": {
      "const": "anim.wave.sequences/1"
    },
    "sequences": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*([.][a-z0-9_~]+)*)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "dur",
          "phases",
          "name"
        ],
        "properties": {
          "dur": {
            "description": "Ticks the whole sequence lasts.",
            "type": "integer",
            "minimum": 1
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "pose"
              ],
              "description": "One phase: a pose, held for `ticks` ticks, or sharing the rest by weight `w`, or (neither) taking what is left.",
              "properties": {
                "pose": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
                },
                "ticks": {
                  "type": "integer",
                  "minimum": 1
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "not": {
                "required": [
                  "ticks",
                  "w"
                ]
              },
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "alt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "_wave": {
            "type": "string",
            "pattern": "^[a-z]+[0-9]+$"
          },
          "_variant": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "_alt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      },
      "patternProperties": {
        "^_": true
      },
      "description": " May be empty: a wave of poses only (cl1, the clinch's grip layer, has none)."
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
