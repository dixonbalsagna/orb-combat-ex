{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/fighters-forms",
  "title": "fighters-forms (schema \"fighter.forms/1\")",
  "description": "data/fighters/PROTAGONIST/forms.json: a fighter's own steps, gains, coil, patience and release (docs/design/hero-forms.md). A shape check inferred from the file (docs/tools/pending/infer-schema.cjs): every key present is required, a key outside is refused unless it starts with an underscore, a number is bounded only below by zero where all its values are, a colour is a hex string; the owner tightens the values. Version field: schema. Policy: closed except keys starting with an underscore.",
  "type": "object",
  "required": [
    "schema",
    "steps",
    "gains",
    "coil",
    "patience",
    "release"
  ],
  "properties": {
    "schema": {
      "const": "fighter.forms/1"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "power",
          "tier",
          "kind",
          "id"
        ],
        "properties": {
          "power": {
            "type": "number",
            "minimum": 0
          },
          "tier": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "branch": {
            "type": "boolean",
            "description": "true at a step that picks a branch (II and IV: hero-forms.md section 4)"
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      }
    },
    "gains": {
      "type": "object",
      "required": [
        "speed",
        "damage",
        "launch",
        "chip",
        "regen",
        "recover"
      ],
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0
        },
        "damage": {
          "type": "number",
          "minimum": 0
        },
        "launch": {
          "type": "number",
          "minimum": 0
        },
        "chip": {
          "type": "number",
          "minimum": 0
        },
        "regen": {
          "type": "number",
          "minimum": 0
        },
        "recover": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "coil": {
      "type": "object",
      "required": [
        "perSec",
        "perDamage",
        "behindMul",
        "max"
      ],
      "properties": {
        "perSec": {
          "type": "number",
          "minimum": 0
        },
        "perDamage": {
          "type": "number",
          "minimum": 0
        },
        "behindMul": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "patience": {
      "type": "object",
      "required": [
        "perTier",
        "max"
      ],
      "properties": {
        "perTier": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "release": {
      "type": "object",
      "required": [
        "minCoil",
        "perPoint",
        "maxMul"
      ],
      "properties": {
        "minCoil": {
          "type": "number",
          "minimum": 0,
          "description": "the coil a release needs to make its form stronger"
        },
        "perPoint": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1,
          "description": "the form's step gains x (1 + coil x perPoint)"
        },
        "maxMul": {
          "type": "number",
          "minimum": 1,
          "maximum": 4,
          "description": "... at most this, for as long as he is in that form"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "branches": {
      "type": "object",
      "description": "the two branches (hero-forms.md section 3): Witness's and Trial's fills and each branch's extras; firstTie the pick's first tie",
      "required": [
        "witness",
        "trial",
        "firstTie"
      ],
      "properties": {
        "witness": {
          "type": "object",
          "required": [
            "range",
            "perPerson",
            "ownKill",
            "damage",
            "launch",
            "care"
          ],
          "properties": {
            "range": {
              "type": "number",
              "minimum": 0
            },
            "perPerson": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "ownKill": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "damage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "launch": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "care": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "trial": {
          "type": "object",
          "required": [
            "opponentForm",
            "opponentFormHeld",
            "deficitPerSec",
            "blowUp",
            "commit",
            "speed",
            "block",
            "followUp"
          ],
          "properties": {
            "opponentForm": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "opponentFormHeld": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "deficitPerSec": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "blowUp": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "commit": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "block": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "followUp": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "firstTie": {
          "enum": [
            "witness",
            "trial"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
