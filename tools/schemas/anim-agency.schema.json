        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The share of the pose mixed in over whatever he is doing."
        },
        "cut_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "The cue kinds that cut the shrug short."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "charge": {
