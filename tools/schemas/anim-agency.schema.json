            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The share of the pose mixed in over whatever he is doing."
            },
            "in": {
              "type": "number",
              "minimum": 0,
              "description": "Ease-in time (s)."
            },
            "out": {
              "type": "number",
              "minimum": 0,
              "description": "Ease-out time (s)."
            },
            "max_ticks": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "feint": {
          "type": "object",
          "required": [
            "hold",
            "weight",
            "in",
            "out",
            "ticks"
          ],
          "properties": {
            "hold": {
              "description": "The held pose (a pose of poses.json or a wave's poses file).",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "The share of the pose mixed in over whatever he is doing."
            },
            "in": {
              "type": "number",
              "minimum": 0,
              "description": "Ease-in time (s)."
            },
            "out": {
              "type": "number",
              "minimum": 0,
              "description": "Ease-out time (s)."
            },
            "ticks": {
              "type": "integer",
              "minimum": 1,
              "description": "The ticks the peel lasts."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "end_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "The cue kinds that end a charge pose (a dodge cancel, a challenge answered ...): the same shape as taunt.cut_kinds."
        },
        "cut_speed": {
          "type": "number",
          "minimum": 0,
          "description": "Speed (u/s) above which a carried fighter lets go of the held charge pose (Animation, 2026-10-18)."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
