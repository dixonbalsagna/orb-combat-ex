              "type": "number",
              "minimum": 0,
              "description": "Ease-out time (s)."
            },
            "max_ticks": {
              "type": "integer",
              "minimum": 1,
              "description": "The most ticks the held flight pose lasts."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "heavy": {
          "type": "object",
          "required": [
