{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-press-styles",
  "title": "anim.pressstyles/1",
  "description": "data/anim/press_styles.json: how the three press styles (tech, speed, heavy) move the body through a strike (docs/animation/press-styles.md). Render only, outside the sim's data hash; it never moves a blow's contact tick. Used only with RenderAnim.press_styles (default off). Times are 60 Hz ticks. read: which style a blow plays when its beat names none, by how the press was read (\"\" for a hold: the profile it plays today). squash_pose: the pose whose legs, pelvis and spine are the squash, by fighter, and the bones it takes. styles: per style, the timing overrides, the flags, the squash, the stretch, the twist and the afterimages. Version field: schema. Policy: closed except keys starting with an underscore. Cross-references (a riposte style names a key of styles (pressstyles-riposte); every squash pose is a pose; by_fighter keys are fighters of fighters.json; every bone is in profiles.json bone_lag; carry has a carry_ticks) are checked by tools/lib/xref-fight.js (pressstyles-*).",
  "type": "object",
  "required": [
    "schema",
    "enabled",
    "read",
    "squash_pose",
    "styles",
    "beat"
  ],
  "properties": {
    "schema": {
      "const": "anim.pressstyles/1"
    },
    "enabled": {
      "type": "boolean",
      "description": "false: no blow plays a style."
    },
    "read": {
      "type": "object",
      "required": [
        "rhythm",
        "mash",
        "heavy",
        "taps",
        "hold",
        "none"
      ],
      "properties": {
        "rhythm": {
          "enum": [
            "tech",
            "speed",
            "heavy"
          ],
          "description": "The press log reads timed."
        },
        "mash": {
          "enum": [
            "tech",
            "speed",
            "heavy"
          ]
        },
        "heavy": {
          "enum": [
            "tech",
            "speed",
            "heavy"
          ]
        },
        "taps": {
          "enum": [
            "tech",
            "speed",
            "heavy"
          ]
        },
        "hold": {
          "enum": [
            "",
            "tech",
            "speed",
            "heavy"
          ],
          "description": "A hold that is not a heavy blow: \"\" plays the profile it plays today."
        },
        "none": {
          "enum": [
            "tech",
            "speed",
            "heavy"
          ],
          "description": "No read."
        }
      },
      "description": "How a blow's style is chosen when its beat does not name one.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "squash_pose": {
      "type": "object",
      "required": [
        "default",
        "by_fighter",
        "bones"
      ],
      "properties": {
        "default": {
          "description": "The squash pose used when the fighter has none of his own.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "by_fighter": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
          },
          "patternProperties": {
            "^_": true
          },
          "description": "A fighter of fighters.json to his squash pose."
        },
        "bones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "The bones the squash takes from its pose."
        }
      },
      "description": "The pose whose legs, pelvis and spine are the squash.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "guard": {
      "type": "object",
      "required": [
        "pose",
        "bones",
        "weight"
      ],
      "properties": {
        "pose": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$",
          "description": "The pose whose bones the guard takes."
        },
        "bones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "The bones the guard takes from its pose."
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How much of the pose the guard takes."
        }
      },
      "description": "Optional. The guard a styled blow keeps up while it plays.",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "riposte": {
      "type": "object",
      "required": [
        "windup",
        "fade"
      ],
      "properties": {
        "windup": {
          "type": "object",
          "required": [
            "light",
            "heavy"
          ],
          "properties": {
            "light": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "Ticks of wind-up (from the block pose) before a light riposte."
            },
            "heavy": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "description": "Ticks of wind-up before a heavy riposte."
            }
          },
          "description": "The riposte's wind-up, in ticks, by weight.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "fade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Ticks the block pose fades into the riposte."
        },
        "style": {
          "type": "object",
          "required": [],
          "properties": {
            "light": {
              "enum": [
                "speed",
                "tech",
                "heavy",
                "push"
              ],
              "description": "The press style a light riposte plays in (a key of styles)."
            },
            "heavy": {
              "enum": [
                "speed",
                "tech",
                "heavy",
                "push"
              ],
              "description": "The press style a heavy riposte plays in (a key of styles)."
            }
          },
          "description": "Optional. The press style of the riposte, by weight; each weight is optional.",
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "grade": {
          "enum": [
            "perfect",
            "good",
            "off",
            "none"
          ],
          "description": "Optional. The grade of block a riposte follows."
        }
      },
      "description": "Optional. The brawl's riposte: the blocker's counter blow leaves from his block pose (docs/animation/press-styles.md section 12).",
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "beat": {
      "type": "object",
