    "schema": {
      "const": "anim.pairlive/1"
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_-]*)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "patternProperties": {
        "^_": true
      },
      "description": "Another name for a fighter of fighters.json."
    },
    "shared": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+[0-9]+$"
      },
      "description": "Waves baked for both fighters."
    },
