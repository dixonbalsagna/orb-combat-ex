              "striker_air"
            ],
            "description": "both_ground: both fighters near the ground; striker_air: the striker well above it."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      },
      "description": "Strikes that join their fighter's pick list only while their gate is open."
    },
    "spray_gap": {
      "type": "integer",
      "minimum": 1,
      "description": "Ticks between a fighter's bolts under which the next is a spray beat."
    },
