{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/director-stick",
  "title": "director.stick/1",
  "description": "DRAFT by Encounter for Tools: data/director/stick.json, the right stick's strike (docs/design/right-hand-attacks-rulings.md section 2). Policy: no key beyond these, and every key required, since DirStick reads each one.",
  "type": "object",
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false,
  "required": [
    "airAbove",
    "autoGoTicks",
    "carryTicks",
    "chargeRecover",
    "levels",
    "pendTicks",
    "quickRecover",
    "repeatSec",
    "schema",
    "windTicks"
  ],
  "properties": {
    "schema": {
      "const": "director.stick/1"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "carryBh",
          "ki",
          "reachBh",
          "stun",
          "worth"
        ],
        "properties": {
          "worth": {
            "type": "number",
            "minimum": 0
          },
          "ki": {
            "type": "number",
            "minimum": 0
          },
          "stun": {
            "type": "integer",
            "minimum": 0
          },
          "carryBh": {
            "type": "number",
            "minimum": 0
          },
          "reachBh": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "minItems": 4,
      "maxItems": 4
    },
    "quickRecover": {
      "type": "integer",
      "minimum": 0
    },
    "chargeRecover": {
      "type": "integer",
      "minimum": 0
    },
    "autoGoTicks": {
      "type": "integer",
      "minimum": 0
    },
    "repeatSec": {
      "type": "number",
      "minimum": 0
    },
    "carryTicks": {
      "type": "integer",
      "minimum": 0
    },
    "pendTicks": {
      "type": "integer",
      "minimum": 0
    },
    "airAbove": {
      "type": "number",
      "minimum": 0
    },
    "windTicks": {
      "type": "integer",
      "minimum": 1
    },
    "bufferTicks": {
      "type": "integer",
      "minimum": 0
    },
    "flickRun": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "points": {
          "type": "number",
          "minimum": 0
        },
        "_note": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "points"
      ],
      "additionalProperties": false
    },
    "pendFollow": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxTicks": {
          "type": "integer",
          "minimum": 1
        },
        "_note": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "maxTicks"
      ],
      "additionalProperties": false
    },
    "lightStops": {
      "type": "boolean"
    },
    "softWorth": {
      "type": "number",
      "minimum": 0
    },
    "softReel": {
      "type": "integer",
      "minimum": 0
    },
    "softRunOff": {
      "type": "integer",
      "minimum": 0
    },
    "guardStun": {
      "type": "integer",
      "minimum": 0
    },
    "armour": {
      "type": "object",
      "properties": {
        "_note": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "fromTicks": {
          "type": "integer",
          "minimum": 0
        },
        "mediumUntilTicks": {
          "type": "integer",
          "minimum": 0
        },
        "missOpenTicks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "steal": {
      "type": "object",
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "reelBase": {
          "type": "integer",
          "minimum": 0
        },
        "reelPer": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
