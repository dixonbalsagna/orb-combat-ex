{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/vfx-catastrophe",
  "title": "vfx catastrophe tier (version 1)",
  "description": "data/vfx/catastrophe.json: the catastrophe tier's presentation numbers (docs/vfx/catastrophe-plan.md). The tremor's dust and the blast cloud. Read by render/vfx/tremor.gd and render/vfx/blast_cloud.gd; every key has a built-in default there. Presentation only. Policy: closed except keys starting with an underscore at the top and in the tremor block (the rules in tools/lib/xref-fight.js: vfx-catastrophe-order).",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tremor": {
      "type": "object",
      "properties": {
        "sprites": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 160
          }
        },
        "alpha_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        },
        "onset_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        },
        "settle_s": {
          "type": "number",
          "minimum": 4,
          "maximum": 20
        },
        "calm_onset_s": {
          "type": "number",
          "minimum": 1.5,
          "maximum": 8
        },
        "calm_settle_s": {
          "type": "number",
          "minimum": 4,
          "maximum": 30
        },
        "shiver": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "wander": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "height_k": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "width_k": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 8
          }
        },
        "z": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -130,
            "maximum": -5
          }
        },
        "rubble_per_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        },
        "rubble_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 20
          }
        },
        "rubble_life_s": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 4
          }
        },
        "max_overlap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "blast_cloud": {
      "type": "object",
      "properties": {
        "sprites": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400
          }
        },
        "far_sprites": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "far_distance": {
          "type": "number",
          "minimum": 1000,
          "maximum": 60000
        },
        "far_size_k": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        },
        "height_max": {
          "type": "number",
          "minimum": 1000,
          "maximum": 40000
        },
        "height_tau_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "cap_major": {
          "type": "number",
          "minimum": 500,
          "maximum": 9000
        },
        "cap_major_tau_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "cap_minor": {
          "type": "number",
          "minimum": 300,
          "maximum": 6000
        },
        "cap_minor_rise_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "cap_omega": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "stem_width": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 50,
            "maximum": 2000
          }
        },
        "skirt_reach": {
          "type": "number",
          "minimum": 500,
          "maximum": 12000
        },
        "skirt_tau_s": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 20
        },
        "skirt_height": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 50,
            "maximum": 2000
          }
        },
        "heat_tau_core_s": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 20
        },
        "heat_tau_stem_s": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 20
        },
        "alpha_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.9
        },
        "fade_in_s": {
          "type": "number",
          "exclusiveMinimum": 0.3,
          "maximum": 10
        },
        "life_s": {
          "type": "number",
          "minimum": 5,
          "maximum": 120
        },
        "fade_out_s": {
          "type": "number",
          "exclusiveMinimum": 1,
          "maximum": 30
        },
        "fire_rise_s": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 5
        },
        "fire_fall_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 12
        },
        "calm_fire_rise_s": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "calm_fire_fall_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "core_radius_k": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.35
        },
        "core_sprites": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "core_alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.7
        },
        "max_alive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "colour_hot": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colour_amber": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colour_ember": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "colour_smoke": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
