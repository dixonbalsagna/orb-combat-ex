        },
        "twist": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "description": "[at full_speed, at run_speed]."
        },
        "lean_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 15,
          "description": "The forward lean at speed, in degrees."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      },
      "description": "The walk and run cycle."
    },
