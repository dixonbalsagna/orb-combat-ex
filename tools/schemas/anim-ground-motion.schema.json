{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-ground-motion",
  "title": "anim.ground_motion/1",
  "description": "data/anim/ground_motion.json: ground locomotion (docs/animation/ground-locomotion.md; AnimFighter's gait layer): a free fighter on the ground walks and runs on a gait driven by the distance he covers, takes off and lands with weight, moves differently on each surface, and each fighter has his own cadence. `look` maps World's gen 2 look classes to a surface. Render only, outside the sim's data hash. Version field: schema. Policy: closed except keys starting with an underscore; every key is required. Cross-references in tools/lib/xref-fight.js (ground-motion-speeds: min < full < run < max; ground-motion-look: every look value is a key of surfaces).",
  "type": "object",
  "required": [
    "schema",
    "enter_ticks",
    "gait",
    "takeoff",
    "land",
    "surfaces",
    "look",
    "fighters"
  ],
  "properties": {
    "schema": {
      "const": "anim.ground_motion/1"
    },
    "enter_ticks": {
      "type": "integer",
      "minimum": 6,
      "maximum": 30,
      "description": "Ticks the layer takes to ease in."
    },
    "gait": {
      "type": "object",
      "required": [
        "min_speed",
        "full_speed",
        "run_speed",
        "max_speed",
        "stride",
        "thigh",
        "knee",
        "bob",
        "twist",
        "lean_deg"
      ],
      "properties": {
        "min_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 3000,
          "description": "Under this the gait is not played."
        },
        "full_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 3000,
          "description": "The speed at which the gait is at its first value."
        },
        "run_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 3000,
          "description": "The speed at which it is at its last value."
        },
        "max_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 3000,
          "description": "From run_speed to here the flight pose takes over."
        },
        "stride": {
          "type": "number",
          "minimum": 10,
          "maximum": 300,
          "description": "Units covered in one cycle."
        },
        "thigh": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
          },
          "description": "[at full_speed, at run_speed]."
        },
        "knee": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 3
