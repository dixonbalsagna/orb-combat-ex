{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/vfx-water",
  "title": "vfx water effects (version 1)",
  "description": "data/vfx/water.json: the numbers behind the skip spray, the plunge column, a beam striking the sea and the wake (docs/vfx/water-plan.md). Presentation only: read by render/vfx/water.gd, never by the sim. Version field: version. Policy: closed except keys starting with an underscore. Every key is optional because water.gd falls back to the same default; speeds are world units a second, sizes world units, lives seconds, angles degrees. Range pairs (min not above max) are checked by tools/lib/xref.js (vfx-water-range).",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scale": {
      "type": "object",
      "description": "How a splash scales with the impact speed (against ref_speed) and the power tier, clamped to min..max.",
      "properties": {
        "ref_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tier_gain": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "skim": {
      "type": "object",
      "description": "The spray of a skip across the water.",
      "properties": {
        "streaks_base": {
          "type": "integer",
          "minimum": 0
        },
        "streaks_per_scale": {
          "type": "number",
          "minimum": 0
        },
        "elev_min_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "elev_max_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "len_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "len_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed_frac_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "speed_frac_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "speed_cap": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "life_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "life_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tail_puffs_base": {
          "type": "integer",
          "minimum": 0
        },
        "tail_puffs_per_scale": {
          "type": "number",
          "minimum": 0
        },
        "skip_decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "plunge": {
      "type": "object",
      "description": "The column of a fighter plunging in.",
      "properties": {
        "height_per_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "streaks_base": {
          "type": "integer",
          "minimum": 0
        },
        "streaks_per_scale": {
          "type": "number",
          "minimum": 0
        },
        "cone_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "column_puffs_base": {
          "type": "integer",
          "minimum": 0
        },
        "column_puffs_per_scale": {
          "type": "number",
          "minimum": 0
        },
        "rebound_delay": {
          "type": "number",
          "minimum": 0
        },
        "rebound_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "beam": {
      "type": "object",
      "description": "A beam striking the sea.",
      "properties": {
        "throw_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "throws_per_tick": {
          "type": "integer",
          "minimum": 0
        },
        "streaks_per_throw": {
          "type": "integer",
          "minimum": 0
        },
        "power_gain": {
          "type": "number",
          "minimum": 0
        },
        "puff_every": {
          "type": "integer",
          "minimum": 1
        },
        "forward_deg_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "forward_deg_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "wake": {
      "type": "object",
      "description": "The wake of a fighter flying low over the water.",
      "properties": {
        "min_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "streaks_per_tick": {
          "type": "integer",
          "minimum": 0
        },
        "puff_every": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "caps": {
      "type": "object",
      "description": "Hard limits on spray particles.",
      "properties": {
        "spray_alive": {
          "type": "integer",
          "minimum": 1
        },
        "per_tick": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "fill": {
      "type": "object",
      "description": "A filling hole (water v2, `water_fill`): the front's foam lip and spray, the rim and bore bursts, a seep's bubbles.",
      "properties": {
        "lip_every": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "lip_streaks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "lip_foam_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "lip_foam_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "start_streaks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "rim_streaks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "rim_foams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "rim_reach": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "bore_streaks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "bore_foams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "seep_foams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "max_fronts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "wave": {
      "type": "object",
      "description": "The ring wave of a slam into standing water (`water_wave`): a pulse of spray and foam a step, a bigger burst at a crater's rim.",
      "properties": {
        "streaks_per_pulse": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "foam_per_pulse": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "rim_streaks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "rim_foams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "max_waves": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "douse": {
      "type": "object",
      "description": "Thin steam where a fill reaches scorched ground (`water_douse`).",
      "properties": {
        "puffs_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "per_columns": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "size_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "size_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "grow": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "life_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "life_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "rise_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "rise_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "slap": {
      "type": "object",
      "description": "A body meeting the sea's or a lake's surface with World's floor on: the low wide splash of a landing on the sheet, and of the grapple's down throw (water.gd slap).",
      "properties": {
        "speed_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "throw_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_per_speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "streaks_base": {
          "type": "integer",
          "minimum": 0
        },
        "streaks_per_scale": {
          "type": "number",
          "minimum": 0
        },
        "fan_min_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "fan_max_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "centre_streaks": {
          "type": "integer",
          "minimum": 0
        },
        "centre_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "foam_base": {
          "type": "integer",
          "minimum": 0
        },
        "foam_per_scale": {
          "type": "number",
          "minimum": 0
        },
        "run_min": {
          "type": "number",
          "minimum": 0
        },
        "run_max": {
          "type": "number",
          "minimum": 0
        },
        "ring_r": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ring_rate": {
          "type": "number",
          "minimum": 0
        },
        "ring_life": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "throw_gain": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
