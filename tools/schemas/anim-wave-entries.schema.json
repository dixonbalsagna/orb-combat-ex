{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/anim-wave-entries",
  "title": "anim.wave.entries/1",
  "description": "data/anim/waves/<wave>.entries.json: the entry phases of a parked wave (generated by render/anim/tools/wave_gen.mjs; docs/animation/pose-pipeline.md section 9.15): how a fighter arrives before a blow, as phases of poses. An entry beat (or a rush beat naming one) plays an entry; none does in live matches. Names may carry a variant (`w2.dash~b`). Render only. Version field: schema. Policy: closed except keys starting with an underscore. Cross-reference: every phase pose is in the wave's poses file (checked by tools/lib/xref-fight.js, wave-pose).",
  "type": "object",
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "anim.wave.entries/1"
    },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*([.][a-z0-9_~]+)*)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "direction",
          "ground",
          "path",
          "phases",
          "favours",
          "lab"
        ],
        "properties": {
          "direction": {
            "enum": [
              "rush",
              "stand",
              "retreat"
            ]
          },
          "ground": {
            "enum": [
              "ok",
              "no",
              "only",
              "plant"
            ],
            "description": "Where it can be played: ok (either), no (never on the ground), only (ground only), plant (feet planted)."
          },
          "path": {
            "enum": [
              "straight",
              "arc",
              "ground",
              "spiral",
              "step",
              "none",
              "back"
            ]
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "pose"
              ],
              "description": "One phase: a pose, held for `ticks` ticks, or sharing the travel by weight `w`, or (neither) taking what is left.",
              "properties": {
                "pose": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_~]+)*$"
                },
                "ticks": {
                  "type": "integer",
                  "minimum": 1
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "not": {
                "required": [
                  "ticks",
                  "w"
                ]
              },
              "additionalProperties": false,
              "patternProperties": {
                "^_": true
              }
            }
          },
          "favours": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            },
            "description": "The strikes this entry leads into well."
          },
          "lab": {
            "type": "object",
            "required": [
              "d0",
              "shape"
            ],
            "properties": {
              "d0": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shape": {
                "enum": [
                  "straight",
                  "arc",
                  "rising",
                  "ground",
                  "spiral",
                  "none",
                  "back",
                  "hop"
                ]
              },
              "apex": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "advance": {
                "type": "number",
                "minimum": 0
              }
            },
            "description": "The lab hints: the start distance (u), the path shape the lab draws, and an apex or an advance where the shape has one.",
            "additionalProperties": false,
            "patternProperties": {
              "^_": true
            }
          },
          "_combat": {
            "type": "string",
            "pattern": "^entry\\.[a-z0-9_]+$",
            "description": "The Combat entry id it realises."
          },
          "_wave": {
            "type": "string",
            "pattern": "^(wave|protag|rival|guard)[0-9]+$"
          },
          "_variant": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "_alt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      },
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
