{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/audio-world-cues",
  "title": "audio world cues (schema 1)",
  "description": "audio/data/world_cues.json: biome sound (docs/audio/biomes.md; audio/audio_world.gd): a bed of ambience per biome, mixed under the brawl and ducked by the fight, and footfall, landing and impact layers by surface, read from the sim at the contact. Switched off by `enabled`. Version field: schema. Policy: closed except keys starting with an underscore. Cross-references in tools/lib/xref-world-cues.js (world-cues-bed, -default, -soil, -surface).",
  "type": "object",
  "required": [
    "schema",
    "note",
    "enabled",
    "sounds",
    "beds",
    "default_biome",
    "biomes",
    "bed",
    "intensity",
    "soil",
    "ground",
    "surfaces",
    "hit",
    "land",
    "bounce",
    "slide",
    "skim",
    "splash",
    "crater",
    "step",
    "water"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean",
      "description": "The one switch (off: nothing reads the rest)."
    },
    "sounds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z]+([.][a-z]+)*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sound"
      },
      "patternProperties": {
        "^_": true
      },
      "description": "ImpactSynth recipes, as in impacts.json; a surface names two of them."
    },
    "beds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/bed"
      },
      "patternProperties": {
        "^_": true
      },
      "description": "AmbienceSynth recipes, looped; a biome names one."
    },
    "default_biome": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "The biome used when the ground has none (a key of biomes: rule world-cues-default)."
    },
    "biomes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "bed",
          "gain_db",
          "alt_db"
        ],
        "properties": {
          "bed": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A bed of `beds` (rule world-cues-bed)."
          },
          "gain_db": {
            "type": "number",
            "minimum": -60,
            "maximum": 12,
            "description": "Level of the bed in this biome."
          },
          "alt_db": {
            "type": "number",
            "minimum": -60,
            "maximum": 12,
            "description": "Level change at altitude (over bed.alt_ref)."
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^_": true
        }
      },
      "patternProperties": {
        "^_": true
      },
      "description": "Each biome of the sim and the bed it plays."
    },
    "bed": {
      "type": "object",
      "required": [
        "bus",
        "priority",
        "cls",
        "cap",
        "hold_ticks",
        "fade_ms",
        "start_db",
        "update_every",
        "min_step_db",
        "ramp_ms",
        "alt_ref"
      ],
      "properties": {
        "bus": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_ ]*$"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cls": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)*$"
        },
        "cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "hold_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600,
          "description": "Ticks a bed is kept after the ground changes."
        },
        "fade_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "start_db": {
          "type": "number",
          "minimum": -80,
          "maximum": 0
        },
        "update_every": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "description": "Ticks between looks at the ground."
        },
        "min_step_db": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 12
        },
        "ramp_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "alt_ref": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "description": "The altitude, in units, at which alt_db applies in full."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      },
      "description": "How a bed is played."
    },
    "intensity": {
      "type": "object",
      "required": [
        "per_damage",
        "per_crater",
        "decay_s",
        "duck_db"
      ],
      "properties": {
        "per_damage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Intensity added per point of damage."
        },
        "per_crater": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decay_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "duck_db": {
          "type": "number",
          "minimum": -40,
          "maximum": 0,
          "description": "How far a fight ducks the bed."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      },
      "description": "How the fight ducks the bed."
    },
    "soil": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "A surface of `surfaces` (rule world-cues-soil)."
      },
      "patternProperties": {
        "^_": true
      },
      "description": "Biome to the surface under it (a key of biomes)."
    },
    "ground": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "A surface of `surfaces` (rule world-cues-ground)."
      },
      "patternProperties": {
        "^_": true
      },
      "description": "Biome to the surface that takes the sim's soil, rock or sand class at a column of that fine biome (ice, a wetland, a beach): a key of biomes to a key of surfaces (rule world-cues-ground)."
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
