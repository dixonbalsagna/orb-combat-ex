{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/biomes-campaign",
  "title": "biomes.campaign/1",
  "description": "data/biomes/campaign.json: the campaign's route on the ring (docs/design/campaign.md; WorldCampaign). Version field: schema. Policy: every key required, objects closed except keys starting with an underscore. Order checks (min within max, maxS above minS, five columns) are WorldCampaign's own load and campaign_check.",
  "type": "object",
  "required": [
    "schema",
    "_about",
    "enabled",
    "flight",
    "columns",
    "sites",
    "turn",
    "side",
    "wear"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "biomes.campaign/1"
    },
    "_about": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "description": "The campaign's route on or off; off, nothing in WorldCampaign runs and the golden is as it was."
    },
    "flight": {
      "type": "object",
      "required": [
        "speed",
        "minS",
        "maxS",
        "climaxMaxS"
      ],
      "additionalProperties": false,
      "description": "The flight band.",
      "properties": {
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 100000.0,
          "description": "Units a second the pair fly between places."
        },
        "minS": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1000.0,
          "description": "The least seconds of flight to a place's near edge."
        },
        "maxS": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1000.0,
          "description": "The most (above minS: WorldCampaign's load)."
        },
        "climaxMaxS": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1000.0,
          "description": "The most for the climax before it counts as the build-up."
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "min",
          "max",
          "pThree",
          "settled",
          "pull",
          "pinned"
        ],
        "additionalProperties": false,
        "description": "One column of the episode.",
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "The fewest places the column offers."
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "The most (at least min: WorldCampaign's load)."
          },
          "pThree": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "The chance of each extra place past min (a seeded draw)."
          },
          "settled": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "description": "How many must be a city or town on the ring."
          },
          "pull": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 5.0,
            "description": "The pull toward settled places in the score."
          },
          "pinned": {
            "type": "boolean",
            "description": "The column's place is the one the caller pins (the climax: the boss's home)."
          }
        }
      },
      "description": "The five columns, cold open to climax."
    },
    "sites": {
      "type": "object",
      "required": [
        "openStride",
        "sepS",
        "jitter",
        "novelty",
        "fallen",
        "openMin"
      ],
      "additionalProperties": false,
      "description": "Choosing places.",
      "properties": {
        "openStride": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "Columns between open-ground samples."
        },
        "sepS": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1000.0,
          "description": "The least seconds of flight between two of a column's places."
        },
        "jitter": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 5.0,
          "description": "How far a seeded draw may move a place's score."
        },
        "novelty": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 5.0,
          "description": "What a new kind of ground adds."
        },
        "fallen": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 5.0,
          "description": "What a fallen place loses."
        },
        "openMin": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "The least land share around an open site."
        }
      }
    },
    "turn": {
      "type": "object",
      "required": [
        "bearings",
        "bonus",
        "minGain"
      ],
      "additionalProperties": false,
      "description": "The ring turn between columns.",
      "properties": {
        "bearings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 90.0,
            "description": "A bearing in degrees, tried both ways."
          },
          "description": "The turns a column may make."
        },
        "bonus": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 5.0,
          "description": "What a turn adds to a ring's score."
        },
        "minGain": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 5.0,
          "description": "How much a turn must gain over no turn."
        }
      }
    },
    "side": {
      "type": "object",
      "required": [
        "sepS",
        "ringCols"
      ],
      "additionalProperties": false,
      "description": "The side story's place.",
      "properties": {
        "sepS": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1000.0,
          "description": "The least seconds of flight between a side story's place and a column's."
        },
        "ringCols": {
          "type": "integer",
          "minimum": 100,
          "maximum": 4800,
          "description": "The columns of the Close ring round a side story's place."
        }
      }
    },
    "wear": {
      "type": "object",
      "required": [
        "band",
        "fallen",
        "hpKeep"
      ],
      "additionalProperties": false,
      "description": "A place's wounds, as place state only (Legal mc02).",
      "properties": {
        "band": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "The share of a place's buildings lost that lifts it to the band."
          },
          "description": "Bands 1 to 3."
        },
        "fallen": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "The share of a worn place's buildings already fallen."
          },
          "description": "For bands 0 to 3."
        },
        "hpKeep": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "The share of hp the other buildings keep."
          },
          "description": "For bands 0 to 3."
        }
      }
    }
  }
}
