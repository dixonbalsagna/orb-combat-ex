          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(_.*|[a-z][a-z0-9_]*)$"
          },
          "additionalProperties": {
            "enum": [
              "light",
              "medium",
              "heavy",
              ""
            ]
          },
          "patternProperties": {
            "^_": true
          },
          "description": "A blow cue text to the strength it reads as (light, medium, heavy, or \"\" for none)."
        },
        "blow_window_ticks": {
          "type": "integer",
          "minimum": 0,
          "description": "Ticks a blow cue stays attributable."
        },
        "fallback_amounts": {
          "type": "object",
          "required": [
            "medium_from",
            "heavy_from"
          ],
          "properties": {
            "medium_from": {
              "type": "number",
              "minimum": 0,
              "description": "Damage from which a hit reads medium."
            },
            "heavy_from": {
              "type": "number",
              "minimum": 0,
              "description": "Damage from which a hit reads heavy (above medium_from: brawl-cue-order)."
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "kind_is_strength": {
          "type": "boolean",
          "description": "Whether the hit kind is itself the strength."
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
