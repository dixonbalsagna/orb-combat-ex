{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/fight-run",
  "title": "fight-run (schema \"fight.run/1\")",
  "description": "data/fight/run.json: the run's numbers (docs/architecture/run-core.md; sim/core/run.gd). Run-only: no versus match reads it. Policy: closed except keys starting with an underscore.",
  "type": "object",
  "required": [
    "schema",
    "ground",
    "carry"
  ],
  "properties": {
    "schema": {
      "const": "fight.run/1"
    },
    "ground": {
      "type": "object",
      "required": [
        "enabled",
        "framesPerRead",
        "stagesBeforeBoss",
        "phases",
        "provingSize"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "the switch: the story mode's host picks each stage's ground with World's ring picker only while it is on"
        },
        "framesPerRead": {
          "type": "object",
          "required": [
            "close",
            "half",
            "whole"
          ],
          "properties": {
            "close": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "a candidate ring read every this many frames of the beats"
            },
            "half": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "a candidate ring read every this many frames of the beats"
            },
            "whole": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "a candidate ring read every this many frames of the beats"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "stagesBeforeBoss": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "the stages before the boss"
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "enum": [
              "early",
              "mid"
            ]
          },
          "description": "the claim's size phase by chapter before the boss"
        },
        "provingSize": {
          "enum": [
            "close",
            "half",
            "whole"
          ],
          "description": "a Proving ground's ring"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    },
    "carry": {
      "type": "object",
      "required": [
        "damagedShare",
        "fallenShare",
        "livesStart",
        "livesMax",
        "fillsKeep",
        "dreadDivisor"
      ],
      "properties": {
        "damagedShare": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "thousandths: a place that has lost this share of its buildings or people is damaged"
        },
        "fallenShare": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "thousandths: under this share of a place's buildings standing or people present, it has fallen"
        },
        "livesStart": {
          "type": "object",
          "required": [
            "story",
            "standard",
            "hard"
          ],
          "properties": {
            "story": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "standard": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "hard": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^_": true
          }
        },
        "livesMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "description": "at most this many lives held"
        },
        "fillsKeep": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "thousandths of the hero's fills carried to the next fight"
        },
        "dreadDivisor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "thousandths: Dread is the villains' kills' share of the planet's people over this, at most 1"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^_": true
      }
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^_": true
  }
}
