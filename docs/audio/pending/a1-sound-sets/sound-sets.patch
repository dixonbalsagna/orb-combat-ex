diff --git a/audio/tools/sets_check.gd b/audio/tools/sets_check.gd
new file mode 100644
index 00000000..0ae12ea2
--- /dev/null
+++ b/audio/tools/sets_check.gd
@@ -0,0 +1,110 @@
+extends SceneTree
+## A-AUDIO-01: are the five things a player should hear (a beam, a knock-out, a launch, a struggle, a transformation) made into sounds on a seeded
+## match with the audio data AS IT SHIPS (the beam struggle, moments and carry sets are on in audio/data since 2026-11-14, as in the build Orb
+## played on 9 November)? For each match it counts the sim's events and the cues made from them, and checks that every cue names a bank sound
+## at an audible level. The sets are NOT switched on here: this reads the data as it is. From the repo root:
+##   godot --headless --path . --script res://audio/tools/sets_check.gd [-- --seeds=301,302,303,304 --ticks=3600 --setup=power,dash]
+## Exit code 1 if a set is off in the data, a cue names no bank sound or has numbers out of range, or an event that happened made no cue.
+## A knock-out is rare in the AI's matches (the sim's KO comes from the wounds, not hit points), so it is usually reported as not in these
+## matches; its cue is checked on a staged event in moments_check.
+## An event that did not happen in the sampled matches is reported as such, not failed (a longer or different match may have it).
+## Run it on a tree with the sim data of the build under test; the same script gives the same lines on any tree whose data matches.
+
+var bank: AudioBank
+var fails: int = 0
+var lines: PackedStringArray = PackedStringArray()
+
+
+func _initialize() -> void:
+	bank = AudioBank.new()
+	_run.call_deferred()
+
+
+func ok(cond: bool, msg: String) -> void:
+	print("  %s  %s" % ["ok  " if cond else "FAIL", msg])
+	if not cond:
+		fails += 1
+
+
+func _run() -> void:
+	var seeds: Array = [301, 302, 303, 304]
+	var ticks: int = 3600
+	var setup: Dictionary = {}
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--seeds="):
+			seeds = []
+			for s in a.substr(8).split(","):
+				seeds.append(int(s))
+		elif a.begins_with("--ticks="):
+			ticks = int(a.substr(8))
+		elif a.begins_with("--setup="):
+			for w in a.substr(8).split(","):
+				if w != "":
+					setup[w] = true
+	var probe := AudioCues.new(bank)
+	print("1. the data as shipped")
+	ok(probe.tug.enabled(), "the beam struggle set is on (audio/data/tug_cues.json)")
+	ok(probe.moments.enabled(), "the moments set is on (audio/data/moment_cues.json)")
+	ok(probe.carry.enabled(), "the carry set is on (audio/data/carry_cues.json)")
+	info("world %s, coop %s (both stay as they were in the build Orb played)" % ["on" if probe.world.enabled() else "off", "on" if probe.coop.enabled() else "off"])
+	print("2. seeded matches %s, up to %d ticks, setup %s" % [str(seeds), ticks, str(setup)])
+	var ev_n: Dictionary = {"beam": 0, "ko": 0, "launch": 0, "struggle": 0, "transform": 0}
+	var cue_n: Dictionary = {"beam": 0, "ko": 0, "launch": 0, "struggle": 0, "transform": 0}
+	var bad: String = ""
+	var total_cues: int = 0
+	for sd in seeds:
+		var M := SimCore.createSim()
+		SimCore.newMatch(M, int(sd), {}, setup)
+		var cm := AudioCues.new(bank)
+		cm.reset(int(sd))
+		var t: int = 0
+		while t < ticks and not (M.game.ko != null and M.game.koT > 3.0):
+			SimCore.step(M)
+			for e in M.out.fx:
+				var k: String = String(e.kind) if e.type == "cue" else ""
+				if e.type == "cue" and (k == "beam_charge" and String(e.text) == "start" or k == "beam_fire"):
+					ev_n.beam += 1
+				elif e.type == "ko":
+					ev_n.ko += 1
+				elif e.type == "launch":
+					ev_n.launch += 1
+				elif e.type == "cue" and k == "beam_struggle" and String(e.text) == "start":
+					ev_n.struggle += 1
+				elif e.type == "transform_ready" or e.type == "form_release":
+					ev_n.transform += 1
+			for c in cm.consume(M, M.out.fx):
+				total_cues += 1
+				if c.sound == "":
+					continue
+				if not bank.has_sound(c.sound):
+					bad = "no such sound " + c.sound
+				elif not (is_finite(c.gain_db) and is_finite(c.pitch)) or c.pitch < 0.3 or c.pitch > 2.5 or c.gain_db < -40.0 or c.gain_db > 8.0:
+					bad = "number out of range for %s: gain %.1f pitch %.2f" % [c.sound, c.gain_db, c.pitch]
+				match String(c.cls):
+					"moment.charge", "moment.fire":
+						cue_n.beam += 1
+					"moment.ko":
+						cue_n.ko += 1
+					"moment.launch":
+						cue_n.launch += 1
+					"tug.bed", "tug.lock":
+						cue_n.struggle += 1
+					"form.ready", "coil":
+						cue_n.transform += 1
+			M.out.fx.clear()
+			M.out.feed.clear()
+			t += 1
+		SimCore.dispose(M)
+	ok(bad == "" and total_cues > 0, "every cue names a bank sound with finite, in-range numbers (%d cues) %s" % [total_cues, bad])
+	for k in ["beam", "ko", "launch", "struggle", "transform"]:
+		var label: String = {"beam": "a beam charging or firing", "ko": "a knock-out", "launch": "a launch", "struggle": "a beam struggle starting", "transform": "a transformation"}[k]
+		if ev_n[k] == 0:
+			info("%s: not in these matches (0 events)" % label)
+		else:
+			ok(cue_n[k] > 0, "%s: %d events, %d cues" % [label, ev_n[k], cue_n[k]])
+	print("\nsets check %s" % ("FAILED (%d)" % fails if fails > 0 else "passed"))
+	quit(1 if fails > 0 else 0)
+
+
+func info(msg: String) -> void:
+	print("  --    " + msg)
diff --git a/audio/tools/drop_probe.gd b/audio/tools/drop_probe.gd
new file mode 100644
index 00000000..f8577703
--- /dev/null
+++ b/audio/tools/drop_probe.gd
@@ -0,0 +1,203 @@
+extends SceneTree
+## Which cues does the voice pool drop, and which does it evict? (docs/audio/drops.md.) A model of AudioVoices.play's decision, run on seeded AI
+## matches with the audio data as shipped: the same distance rule (a cue at or beyond mix.space.max_distance from the camera is dropped), the same
+## `_take` (a cue's own group, then the class cap, then a free voice, then the weakest voice it outranks), 16 voices (mix.voices), and each voice
+## busy for its stream's length over its pitch (a looped voice until its group is stopped), as the web path counts a one-shot. The camera is the
+## midpoint of the two fighters. Nothing is played: no sound device is used. From the repo root:
+##   godot --headless --path . --script res://audio/tools/drop_probe.gd [-- --seeds=301,302 --ticks=7200 --setup=power,dash --voices=16 --suspend=SECONDS [--hold] --csv=PATH]
+## --suspend=60 models the browser holding the sound back for the first 60 s of each match (Orb's 2026-11-07 play): a one-shot started in that time
+## stays 'playing' on a frozen context until the second it is released, so the pool fills.
+## Prints, per class: cues asked, played, dropped for distance, dropped for no slot, evicted while still sounding (and by whom). Exit 0.
+
+var bank: AudioBank
+var mix: Dictionary = {}
+
+var n_voices: int = 16
+var meta: Array = []                  # per voice: {priority, group, cls, t, until, loop, sound}
+var stat: Dictionary = {}             # cls -> {ask, played, far, slot, evicted, left_sum}
+var evict_by: Dictionary = {}         # "victim_cls <- by_cls" -> count
+var drop_by_sound: Dictionary = {}    # sound -> count of slot drops
+var far_by_sound: Dictionary = {}
+var maxd: float = 2600.0
+var clock: float = 0.0
+var suspend_s: float = 0.0           # >0: the Godot path with a suspended browser context: a one-shot that starts before this second never ends until it
+var released: bool = true
+var hold: bool = false               # the proposed fix: while the sound is held back, a cue is not taken at all (held), so the pool stays free
+var held: int = 0
+
+
+func _initialize() -> void:
+	bank = AudioBank.new()
+	mix = AudioBank.load_json("res://audio/data/mix.json")
+	_run.call_deferred()
+
+
+func _row(cls: String) -> Dictionary:
+	if not stat.has(cls):
+		stat[cls] = {"ask": 0, "played": 0, "far": 0, "slot": 0, "evicted": 0}
+	return stat[cls]
+
+
+func _busy(i: int) -> bool:
+	return float(meta[i].until) > clock or (bool(meta[i].loop) and bool(meta[i].alive))
+
+
+func _take(c) -> int:
+	if c.group != "":
+		for i in range(n_voices):
+			if meta[i].group == c.group and _busy(i):
+				return i
+	if c.cap > 0 and c.cls != "":
+		var oldest: int = -1
+		var count: int = 0
+		for i in range(n_voices):
+			if _busy(i) and meta[i].cls == c.cls:
+				count += 1
+				if oldest == -1 or float(meta[i].t) < float(meta[oldest].t):
+					oldest = i
+		if count >= c.cap:
+			return oldest if c.priority >= int(meta[oldest].priority) else -1
+	var weakest: int = -1
+	for i in range(n_voices):
+		if not _busy(i):
+			return i
+		if weakest == -1 or int(meta[i].priority) < int(meta[weakest].priority) or (int(meta[i].priority) == int(meta[weakest].priority) and float(meta[i].t) < float(meta[weakest].t)):
+			weakest = i
+	if weakest != -1 and c.priority >= int(meta[weakest].priority):
+		return weakest
+	return -1
+
+
+func _play(c, cam_x: float) -> void:
+	if c.sound == "" and c.stop_group != "":
+		for i in range(n_voices):
+			if meta[i].group == c.stop_group:
+				meta[i].alive = false
+				meta[i].until = 0.0
+		return
+	if c.update:
+		return
+	if hold and clock < suspend_s and not c.loop:
+		held += 1
+		return
+	var r: Dictionary = _row(String(c.cls) if c.cls != "" else "(none) " + String(c.sound).get_slice(".", 0))
+	r.ask += 1
+	var dx: float = 0.0 if c.ambient else SimWrap.sdx(cam_x, c.x)
+	if absf(dx) >= maxd:
+		r.far += 1
+		far_by_sound[c.sound] = int(far_by_sound.get(c.sound, 0)) + 1
+		return
+	var slot: int = _take(c)
+	if slot < 0:
+		r.slot += 1
+		drop_by_sound[c.sound] = int(drop_by_sound.get(c.sound, 0)) + 1
+		return
+	if _busy(slot) and meta[slot].group != c.group:
+		var vr: Dictionary = _row(String(meta[slot].cls) if meta[slot].cls != "" else "(none) " + String(meta[slot].sound).get_slice(".", 0))
+		vr.evicted += 1
+		var key: String = "%s (prio %d) <- %s (prio %d)" % [meta[slot].cls if meta[slot].cls != "" else meta[slot].sound, int(meta[slot].priority), c.cls if c.cls != "" else c.sound, c.priority]
+		evict_by[key] = int(evict_by.get(key, 0)) + 1
+	var len: float = 0.0
+	var meta_len: float = 0.0
+	if c.loop:
+		len = 1.0e9
+	else:
+		len = bank.stream(c.sound, c.variant).get_length() / maxf(c.pitch, 0.1)
+		if clock < suspend_s:
+			meta_len = len
+			len = 1.0e9
+	meta[slot] = {"priority": c.priority, "group": c.group, "cls": c.cls, "t": clock, "until": clock + len, "loop": c.loop, "alive": true, "sound": c.sound, "len": meta_len}
+	r.played += 1
+
+
+func _run() -> void:
+	var seeds: Array = [301, 302, 303, 304, 305, 306]
+	var ticks: int = 7200
+	var setup: Dictionary = {}
+	var csv: String = ""
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--seeds="):
+			seeds = []
+			for s in a.substr(8).split(","):
+				seeds.append(int(s))
+		elif a.begins_with("--ticks="):
+			ticks = int(a.substr(8))
+		elif a.begins_with("--voices="):
+			n_voices = int(a.substr(9))
+		elif a == "--hold":
+			hold = true
+		elif a.begins_with("--suspend="):
+			suspend_s = float(a.substr(10))
+		elif a.begins_with("--csv="):
+			csv = a.substr(6)
+		elif a.begins_with("--setup="):
+			for w in a.substr(8).split(","):
+				if w != "":
+					setup[w] = true
+	maxd = float(mix.space.max_distance)
+	var total_ticks: int = 0
+	for sd in seeds:
+		meta.clear()
+		released = suspend_s <= 0.0
+		for i in range(n_voices):
+			meta.append({"priority": -1, "group": "", "cls": "", "t": -1.0, "until": 0.0, "loop": false, "alive": false, "sound": "", "len": 0.0})
+		var M := SimCore.createSim()
+		SimCore.newMatch(M, int(sd), {}, setup)
+		var cm := AudioCues.new(bank)
+		cm.reset(int(sd))
+		var t: int = 0
+		while t < ticks and not (M.game.ko != null and M.game.koT > 3.0):
+			SimCore.step(M)
+			clock = float(t) / 60.0
+			if suspend_s > 0.0 and clock >= suspend_s and not released:
+				released = true
+				for i in range(n_voices):
+					if float(meta[i].until) >= 1.0e8 and not bool(meta[i].loop):
+						meta[i].until = clock + float(meta[i].len)
+			var f0 = M.fighters[0]
+			var f1 = M.fighters[1]
+			var cam_x: float = f0.x + SimWrap.sdx(f0.x, f1.x) * 0.5
+			for c in cm.consume(M, M.out.fx):
+				_play(c, cam_x)
+			M.out.fx.clear()
+			M.out.feed.clear()
+			t += 1
+		total_ticks += t
+		SimCore.dispose(M)
+	print("drop probe: seeds %s, %d ticks (%.0f s), %d voices, setup %s" % [str(seeds), total_ticks, total_ticks / 60.0, n_voices, str(setup)])
+	var ask: int = 0
+	var played: int = 0
+	var far: int = 0
+	var slot: int = 0
+	var rows: Array = []
+	for k in stat:
+		var r: Dictionary = stat[k]
+		ask += r.ask
+		played += r.played
+		far += r.far
+		slot += r.slot
+		rows.append([k, r])
