  "_about": "the lockout and the no-regrab are shared by every grab; sameplaceMax is Legal's s08, counted by place, as Game Design re-ruled on 2026-10-17 (grapple.md section 2): a region has two or three places, so a stick held on one wound keeps working it, the blows alternating places",
  "places": {
   "head": [
    "head",
    "jaw"
   ],
   "core": [
    "chest",
    "gut"
   ],
   "legs": [
    "legs",
    "shins"
   ],
   "arms": [
    "shoulder",
    "elbow",
    "wrist"
   ],
   "_arms": "the grammar has one arm target; its three places (shoulder, elbow, wrist) are assigned by Animation at run time (Legal's launcher-and-reach-screen), so arm blows alternate there"
  },
  "everyPlaceHasAPiece": true
 },
 "regions": {
  "up": "head",
  "down": "legs",
  "toward": "core",
  "away": "arms",
  "_about": "the stick's lean to the region a vicious blow goes to; no stick: core"
 },
