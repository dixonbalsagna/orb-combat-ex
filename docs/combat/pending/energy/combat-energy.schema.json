  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "fighter",
    "side",
    "meter",
    "lane",
    "names",
    "light",
    "medium",
    "heavy",
    "beam",
    "grab",
    "trap",
    "atoms"
  ],
