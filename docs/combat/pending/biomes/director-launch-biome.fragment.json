{
  "$comment": "DRAFT by Combat for Tools (docs/combat/biomes.md section 3): the property 'biome' to add to tools/schemas/director-launch.schema.json properties (optional, so today's launch.json stays valid). Each candidate is open past its common keys, since each names its own probe. Cross-references for Tools' xref (proposed): every name in biome.sends is a key of biome.candidates and each candidate's sends matches the list it is in; every surfaceLand key is a data/combat/ground.json surfaces key; every downBonus and distMul key is a biome WorldBiomes can return",
  "biome": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "touchBuilt": {
        "type": "boolean"
      },
      "rules": {
        "type": "object",
        "patternProperties": {
          "^_": {},
          "^[a-zA-Z]+$": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "qa": {
        "type": "object",
        "properties": {
          "takenWhereOffered": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "maxInOwnBiome": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "seaLandingsFall": {
            "type": "boolean"
          }
        },
        "patternProperties": {
          "^_": {}
        },
        "additionalProperties": false
      },
      "downBonus": {
        "type": "object",
        "patternProperties": {
          "^_": {},
          "^[a-z][a-z_]*$": {
            "type": "number",
            "minimum": -200,
            "maximum": 200
          }
        },
        "additionalProperties": false
      },
      "distMul": {
        "type": "object",
        "patternProperties": {
          "^_": {},
          "^[a-z][a-z_]*$": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 3
          }
        },
        "additionalProperties": false
      },
      "surfaceLand": {
        "type": "object",
        "patternProperties": {
          "^_": {},
          "^[a-z][a-z_]*$": {
            "type": "object",
            "properties": {
              "across": {
                "type": "number",
                "minimum": -200,
                "maximum": 200
              },
              "down": {
                "type": "number",
                "minimum": -200,
                "maximum": 200
              },
              "up": {
                "type": "number",
                "minimum": -200,
                "maximum": 200
              },
              "soft": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 1
              }
            },
            "patternProperties": {
              "^_": {}
            },
            "additionalProperties": false,
            "required": [
              "across",
              "down",
              "up"
            ]
          }
        },
        "additionalProperties": false
      },
      "candidates": {
        "type": "object",
        "patternProperties": {
          "^_": {},
          "^[A-Z][A-Z ]{2,23}$": {
            "type": "object",
            "required": [
              "sends",
              "score"
            ],
            "properties": {
              "sends": {
                "enum": [
                  "across",
                  "down",
                  "up"
                ]
              },
              "score": {
                "type": "number",
                "minimum": -200,
                "maximum": 200
              },
              "hero": {
                "type": "number",
                "minimum": -200,
                "maximum": 200
              },
              "villain": {
                "type": "number",
                "minimum": -200,
                "maximum": 200
              },
              "where": {
                "type": "string",
                "minLength": 1
              },
              "ux": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "uy": {
                "type": "number",
                "minimum": -2,
                "maximum": 2
              },
              "force": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 4
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "sends": {
        "type": "object",
        "properties": {
          "across": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z ]{2,23}$"
            },
            "uniqueItems": true
          },
          "down": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z ]{2,23}$"
            },
            "uniqueItems": true
          },
          "up": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z ]{2,23}$"
            },
            "uniqueItems": true
          }
        },
        "patternProperties": {
          "^_": {}
        },
        "additionalProperties": false
      }
    },
    "patternProperties": {
      "^_": {}
    },
    "additionalProperties": false,
    "required": [
      "enabled",
      "candidates",
      "sends"
    ]
  }
}
