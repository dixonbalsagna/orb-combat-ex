{
  "_about": "PROPOSED fixture cases for tools/fixtures/cases.json (Combat, 2026-10-23): three refusals per new schema, in that file's shape. Each was run against the draft schemas with Tools' validator in a scratch root; '_seen' is the finding it printed, for Tools to set expect.rule from. The virtual fixture tree needs copies of data/combat/sigvariants.json and data/combat/ground.json (docs/combat/pending/biomes/), and launch.json with the biome block",
  "cases": [
    {
      "id": "sigvariants-name-lower",
      "schema": "combat-sigvariants.schema.json",
      "mutate": [
        {
          "file": "data/combat/sigvariants.json",
          "set": {
            "/variants/jungle/name": "vine shear"
          }
        }
      ],
      "expect": {
        "pointer": "/variants/jungle/name",
        "_seen": "error  data/combat/sigvariants.json:235 /variants/jungle/name  [pattern] must match /^[A-Z][A-Z ]{2,23}$/ (got \"vine shear\")"
      }
    },
    {
      "id": "sigvariants-scorch-three",
      "schema": "combat-sigvariants.schema.json",
      "mutate": [
        {
          "file": "data/combat/sigvariants.json",
          "set": {
            "/variants/tundra/scorch": [
              1.0,
              1.0,
              1.0
            ]
          }
        }
      ],
      "expect": {
        "pointer": "/variants/tundra/scorch",
        "_seen": "error  data/combat/sigvariants.json:290 /variants/tundra/scorch  [maxItems] must have at most 2 items (got 3)"
      }
    },
    {
      "id": "sigvariants-aftermath-kind",
