{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meridian/combat-ground-atoms",
  "title": "combat.ground_atoms/1",
  "description": "DRAFT by Combat for Tools (docs/combat/biomes.md section 4): data/combat/ground_atoms.json, choreography atoms that read the ground by surface class: skid-stops, recoil landings, approaches and the slam crater's shape. Policy: closed except keys starting with an underscore. Cross-references for Tools' xref (proposed): every surfaces row with exists true is a class of data/biomes/contact.json surfaces, and every class there has a row; every skidStop, landing, approach and craters key and every stripLooks value is a surfaces key or 'water'; every stripLooks key is an aftermath kind of data/combat/sigvariants.json; each look a data/biomes/ground.json profile names is a surfaces key; a craters row with refill has refillTicks",
  "type": "object",
  "properties": {
    "schema": {
      "const": "combat.ground_atoms/1"
    },
    "enabled": {
      "type": "boolean"
    },
    "touchBuilt": {
      "type": "boolean"
    },
    "embedThresholdScales": {
      "type": "boolean"
    },
    "qa": {
      "type": "object",
      "properties": {
        "embedsPerMinute": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "patternProperties": {
        "^_": {}
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "object",
      "patternProperties": {
        "^_": {},
        "^[a-z][a-z_]*$": {
          "type": "object",
          "properties": {
            "exists": {
              "type": "boolean"
            },
            "readsAs": {
              "enum": [
                "paving",
                "rock",
                "soil",
                "sand",
                "rubble"
              ]
            },
            "forAnimation": {
              "type": "object",
              "properties": {
                "bounceMul": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "patternProperties": {
                "^_": {}
              },
              "additionalProperties": false,
              "required": [
                "bounceMul"
              ]
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "required": [
            "exists"
          ]
        }
      },
      "additionalProperties": false
    },
    "stripLooks": {
      "type": "object",
      "patternProperties": {
        "^_": {},
        "^[a-zA-Z]+$": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*$"
        }
      },
      "additionalProperties": false
    },
    "skidStop": {
      "type": "object",
      "patternProperties": {
        "^_": {},
        "^[a-z][a-z_]*$": {
          "type": "object",
          "properties": {
            "pose": {
              "type": "string",
              "minLength": 1
            },
            "trail": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "enum": [
                "crouch",
                "low_crouch",
                "kneel",
                "shin_deep",
                "sunk",
                "waist_deep"
              ]
            },
            "spin": {
              "type": "boolean"
            },
            "handBrake": {
              "type": "boolean"
            },
            "sunkMoveTicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "tripAbove": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            },
            "tripEnd": {
              "enum": [
                "crouch",
                "low_crouch",
                "kneel",
                "shin_deep",
                "sunk",
                "waist_deep"
              ]
            },
            "skate": {
              "type": "boolean"
            },
            "controlAtBrake": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 4
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "required": [
            "pose",
            "trail",
            "end"
          ]
        }
      },
      "additionalProperties": false
    },
    "landing": {
      "type": "object",
      "patternProperties": {
        "^_": {},
        "^[a-z][a-z_]*$": {
          "type": "object",
          "properties": {
            "slideBh": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "sinkBh": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "burst": {
              "type": "string",
              "minLength": 1
            },
            "pose": {
              "type": "string",
              "minLength": 1
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "required": [
            "burst"
          ]
        }
      },
      "additionalProperties": false
    },
    "approach": {
      "type": "object",
      "patternProperties": {
        "^_": {},
        "^[a-z][a-z_]*$": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "minLength": 1
            },
            "trail": {
              "type": "string",
              "minLength": 1
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "required": [
            "start",
            "trail"
          ]
        }
      },
      "additionalProperties": false
    },
    "craters": {
      "type": "object",
      "patternProperties": {
        "^_": {},
        "^[a-z][a-z_]*$": {
          "type": "object",
          "properties": {
            "radius": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3
            },
            "depth": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3
            },
            "rim": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "steep": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3
            },
            "refill": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "refillTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36000
            },
            "cracks": {
              "type": "string",
              "minLength": 1
            },
            "ejecta": {
              "type": "string",
              "minLength": 1
            },
            "embedMul": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 3
            },
            "fill": {
              "enum": [
                "water",
                "waterNearSea"
              ]
            },
            "seaCols": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            },
            "breakThrough": {
              "type": "boolean"
            },
            "rimKind": {
              "type": "string",
              "minLength": 1
            },
            "treesLean": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "glowTicks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36000
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "required": [
            "radius",
            "depth",
            "rim",
            "steep",
            "cracks",
            "ejecta"
          ]
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "patternProperties": {
        "^_": {},
        "^[a-z][a-z_]*$": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "sentAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": false,
          "required": [
            "fields",
            "sentAt"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "enabled",
    "touchBuilt",
    "surfaces",
    "skidStop",
    "craters"
  ]
}
