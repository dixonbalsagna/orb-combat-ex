+## A field's value changed once, by its type; null for an object or a container (not changed here).
+static func _bumped(x):
+	match typeof(x):
+		TYPE_FLOAT:
+			return x + 0.5
+		TYPE_INT:
+			return x + 1
+		TYPE_BOOL:
+			return not x
+		TYPE_STRING:
+			return x + "x"
+		TYPE_STRING_NAME:
+			return StringName(String(x) + "x")
+	return null
+
