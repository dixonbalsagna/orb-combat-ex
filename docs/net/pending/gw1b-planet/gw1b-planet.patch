+		if o == null:
+			return
+		var was = o.get(k)
+		var now = _bumped(was)
+		if now == null:
+			return
+		o.set(k, now)
+		out.n = int(out.n) + 1
+		if NetDesync.digest(S) != base:
+			out.moved = int(out.moved) + 1
+		else:
+			out.still.append(name)
+		o.set(k, was)
