+
+
+## Simulation's review (five findings): the rows for the three that show in play.
+func _t_review() -> void:
+	print("-- the review's findings")
+	# 1: a heavy that staggers him as he holds away never ends the brawl as "broke" while he is staggered
+	var heavies := func(S_, t):
+		var r1 := _in()
+		r1.sig = t >= 20 and t % 40 == 0   # B: the brawl's heavy (with the 9 November pad B is always the heavy), which staggers a fighter it lands on
+		return [_in(-1.0 if t >= 20 else 0.0), r1]
+	var S := _mk(_bh(2.0), {"wellClose": "own"})
+	_step(S, _in(0.0, true))
+	var a = S.fighters[0]
+	var staggered: int = 0
+	var brokeStunned: bool = false
+	var brokeOnHeavy: bool = false
+	var endWhy: String = ""
+	for t in range(400):
+		var pair: Array = heavies.call(S, t)
+		SimCore.step(S, [pair[0], pair[1]])
+		if a.stunTicks > 0:
+			staggered += 1
+		var heavyOnHim: bool = false
+		for e in S.out.fx:
+			if e.type == "damage" and int(e.victim) == 0 and (String(e.kind) == "heavy" or String(e.weight) == "heavy"):
+				heavyOnHim = true
+		for e in S.out.fx:
+			if e.type == "cue" and String(e.kind) == "brawl_end" and endWhy == "":
+				endWhy = String(e.text)
+				brokeStunned = endWhy == "broke" and a.stunTicks > 0
+				brokeOnHeavy = endWhy == "broke" and heavyOnHim
+		S.out.fx.clear()
+		S.out.feed.clear()
+		if endWhy != "":
+			break
+	ok(staggered > 0 and not brokeStunned and not brokeOnHeavy, "1: holding away against heavies (%d ticks staggered), the brawl never ends as \"broke\" on the tick a heavy lands on him, nor while he is staggered (it ended as \"%s\")" % [staggered, endWhy])
+	# 2: a shallow stick, inside the dead zone, toward an idle rival: nobody moves
+	var S2 := _mk(_bh(2.0), {"wellClose": "own"})
+	_step(S2, _in(0.0, true))
+	for t in range(15):
+		_step(S2)
+	var ax0: float = S2.fighters[0].x
+	var dx0: float = S2.fighters[1].x
+	for t in range(30):
+		_step(S2, _in(0.2), null)   # (inside the brawl: it lets go after a second without an attack, and free flight is today's)
+	var still: bool = S2.dirS.ex != null and DirBrawl.isBrawl(S2.dirS.ex) and S2.dirS.ex.branch == ""
+	ok(still and absf(SimWrap.sdx(ax0, S2.fighters[0].x)) < 0.5 and absf(SimWrap.sdx(dx0, S2.fighters[1].x)) < 0.5, "2: in the brawl, a stick inside the dead zone (0.2) toward an idle rival moves neither body (%.1f, %.1f)" % [absf(SimWrap.sdx(ax0, S2.fighters[0].x)), absf(SimWrap.sdx(dx0, S2.fighters[1].x))])
+	# 5: a lunge arrives and the brawl begins: the defender is not shoved by the arrival's carry
+	var S5 := _mk(_bh(6.0), {"wellClose": "own"})
+	var gi := _in()
+	gi.guard = true   # (his hands on the guard: the core's draw is not the arrival)
+	SimCore.step(S5, [_in(0.0, true), gi])
+	S5.out.fx.clear()
+	var d5 = S5.fighters[1]
+	var began: int = -1
+	var dAt: float = 0.0
+	var moved: float = 0.0
+	for t in range(60):
+		_step(S5, null, gi if began < 0 else _in())   # (his hands on the guard while the lunge flies; idle once the brawl begins)
+		if began < 0 and S5.dirS.ex != null and DirBrawl.isBrawl(S5.dirS.ex):
+			began = t
+			dAt = d5.x
+		elif began >= 0 and t <= began + 20:
+			moved = maxf(moved, absf(SimWrap.sdx(dAt, d5.x)))
+	ok(began >= 0 and moved < 0.5, "5: the brawl a lunge begins: the idle defender is not moved by the arrival (%.2f units over 20 ticks)" % moved)
+
+
+func _t_hash() -> void:
+	print("-- the hash")
+	var hs: Array = []
+	for run in range(2):
+		var S := _mk(_bh(9.0), {"wellClose": "own"})
+		var h: Array = []
+		for t in range(600):
+			var i0 := _in(1.0 if (t / 100) % 2 == 0 else -1.0, t % 23 == 0)
+			var i1 := _in(-1.0 if (t / 70) % 2 == 0 else 1.0, t % 31 == 0)
+			_step(S, i0, i1)
+			S.out.fx.clear()
+			if t % 60 == 59:
+				h.append(SimHash.stateHash(S).gameplay)
+		hs.append(h)
+	ok(hs[0] == hs[1], "both switches on: two runs, one hash (10 readings)")
+
+
+func _init() -> void:
+	_t_band()
+	_t_snap()
+	_t_latch()
+	_t_own()
+	_t_review()
+	_t_hash()
+	print("WELL DIR: %d check(s), %d failed" % [checks, fails])
+	quit(1 if fails > 0 else 0)
