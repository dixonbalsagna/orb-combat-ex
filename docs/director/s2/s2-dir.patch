+extends SceneTree
+## Spike S2, the gravity well, the director's half (scratch; never to land): godot --headless --path . --script res://sim/director/tools/well_dir_check.gd
+## The press's band (DirBands.pressBand) at the zones; the snap against today's lunge; the knock-backs' latch; the close fight's own-body
+## mode (Game Design's S2 rulings 3 and 4): a stick moves its own body, nobody's stick moves the other player, a body is solid, the magnet
+## only with both sticks at rest, the walk-out on the third blow ("broke"). Today's pair mode is the negative control for each own row.
+
+var fails: int = 0
+var checks: int = 0
+
+
+func ok(c: bool, what: String) -> void:
+	checks += 1
+	if not c:
+		fails += 1
+		print("FAIL  " + what)
+	else:
+		print("ok    " + what)
+
+
+## Two players, sep apart at one height in the air, still: the trial's setup (flat out 3,500, travel 1.5).
+func _mk(sep: float, more: Dictionary = {}) -> SimState:
+	var S := SimCore.createSim()
+	var su: Dictionary = {"well": true, "intro": false, "flatOut": 3500.0, "travel": 1.5, "v2": [true, true]}
+	su.merge(more, true)
+	SimCore.newMatch(S, 77, {"p1": false, "p2": false}, su)
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	a.x = 3000.0
+	b.x = SimWrap.wrap(3000.0 + sep)
+	a.y = 2500.0
+	b.y = 2500.0
+	for f in [a, b]:
+		f.vx = 0.0
+		f.vy = 0.0
+		f.face = 1.0 if f == a else -1.0
+		if f.wel != null:
+			f.wel.zone = -1
+	S.dirS.cool = 0.0
+	return S
+
+
+func _in(mx: float = 0.0, light: bool = false, heavy: bool = false) -> SimIntent:
+	var i := SimIntent.new()
+	i.mx = mx
+	i.light = light
+	i.heavy = heavy
+	return i
+
+
+func _step(S: SimState, i0 = null, i1 = null) -> void:
+	SimCore.step(S, [i0 if i0 != null else _in(), i1 if i1 != null else _in()])
+	S.out.feed.clear()
+
+
+func _bh(n: float) -> float:
+	return n * 75.0
+
+
+## The press's band at a gap: the well's answer, read straight from the distance.
+func _band(sep: float, more: Dictionary, tierA: float = 1.0, tierD: float = 1.0) -> int:
+	var S := _mk(sep, more)
+	S.fighters[0].tier = tierA
+	S.fighters[1].tier = tierD
+	return DirBands.pressBand(S, S.fighters[0], S.fighters[1])
+
+
+func _t_band() -> void:
+	print("-- the press's band")
+	ok(_band(_bh(14.0), {"well": false}) == DirBands.FAR and _band(_bh(8.0), {"well": false}) == DirBands.MID, "the well off: the band as it was (8 bh middle, 14 far)")
+	ok(_band(_bh(8.0), {}) == DirBands.MID, "tier 1: 8 bh is inside the well: the middle")
+	ok(_band(_bh(14.0), {}) == DirBands.MID, "tier 1: 14 bh is on its edge (12.5 to 15.5): the middle, where today it is the far")
+	ok(_band(_bh(17.0), {}) == DirBands.FAR, "tier 1: 17 bh is outside: the far kit")
+	ok(_band(_bh(19.0), {}, 1.0, 4.0) == DirBands.MID and _band(_bh(19.0), {}, 4.0, 1.0) == DirBands.FAR, "a tier 4 well reaches a tier 1 fighter from 19 bh; the tier 4 fighter, outside the small well, has the far kit")
+	ok(_band(_bh(2.0), {}) == DirBands.CLOSE, "the close band stays the band's own")
+
+
+## A press of X at a gap: the ticks to the engage (APPR_LEFT, the wind-up and the flight), and whether it snapped.
+func _press(sep: float, more: Dictionary, tierA: float = 1.0, full: bool = false) -> Dictionary:
+	var S := _mk(sep, more)
+	var a = S.fighters[0]
+	a.tier = tierA
+	if full:
+		a.power = 100.0
+	var cues: Array = []
+	var feed: Array = []
+	SimCore.step(S, [_in(0.0, true), _in()])
+	for e in S.out.fx:
+		if e.type == "cue":
+			cues.append(String(e.kind))
+	for l in S.out.feed:
+		feed.append(String(l.tag) + ": " + String(l.sub))
+	S.out.fx.clear()
+	S.out.feed.clear()
+	return {"S": S, "left": DirInterrupt.gi(a, DirInterrupt.APPR_LEFT), "wind": DirInterrupt.gi(a, DirInterrupt.APPR_WIND), "snap": cues.has("snap"), "feed": " ".join(feed)}
+
+
+func _t_snap() -> void:
+	print("-- the snap")
+	for bh in [6.0, 9.0, 12.0]:
+		var on: Dictionary = _press(_bh(bh), {})
+		var off: Dictionary = _press(_bh(bh), {"well": false})
+		ok(on.left == off.left and on.left > 0 and on.snap, "tier 1 from %.0f bh: the snap is today's lunge, %d ticks to the engage (today %d)" % [bh, on.left, off.left])
+	var e: Dictionary = _press(_bh(15.0), {})
