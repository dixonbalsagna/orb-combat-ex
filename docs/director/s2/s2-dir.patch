+	var o: Dictionary = _press(_bh(17.0), {})
+	ok(not o.snap and o.left == 0 and o.feed.contains("FAR KIT") and DirBands.taunting(o.S.fighters[0]), "tier 1 from 17 bh, outside: no snap, the far kit (a tap taunts), and the feed says so")
+	var t1: Dictionary = _press(_bh(12.0), {}, 1.0)
+	var t4: Dictionary = _press(_bh(12.0), {}, 4.0, true)
+	var flat4: float = SimPower.flatFor(t4.S, t4.S.fighters[0])
+	var n4: int = int(t4.left) - int(t4.wind)
+	var floorN: int = int(ceil((_bh(12.0) - eng) / _bh(3.0)))
+	ok(int(t4.left) < int(t1.left) and n4 >= floorN, "tier 4 from 12 bh flies faster (%d ticks against %d; flat out %.0f), never more than 3 bh a tick (at least %d of flight)" % [t4.left, t1.left, flat4, floorN])
+	# the defender is free and unmoved while it flies
+	var r: Dictionary = _press(_bh(9.0), {})
+	var S: SimState = r.S
+	var d = S.fighters[1]
+	var x0: float = d.x
+	var still: bool = true
+	var gi := _in()
+	gi.guard = true   # (his hands on the guard: the core's draw, which acts on a silent fighter, is not the snap's)
+	for t in range(int(r.left) - 1):
+		_step(S, null, gi)
+		still = still and d.x == x0 and d.state == "free"
+	ok(still, "the defender is free and unmoved by the snap while it flies (%d ticks)" % (int(r.left) - 1))
+
+
+func _t_latch() -> void:
+	print("-- the knock-backs' latch")
+	var S := _mk(_bh(4.0))
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	b.wel.own = 1
+	DirRecoil.knocked(S, a, b, 300.0, 1, S.tick + 20)
+	var k1: bool = b.wel.own == 0
+	b.wel.own = 1
+	DirLaunch.knockBack(S, a, b)
+	ok(k1 and b.wel.own == 0, "DirRecoil.knocked and DirLaunch.knockBack set the latch: no draw until his own next input")
+
+
+## A brawl begun by A's light from 2 bh; then each tick the sticks given. Returns the run's readings.
+func _brawl(own: bool, sticks: Callable, ticks: int, seed_more: Dictionary = {}) -> Dictionary:
+	var more: Dictionary = {"wellClose": "own" if own else "pair"}
+	more.merge(seed_more, true)
+	var S := _mk(_bh(2.0), more)
+	_step(S, _in(0.0, true))
+	var ex = S.dirS.ex
+	var r := {"S": S, "started": ex != null and DirBrawl.isBrawl(ex), "end": "", "endT": -1, "xs0": [], "xs1": [], "vx0After": 0.0}
+	for t in range(ticks):
+		var pair: Array = sticks.call(S, t)
+		SimCore.step(S, [pair[0], pair[1]])
+		for e in S.out.fx:
+			if e.type == "cue" and String(e.kind) == "brawl_end" and r.end == "":
+				r.end = String(e.text)
+				r.endT = t
+		S.out.fx.clear()
+		S.out.feed.clear()
+		r.xs0.append(S.fighters[0].x)
+		r.xs1.append(S.fighters[1].x)
+		if r.end != "" and t == r.endT + 2:
+			r.vx0After = S.fighters[0].vx
+	return r
+
+
+func _moved(xs: Array, from: int, to: int) -> float:
+	var m: float = 0.0
+	for t in range(from + 1, mini(to, xs.size())):
+		m = maxf(m, absf(SimWrap.sdx(float(xs[from]), float(xs[t]))))
+	return m
+
+
+func _t_own() -> void:
+	print("-- the close fight's own-body mode (and today's, as the control)")
+	# Walking away from an idle rival, after the first blow has played out (40 ticks)
+	var away := func(S_, t): return [_in(-1.0 if t >= 40 else 0.0), _in()]
+	var ro: Dictionary = _brawl(true, away, 200)
+	var rp: Dictionary = _brawl(false, away, 200)
+	var dMoveOwn: float = _moved(ro.xs1, 40, ro.endT if ro.endT > 0 else 200)
+	var dMovePair: float = _moved(rp.xs1, 40, rp.endT if rp.endT > 0 else 200)
+	ok(ro.started and dMoveOwn < 0.5, "own: holding away from an idle rival, the rival is not moved (%.1f units)" % dMoveOwn)
+	ok(rp.started and dMovePair > 5.0, "control, today's pair: the rival is dragged (%.1f units)" % dMovePair)
+	var gOpen: float = absf(SimWrap.sdx(float(ro.xs0[ro.endT]), float(ro.xs1[ro.endT]))) - absf(SimWrap.sdx(float(ro.xs0[40]), float(ro.xs1[40]))) if ro.endT > 40 else 0.0
+	ok((ro.end == "apart" or ro.end == "idle") and gOpen > 10.0 and absf(ro.vx0After) > 10.0, "own: the gap opens as he walks (%.0f units); the brawl lets go as \"%s\" at tick %d (a second without an attack, or 4.5 bh) and he walks on (%.0f a second)" % [gOpen, ro.end, ro.endT, ro.vx0After])
+	# Walking into an idle rival: he stops against him, who is not moved
+	var into := func(S_, t): return [_in(1.0 if t >= 40 else 0.0), _in()]
+	var ri: Dictionary = _brawl(true, into, 120)
+	var rip: Dictionary = _brawl(false, into, 120)
+	var iEnd: int = ri.endT if ri.endT > 40 else 120   # (inside the brawl: once it lets go, free flight is today's)
+	var dInto: float = _moved(ri.xs1, 40, iEnd)
+	var gapEnd: float = absf(SimWrap.sdx(float(ri.xs0[iEnd - 1]), float(ri.xs1[iEnd - 1])))
+	ok(dInto < 0.5 and gapEnd >= float(DirData.contact().minSeparation) - 0.5, "own: walking into an idle rival, he stops against him (gap %.0f) and the rival is not moved (%.1f)" % [gapEnd, dInto])
+	var pEnd: int = rip.endT if rip.endT > 40 else 120
+	ok(_moved(rip.xs1, 40, pEnd) > 5.0, "control, today's pair: the pair slides (%.1f)" % _moved(rip.xs1, 40, pEnd))
+	# A stick pushed from rest moves his own body that way within 2 ticks
+	var S := _mk(_bh(2.0), {"wellClose": "own"})
+	_step(S, _in(0.0, true))
+	for t in range(40):
+		_step(S)
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	var x0: float = a.x
+	var bx0: float = b.x
+	var first: int = -1
+	for t in range(6):
+		_step(S, _in(0.0, false), _in(1.0))   # (the rival pushes toward him, then away: only the rival's own body moves)
+		if first < 0 and absf(SimWrap.sdx(bx0, b.x)) > 0.01:
+			first = t + 1
+	ok(first >= 1 and first <= 2 and absf(SimWrap.sdx(x0, a.x)) < 0.5, "own: a stick pushed from rest moves his own body within %d tick(s); the other is not moved (%.2f)" % [first, absf(SimWrap.sdx(x0, a.x))])
+	# Walking away from a rival throwing lights: he breaks clear on the third blow that reaches him
+	var lights := func(S_, t): return [_in(-1.0 if t >= 20 else 0.0), _in(0.0, t >= 20 and t % 15 == 0)]
+	var rl: Dictionary = _brawl(true, lights, 400)
+	ok(rl.end == "broke" and rl.endT > 20 and rl.endT - 20 < 120, "own: holding away from a rival throwing lights, he breaks clear as \"%s\" %d ticks after he turned away" % [rl.end, rl.endT - 20])
+	var rlp: Dictionary = _brawl(false, lights, 400)
