+## Own bodies: the stick that moves f's own body in a brawl. A player's, as he holds it; staggered, the way he leans at nudge.stagger. The
+## computer's is its nudge, which was written to steer the pair: toward its rival it follows, and where it pushed away it holds still (a
+## retune is Encounter's, after the trial).
+static func _ownStick(ex, f) -> PackedFloat64Array:
+	var o = ex.D if f == ex.A else ex.A
+	var ux: float = 0.0
+	var uy: float = 0.0
+	if f.stunTicks <= 0:
+		var st: PackedFloat64Array = stick(ex, f)
+		ux = st[0]
+		uy = st[1]
+		if f.ai != null and ux * SimWrap.sdx(f.x, o.x) + uy * (o.y - f.y) < 0.0:
+			ux = 0.0
+			uy = 0.0
+	elif f.ai == null:
+		ux = f.heldMx * float(cfg().nudge.stagger)
+		uy = f.heldMy * float(cfg().nudge.stagger)
+	var ul: float = SimDetMath.hypot(ux, uy)
+	if ul <= SimAct.awayDead:
+		return PackedFloat64Array([0.0, 0.0])   # one threshold: a stick inside the dead zone neither walks him nor pushes (pushesIn, _atRest)
+	if ul > 1.0:
+		ux /= ul
+		uy /= ul
+	return PackedFloat64Array([ux, uy])
+
+
+## Own bodies: f's stick is at rest (the magnet works only while both are).
+static func _atRest(ex, f) -> bool:
+	var st: PackedFloat64Array = _ownStick(ex, f)
+	return SimDetMath.hypot(st[0], st[1]) <= SimAct.awayDead
+
+
+## Own bodies: f's own stick pushes into o (a solid body stops him, and only him: DirMelee.contactTick).
+static func pushesIn(ex, f, o) -> bool:
+	var st: PackedFloat64Array = _ownStick(ex, f)
+	var lx: float = SimWrap.sdx(f.x, o.x)
+	var ly: float = o.y - f.y
+	var ll: float = SimDetMath.hypot(lx, ly)
+	if ll <= 0.0:
+		return false
+	if st[0] * lx + st[1] * ly > 0.0:
+		return true   # his stick, past the dead zone, has a part toward him
+	return float(_g(f, PMOVE_X)) * lx + float(_g(f, PMOVE_Y)) * ly > 0.0   # or his own last step closed on him: the arrival's carry that brought him in
+
+
+## Own bodies: f holds his stick away from o, read as held (a heavy's stagger zeroes the gated stick, not this). The computer: only when
+## it has chosen to walk out.
+static func _heldAway(ex, f, o) -> bool:
+	if f.ai != null:
+		return _g(f, AI_PART) > 0
+	if SimDetMath.hypot(f.heldMx, f.heldMy) <= SimAct.awayDead:
+		return false
+	return SimAim.angle_off_away_deg(f.heldMx, f.heldMy, 1 if SimWrap.sdx(o.x, f.x) >= 0.0 else -1) <= int(cfg().partDeg)
+
+
+## Own bodies (Game Design's S2 ruling 3): a blow reached o, landed or guarded. Held away, it counts (a stun or a grab he was already in
+## does not). The break is the tick's (_brokeTick): never on the tick of a blow that staggers, holds or sends him. Always false.
+static func _broke(S: SimState, ex, o) -> bool:
+	if o.wel == null:
+		return false
+	var f = ex.A if o == ex.D else ex.D
+	if o.stunTicks > 0 or DirGrapple.holds(o) or not _heldAway(ex, o, f):
+		return false
+	o.wel.lv += 1
+	return false   # (counted at contact; the break itself is read in the tick, after the blow's stagger or send has been applied)
+
+
+## Own bodies: the walk-out's break, once a brawl tick. On the leaveAfterBlows-th blow that reached him holding away he breaks clear, as
+## "broke", only while he is free of a stun or a stagger, not held in a grab, still in the brawl (not sent) and still holding away.
+static func _brokeTick(S: SimState, ex, f, o) -> bool:
+	if f.wel == null or f.wel.lv < int(SimWell.cfg().close.leaveAfterBlows):
+		return false
+	if f.stunTicks > 0 or DirGrapple.holds(f) or f.state != "locked" or not _heldAway(ex, f, o):
+		return false
+	end(S, ex, "broke")
+	return true
+
+
+## Own bodies, once a brawl tick in place of _move: each fighter's stick moves his own body at close.ownMul of his flight (as the pair's
+## nudge did), ramped over close.rampTicks; his part of the speed the brawl began with fades over carryTicks. Kept per body: the live
+## gate (no stick during a zip's ticks in reach, a double hit or a grab), a step in carrying him (his stick waits), the guard's and the
+## stagger's factors, the step's cap, a building's face and a slope, each at his own place. Inside the give leash the giver's stick moves
+## him by _giveStep; past it he walks at his own pace. Every own movement is counted on a winder's gap, or heavies land from too far.
+static func _moveOwn(S: SimState, ex) -> void:
+	var c: Dictionary = cfg()
+	var wc: Dictionary = SimWell.cfg().close
+	var A = ex.A
+	var D = ex.D
+	var dt: float = SimConst.DT
+	var live: bool = not quiet(ex) and _g(A, DBL_AT) == 0 and not DirGrapple.holds(A) and not DirGrapple.holds(D)
+	var gv = _giver(S, ex)
+	var d0: float = DirBands.dist(A, D)
+	var leash: float = float(DirData.contact().offset) + float(c.give.leashBh) * DirInterrupt.BH
+	var cap: float = float(c.maxStepBh) * DirInterrupt.BH / dt
+	var nx := PackedFloat64Array([A.x, D.x])
+	var ny := PackedFloat64Array([A.y, D.y])
+	for k in range(2):
+		var f = A if k == 0 else D
+		var st: PackedFloat64Array = _ownStick(ex, f) if live else PackedFloat64Array([0.0, 0.0])
+		var ux: float = st[0]
+		var uy: float = st[1]
+		if gv == f and _alone(ex, f) and d0 < leash - 0.01:
+			ux = 0.0   # inside the give leash his stick moves him by _giveStep
+			uy = 0.0
+		var tgt: float = float(wc.ownMul) * _flySpeed(S, f)
+		if f.stance == 1.0 and _g(f, LINE) == 0:
+			tgt *= float(c.nudge.guard)   # he guards
+		var acc: float = float(wc.ownMul) * _flySpeed(S, f) / maxf(1.0, float(int(wc.rampTicks)))
+		var vx: float = float(f.wel.ovx) / 16.0
+		var vy: float = float(f.wel.ovy) / 16.0
+		vx += clampf(ux * tgt - vx, -acc, acc)
+		vy += clampf(uy * tgt - vy, -acc, acc)
+		if f.rush != null:
+			vx = 0.0   # a step in carries him: his stick waits for his arrival, the other keeps his
+			vy = 0.0
+		f.wel.ovx = int(round(vx * 16.0))
+		f.wel.ovy = int(round(vy * 16.0))
+		var wx: float = vx
+		var wy: float = vy
+		var cn: int = _g(f, CARRY_N)
+		if cn > 0:
+			var share: float = float(cn) / maxf(1.0, float(int(c.carryTicks)))
+			wx += float(_g(f, CARRY_X)) / 16.0 * share
+			wy += float(_g(f, CARRY_Y)) / 16.0 * share
+			_s(f, CARRY_N, cn - 1)
+		if f.rush != null:
