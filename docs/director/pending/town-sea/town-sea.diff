diff --git a/sim/director/visit.gd b/sim/director/visit.gd
index 38cc0d0..2f683d2 100644
--- a/sim/director/visit.gd
+++ b/sim/director/visit.gd
@@ -6,15 +6,93 @@ extends RefCounted
 
 const V_SENDS: int = 0   # sends into a building in the town the fight is in
 const V_SENT: int = 1    # the live tick of the last, plus 1
-const V_N: int = 2
+const V_SEA: int = 2     # the live tick the fight's dull stretch at sea began, plus 1
+const V_COAST: int = 3   # the way to land within drift's reach, 1 or -1 plus 2, read now and then; 0 none
+const V_N: int = 4
 
 static var _force: int = -1   # tools: -1 the data's switch, 0 off, 1 on
+static var _seaForce: int = -1
 
 
 static func setForce(v: int) -> void:
 	_force = v
 
 
+static func setSeaForce(v: int) -> void:
+	_seaForce = v
+
+
+static func seaCfg() -> Dictionary:
+	return DirLaunch.data().get("town", {}).get("sea", {})
+
+
+static func seaOn() -> bool:
+	return bool(seaCfg().get("enabled", false)) if _seaForce < 0 else _seaForce == 1
+
+
+static func _isLand(x: float) -> bool:
+	return WorldBiomes.biomeAt(x) != "ocean"
+
+
+## Once a live tick: how long the fight has been dull at sea. A body in the water or sent resets it: a sea fight that's being a sea
+## fight isn't pulled away.
+static func seaTick(S: SimState) -> void:
+	if not seaOn():
+		return
+	var at: int = _g(S, V_SEA)
+	var dull: bool = true
+	for f in S.fighters:
+		if _isLand(f.x) or f.state == "launched" or f.wet or f.y < WorldWater.surfaceAt(S, f.x):
+			dull = false
+			break
+	if not dull:
+		if at != 0:
+			_s(S, V_SEA, 0)
+			_s(S, V_COAST, 0)
+		return
+	var now: int = DirBrawl._now(S)
+	if at == 0:
+		_s(S, V_SEA, now + 1)
+		return
+	if now % int(seaCfg().coastEvery) == 0:
+		_s(S, V_COAST, _coast(S.fighters[0].x, float(seaCfg().driftReach), float(seaCfg().coastStep)))
+
+
+## The way to the nearest land within reach, plus 2; 0 for none.
+static func _coast(x: float, reach: float, step: float) -> int:
+	var d: float = step
+	while d <= reach:
+		if _isLand(SimWrap.wrap(x + d)):
+			return 3
+		if _isLand(SimWrap.wrap(x - d)):
+			return 1
+		d += step
+	return 0
+
+
+static func seaSecs(S: SimState) -> float:
+	var at: int = _g(S, V_SEA)
+	return float(DirBrawl._now(S) - (at - 1)) / DirData.TICKS_PER_SEC if at > 0 else 0.0
+
+
+## A landing on land or at a built place, from a dull stretch at sea: lever 1. 0 otherwise.
+static func seaBonus(S: SimState, x: float) -> float:
+	if not seaOn() or seaSecs(S) < float(seaCfg().after):
+		return 0.0
+	return float(seaCfg().bonus) if _isLand(x) else 0.0
+
+
+## The brawl's drift toward land in sight: lever 2. Slow, and any held stick cancels it that tick. 0 otherwise.
+static func drift(S: SimState, ex) -> float:
+	if not seaOn() or seaSecs(S) < float(seaCfg().driftAfter) or _g(S, V_COAST) == 0:
+		return 0.0
+	for f in [ex.A, ex.D]:
+		var st: PackedFloat64Array = DirBrawl.stick(ex, f)
+		if st[0] != 0.0 or st[1] != 0.0:
+			return 0.0
+	return float(_g(S, V_COAST) - 2) * float(seaCfg().driftSpeed)
+
+
 static func cfg() -> Dictionary:
 	return DirLaunch.data().get("town", {}).get("visit", {})
 
