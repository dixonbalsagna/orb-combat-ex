diff --git a/sim/director/tools/beam_front_check.gd b/sim/director/tools/beam_front_check.gd
index 61c7868..7df9132 100644
--- a/sim/director/tools/beam_front_check.gd
+++ b/sim/director/tools/beam_front_check.gd
@@ -272,6 +272,9 @@ func _standoff() -> void:
 		SimCore.dispose(S)
 	cfg["stationary"] = true
 	_release()
+	_holdMoves()
+	_kite()
