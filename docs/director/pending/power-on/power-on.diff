diff --git a/sim/director/tools/launch_hold_check.gd b/sim/director/tools/launch_hold_check.gd
new file mode 100644
index 0000000..be240ae
--- /dev/null
+++ b/sim/director/tools/launch_hold_check.gd
@@ -0,0 +1,61 @@
+extends SceneTree
+## The held moment on a launch, by share (Game Design, slam-and-pace.md section 2; docs/director/pending/launch-hold/):
+##   godot --headless --path . --script res://sim/director/tools/launch_hold_check.gd
+## - readable on: a lit launcher's send holds heldTicks[0] (14), a full send's heldTicks[1] (18), a share between them in proportion, and a
+##   share under the launcher's holds the least
+## - with heldUncut, the freeze budget never cuts it, even with hit-stop by weight on and the budget over
+## - a set piece keeps its decisive stop
+## - readable off (or no block): as before; with hit-stop by weight off, a send holds nothing
+## Reads SimPower.readable() (Simulation's). Ends on the verdict line.
+
+var failed: int = 0
+
+
+func _init() -> void:
+	var rf := Callable(SimPower, "readable")
+	if not rf.is_valid():
+		print("FAIL  SimPower.readable() is missing (Simulation's grant)")
+		print("LAUNCH HOLD: 1 check(s) failed")
+		quit(1)
+		return
+	var rd: Dictionary = rf.call()
+	var on0: bool = bool(rd.get("enabled", false))
+	rd["enabled"] = true
+	var lit: int = _held("launcher", false, false)
+	var full: int = _held("fullB", false, false)
+	var mid: int = _held("chainLink", false, false)
+	var tap: int = _held("tap", false, false)
+	var cut: int = _held("launcher", true, true)
+	rd["enabled"] = false
+	var off: int = _held("launcher", false, false)
+	var offFull: int = _held("fullB", false, false)
+	rd["enabled"] = on0
+	print("      held ticks: lit launcher %d, full send %d, chain link %d, tap %d, budget over %d; off %d / %d" % [lit, full, mid, tap, cut, off, offFull])
+	_expect(lit == 14 and full == 18, "on: a lit launcher holds 14, a full send 18")
+	_expect(mid == 14 and tap == 14, "on: a share at or under the launcher's holds the least (14)")
+	_expect(cut == 14, "on: with the freeze budget over and hit-stop by weight on, it isn't cut (14)")
+	_expect(off == 0 and offFull == 0, "off: as before (hit-stop by weight off, a send holds nothing)")
+	print("LAUNCH HOLD: %d check(s) failed" % failed)
+	quit(1 if failed > 0 else 0)
+
+
+func _expect(ok: bool, what: String) -> void:
+	print(("ok    " if ok else "FAIL  ") + what)
+	if not ok:
+		failed += 1
+
+
+## The ticks a send of this share holds. hitstop: hit-stop by weight on; over: its freeze budget over.
+func _held(key: String, hitstop: bool, over: bool) -> int:
+	var S := SimCore.createSim()
+	SimCore.newMatch(S, 3, {"p1": true, "p2": true}, {"intro": false})
+	S.dirS.stop = 0.0
+	S.hitstopOn = hitstop
+	if over:
+		SimHitstop.setup(S)
+		for _k in range(400):
+			SimHitstop.frozen(S)   # a long run of frozen ticks: the budget is over
+	DirMelee.holdSend(S, false, 1.0, key)
+	var n: int = int(round(S.dirS.stop / SimConst.DT))
+	SimCore.dispose(S)
+	return n
