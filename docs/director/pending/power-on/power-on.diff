+## The readable budget's held moment, when Simulation's block is there and on. True when it held.
+static func _heldByShare(S: SimState, key: String) -> bool:
+	var rf := Callable(SimPower, "readable")
+	if not rf.is_valid():
+		return false
+	var rd = rf.call()
+	if not (rd is Dictionary) or not bool(rd.get("enabled", false)):
+		return false
+	var ht: Array = rd.get("heldTicks", [14, 18])
+	var lo: float = SimPower.share("launcher")
+	var hi: float = SimPower.share("fullB")
+	var s: float = SimPower.share(key) if key != "" else lo
+	var t: float = clampf((s - lo) / maxf(0.001, hi - lo), 0.0, 1.0)
+	var n: int = int(SimMathx.jround(float(ht[0]) + (float(ht[1]) - float(ht[0])) * t))
+	if bool(rd.get("heldUncut", true)) or not S.hitstopOn:
+		SimClock.hold(S, float(n) * SimConst.DT)   # the eye catches the start, and the camera gets its head start: never cut
+	else:
+		SimClock.hold(S, float(SimHitstop.ticks(S, "launch") if n <= 0 else n) * SimConst.DT)
+	return true
+
