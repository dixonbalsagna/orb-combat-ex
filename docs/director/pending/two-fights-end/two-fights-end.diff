 		if key == 0:
 			continue
 		var D = SimCross.body(S, "p" + str(key))
-		if D == null or A.state != "free" or D.state == "launched":
-			_s(A, O_KEY, 0)
+		if D == null or A.state != "free" or D.state == "launched" or S.fighters.has(D):
