@@ -9,10 +9,12 @@ var failed: int = 0
 
 
 func _init() -> void:
+	WorldPlan.everywhereOverride = 0   # (the field world as main shipped it: World's plans.everywhere, on in the 9 November data, lays every place and moves the street this check stages)
