 func _bb_pb_step() -> bool:
+	if _bb_pb_t == 0:
+		seed = int(_bb_pb.get("seed", 0)) & 0xFFFFFFFF
+		SimCore.newMatch(S, seed, _bb_pb.get("ai", {}), _bb_pb.get("setup", {}))   # scratch: the recorded match exactly as SimReplay.play starts it, with no hub setup merged in
+		_started(_bb_pb.get("setup", {}), false)
+		for k in range(S.fighters.size()):
+			var want_ai: bool = bool(_bb_pb.get("ai", {}).get("p%d" % (k + 1), true))
+			if (S.fighters[k].ai != null) != want_ai:
+				SimCore.toggleAI(S, k)
 	while _bb_pb_ti < _bb_pb.toggles.size() and int(_bb_pb.toggles[_bb_pb_ti][0]) == _bb_pb_t:
 		SimCore.toggleAI(S, int(_bb_pb.toggles[_bb_pb_ti][1]))
 		_bb_pb_ti += 1
