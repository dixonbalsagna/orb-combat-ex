 			if DirBeamPlay.stationary() and (f.state == "launched" or f.state == "down" or f.state == "dropped" or f.stunTicks > 0):
 				_holdLost(S, f)   # something took him
 				continue
 			if i.rsRelease or not i.rsHeld:
