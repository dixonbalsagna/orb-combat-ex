diff --git a/sim/director/tools/arc_size_check.gd b/sim/director/tools/arc_size_check.gd
new file mode 100644
index 0000000..36da2ee
--- /dev/null
+++ b/sim/director/tools/arc_size_check.gd
@@ -0,0 +1,70 @@
+extends SceneTree
+## arcBySize (Game Design, docs/design/planet-sizes.md section 2): godot --headless --path . --script res://sim/director/tools/arc_size_check.gd
+## The meteor and the high arc flown on each of the five sizes (planet 7, touch 1): on tiny and small the rise is at most 1.0 x the radius and the
+## sideways distance at most a quarter of the lap; on medium, big and huge the curve is absolute (medium's numbers, today's at medium); a ring
+## smaller than its planet still scales it. Negative control: arcBySize taken out, tiny flies the absolute curve past both caps.
+
+var fails: int = 0
+var checks: int = 0
+
+
+func ok(c: bool, what: String) -> void:
+	checks += 1
+	if not c:
+		fails += 1
+		print("FAIL  " + what)
+	else:
+		print("ok    " + what)
+
+
+## One curve flown to its end: the peak over the start's ground, the sideways distance, the ticks.
+func _fly(size: String, row: int, arena: int = 0) -> Dictionary:
+	var S := SimCore.createSim()
+	var su: Dictionary = {"intro": false, "planet": 7, "touch": 1, "planetGen": 3, "planetSize": size}
+	if arena > 0:
+		su["arena"] = {"cols": arena}
+	SimCore.newMatch(S, 11, {"p1": false, "p2": false}, su)
+	var f = S.fighters[0]
+	var o = S.fighters[1]
+	var x0: float = o.x
+	var g0: float = maxf(WorldTerrain.groundY(S, o.x), WorldWater.surfaceAt(S, o.x))
+	DirArc.send(S, f, o, row, 1.0)
+	var top: float = o.y
+	var n: int = 0
+	var far: float = 0.0
+	while DirArc._g(o, DirArc.A_ROW) != 0 and n < 2000:
+		SimCore.step(S)
+		S.out.fx.clear()
+		S.out.feed.clear()
+		top = maxf(top, o.y)
+		far = maxf(far, absf(SimWrap.sdx(x0, o.x)))
+		n += 1
+	return {"peak": top - g0, "side": far, "R": SimField.R, "lap": float(SimConst.PLANET_NC) * SimConst.COL, "dist": DirArc._dist(DirArc._row(row)), "rise": DirArc._rise(DirArc._row(row)), "ticks": n}
+
+
+func _init() -> void:
+	DirArc.setForce(1)
+	var hM: Array = [16400.0, 9900.0]
+	var dM: Array = [25436.0, 15355.0]
+	var c: Dictionary = SimPower.arcBySize()
+	ok(not c.is_empty() and c.sizes.has("tiny") and c.sizes.has("small"), "power.json arcBySize names tiny and small (%s)" % str(c))
+	for size in ["tiny", "small", "medium", "big", "huge"]:
+		for row in [0, 1]:
+			var r: Dictionary = _fly(size, row)
+			var name: String = ["meteor", "high arc"][row]
+			print("  %s %s: peak %.0f (rise %.0f, radius %.0f), sideways %.0f (dist %.0f, lap %.0f, %.3f of it), %d ticks" % [size, name, r.peak, r.rise, r.R, r.side, r.dist, r.lap, r.side / r.lap, r.ticks])
+			if size == "tiny" or size == "small":
+				ok(r.rise <= r.R + 1e-6 and r.dist <= 0.25 * r.lap + 1e-6, "%s %s: the rise at most the radius, the sideways distance at most a quarter of the lap" % [size, name])
+				ok(r.side <= 0.25 * r.lap + 60.0, "%s %s: flown, it lands within a quarter of the lap (%.3f)" % [size, name, r.side / r.lap])
+			else:
+				ok(absf(r.dist - dM[row]) < 1e-6 and absf(r.rise - hM[row]) < 1e-6, "%s %s: absolute, medium's curve (%.0f across, %.0f up)" % [size, name, r.dist, r.rise])
+	var rr: Dictionary = _fly("medium", 0, 2400)
+	ok(absf(rr.dist - dM[0] * 0.5) < 1e-6, "a ring of half its planet still scales the curve by half, so the angle round holds (%.0f)" % rr.dist)
+	# negative control: without arcBySize tiny flies the absolute curve, past both caps
+	var keep = SimPower._d.get("arcBySize")
+	SimPower._d.erase("arcBySize")
+	var nr: Dictionary = _fly("tiny", 0)
+	SimPower._d["arcBySize"] = keep
+	ok(nr.rise > nr.R and nr.dist > 0.25 * nr.lap, "negative control: arcBySize out, tiny's meteor rises %.0f over a radius of %.0f and goes %.3f of the lap" % [nr.rise, nr.R, nr.dist / nr.lap])
+	print("ARC SIZES: %d check(s), %d failed" % [checks, fails])
+	quit(1 if fails > 0 else 0)
