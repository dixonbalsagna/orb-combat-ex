--- a/tools/schemas/map.json
+++ b/tools/schemas/map.json
@@ -739,6 +739,10 @@
       "match": "data/fight/kick.json",
       "schema": "fight-kick.schema.json"
     },
+    {
+      "match": "data/fight/well.json",
+      "schema": "fight-well.schema.json"
+    },
     {
       "match": "data/fight/power.json",
       "schema": "fight-power.schema.json"
