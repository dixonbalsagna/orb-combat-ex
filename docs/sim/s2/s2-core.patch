diff --git a/data/fight/well.json b/data/fight/well.json
new file mode 100644
index 0000000..1ea35f6
--- /dev/null
+++ b/data/fight/well.json
@@ -0,0 +1,59 @@
+{
+  "schema": "fight.well/1",
+  "enabled": false,
+  "_enabled": "the gravity well (spike S2, docs/ep/proposals/gravity-well-trial-design.html; Game Design's rulings at the end of docs/design/gravity-well-reading.md): a setup's \"well\" overrides it for a match. Off, nothing runs and nothing is hashed",
+  "size": {
+    "baseBh": 12.5,
+    "_baseBh": "a tier 1 well's radius in body heights (75 units): today's middle band's edge (bands.midBh)",
+    "tierStep": 0.2,
+    "_tierStep": "each tier past the first adds this share: 12.5, 15, 17.5, 20",
+    "chargeGrow": 0.25,
+    "_chargeGrow": "a fighter powering up or gathering a beam swells by this share at full charge. Game Design's ruling 5: 0.25 for the trial, 0 the lever",
+    "chargeRiseTicks": 30,
+    "chargeFallTicks": 15,
+    "minBh": 4.5,
+    "maxBh": 20,
+    "_maxBh": "the cap (today's BOOST_NEAR, 1,500 units); 4.5 is the brawl's breakBh"
+  },
+  "zones": {
+    "edgeBh": 3,
+    "_edgeBh": "the band past a well where a tap still snaps in: no cliff",
+    "hysteresisBh": 0.5,
+    "either": false,
+    "_either": "the second reading of Orb's 13 November answer: either of you inside the other's well and you both fight close"
+  },
+  "draw": {
+    "mode": "rest",
+    "_mode": "\"off\"; \"rest\" (Game Design's ruling 2, the default: only in silence, never after a knock-back until the fighter's own next input); \"capped\" (the comparison arm: always, halved on a fighter holding away)",
+    "cap": 0.25,
+    "_cap": "the most it moves a fighter, as a share of his plain flying speed",
+    "fullAt": 0.5,
+    "_fullAt": "nothing at the well's edge, full by this share of its radius",
+    "quietTicks": 12,
+    "_quietTicks": "\"rest\": it fades in over this many ticks of silence",
+    "stopBh": 2.5,
+    "stopEaseBh": 1,
+    "_stopBh": "it eases out over the last stopEaseBh before stopBh (where an approach ends) and never pushes into the rival",
+    "awayDead": 0.3,
+    "awayShare": 0.5,
+    "_awayDead": "\"capped\": a stick held beyond awayDead whose part away from the rival is at least awayShare of it is holding away (60 degrees)"
+  },
+  "snap": {
+    "enabled": true,
+    "floorSpeed": 4000,
+    "_floorSpeed": "Game Design's ruling 1: the snap flies at the faster of today's lunge (4,000) and flat out for the level",
+    "maxStepBh": 3,
+    "_maxStepBh": "never more than 3 body heights a tick (the creative rulebook's m02)",
+    "outrun": false,
+    "graceTicks": 6
+  },
+  "close": {
+    "mode": "pair",
+    "_mode": "\"pair\" (today: the sticks move the fight) or \"own\" (each stick moves its own fighter; a body is solid). A setup's \"wellClose\" overrides it, with or without the well",
+    "ownMul": 0.4,
+    "rampTicks": 8,
+    "leaveAfterBlows": 3,
+    "_leaveAfterBlows": "Game Design's ruling 3: a fighter holding away breaks clear on the third blow that reaches him, landed or guarded; a stun pauses the count, letting go of away resets it",
+    "magnetAtRestOnly": true
+  }
+}
