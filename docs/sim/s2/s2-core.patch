new file mode 100644
index 0000000..6e7b499
--- /dev/null
+++ b/tools/schemas/fight-well.schema.json
@@ -0,0 +1,82 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "meridian/fight-well",
+  "title": "fight-well (schema \"fight.well/1\")",
+  "description": "data/fight/well.json: the switch and numbers of the gravity well (spike S2, docs/ep/proposals/gravity-well-trial-design.html section 10). Policy: closed; a key starting with _ is a comment.",
+  "type": "object",
+  "required": ["schema", "enabled", "size", "zones", "draw", "snap", "close"],
+  "properties": {
+    "schema": { "const": "fight.well/1" },
+    "enabled": { "type": "boolean" },
+    "size": {
+      "type": "object",
+      "required": ["baseBh", "tierStep", "chargeGrow", "chargeRiseTicks", "chargeFallTicks", "minBh", "maxBh"],
+      "properties": {
+        "baseBh": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
+        "tierStep": { "type": "number", "minimum": 0, "maximum": 2 },
+        "chargeGrow": { "type": "number", "minimum": 0, "maximum": 2 },
+        "chargeRiseTicks": { "type": "integer", "minimum": 1, "maximum": 600 },
+        "chargeFallTicks": { "type": "integer", "minimum": 1, "maximum": 600 },
+        "minBh": { "type": "number", "minimum": 0, "maximum": 100 },
+        "maxBh": { "type": "number", "minimum": 0, "maximum": 100 }
+      },
+      "additionalProperties": false,
+      "patternProperties": { "^_": true }
+    },
+    "zones": {
+      "type": "object",
+      "required": ["edgeBh", "hysteresisBh", "either"],
+      "properties": {
+        "edgeBh": { "type": "number", "minimum": 0, "maximum": 50 },
+        "hysteresisBh": { "type": "number", "minimum": 0, "maximum": 10 },
+        "either": { "type": "boolean" }
+      },
+      "additionalProperties": false,
+      "patternProperties": { "^_": true }
+    },
+    "draw": {
+      "type": "object",
+      "required": ["mode", "cap", "fullAt", "quietTicks", "stopBh", "stopEaseBh", "awayDead", "awayShare"],
+      "properties": {
+        "mode": { "enum": ["off", "rest", "capped"] },
+        "cap": { "type": "number", "minimum": 0, "maximum": 1 },
+        "fullAt": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
+        "quietTicks": { "type": "integer", "minimum": 1, "maximum": 600 },
+        "stopBh": { "type": "number", "minimum": 0, "maximum": 50 },
+        "stopEaseBh": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
+        "awayDead": { "type": "number", "minimum": 0, "maximum": 1 },
+        "awayShare": { "type": "number", "minimum": 0, "maximum": 1 }
+      },
+      "additionalProperties": false,
+      "patternProperties": { "^_": true }
+    },
+    "snap": {
+      "type": "object",
+      "required": ["enabled", "floorSpeed", "maxStepBh", "outrun", "graceTicks"],
+      "properties": {
+        "enabled": { "type": "boolean" },
+        "floorSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
+        "maxStepBh": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
+        "outrun": { "type": "boolean" },
+        "graceTicks": { "type": "integer", "minimum": 0, "maximum": 120 }
+      },
+      "additionalProperties": false,
+      "patternProperties": { "^_": true }
+    },
+    "close": {
+      "type": "object",
+      "required": ["mode", "ownMul", "rampTicks", "leaveAfterBlows", "magnetAtRestOnly"],
+      "properties": {
+        "mode": { "enum": ["pair", "own"] },
+        "ownMul": { "type": "number", "minimum": 0, "maximum": 2 },
+        "rampTicks": { "type": "integer", "minimum": 1, "maximum": 120 },
+        "leaveAfterBlows": { "type": "integer", "minimum": 1, "maximum": 20 },
+        "magnetAtRestOnly": { "type": "boolean" }
+      },
+      "additionalProperties": false,
+      "patternProperties": { "^_": true }
+    }
+  },
+  "additionalProperties": false,
+  "patternProperties": { "^_": true }
+}
