diff --git a/sim/core/tools/well_check.gd b/sim/core/tools/well_check.gd
new file mode 100644
index 0000000..0e21551
--- /dev/null
+++ b/sim/core/tools/well_check.gd
@@ -0,0 +1,268 @@
+extends SceneTree
+## The gravity well's core (spike S2, sim/core/well.gd): godot --headless --path . --script res://sim/core/tools/well_check.gd
+## The data and its sizes, the snap's speed by tier, the switch (off is the same as no word of it; on, the state is hashed and
+## the data is in the replay's key), the zones and their hysteresis, the draw in silence (its cap, its stop, the stick and the
+## hands ending it on the tick, the knock-back latch), Game Design's capped arm, and two runs and a rollback with it on.
+
+var fails: int = 0
+
+
+func ok(c: bool, what: String) -> void:
+	if not c:
+		fails += 1
+		print("FAIL  " + what)
+
+
+## Two human fighters, sep apart at one height, still, the well on, the trial's setup.
+func _mk(sep: float, more: Dictionary = {}) -> SimState:
+	var S := SimCore.createSim()
+	var su: Dictionary = {"well": true, "intro": false, "flatOut": 3500.0}
+	su.merge(more, true)
+	SimCore.newMatch(S, 77, {"p1": false, "p2": false}, su)
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	a.x = 3000.0
+	b.x = SimWrap.wrap(3000.0 + sep)
+	a.y = 2500.0
+	b.y = 2500.0
+	for f in [a, b]:
+		f.vx = 0.0
+		f.vy = 0.0
+	return S
+
+
+func _gap(S: SimState) -> float:
+	return absf(SimWrap.sdx(S.fighters[0].x, S.fighters[1].x))
+
+
+## One tick with these sticks (null: hands off).
+func _step(S: SimState, mx0: float = 0.0, mx1: float = 0.0, guard0: bool = false) -> void:
+	var i0 := SimIntent.new()
+	i0.mx = mx0
+	i0.guard = guard0
+	var i1 := SimIntent.new()
+	i1.mx = mx1
+	SimCore.step(S, [i0, i1])
+	S.out.fx.clear()
+	S.out.feed.clear()
+
+
+func _data() -> void:
+	ok(SimWell.errors().is_empty(), "well.json loads: " + str(SimWell.errors()))
+	ok(not SimWell.enabled() and SimWell.closeMode() == "pair", "the switch is off and the close fight is today's in data")
+	var S := _mk(900.0)
+	var a = S.fighters[0]
+	var want: Array = [937.5, 1125.0, 1312.5, 1500.0]
+	for t in range(4):
+		a.tier = float(t + 1)
+		ok(absf(SimWell.radius(a) - want[t]) < 1.0e-6, "tier %d's well: %.1f against %.1f" % [t + 1, SimWell.radius(a), want[t]])
+	a.tier = 1.0
+	a.wel.chg = 30
+	ok(absf(SimWell.radius(a) - 1171.875) < 1.0e-6, "a full charge at tier 1: 15.6 bh (%.1f)" % SimWell.radius(a))
+	a.tier = 3.0
+	ok(SimWell.radius(a) == 1500.0, "a full charge at tier 3 is held at the cap (%.1f)" % SimWell.radius(a))
+	a.tier = 1.0
+	a.wel.chg = 0
+	# The snap's speed (Game Design's ruling 1): the faster of 4,000 and flat out for the level; tier 1 is today's lunge.
+	var row: Array = []
+	for t in range(4):
+		a.tier = float(t + 1)
+		a.power = 0.0
+		var fl: float = SimPower.flatFor(S, a)
+		ok(absf(fl - S.powerFlat * SimDetMath.pow(SimPower.flatGrowth, SimPower.level(a)) * a.spd) < 1.0e-9, "flatFor reads the level")
+		row.append(roundi(maxf(4000.0, fl)))
+	var full: Array = []   # with a full power meter (the level's other 0.2): the design's table
+	for t in range(4):
+		a.tier = float(t + 1)
+		a.power = 100.0
+		full.append(roundi(maxf(4000.0, SimPower.flatFor(S, a))))
+	a.power = 0.0
+	print("well: ... and with a full power meter: %s (his spd %.3f)" % [str(full), a.spd])
+	a.tier = 1.0
+	ok(S.powerFlat == 3500.0 and row[0] == 4000 and row[1] > row[0] and row[3] > row[2] and row[2] > row[1], "the snap by tier at flat out 3,500: %s" % str(row))
+	print("well: the snap's speed by tier (power 0, flat out %.0f): %s" % [S.powerFlat, str(row)])
+	SimCore.dispose(S)
+
+
+func _run(setup_, ticks: int, rollAt: int = -1) -> Dictionary:
+	var S := SimCore.createSim()
+	var su: Dictionary = {"intro": false}
+	su.merge(setup_, true)
+	SimCore.newMatch(S, 12345, {"p1": true, "p2": true}, su)
+	var snap: NetSnapshot = null
+	var at: Array = []
+	var snapsIn: int = 0
+	for t in range(ticks):
+		if t == rollAt:
+			snap = NetSnapshot.take(S)
+		SimCore.step(S)
+		if rollAt >= 0 and t >= rollAt:
+			at.append(SimHash.stateHash(S).gameplay)
+		if S.wellOn and S.fighters[0].wel.zone == SimWell.IN:
+			snapsIn += 1
+		S.out.fx.clear()
+		S.out.feed.clear()
+	var bad: int = 0
+	if rollAt >= 0:
+		NetSnapshot.restore(S, snap)
+		for t in range(rollAt, ticks):
+			SimCore.step(S)
+			if SimHash.stateHash(S).gameplay != at[t - rollAt]:
+				bad += 1
+			S.out.fx.clear()
+			S.out.feed.clear()
+	var h: String = SimHash.stateHash(S).gameplay
+	var on: bool = S.wellOn
+	var w = S.fighters[0].wel
+	SimCore.dispose(S)
+	return {"h": h, "bad": bad, "on": on, "wel": w, "in": snapsIn}
+
+
+func _switch() -> void:
+	var off: Dictionary = _run({"well": false}, 600)
+	var dflt: Dictionary = _run({}, 600)
+	ok(off.h == dflt.h and off.wel == null, "off: the same as a match with no word of it, and no well state")
+	var on: Dictionary = _run({"well": true}, 600)
+	ok(on.on and on.wel != null, "on: each fighter has a well")
+	print("well: AI against AI, 600 ticks, ticks the first slot stood in the rival's well: %d" % on["in"])
+	# the state is in the hash
+	var S := _mk(900.0)
+	_step(S)
+	var h0: String = SimHash.stateHash(S).gameplay
+	S.fighters[1].wel.quiet += 1
+	ok(SimHash.stateHash(S).gameplay != h0, "the well's state is in the gameplay hash")
+	SimCore.dispose(S)
+	ok(SimReplay.dataHash({"well": true}) != SimReplay.dataHash({"well": false}), "the replay's key folds well.json with the well on")
+	ok(SimReplay.dataHash({"wellClose": "own"}) != SimReplay.dataHash({}), "... and with the own-body close fight on")
+	ok(SimReplay.dataHash({"well": false}) == SimReplay.dataHash({}), "... and not with both off")
+	var O := _mk(900.0, {"well": false, "wellClose": "own"})
+	ok(not O.wellOn and O.wellOwn and O.fighters[0].wel != null, "the own-body mode alone: the state exists, the wells don't run")
+	SimCore.dispose(O)
+
+
+func _zones() -> void:
+	for row in [[900.0, SimWell.IN], [1050.0, SimWell.EDGE], [1250.0, SimWell.OUT]]:
+		var S := _mk(row[0])
+		SimWell.cfg().draw.mode = "off"
+		_step(S)
+		ok(S.fighters[0].wel.zone == row[1] and S.fighters[1].wel.zone == row[1], "at %.0f units, tier 1 against tier 1: zone %d (want %d)" % [row[0], S.fighters[0].wel.zone, row[1]])
+		SimWell.cfg().draw.mode = "rest"
+		SimCore.dispose(S)
+	# a bigger well reaches the smaller fighter first; the bigger one stands outside the small one's
+	var B := _mk(1100.0)
+	SimWell.cfg().draw.mode = "off"
+	B.fighters[1].tier = 4.0
+	_step(B)
+	ok(B.fighters[0].wel.zone == SimWell.IN and B.fighters[1].wel.zone == SimWell.EDGE, "tier 1 at 14.7 bh from tier 4: the small one inside the big well (%d), the big one on the small well's edge (%d)" % [B.fighters[0].wel.zone, B.fighters[1].wel.zone])
+	SimWell.cfg().zones.either = true
+	_step(B)
+	ok(B.fighters[1].wel.zone == SimWell.IN, "zones.either: either inside the other's well and both fight close")
+	SimWell.cfg().zones.either = false
+	SimWell.cfg().draw.mode = "rest"
+	SimCore.dispose(B)
+	# hysteresis: inside at 12.5 bh + 0.2 stays inside; from outside it isn't inside until 0.25 bh in
+	var H := _mk(937.5 + 15.0)
+	SimWell.cfg().draw.mode = "off"
+	H.fighters[0].wel.zone = SimWell.IN
+	H.fighters[1].wel.zone = SimWell.EDGE
+	_step(H)
+	ok(H.fighters[0].wel.zone == SimWell.IN and H.fighters[1].wel.zone == SimWell.EDGE, "hysteresis: 0.2 bh past the edge, inside stays inside and the edge band stays the edge band")
+	SimWell.cfg().draw.mode = "rest"
+	SimCore.dispose(H)
+	# mirror: the slots swapped, the zones swap
+	var M1 := _mk(1200.0)
+	SimWell.cfg().draw.mode = "off"
+	M1.fighters[0].tier = 4.0
+	_step(M1)
+	var z1: Array = [M1.fighters[0].wel.zone, M1.fighters[1].wel.zone]
+	SimCore.dispose(M1)
+	var M2 := _mk(1200.0)
+	M2.fighters[1].tier = 4.0
+	_step(M2)
+	ok(z1 == [M2.fighters[1].wel.zone, M2.fighters[0].wel.zone], "the zones mirror with the slots swapped: %s" % str(z1))
+	SimWell.cfg().draw.mode = "rest"
+	SimCore.dispose(M2)
+
+
+func _drawRest() -> void:
+	var S := _mk(10.0 * 75.0)
+	var g0: float = _gap(S)
+	var cap: float = 0.25 * SimFighter.flightSpeed(S, S.fighters[0], false)
+	var most: float = 0.0
+	for t in range(11):
+		_step(S)
+	ok(S.fighters[0].wel.quiet >= 1 and S.fighters[0].wel.quiet <= 12, "silence counts up, to quietTicks (%d after 11 ticks)" % S.fighters[0].wel.quiet)
+	for t in range(60):
+		var x0: float = S.fighters[0].x
+		_step(S)
+		most = maxf(most, absf(SimWrap.sdx(x0, S.fighters[0].x)) * 60.0)
+	ok(_gap(S) < g0, "two who let go inside a well drift together: %.0f to %.0f" % [g0, _gap(S)])
+	ok(most <= cap + 1.0e-6, "the draw is at most a quarter of plain flight: %.1f against %.1f" % [most, cap])
+	for t in range(1800):
+		_step(S)
+	ok(_gap(S) >= 2.5 * 75.0 - 1.0e-6, "the draw stops short of 2.5 bh: the gap is %.1f" % _gap(S))
+	print("well: two who let go at 10 bh are %.2f bh apart after 31 s; the fastest draw was %.1f a second (cap %.1f)" % [_gap(S) / 75.0, most, cap])
+	SimCore.dispose(S)
+	# the stick ends it on the tick: a held stick, and the draw moves him by nothing
+	var T := _mk(10.0 * 75.0)
+	for t in range(30):
+		_step(T)
+	_step(T, 0.2)
+	ok(T.fighters[0].wel.dx == 0 and T.fighters[0].wel.quiet == 0, "a held stick: no draw on that tick (dx %d, quiet %d)" % [T.fighters[0].wel.dx, T.fighters[0].wel.quiet])
+	ok(T.fighters[1].wel.dx != 0, "... while the rival, silent, is still drawn")
+	_step(T, 0.0, 0.0, true)
+	ok(T.fighters[0].wel.dx == 0, "hands on the guard: no draw")
+	SimCore.dispose(T)
+	# the latch: after something else moves him, no draw for either until his own input
+	var L := _mk(10.0 * 75.0)
+	for t in range(30):
+		_step(L)
+	SimWell.sent(L.fighters[1])
+	for t in range(30):
+		_step(L)
+	ok(L.fighters[0].wel.dx == 0 and L.fighters[1].wel.dx == 0, "after a knock-back: no draw on him or on the one who sent him")
+	_step(L, 0.0, 0.5)
+	for t in range(20):
+		_step(L)
+	ok(L.fighters[1].wel.own == 1 and L.fighters[0].wel.dx != 0 and L.fighters[1].wel.dx != 0, "... until his own input, then both are drawn again")
+	SimCore.dispose(L)
+	# outside the well, nothing
+	var F := _mk(14.0 * 75.0)
+	for t in range(30):
+		_step(F)
+	ok(F.fighters[0].wel.dx == 0 and F.fighters[1].wel.dx == 0, "outside the well (14 bh at tier 1): no draw")
+	SimCore.dispose(F)
+
+
+func _drawCapped() -> void:
+	SimWell.cfg().draw.mode = "capped"
+	var S := _mk(8.0 * 75.0)
+	_step(S, -1.0, -1.0)   # the first slot holds away from the rival (on its right); the second holds toward
+	var toward: float = absf(float(S.fighters[1].wel.dx)) / SimFighter.flightSpeed(S, S.fighters[1], false)   # each against his own plain flight: the two fighters' speeds differ
+	var away: float = absf(float(S.fighters[0].wel.dx)) / SimFighter.flightSpeed(S, S.fighters[0], false)
+	ok(away > 0.0 and toward > 0.0 and absf(away * 2.0 - toward) <= 0.01 * toward, "Game Design's capped draw: on with the stick held, halved on a fighter holding away (%.3f against %.3f of his flight)" % [away / 16.0, toward / 16.0])
+	SimWell.cfg().draw.mode = "rest"
+	SimCore.dispose(S)
+
+
+func _whole() -> void:
+	var a1: Dictionary = _run({"well": true, "flatOut": 3500.0}, 1200)
+	var a2: Dictionary = _run({"well": true, "flatOut": 3500.0}, 1200)
+	ok(a1.h == a2.h, "two runs with the well on are the same")
+	var r: Dictionary = _run({"well": true, "flatOut": 3500.0}, 900, 400)
+	ok(r.bad == 0, "a rollback across the wells replays the same (%d ticks differ)" % r.bad)
+	SimWell.cfg().draw.mode = "capped"
+	var c: Dictionary = _run({"well": true, "flatOut": 3500.0}, 900, 400)
+	ok(c.bad == 0, "... and with the capped draw (%d ticks differ)" % c.bad)
+	SimWell.cfg().draw.mode = "rest"
+
+
+func _init() -> void:
+	_data()
+	_switch()
+	_zones()
+	_drawRest()
+	_drawCapped()
+	_whole()
+	print("WELL: %d check(s) failed" % fails)
+	quit(1 if fails > 0 else 0)
