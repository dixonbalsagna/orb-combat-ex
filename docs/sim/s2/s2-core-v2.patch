+# ------------------------------------------------------------------------------------------------- row 1, scripted
+
+## Row 1's own view of the world, kept apart from SimWell's latch (the S2 review: judging by wel.own only restated the rule):
+## before each step, each fighter's stun, approach and zip, and whether something else has moved him since his last own input
+## (a knock-back event, launched, down, dropped or stunned, cleared by his own stick or hands once free). After a live step,
+## a fighter the draw moved is judged against what held when the draw was computed (the stick and hands are this tick's).
+var _sentFlag: Array = [false, false]
+
+
+func _pre(S: SimState) -> Array:
+	var p: Array = []
+	for k in range(2):
+		var f = S.fighters[k]
+		p.append({"stun": f.stunTicks > 0, "appr": DirBands.pending(f), "zip": DirZip.zipping(f), "sent": bool(_sentFlag[k])})
+	return p
+
+
+func _post(S: SimState) -> void:
+	for e in S.out.fx:
+		if e.type == "knockback" and int(e.victim) >= 0 and int(e.victim) < 2:
+			_sentFlag[int(e.victim)] = true
+	for k in range(2):
+		var f = S.fighters[k]
+		if f.state == "launched" or f.state == "down" or f.state == "dropped" or f.stunTicks > 0:
+			_sentFlag[k] = true
+		elif f.state == "free" and f.rush == null and (f.heldMx != 0.0 or f.heldMy != 0.0 or SimWell._hands(f)):
+			_sentFlag[k] = false
+
+
+func _loud(S: SimState, k: int, pre: Array) -> String:
+	var f = S.fighters[k]
+	if f.wel == null or (f.wel.dx == 0 and f.wel.dy == 0):
+		return ""
+	var a: Dictionary = pre[k]
+	var b: Dictionary = pre[1 - k]
+	if f.heldMx != 0.0 or f.heldMy != 0.0:
+		return "stick"
+	if SimWell._hands(f):
+		return "hands"
+	if a.stun:
+		return "stun"
+	if a.sent or b.sent:
+		return "latch"
+	if a.appr or b.appr or a.zip or b.zip:
+		return "approach"
+	return ""
+
+
+## One step for row 1: snapshot, step, judge (live steps only: a frozen step keeps the last live draw), then update the flags.
+func _judged(S: SimState, inputs, counts: Dictionary) -> void:
+	var pre: Array = _pre(S)
+	var live: bool = SimCore.step(S, inputs)
+	if live:
+		for k in range(2):
+			var why: String = _loud(S, k, pre)
+			if why != "":
+				counts[why] = int(counts.get(why, 0)) + 1
+	_post(S)
+
+
+func _draw() -> void:
+	print("== row 1 (scripted): ticks the draw moved a fighter who wasn't silent")
+	for mode in ["rest", "capped"]:
+		SimWell.cfg().draw.mode = mode
+		var counts := {}
+		var ticks: int = 0
+		for g in [5.0, 8.0, 11.0, 13.0]:
+			for sc in range(4):
+				var S := _mk(g * BH, OWN)
+				_sentFlag = [false, false]
+				for t in range(300):
+					var i0 := _in()
+					var i1 := _in()
+					match sc:
+						0:   # one holds his stick, on and off
+							i0.mx = 0.6 if (t / 20) % 2 == 0 else 0.0
+						1:   # one guards, one charges a strike on the right stick in turns
+							i0.guard = (t / 30) % 2 == 0
+							i1.rsHeld = (t / 25) % 2 == 1
+						2:   # presses from range every 70 ticks, both
+							i0.light = t % 70 == 0
+							i1.heavy = t % 70 == 35
+						3:   # silence, then a stick flick
+							i1.mx = -1.0 if t % 90 == 45 else 0.0
+					_judged(S, [i0, i1], counts)
+					S.out.fx.clear()
+					S.out.feed.clear()
+					ticks += 1
+				SimCore.dispose(S)
+		print("row1 scripted, draw %s: %s over %d ticks (rest: 0 is the pass line; capped: the stick, hands, latch and approach rows are that arm's own rule, only stun counts against it)" % [mode, str(counts), ticks])
+	SimWell.cfg().draw.mode = "rest"
+
+
+# ------------------------------------------------------------------------------------------------- rows 1, 8, 9 from matches
+
+func _matches() -> void:
+	print("== rows 8, 9 and 1: %d computer matches a mode, the well on, the draw in silence" % nMatch)
+	for arm in [PAIR, OWN]:
+		var ends := {}
+		var lens: Array = []
+		var brawlTicks: int = 0
+		var allTicks: int = 0
+		var blowsAtExit: Array = []
+		var unwanted: int = 0
+		var farFromBig: int = 0
+		var chargeSnapped: int = 0
+		var loud := {}
+		var ko: int = 0
+		for m in range(nMatch):
+			var S := SimCore.createSim()
+			var su: Dictionary = {"intro": false, "flatOut": 3500.0, "travel": 1.5}
+			su.merge(arm, true)
+			SimCore.newMatch(S, 9001 + m, {"p1": true, "p2": true}, su)
+			var open: int = -1
+			var blows: int = 0
+			_sentFlag = [false, false]
+			for t in range(36000):
+				var charging: Array = [S.fighters[0].state == "charging", S.fighters[1].state == "charging"]
+				var taunting0: Array = [DirBands.taunting(S.fighters[0]), DirBands.taunting(S.fighters[1])]
+				var pre: Array = _pre(S)
+				var live: bool = SimCore.step(S)
+				allTicks += 1
+				if open >= 0:
+					brawlTicks += 1
+				for e in S.out.fx:
+					if e.type == "cue":
+						var k: String = String(e.kind)
+						if k == "brawl_start" and open < 0:
+							open = t
+							blows = 0
+						elif k == "brawl_end" and open >= 0:
+							var why: String = String(e.text)
+							ends[why] = int(ends.get(why, 0)) + 1
+							lens.append(t - open)
+							blowsAtExit.append(blows)
+							open = -1
+						elif k == "snap":
+							var A = S.fighters[int(e.actor)] if e.get("actor") != null else null
+							if A != null:
+								var D = S.fighters[1 - S.fighters.find(A)]
+								if charging[S.fighters.find(D)] and SimWell._dist(A, D) > 12.5 * BH:
+									chargeSnapped += 1
+					elif e.type == "damage" and open >= 0 and int(e.attacker) >= 0 and String(e.kind) != "impact":
+						blows += 1
+				for k in range(2):   # a taunt that began this tick (the S2 review: the FAR KIT line also comes with answers, fly-ins and spent presses)
+					var f = S.fighters[k]
+					var o = S.fighters[1 - k]
+					if not taunting0[k] and DirBands.taunting(f) and f.tier > o.tier:
+						farFromBig += 1
+						if o.wel != null and o.wel.zone == SimWell.IN:
+							unwanted += 1
+				if live:
+					for k in range(2):
+						var why2: String = _loud(S, k, pre)
+						if why2 != "":
+							loud[why2] = int(loud.get(why2, 0)) + 1
+				_post(S)
+				S.out.fx.clear()
+				S.out.feed.clear()
+				if S.game.ko != null and S.game.koT > 2.5:
+					ko += 1
+					break
+			SimCore.dispose(S)
+		lens.sort()
+		var med: int = int(lens[lens.size() / 2]) if not lens.is_empty() else 0
+		var bsum: int = 0
+		for x in blowsAtExit:
+			bsum += int(x)
+		print("row8 %s: %d matches (%d to a K.O.), %.1f min a match; brawls %d (%.1f a match) by end %s; median brawl %d ticks; share of the match in a brawl %.0f%%; blows that reached a fighter a brawl %.1f" % [
+			_armName(arm), nMatch, ko, float(allTicks) / float(nMatch) / 3600.0, lens.size(), float(lens.size()) / float(nMatch), str(ends), med, 100.0 * float(brawlTicks) / maxf(1.0, float(allTicks)), float(bsum) / maxf(1.0, float(blowsAtExit.size()))])
+		print("row9 %s: taunts begun by the bigger fighter %d, of them with the smaller one inside his well %d (%.2f a match); power-ups ended by a snap from beyond 12.5 bh %d" % [_armName(arm), farFromBig, unwanted, float(unwanted) / float(nMatch), chargeSnapped])
+		print("row1 matches %s: the draw on a fighter who wasn't silent %s (0 is the pass line)" % [_armName(arm), str(loud)])
+
+
+func _init() -> void:
+	_args()
+	if part == "all" or part == "press":
+		_press()
+	if part == "all" or part == "brawl":
+		_brawl()
+	if part == "all" or part == "draw":
+		_draw()
+	if part == "all" or part == "matches":
+		_matches()
+	print("WELL READ done")
+	quit(0)
