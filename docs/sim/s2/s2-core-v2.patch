diff --git a/sim/core/tools/well_check.gd b/sim/core/tools/well_check.gd
new file mode 100644
index 0000000..c27a7ee
--- /dev/null
+++ b/sim/core/tools/well_check.gd
@@ -0,0 +1,317 @@
+extends SceneTree
+## The gravity well's core (spike S2, sim/core/well.gd): godot --headless --path . --script res://sim/core/tools/well_check.gd
+## The data and its sizes, the snap's speed by tier, the switch (off is the same as no word of it; on, the state is hashed and
+## the data is in the replay's key), the zones and their hysteresis, the draw in silence (its cap, its stop, the stick and the
+## hands ending it on the tick, the knock-back latch), Game Design's capped arm, and two runs and a rollback with it on.
+
+var fails: int = 0
+
+
+func ok(c: bool, what: String) -> void:
+	if not c:
+		fails += 1
+		print("FAIL  " + what)
+
+
+## Two human fighters, sep apart at one height, still, the well on, the trial's setup.
+func _mk(sep: float, more: Dictionary = {}) -> SimState:
+	var S := SimCore.createSim()
+	var su: Dictionary = {"well": true, "intro": false, "flatOut": 3500.0}
+	su.merge(more, true)
+	SimCore.newMatch(S, 77, {"p1": false, "p2": false}, su)
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	a.x = 3000.0
+	b.x = SimWrap.wrap(3000.0 + sep)
+	a.y = 2500.0
+	b.y = 2500.0
+	for f in [a, b]:
+		f.vx = 0.0
+		f.vy = 0.0
+	return S
+
+
+func _gap(S: SimState) -> float:
+	return absf(SimWrap.sdx(S.fighters[0].x, S.fighters[1].x))
+
+
+## One tick with these sticks (null: hands off).
+func _step(S: SimState, mx0: float = 0.0, mx1: float = 0.0, guard0: bool = false) -> void:
+	var i0 := SimIntent.new()
+	i0.mx = mx0
+	i0.guard = guard0
+	var i1 := SimIntent.new()
+	i1.mx = mx1
+	SimCore.step(S, [i0, i1])
+	S.out.fx.clear()
+	S.out.feed.clear()
+
+
+func _data() -> void:
+	ok(SimWell.errors().is_empty(), "well.json loads: " + str(SimWell.errors()))
+	ok(not SimWell.enabled() and SimWell.closeMode() == "pair", "the switch is off and the close fight is today's in data")
+	var S := _mk(900.0)
+	var a = S.fighters[0]
+	var want: Array = [937.5, 1125.0, 1312.5, 1500.0]
+	for t in range(4):
+		a.tier = float(t + 1)
+		ok(absf(SimWell.radius(a) - want[t]) < 1.0e-6, "tier %d's well: %.1f against %.1f" % [t + 1, SimWell.radius(a), want[t]])
+	a.tier = 1.0
+	a.wel.chg = 30
+	ok(absf(SimWell.radius(a) - 1171.875) < 1.0e-6, "a full charge at tier 1: 15.6 bh (%.1f)" % SimWell.radius(a))
+	a.tier = 3.0
+	ok(SimWell.radius(a) == 1500.0, "a full charge at tier 3 is held at the cap (%.1f)" % SimWell.radius(a))
+	a.tier = 1.0
+	a.wel.chg = 0
+	# The snap's speed (Game Design's ruling 1): the faster of 4,000 and flat out for the level; tier 1 is today's lunge.
+	var row: Array = []
+	for t in range(4):
+		a.tier = float(t + 1)
+		a.power = 0.0
+		var fl: float = SimPower.flatFor(S, a)
+		ok(absf(fl - S.powerFlat * SimDetMath.pow(SimPower.flatGrowth, SimPower.level(a)) * a.spd) < 1.0e-9, "flatFor reads the level")
+		row.append(roundi(maxf(4000.0, fl)))
+	var full: Array = []   # with a full power meter (the level's other 0.2): the design's table
+	for t in range(4):
+		a.tier = float(t + 1)
+		a.power = 100.0
+		full.append(roundi(maxf(4000.0, SimPower.flatFor(S, a))))
+	a.power = 0.0
+	print("well: ... and with a full power meter: %s (his spd %.3f)" % [str(full), a.spd])
+	a.tier = 1.0
+	ok(S.powerFlat == 3500.0 and row[0] == 4000 and row[1] > row[0] and row[3] > row[2] and row[2] > row[1], "the snap by tier at flat out 3,500: %s" % str(row))
+	print("well: the snap's speed by tier (power 0, flat out %.0f): %s" % [S.powerFlat, str(row)])
+	SimCore.dispose(S)
+
+
+func _run(setup_, ticks: int, rollAt: int = -1) -> Dictionary:
+	var S := SimCore.createSim()
+	var su: Dictionary = {"intro": false}
+	su.merge(setup_, true)
+	SimCore.newMatch(S, 12345, {"p1": true, "p2": true}, su)
+	var snap: NetSnapshot = null
+	var at: Array = []
+	var snapsIn: int = 0
+	for t in range(ticks):
+		if t == rollAt:
+			snap = NetSnapshot.take(S)
+		SimCore.step(S)
+		if rollAt >= 0 and t >= rollAt:
+			at.append(SimHash.stateHash(S).gameplay)
+		if S.wellOn and S.fighters[0].wel.zone == SimWell.IN:
+			snapsIn += 1
+		S.out.fx.clear()
+		S.out.feed.clear()
+	var bad: int = 0
+	if rollAt >= 0:
+		NetSnapshot.restore(S, snap)
+		for t in range(rollAt, ticks):
+			SimCore.step(S)
+			if SimHash.stateHash(S).gameplay != at[t - rollAt]:
+				bad += 1
+			S.out.fx.clear()
+			S.out.feed.clear()
+	var h: String = SimHash.stateHash(S).gameplay
+	var on: bool = S.wellOn
+	var w = S.fighters[0].wel
+	SimCore.dispose(S)
+	return {"h": h, "bad": bad, "on": on, "wel": w, "in": snapsIn}
+
+
+func _switch() -> void:
+	var off: Dictionary = _run({"well": false}, 600)
+	var dflt: Dictionary = _run({}, 600)
+	ok(off.h == dflt.h and off.wel == null, "off: the same as a match with no word of it, and no well state")
+	var on: Dictionary = _run({"well": true}, 600)
+	ok(on.on and on.wel != null, "on: each fighter has a well")
+	print("well: AI against AI, 600 ticks, ticks the first slot stood in the rival's well: %d" % on["in"])
+	# the state is in the hash
+	var S := _mk(900.0)
+	_step(S)
+	var h0: String = SimHash.stateHash(S).gameplay
+	S.fighters[1].wel.quiet += 1
+	ok(SimHash.stateHash(S).gameplay != h0, "the well's state is in the gameplay hash")
+	SimCore.dispose(S)
+	ok(SimReplay.dataHash({"well": true}) != SimReplay.dataHash({"well": false}), "the replay's key folds well.json with the well on")
+	ok(SimReplay.dataHash({"wellClose": "own"}) != SimReplay.dataHash({}), "... and with the own-body close fight on")
+	ok(SimReplay.dataHash({"well": false}) == SimReplay.dataHash({}), "... and not with both off")
+	var O := _mk(900.0, {"well": false, "wellClose": "own"})
+	ok(not O.wellOn and O.wellOwn and O.fighters[0].wel != null, "the own-body mode alone: the state exists, the wells don't run")
+	SimCore.dispose(O)
+
+
+func _zones() -> void:
+	for row in [[900.0, SimWell.IN], [1050.0, SimWell.EDGE], [1250.0, SimWell.OUT]]:
+		var S := _mk(row[0])
+		SimWell.cfg().draw.mode = "off"
+		_step(S)
+		ok(S.fighters[0].wel.zone == row[1] and S.fighters[1].wel.zone == row[1], "at %.0f units, tier 1 against tier 1: zone %d (want %d)" % [row[0], S.fighters[0].wel.zone, row[1]])
+		SimWell.cfg().draw.mode = "rest"
+		SimCore.dispose(S)
+	# a bigger well reaches the smaller fighter first; the bigger one stands outside the small one's
+	var B := _mk(1100.0)
+	SimWell.cfg().draw.mode = "off"
+	B.fighters[1].tier = 4.0
+	_step(B)
+	ok(B.fighters[0].wel.zone == SimWell.IN and B.fighters[1].wel.zone == SimWell.EDGE, "tier 1 at 14.7 bh from tier 4: the small one inside the big well (%d), the big one on the small well's edge (%d)" % [B.fighters[0].wel.zone, B.fighters[1].wel.zone])
+	SimWell.cfg().zones.either = true
+	_step(B)
+	ok(B.fighters[1].wel.zone == SimWell.IN, "zones.either: either inside the other's well and both fight close")
+	SimWell.cfg().zones.either = false
+	SimWell.cfg().draw.mode = "rest"
+	SimCore.dispose(B)
+	# hysteresis: inside at 12.5 bh + 0.2 stays inside; from outside it isn't inside until 0.25 bh in
+	var H := _mk(937.5 + 15.0)
+	SimWell.cfg().draw.mode = "off"
+	H.fighters[0].wel.zone = SimWell.IN
+	H.fighters[1].wel.zone = SimWell.EDGE
+	_step(H)
+	ok(H.fighters[0].wel.zone == SimWell.IN and H.fighters[1].wel.zone == SimWell.EDGE, "hysteresis: 0.2 bh past the edge, inside stays inside and the edge band stays the edge band")
+	SimWell.cfg().draw.mode = "rest"
+	SimCore.dispose(H)
+	# mirror: the slots swapped, the zones swap
+	var M1 := _mk(1200.0)
+	SimWell.cfg().draw.mode = "off"
+	M1.fighters[0].tier = 4.0
+	_step(M1)
+	var z1: Array = [M1.fighters[0].wel.zone, M1.fighters[1].wel.zone]
+	SimCore.dispose(M1)
+	var M2 := _mk(1200.0)
+	M2.fighters[1].tier = 4.0
+	_step(M2)
+	ok(z1 == [M2.fighters[1].wel.zone, M2.fighters[0].wel.zone], "the zones mirror with the slots swapped: %s" % str(z1))
+	SimWell.cfg().draw.mode = "rest"
+	SimCore.dispose(M2)
+
+
+func _drawRest() -> void:
+	var S := _mk(10.0 * 75.0)
+	var g0: float = _gap(S)
+	var cap: float = 0.25 * SimFighter.flightSpeed(S, S.fighters[0], false)
+	var most: float = 0.0
+	for t in range(11):
+		_step(S)
+	ok(S.fighters[0].wel.quiet >= 1 and S.fighters[0].wel.quiet <= 12, "silence counts up, to quietTicks (%d after 11 ticks)" % S.fighters[0].wel.quiet)
+	for t in range(60):
+		var x0: float = S.fighters[0].x
+		_step(S)
+		most = maxf(most, absf(SimWrap.sdx(x0, S.fighters[0].x)) * 60.0)
+	ok(_gap(S) < g0, "two who let go inside a well drift together: %.0f to %.0f" % [g0, _gap(S)])
+	ok(most <= cap + 1.0e-6, "the draw is at most a quarter of plain flight: %.1f against %.1f" % [most, cap])
+	for t in range(1800):
+		_step(S)
+	ok(_gap(S) >= 2.5 * 75.0 - 1.0e-6, "the draw stops short of 2.5 bh: the gap is %.1f" % _gap(S))
+	print("well: two who let go at 10 bh are %.2f bh apart after 31 s; the fastest draw was %.1f a second (cap %.1f)" % [_gap(S) / 75.0, most, cap])
+	SimCore.dispose(S)
+	# the stick ends it on the tick: a held stick, and the draw moves him by nothing
+	var T := _mk(10.0 * 75.0)
+	for t in range(30):
+		_step(T)
+	_step(T, 0.2)
+	ok(T.fighters[0].wel.dx == 0 and T.fighters[0].wel.quiet == 0, "a held stick: no draw on that tick (dx %d, quiet %d)" % [T.fighters[0].wel.dx, T.fighters[0].wel.quiet])
+	ok(T.fighters[1].wel.dx != 0, "... while the rival, silent, is still drawn")
+	_step(T, 0.0, 0.0, true)
+	ok(T.fighters[0].wel.dx == 0, "hands on the guard: no draw")
+	SimCore.dispose(T)
+	# the latch: after something else moves him, no draw for either until his own input
+	var L := _mk(10.0 * 75.0)
+	for t in range(30):
+		_step(L)
+	SimWell.sent(L.fighters[1])
+	for t in range(30):
+		_step(L)
+	ok(L.fighters[0].wel.dx == 0 and L.fighters[1].wel.dx == 0, "after a knock-back: no draw on him or on the one who sent him")
+	_step(L, 0.0, 0.5)
+	for t in range(20):
+		_step(L)
+	ok(L.fighters[1].wel.own == 1 and L.fighters[0].wel.dx != 0 and L.fighters[1].wel.dx != 0, "... until his own input, then both are drawn again")
+	SimCore.dispose(L)
+	# outside the well, nothing
+	var F := _mk(14.0 * 75.0)
+	for t in range(30):
+		_step(F)
+	ok(F.fighters[0].wel.dx == 0 and F.fighters[1].wel.dx == 0, "outside the well (14 bh at tier 1): no draw")
+	SimCore.dispose(F)
+
+
+## The defender while the rival's snap flies (the design's section 2: not moved at all; Encounter's question at the join): in silence,
+## no draw on either fighter from the press until it arrives; Game Design's capped arm draws him to meet it unless he guards.
+func _drawSnap() -> void:
+	for mode in ["rest", "capped"]:
+		SimWell.cfg().draw.mode = mode
+		var S := _mk(8.0 * 75.0, {"v2": [true, true], "travel": 1.5})   # (presses go through intent v2, as Encounter's check)
+		for t in range(30):
+			_step(S)
+		S.dirS.cool = 0.0
+		var d0 = S.fighters[0]
+		var a1 = S.fighters[1]
+		var x0: float = d0.x
+		var i1 := SimIntent.new()
+		i1.light = true
+		SimCore.step(S, [SimIntent.new(), i1])
+		var flying: int = 0
+		var drawn: int = 0
+		for t in range(60):
+			if not DirBands.pending(a1):
+				break
+			flying += 1
+			if d0.wel.dx != 0 or d0.wel.dy != 0:
+				drawn += 1
+			_step(S)
+		var moved: float = absf(SimWrap.sdx(x0, d0.x))
+		if mode == "rest":
+			ok(flying > 0 and drawn == 0 and moved < 1.0e-9, "in silence, the defender while the rival's snap flies: no draw (%d of %d ticks drawn), not moved (%.3f)" % [drawn, flying, moved])
+		else:
+			ok(flying > 0 and drawn > 0, "Game Design's capped arm: the defender is drawn to meet the snap (%d of %d ticks)" % [drawn, flying])
+		print("well: %s: a light pressed at 8 bh, approach in hand %d ticks, the defender drawn on %d, moved %.1f" % [mode, flying, drawn, moved])
+		SimCore.dispose(S)
+	SimWell.cfg().draw.mode = "rest"
+
+
+## Slot order changes nothing (the S2 review): a rival stunned this tick stops the silent fighter's draw from either slot.
+func _drawSlots() -> void:
+	for stunned in [1, 0]:
+		var S := _mk(8.0 * 75.0)
+		for t in range(30):
+			_step(S)
+		S.fighters[stunned].stunTicks = 10
+		_step(S)
+		var w = S.fighters[1 - stunned].wel
+		ok(w.dx == 0 and w.quiet == 0, "a rival stunned this tick (slot %d): the silent fighter is not drawn (dx %d, quiet %d), whichever slot he is in" % [stunned, w.dx, w.quiet])
+		SimCore.dispose(S)
+
+
+func _drawCapped() -> void:
+	SimWell.cfg().draw.mode = "capped"
+	var S := _mk(8.0 * 75.0)
+	_step(S, -1.0, -1.0)   # the first slot holds away from the rival (on its right); the second holds toward
+	var toward: float = absf(float(S.fighters[1].wel.dx)) / SimFighter.flightSpeed(S, S.fighters[1], false)   # each against his own plain flight: the two fighters' speeds differ
+	var away: float = absf(float(S.fighters[0].wel.dx)) / SimFighter.flightSpeed(S, S.fighters[0], false)
+	ok(away > 0.0 and toward > 0.0 and absf(away * 2.0 - toward) <= 0.01 * toward, "Game Design's capped draw: on with the stick held, halved on a fighter holding away (%.3f against %.3f of his flight)" % [away / 16.0, toward / 16.0])
+	SimWell.cfg().draw.mode = "rest"
+	SimCore.dispose(S)
+
+
+func _whole() -> void:
+	var a1: Dictionary = _run({"well": true, "flatOut": 3500.0}, 1200)
+	var a2: Dictionary = _run({"well": true, "flatOut": 3500.0}, 1200)
+	ok(a1.h == a2.h, "two runs with the well on are the same")
+	var r: Dictionary = _run({"well": true, "flatOut": 3500.0}, 900, 400)
+	ok(r.bad == 0, "a rollback across the wells replays the same (%d ticks differ)" % r.bad)
+	SimWell.cfg().draw.mode = "capped"
+	var c: Dictionary = _run({"well": true, "flatOut": 3500.0}, 900, 400)
+	ok(c.bad == 0, "... and with the capped draw (%d ticks differ)" % c.bad)
+	SimWell.cfg().draw.mode = "rest"
+
+
+func _init() -> void:
+	_data()
+	_switch()
+	_zones()
+	_drawRest()
+	_drawCapped()
+	_drawSnap()
+	_drawSlots()
+	_whole()
+	print("WELL: %d check(s) failed" % fails)
+	quit(1 if fails > 0 else 0)
diff --git a/sim/core/tools/well_clips.gd b/sim/core/tools/well_clips.gd
new file mode 100644
index 0000000..e970232
--- /dev/null
+++ b/sim/core/tools/well_clips.gd
@@ -0,0 +1,175 @@
+extends SceneTree
+## Spike S2's clip matches (the design's section 12, "What Orb gets"): godot --headless --path . --script res://sim/core/tools/well_clips.gd -- --out=<folder> [--commit=<key>]
+## Each scene is a real match from its start (a replay can't carry a body placed by hand), both pads scripted closed-loop on
+## the state, recorded with SimReplay's recorder and written as a match file for Tools' clip kit (node tools/clips/make.mjs
+## --from-match <file> --build <the trial's web build>), with one mark on the moment. Two arms a scene: today (no well, the
+## pair's shared movement) and proposed (the well, the own-body close fight). A trial tool in scratch: never to land.
+
+const BH: float = 75.0
+const TODAY: Dictionary = {"well": false, "wellClose": "pair"}
+const PROPOSED: Dictionary = {"well": true, "wellClose": "own"}
+const TURN: int = 10
+
+var out: String = ""
+var commit: String = ""
+
+
+func _args() -> void:
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--out="):
+			out = a.substr(6)
+		elif a.begins_with("--commit="):
+			commit = a.substr(9)
+
+
+func _in(mx: float = 0.0, my: float = 0.0) -> SimIntent:
+	var i := SimIntent.new()
+	i.mx = mx
+	i.my = my
+	return i
+
+
+func _setup(arm: Dictionary) -> Dictionary:
+	var su: Dictionary = {"intro": false, "flatOut": 3500.0, "travel": 1.5, "v2": [true, true]}
+	su.merge(arm, true)
+	return su
+
+
+## The first slot flies to the rival and holds there at gap units, level with him. Returns the inputs for this tick.
+func _steer(S: SimState, gap: float) -> SimIntent:
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	var dx: float = SimWrap.sdx(a.x, b.x)
+	var d: float = absf(dx)
+	var mx: float = 0.0
+	if d > gap + 300.0:
+		mx = SimMathx.jsign(dx)
+	elif d > gap:
+		mx = 0.5 * SimMathx.jsign(dx)
+	elif d < gap - 300.0:
+		mx = -SimMathx.jsign(dx)   # too close: back off to the gap
+	elif d < gap - 30.0:
+		mx = -0.5 * SimMathx.jsign(dx)
+	return _in(mx, SimMathx.jclamp((b.y - a.y) / 150.0, -1.0, 1.0))
+
+
+func _save(name: String, arm: Dictionary, rp: Dictionary, markTick: int, before: int, note: String) -> void:
+	var doc := {"replay": rp, "marks": [{"kind": "clip", "tick": markTick, "before": before}], "build": {"commit": commit}, "pageSearch": "", "note": note}
+	var path: String = out.path_join(name + ".json")
+	var f := FileAccess.open(path, FileAccess.WRITE)
+	f.store_string(JSON.stringify(doc))
+	f.close()
+	print("clip %s: %d ticks, mark at %d (the %d before it); %s" % [name, int(rp.ticks), markTick, before, note])
+
+
+## A brawl opened by the first slot's light, then sticks(t) from the turn for 240 ticks. The mark covers the second before the
+## turn and the four seconds after it.
+func _brawlScene(name: String, arm: Dictionary, sticks: Callable) -> void:
+	var S := SimCore.createSim()
+	var rec := SimReplay.recorder(S, 4242, {"p1": false, "p2": false}, _setup(arm))
+	var opened: int = -1
+	var turn: int = -1
+	var away: float = 0.0
+	var end: String = ""
+	for t in range(3600):
+		var i0: SimIntent = _in()
+		var i1: SimIntent = _in()
+		if opened < 0:
+			i0 = _steer(S, 2.0 * BH)
+			var a = S.fighters[0]
+			var b = S.fighters[1]
+			if absf(SimWrap.sdx(a.x, b.x)) <= 2.2 * BH and absf(b.y - a.y) < 60.0 and S.dirS.cool <= 0.0:
+				i0.light = true
+				opened = t
+		elif turn < 0 and t >= opened + TURN:
+			turn = t
+			away = -SimMathx.jsign(SimWrap.sdx(S.fighters[0].x, S.fighters[1].x))
+		if turn >= 0:
+			var pr: Array = sticks.call(t - turn, away)
+			i0 = pr[0]
+			i1 = pr[1]
+		rec.step([i0, i1])
+		for e in S.out.fx:
+			if e.type == "cue" and String(e.kind) == "brawl_end" and turn >= 0 and end == "":
+				end = "%s at %d after the turn" % [String(e.text), t - turn]
+		S.out.fx.clear()
+		S.out.feed.clear()
+		if turn >= 0 and t >= turn + 240:
+			break
+	var rp: Dictionary = rec.finish()
+	SimCore.dispose(S)
+	if turn < 0:
+		print("clip %s: NO BRAWL OPENED (not saved)" % name)
+		return
+	_save(name, arm, rp, turn + 240, 300, "opened at %d, turned at %d; %s" % [opened, turn, end if end != "" else "no end in four seconds"])
+
+
+## The first slot flies to sep from the rival, settles, and presses X (a light). charge: first he powers up until his tier
+## reaches it (or gives up after a minute).
+func _pressScene(name: String, arm: Dictionary, sep: float, tier: float) -> void:
+	var S := SimCore.createSim()
+	var rec := SimReplay.recorder(S, 4243, {"p1": false, "p2": false}, _setup(arm))
+	var a = S.fighters[0]
+	var charged: bool = tier <= 1.0
+	var settled: int = -1
+	var pressed: int = -1
+	var what: String = ""
+	var lastForm: int = -100
+	for t in range(9000):
+		var i0: SimIntent = _in()
+		if not charged:
+			if a.tier >= tier:
+				charged = true
+			elif a.act.formReady and t >= lastForm + 30:
+				i0.transform = true   # the tier waits for the transform press (ladder manualTierUp): one tap when a form is ready
+				lastForm = t
+			elif a.act.breakIn < 0:
+				i0.charge = true   # power up until the next form is ready
+		elif pressed < 0:
+			i0 = _steer(S, sep)
+			var d: float = absf(SimWrap.sdx(a.x, S.fighters[1].x))
+			if absf(d - sep) < 40.0 and absf(S.fighters[1].y - a.y) < 60.0:
+				settled = settled if settled >= 0 else t
+				i0 = _in()
+				if t >= settled + 30 and S.dirS.cool <= 0.0:
+					i0.light = true
+					pressed = t
+			else:
+				settled = -1
+		rec.step([i0, _in()])
+		for e in S.out.fx:
+			if e.type == "cue" and pressed >= 0 and what == "":
+				var k: String = String(e.kind)
+				if k == "snap" or k.begins_with("lunge_") or k.begins_with("taunt") or k == "far_taunt":
+					what = k
+		S.out.fx.clear()
+		S.out.feed.clear()
+		if pressed >= 0 and t >= pressed + 90:
+			break
+	var rp: Dictionary = rec.finish()
+	SimCore.dispose(S)
+	if pressed < 0:
+		print("clip %s: NEVER PRESSED (tier %.0f reached: %s; not saved)" % [name, a.tier, str(charged)])
+		return
+	_save(name, arm, rp, pressed + 90, 150, "tier %.0f, pressed at %.1f bh, tick %d; the press became: %s%s" % [a.tier, sep / BH, pressed, what if what != "" else "(no cue)", ", taunting" if DirBands.taunting(a) else ""])
+
+
+func _init() -> void:
+	_args()
+	if out == "":
+		print("usage: -- --out=<folder>")
+		quit(2)
+		return
+	DirAccess.make_dir_recursive_absolute(out)
+	for arm in [TODAY, PROPOSED]:
+		var tag: String = "today" if arm == TODAY else "proposed"
+		_brawlScene("1-walk-away-idle-" + tag, arm, func(t, away): return [_in(away), _in()])
+		_brawlScene("2-walk-away-lights-" + tag, arm, func(t, away):
+			var i1 := _in()
+			i1.light = t % 15 == 0
+			return [_in(away), i1])
+		_brawlScene("3-still-rival-pushes-" + tag, arm, func(t, away): return [_in(), _in(-away)])
+		_pressScene("4a-press-x-tier1-" + tag, arm, 14.0 * BH, 1.0)
+		_pressScene("4b-press-x-tier3-" + tag, arm, 14.0 * BH, 3.0)
+	print("WELL CLIPS done")
+	quit(0)
diff --git a/sim/core/tools/well_clips_check.gd b/sim/core/tools/well_clips_check.gd
new file mode 100644
index 0000000..4834720
--- /dev/null
+++ b/sim/core/tools/well_clips_check.gd
@@ -0,0 +1,22 @@
+extends SceneTree
+## Each S2 clip match file replays on this tree exactly as it was recorded (SimReplay.play: every checkpoint and the final
+## hash): godot --headless --path . --script res://sim/core/tools/well_clips_check.gd -- --dir=<folder>. A trial tool in scratch.
+
+func _init() -> void:
+	var dir: String = ""
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--dir="):
+			dir = a.substr(6)
+	var bad: int = 0
+	var n: int = 0
+	for f in DirAccess.get_files_at(dir):
+		if not f.ends_with(".json"):
+			continue
+		n += 1
+		var doc = JSON.parse_string(FileAccess.get_file_as_string(dir.path_join(f)))
+		var r: Dictionary = SimReplay.play(doc.replay)
+		print("%s %s: %s" % ["ok  " if r.ok else "FAIL", f, "plays back exactly" if r.ok else "%s at tick %d" % [str(r.reason), int(r.firstBadTick)]])
+		if not r.ok:
+			bad += 1
+	print("WELL CLIPS CHECK: %d of %d files failed" % [bad, n])
+	quit(1 if bad > 0 or n == 0 else 0)
diff --git a/sim/core/tools/well_read.gd b/sim/core/tools/well_read.gd
new file mode 100644
index 0000000..f973aca
--- /dev/null
+++ b/sim/core/tools/well_read.gd
@@ -0,0 +1,455 @@
+extends SceneTree
+## Spike S2's readings (docs/ep/proposals/gravity-well-trial-design.html section 12), on the joined trial tree:
+##   godot --headless --path . --script res://sim/core/tools/well_read.gd -- [--part=all|press|brawl|matches|draw] [--matches=40]
+## One line a reading, for the page. A trial tool in scratch: never to land. Every match runs the trial's setup (flat out
+## 3,500, travel 1.5, intent v2) on GW1a's target data (the kick, the slip and the dash on).
+##   press:   rows 4, 5, 6 and 11 (press to contact and to held, the defender's speed at arrival, the computer's answers);
+##   brawl:   rows 2, 3 and 7 (the design's four-second table, both close modes);
+##   draw:    row 1 (the draw on a fighter who isn't silent), scripted;
+##   matches: rows 1, 8 and 9 (computer against computer, both close modes, the well on).
+
+const BH: float = 75.0
+const TODAY: Dictionary = {"well": false, "wellClose": "pair"}
+const PAIR: Dictionary = {"well": true, "wellClose": "pair"}
+const OWN: Dictionary = {"well": true, "wellClose": "own"}
+
+var part: String = "all"
+var nMatch: int = 40
+
+
+func _args() -> void:
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--part="):
+			part = a.substr(7)
+		elif a.begins_with("--matches="):
+			nMatch = int(a.substr(10))
+
+
+func _armName(arm: Dictionary) -> String:
+	if not bool(arm.get("well", false)):
+		return "today" if str(arm.get("wellClose", "pair")) == "pair" else "own, no well"
+	return "well+" + str(arm.get("wellClose", "pair"))
+
+
+## Two fighters sep apart at one height in the air, still (as Encounter's well_dir_check). ai: the second slot is the computer.
+func _mk(sep: float, more: Dictionary, seed_: int = 77, ai: bool = false) -> SimState:
+	var S := SimCore.createSim()
+	var su: Dictionary = {"intro": false, "flatOut": 3500.0, "travel": 1.5, "v2": [true, true]}
+	su.merge(more, true)
+	SimCore.newMatch(S, seed_, {"p1": false, "p2": ai}, su)
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	a.x = 3000.0
+	b.x = SimWrap.wrap(3000.0 + sep)
+	a.y = 2500.0
+	b.y = 2500.0
+	for f in [a, b]:
+		f.vx = 0.0
+		f.vy = 0.0
+		f.face = 1.0 if f == a else -1.0
+		if f.wel != null:
+			f.wel.zone = -1
+	S.dirS.cool = 0.0
+	return S
+
+
+func _in(mx: float = 0.0, light: bool = false, heavy: bool = false, my: float = 0.0) -> SimIntent:
+	var i := SimIntent.new()
+	i.mx = mx
+	i.my = my
+	i.light = light
+	i.heavy = heavy
+	return i
+
+
+func _gap(S: SimState) -> float:
+	return absf(SimWrap.sdx(S.fighters[0].x, S.fighters[1].x))
+
+
+# ------------------------------------------------------------------------------------------------- rows 4, 5, 6, 11
+
+## A's press (light or heavy) from sep, D as told: "idle", "guard" (held all along), "dodge" (tapped 4 ticks after the press),
+## "side" (holds up). Returns the ticks after the press step to D's first hit landing (contact), to D held (locked), the
+## exchange that held him, D's speed the tick before and after he was held, and what the press became.
+func _pressRun(sep: float, arm: Dictionary, heavy: bool, tier: float, full: bool, dmode: String, ai: bool = false, seed_: int = 77, tierD: float = 1.0) -> Dictionary:
+	var S := _mk(sep, arm, seed_, ai)
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	a.tier = tier
+	b.tier = tierD
+	a.power = 100.0 if full else 0.0
+	var r := {"contact": -1, "held": -1, "ex": "", "vBefore": 0.0, "vAfter": 0.0, "snap": false, "lunge": false, "taunt": false, "farKit": false, "aiReact": -1, "appr": 0}
+	var px: float = b.x
+	var py: float = b.y
+	var vs: Array = []
+	for t in range(260):
+		var ia: SimIntent = _in(0.0, t == 0 and not heavy, t == 0 and heavy)
+		var ib: SimIntent = _in()
+		if dmode == "guard":
+			ib.guard = true
+		elif dmode == "dodge" and t == 4:
+			ib.dodge = true
+		elif dmode == "side":
+			ib.my = 1.0
+		SimCore.step(S, [ia, null if ai else ib])
+		if t == 0:
+			r.appr = DirInterrupt.gi(a, DirInterrupt.APPR_LEFT)
+			if ai:
+				r.aiReact = DirInterrupt.gi(b, DirInterrupt.AI_REACT)
+			r.taunt = DirBands.taunting(a)
+		for e in S.out.fx:
+			if e.type == "cue":
+				if String(e.kind) == "snap":
+					r.snap = true
+				elif String(e.kind).begins_with("lunge_"):
+					r.lunge = true
+			if e.type == "damage" and r.contact < 0 and int(e.attacker) == 0 and int(e.victim) == 1:
+				r.contact = t
+		for l in S.out.feed:
+			if String(l.tag).contains("FAR KIT"):
+				r.farKit = true
+		S.out.fx.clear()
+		S.out.feed.clear()
+		vs.append(SimDetMath.hypot(SimWrap.sdx(px, b.x), b.y - py) * 60.0)
+		px = b.x
+		py = b.y
+		if r.held < 0 and b.state == "locked":
+			r.held = t
+			var ex = S.dirS.ex
+			r.ex = ("brawl" if DirBrawl.isBrawl(ex) else String(ex.tag)) if ex != null else "?"
+			r.vBefore = float(vs[t - 1]) if t >= 1 else 0.0
+		if r.held >= 0 and t == r.held + 1:
+			r.vAfter = float(vs[t])
+		if r.contact >= 0 and r.held >= 0 and t > r.held + 1:
+			break
+	SimCore.dispose(S)
+	return r
+
+
+func _what(r: Dictionary) -> String:
+	if r.snap:
+		return "snap"
+	if r.lunge:
+		return "lunge"
+	if r.taunt:
+		return "taunt"
+	return "far"
+
+
+func _press() -> void:
+	print("== row 4: press to contact (ticks from the press to the blow landing on an idle rival), today against the well")
+	var levels: Array = [[1.0, false, "t1"], [4.0, false, "t4 empty"], [4.0, true, "t4 full"]]
+	for heavy in [false, true]:
+		for lv in levels:
+			var cells := PackedStringArray()
+			for g in [4.5, 6.0, 9.0, 12.5, 15.0, 20.0]:
+				var parts := PackedStringArray()
+				for arm in [TODAY, PAIR, OWN]:
+					var r: Dictionary = _pressRun(g * BH, arm, heavy, lv[0], lv[1], "idle")
+					parts.append(("%d" % r.contact if r.contact >= 0 else "-") + ":" + _what(r))
+				cells.append("%.1f bh %s" % [g, "/".join(parts)])
+			print("row4 %s %s (today/well+pair/well+own): %s" % ["heavy" if heavy else "light", lv[2], "; ".join(cells)])
+	print("== row 4b: against a tier 4 rival (his well 20 bh, its edge 23): a light from 15, 20, 23 and 25 bh")
+	for lv in levels:
+		var cells := PackedStringArray()
+		for g in [15.0, 20.0, 23.0, 25.0]:
