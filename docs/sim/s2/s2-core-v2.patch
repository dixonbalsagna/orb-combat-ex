+class_name SimWell
+extends RefCounted
+## The gravity well (spike S2: docs/ep/proposals/gravity-well-trial-design.html sections 4 to 6 and 10 to 11; Game Design's
+## five rulings at the end of docs/design/gravity-well-reading.md). The core's side: each fighter's well (its radius by tier
+## and charge), the zone each fighter stands in against the rival's well (inside, the edge band, outside), and the draw.
+## The press's band read, the snap and the close fight's own-body mode are the director's (DirBands, DirBrawl): they read
+## what this writes. A trial, in scratch: nothing here lands.
+##
+## The switch is data/fight/well.json "enabled" (off), which SimCore.newMatch copies into S.wellOn unless the setup has its
+## own "well"; "wellClose" ("pair" or "own") overrides close.mode, with or without the well (S.wellOwn). With both off, no
+## well state exists, nothing is hashed, and the file is not in a replay's data hash. No draw from S.rng anywhere here.
+## The core may not name the director (the load split): the distance is measured here, and the approach is read through
+## SimDir.
+
+const FILE: String = "res://data/fight/well.json"
+## The well state the gameplay hash reads, only while S.wellOn or S.wellOwn (hash.gd).
+const HASHED: Array = ["zone", "r", "chg", "quiet", "own", "dx", "dy", "ovx", "ovy", "lv", "late"]
+const BH: float = 75.0
+const IN: int = 0
+const EDGE: int = 1
+const OUT: int = 2
+
+static var _d = null
+static var _hash: String = ""
+static var _errors: Array = []
+static var on_: bool = false
+
+
+static func _ensure() -> void:
+	if _d != null:
+		return
+	_errors = []
+	var h := SimHash.Hasher.new()
+	var j = FighterData._load(FILE, "fight/well.json") if FileAccess.file_exists(FILE) else null
+	if not (j is Dictionary):
+		_errors.append("fight/well.json: missing, or not an object")
+		_d = {"enabled": false, "close": {"mode": "pair"}}
+		_hash = h.hex()
+		return
+	_d = j
+	h.text("fight/well.json")
+	FighterData._canon(h, j)
+	_hash = h.hex()
+	on_ = j.get("enabled") == true
+
+
+static func enabled() -> bool:
+	_ensure()
+	return on_
+
+
+## The data's close mode, "pair" or "own".
+static func closeMode() -> String:
+	_ensure()
+	return str(_d.get("close", {}).get("mode", "pair"))
+
+
+static func cfg() -> Dictionary:
+	_ensure()
+	return _d
+
+
+static func dataHash() -> String:
+	_ensure()
+	return _hash
+
+
+static func errors() -> Array:
+	_ensure()
+	return _errors
+
+
+## Tests only: read the file again on the next call.
+static func reload() -> void:
+	_d = null
+
+
+## Whether a match with this setup reads the well's data (the replay's key folds it): the well on, or the own-body mode.
+static func inMatch(setup_: Dictionary) -> bool:
+	return setup_.get("well", enabled()) == true or str(setup_.get("wellClose", closeMode())) == "own"
+
+
+## Each fighter's well state for a new match (SimCore.newMatch). S.wellOn is set by the caller.
+static func setup(S: SimState, setup_: Dictionary = {}) -> void:
+	_ensure()
+	S.wellOwn = str(setup_.get("wellClose", closeMode())) == "own"
+	for f in S.fighters:
+		f.wel = SimState.WellState.new() if (S.wellOn or S.wellOwn) else null
+
+
+## f's own well, in units: by tier and by the charge he holds. Pure.
+static func radius(f) -> float:
+	var c: Dictionary = _d.size
+	var r: float = float(c.baseBh) * BH
+	r *= 1.0 + float(c.tierStep) * (f.tier - 1.0)
+	r *= 1.0 + float(c.chargeGrow) * float(f.wel.chg) / float(c.chargeRiseTicks)
+	return SimMathx.jclamp(r, float(c.minBh) * BH, float(c.maxBh) * BH)
+
+
+## A's zone against D's well now, straight from the distance (for a press before the first write). Pure.
+static func zoneNow(_S: SimState, A, D) -> int:
+	_ensure()
+	return _zone(_dist(A, D), radius(D), -1)
+
+
+## As the director's band distance (centre to centre, the shortest arc and the height together; in three axes when a depth
+## is set), measured here so that the core names no director class.
+static func _dist(a, b) -> float:
+	if a.z != b.z and (a.zT != 0.0 or b.zT != 0.0):
+		return SimDetMath.hypot(SimDetMath.hypot(SimWrap.sdx(a.x, b.x), b.y - a.y), b.z - a.z)
+	return SimDetMath.hypot(SimWrap.sdx(a.x, b.x), b.y - a.y)
+
+
+## The zone at distance d from a well of radius rj, for a fighter now in zone was (-1: none yet). An edge is crossed only
+## half the hysteresis beyond it, as the bands do.
+static func _zone(d: float, rj: float, was: int) -> int:
+	var h: float = float(_d.zones.hysteresisBh) * BH * 0.5 if was >= 0 else 0.0
+	if d <= rj + (h if was == IN else -h):
+		return IN
+	return EDGE if d <= rj + float(_d.zones.edgeBh) * BH + (h if (was == IN or was == EDGE) else -h) else OUT
+
+
+## The other body of f's fight (slot k): the other of the pair. Bodies past the pair have no well to read (-1).
+static func _other(S: SimState, k: int) -> int:
+	if k >= 2 or S.fighters.size() < 2:
+		return -1
+	return 1 - k
+
+
+## The one writer. Once a live tick from SimCore's fight tick, after the control loop and before the bodies step, while
+## S.wellOn. It reads every body as the tick began and then writes them all, so the slot order changes nothing. A face
+## press is read inside the control loop, so it reads the zone written the tick before, as it reads last tick's band.
+static func tick(S: SimState) -> void:
+	var n: int = S.fighters.size()
+	var sz: Dictionary = _d.size
+	var rs := PackedFloat64Array()
+	rs.resize(n)
+	for k in n:
+		var f = S.fighters[k]
+		var up: bool = f.state == "charging" or f.beamCharge != null
+		f.wel.chg = mini(int(sz.chargeRiseTicks), f.wel.chg + 1) if up else maxi(0, f.wel.chg - ceili(float(sz.chargeRiseTicks) / float(sz.chargeFallTicks)))
+		rs[k] = radius(f)
+	var mv: Array = []   # the latches first, every body's, so each fighter's silence reads both from this tick (the S2 review: in one loop slot 0 read the rival's from the last)
+	for k in n:
+		mv.append(_latch(S.fighters[k]))
+	var zs := PackedInt32Array()
+	zs.resize(n)
+	var ds := PackedFloat64Array()
+	ds.resize(n * 2)
+	ds.fill(0.0)
+	for k in n:
+		var f = S.fighters[k]
+		var j: int = _other(S, k)
+		if j < 0:
+			zs[k] = OUT
+			continue
+		var o = S.fighters[j]
+		var d: float = _dist(f, o)
+		zs[k] = _zone(d, rs[j], f.wel.zone)
+		if bool(_d.zones.either) and zs[k] != IN and _zone(d, rs[k], o.wel.zone) == IN:
+			zs[k] = IN   # the second reading: either of you inside the other's well
+		_draw(S, f, o, d, rs[j], ds, k, bool(mv[k]))
+	for k in n:
+		var w = S.fighters[k].wel
+		w.zone = zs[k]
+		w.r = roundi(rs[k])
+		w.dx = roundi(ds[k * 2] * 16.0)
+		w.dy = roundi(ds[k * 2 + 1] * 16.0)
+
+
+## The director calls this where it moves a fighter without a rush or a state of its own (a knock-back's shove): no draw
+## for him, or for the fighter who sent him, until he makes an input of his own.
+static func sent(f) -> void:
+	if f.wel != null:
+		f.wel.own = 0
+
+
+## Whether f holds his stick away from o (the capped draw's halving): beyond awayDead, its part away from o at least awayShare of it.
+static func heldAway(f, o) -> bool:
+	var m: float = SimDetMath.hypot(f.heldMx, f.heldMy)
+	if m <= float(_d.draw.awayDead):
+		return false
+	var away: float = -f.heldMx * SimMathx.jsign(SimWrap.sdx(f.x, o.x))
+	return away >= float(_d.draw.awayShare) * m
+
+
+## Whether f's hands are on anything this tick (the silence's other half): any held or pressed control, or a beam's gather.
+static func _hands(f) -> bool:
+	var i = f.input
+	return i.guard or i.dash or i.light or i.heavy or i.sig or i.lightHeld or i.heavyHeld or i.sigHeld or i.rsHeld or i.rsStart \
+		or i.dodge or i.dodgeHeld or i.sprint or i.escape or i.charge or i.power or i.contextHeld or i.context or f.beamCharge != null
+
+
+## The latch, for every body before any silence is read: launched, down, dropped, stunned, or a rush with no target (a send's
+## slide or drift; an approach's has one) clears it; his own input once free sets it again. Returns whether something else
+## has him this tick.
+static func _latch(f) -> bool:
+	var moved: bool = f.state == "launched" or f.state == "down" or f.state == "dropped" or f.stunTicks > 0 \
+		or (f.rush != null and f.rush.tgt == null)
+	if moved:
+		f.wel.own = 0   # something else has him: no draw until he acts
+	elif f.state == "free" and f.rush == null and (f.heldMx != 0.0 or f.heldMy != 0.0 or _hands(f)):
+		f.wel.own = 1   # his own input, once free: the latch is his again
+	return moved
+
+
+## The draw: writes f's wanted movement toward o into ds (units a second). "rest" acts only in silence; "capped" always,
+## halved on a fighter holding away. Never on a fighter something else is moving, never closer than stopBh.
+static func _draw(S: SimState, f, o, d: float, r: float, ds: PackedFloat64Array, k: int, moved: bool) -> void:
+	var dw: Dictionary = _d.draw
+	var rest: bool = f.heldMx == 0.0 and f.heldMy == 0.0   # the stick as held, before any gate: a stun clears the intent's, not these
+	var hands: bool = _hands(f)
+	var silent: bool = rest and not hands and f.state == "free" and f.rush == null and f.stunTicks == 0 \
+		and S.game.ko == null and not SimDir.approaching(f) and not SimDir.approaching(o) and not SimDir.zipping(f) and not SimDir.zipping(o) \
+		and f.wel.own == 1 and o.wel.own == 1   # no approach or zip in hand, his or the rival's (the defender is not moved at all while a snap flies: the design's section 2); and the rival's latch: nobody drifts after a fighter they sent
+	f.wel.quiet = mini(int(dw.quietTicks), f.wel.quiet + 1) if silent else 0
+	var mode: String = str(dw.mode)
+	if mode == "off" or d > r:
+		return
+	var stop: float = float(dw.stopBh) * BH
+	if d <= stop:
+		return
+	var share: float = float(f.wel.quiet) / float(dw.quietTicks)
+	if mode == "capped":   # Game Design's reading: always on, halved on a fighter holding away; while the rival's approach flies, drawn to meet it, and not at all while he holds away or guards
+		if SimDir.approaching(o):
+			share = 0.0 if (heldAway(f, o) or f.input.guard) else 1.0
+		else:
+			share = 0.5 if heldAway(f, o) else 1.0
+		if moved or f.state != "free" or f.rush != null or S.game.ko != null or SimDir.approaching(f) or SimDir.zipping(f):   # (and never during his own approach's crouch or zip: the tell stays still)
+			share = 0.0
+	if share <= 0.0:
+		return
+	var depth: float = SimMathx.jclamp((1.0 - d / r) / (1.0 - float(dw.fullAt)), 0.0, 1.0)
+	var ease: float = SimMathx.jclamp((d - stop) / (float(dw.stopEaseBh) * BH), 0.0, 1.0)
+	var sp: float = float(dw.cap) * SimFighter.flightSpeed(S, f, false) * depth * ease * share
+	ds[k * 2] = SimWrap.sdx(f.x, o.x) / d * sp
+	ds[k * 2 + 1] = (o.y - f.y) / d * sp
