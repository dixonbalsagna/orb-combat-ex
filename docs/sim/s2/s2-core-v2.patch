+			for arm in [TODAY, PAIR]:
+				var r: Dictionary = _pressRun(g * BH, arm, false, lv[0], lv[1], "idle", false, 77, 4.0)
+				parts.append(("%d" % r.contact if r.contact >= 0 else "-") + ":" + _what(r))
+			cells.append("%.1f bh %s" % [g, "/".join(parts)])
+		print("row4b light %s against tier 4 (today/well): %s" % [lv[2], "; ".join(cells)])
+	print("== row 5: press to the defender held, and what held him (idle, guarding, a dodge tapped 4 ticks in)")
+	for lv in [[1.0, false, "t1"], [4.0, true, "t4 full"]]:
+		for dm in ["idle", "guard", "dodge"]:
+			var cells := PackedStringArray()
+			for g in [6.0, 12.5, 15.0, 20.0]:
+				var parts := PackedStringArray()
+				for arm in [TODAY, OWN]:
+					var r: Dictionary = _pressRun(g * BH, arm, false, lv[0], lv[1], dm)
+					parts.append(("%d %s" % [r.held, r.ex]) if r.held >= 0 else "not held")
+				cells.append("%.1f bh %s" % [g, " / ".join(parts)])
+			print("row5 light %s defender %s (today / well+own): %s" % [lv[2], dm, "; ".join(cells)])
+	print("== row 6: the defender's speed the tick before he is held and the tick after (he holds up while it flies)")
+	for lv in [[1.0, false, "t1"], [4.0, true, "t4 full"]]:
+		var cells := PackedStringArray()
+		for g in [9.0, 15.0]:
+			for arm in [PAIR, OWN]:
+				var r: Dictionary = _pressRun(g * BH, arm, false, lv[0], lv[1], "side")
+				cells.append("%.1f bh %s: %.0f then %.0f" % [g, _armName(arm), r.vBefore, r.vAfter])
+		print("row6 %s: %s" % [lv[2], "; ".join(cells)])
+	print("== row 11: the computer's answer to an approach (it answers only one of reactTicks + 2 or more): approach ticks, and how often it chose an answer over 8 seeds")
+	for lv in [[1.0, false, "t1"], [4.0, true, "t4 full"]]:
+		var cells := PackedStringArray()
+		for g in [6.0, 9.0, 12.5, 15.0, 20.0]:
+			for arm in [TODAY, PAIR]:
+				var n: int = 0
+				var ap: int = 0
+				for sd in range(8):
+					var r: Dictionary = _pressRun(g * BH, arm, false, lv[0], lv[1], "idle", true, 100 + sd)
+					ap = int(r.appr) + 1 if int(r.appr) > 0 else 0   # read after the press step, which already counted one tick down: the computer's rule compares the full wind + n
+					if int(r.aiReact) > 0:
+						n += 1
+				cells.append("%.1f bh %s: %d ticks, %d of 8" % [g, "today" if arm == TODAY else "well", ap, n])
+		print("row11 %s: %s" % [lv[2], "; ".join(cells)])
+
+
+# ------------------------------------------------------------------------------------------------- rows 2, 3, 7
+
+## A brawl opened by the first slot's light from 2 bh; from tick TURN each tick's sticks from sticks.call(t - TURN). Reads, from
+## the turn: how it ended and when, how far each body moved, the blows that reached the first slot (landed or guarded), the
+## gap 60 ticks on, and the live ticks his stick was held away while his body stood still. The turn comes as soon as the
+## opening light has landed, so the brawl's one-second idle clock starts with the sticks (the S2 review: at tick 40 it cut
+## every scene without an attack short).
+const TURN: int = 10
+func _scene(arm: Dictionary, sticks: Callable, ticks: int = 240) -> Dictionary:
+	var S := _mk(2.0 * BH, arm)
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	SimCore.step(S, [_in(0.0, true), _in()])
+	S.out.fx.clear()
+	S.out.feed.clear()
+	for t in range(TURN - 1):
+		SimCore.step(S, [_in(), _in()])
+		S.out.fx.clear()
+		S.out.feed.clear()
+	var started: bool = S.dirS.ex != null and DirBrawl.isBrawl(S.dirS.ex) and a.state == "locked"
+	var r := {"started": started, "end": "", "endT": -1, "blows": 0, "moved0": 0.0, "moved1": 0.0, "gap60": 0.0, "stood": 0, "awayLive": 0, "firstMove": -1, "drag1": 0.0, "kinds": {}}
+	var ax0: float = a.x
+	var bx0: float = b.x
+	for t in range(ticks):
+		var pr: Array = sticks.call(t)
+		var lx: float = a.x
+		var live: bool = SimCore.step(S, [pr[0], pr[1]])
+		for e in S.out.fx:
+			if e.type == "cue" and String(e.kind) == "brawl_end" and r.end == "":
+				r.end = String(e.text)
+				r.endT = t
+			if e.type == "damage" and int(e.victim) == 0 and int(e.attacker) == 1 and String(e.kind) != "impact" and (r.end == "" or t == r.endT):
+				r.blows += 1   # every blow of the rival's that reached him, landed or guarded (light, medium, heavy, guard ...); not a landing's impact
+				r.kinds[String(e.kind)] = int(r.kinds.get(String(e.kind), 0)) + 1
+		S.out.fx.clear()
+		S.out.feed.clear()
+		if r.end == "" or t <= r.endT:
+			r.moved0 = maxf(r.moved0, absf(SimWrap.sdx(ax0, a.x)))
+			r.moved1 = maxf(r.moved1, absf(SimWrap.sdx(bx0, b.x)))
+		if t == 60:
+			r.gap60 = _gap(S) / BH
+		var awayHeld: bool = (pr[0] as SimIntent).mx < -0.5
+		if awayHeld and live and r.end == "" and a.state == "locked":
+			r.awayLive += 1
+			if absf(SimWrap.sdx(lx, a.x)) < 0.01:
+				r.stood += 1
+		if r.firstMove < 0 and absf((pr[0] as SimIntent).mx) > 0.5 and absf(SimWrap.sdx(ax0, a.x)) > 0.01:
+			r.firstMove = t + 1
+	SimCore.dispose(S)
+	return r
+
+
+func _brawl() -> void:
+	print("== rows 2, 3, 7: the design's four-second table (the first slot opened the brawl; from the turn, 240 ticks; distances in units, the gap in bh)")
+	var scenes: Array = [
+		["you hold away, the rival does nothing", func(t): return [_in(-1.0), _in()]],
+		["you hold away, the rival throws lights", func(t): return [_in(-1.0), _in(0.0, t % 15 == 0)]],
+		["you hold away, the rival winds up heavies", func(t): return [_in(-1.0), _in(0.0, false, t % 40 == 0)]],
+		["you hold away, the rival mixes a heavy every third blow", func(t): return [_in(-1.0), _in(0.0, t % 15 == 0 and (t / 15) % 3 != 2, t % 15 == 0 and (t / 15) % 3 == 2)]],
+		["you do nothing, the rival holds away", func(t): return [_in(), _in(1.0)]],
+		["you do nothing, the rival holds toward", func(t): return [_in(), _in(-1.0)]],
+		["you walk into an idle rival", func(t): return [_in(1.0), _in()]],
+		["you both hold away", func(t): return [_in(-1.0), _in(1.0)]],
+	]
+	for sc in scenes:
+		var cells := PackedStringArray()
+		for arm in [PAIR, OWN]:
+			var r: Dictionary = _scene(arm, sc[1])
+			cells.append("%s: %s%s at %d, blows %d %s, you moved %.0f, rival moved %.0f, gap at 1 s %.2f, stick away and standing %d of %d live ticks, first move %d" % [
+				_armName(arm), "" if r.started else "(no brawl!) ", r.end if r.end != "" else "no end", r.endT, r.blows, str(r.kinds), r.moved0, r.moved1, r.gap60, r.stood, r.awayLive, r.firstMove])
+		print("row7 %s | %s" % [sc[0], " | ".join(cells)])
+
