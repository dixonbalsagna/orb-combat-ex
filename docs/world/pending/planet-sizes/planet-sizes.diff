+        "additionalProperties": false,
+        "properties": {
+          "cols": { "type": "integer", "minimum": 1280, "description": "The planet's columns round (a column is 32 units)." },
+          "arenaCols": { "type": "integer", "minimum": 600, "description": "The longest ring a fight is played on (on a field world: the planet's own round)." },
+          "bakeStride": { "type": "integer", "minimum": 1, "description": "The bake's spacing in 128-unit nodes." },
+          "offered": { "type": "boolean", "description": "In the menu's list of sizes." },
+          "places": {
+            "type": "object",
+            "description": "planet.json numbers this size changes: the place counts and the ring's minimums.",
+            "additionalProperties": false,
+            "properties": {
+              "cities": { "type": "integer", "minimum": 0 },
+              "towns": { "type": "integer", "minimum": 0 },
+              "minCities": { "type": "integer", "minimum": 0 },
+              "minTowns": { "type": "integer", "minimum": 0 },
+              "relaxCities": { "type": "integer", "minimum": 0 },
+              "relaxTowns": { "type": "integer", "minimum": 0 }
+            }
+          }
+        }
+      }
+    }
+  }
+}
