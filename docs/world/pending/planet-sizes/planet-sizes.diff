+    "small":    { "cols": 2560,  "arenaCols": 2560, "bakeStride": 4,  "offered": true, "places": { "cities": 4, "towns": 12, "minCities": 1, "minTowns": 2, "relaxCities": 1, "relaxTowns": 1 } },
+    "medium":   { "cols": 4800,  "arenaCols": 4800, "bakeStride": 4,  "offered": true },
+    "big":      { "cols": 9600,  "arenaCols": 9600, "bakeStride": 4,  "offered": true, "places": { "cities": 24, "towns": 88 } },
+    "huge":     { "cols": 19200, "arenaCols": 19200, "bakeStride": 8,  "offered": true, "places": { "cities": 48, "towns": 176 } },
+    "colossal": { "cols": 38400, "arenaCols": 38400, "bakeStride": 16, "offered": false, "places": { "cities": 96, "towns": 352 } }
+  }
+}
