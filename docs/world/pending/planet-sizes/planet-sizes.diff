+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "meridian/biomes-sizes",
+  "title": "biomes.sizes/1",
+  "description": "data/biomes/sizes.json: the planet sizes a match can pick (WorldPlanetSize; docs/world/planet-sizes.md). Version field: schema. Policy: every key required, objects closed except keys starting with an underscore. The loader also checks the rules JSON Schema cannot: cols a multiple of 64, arenaCols 600 to cols and a multiple of 8, bakeStride dividing cols / 16, and the default being medium's 4,800.",
+  "type": "object",
+  "required": ["schema", "_about", "default", "sizes"],
+  "additionalProperties": false,
+  "properties": {
+    "schema": { "const": "biomes.sizes/1" },
+    "_about": { "type": "string" },
+    "default": { "type": "string", "description": "The size a setup that names none plays: medium." },
+    "sizes": {
+      "type": "object",
