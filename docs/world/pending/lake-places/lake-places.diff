--- /dev/null
+++ b/sim/world/tools/lake_places_check.gd
@@ -0,0 +1,59 @@
+extends SceneTree
+# No town stands under a lake's water (World, sim/world/plan.gd layFree, data/biomes/field.json plans.lakeMax; docs/world/lake-places.md). With plans.everywhere on, the planet's free places are laid on it and the lakes
+# are records laid on the ring's plan; a place laid on a lake's bed was a town under water (34 of 3,835 buildings on planet 7, touch 3, up to 611 units deep: Animation's water_tile_check found the lakes undrawn and fighters
+# standing in the air over them). With lakeMax a building whose base is under more water than that is not laid.
+#   godot --headless --path . --script res://sim/world/tools/lake_places_check.gd -- [--planet=7] [--touch=3]
+var fails: int = 0
+
+
+func ok(cond: bool, what: String) -> void:
+	if cond:
+		print("  ok   ", what)
+	else:
+		fails += 1
+		print("  FAIL ", what)
+
+
+## [buildings, buildings standing in lake or river water deeper than 1, the deepest, how many were not laid (the drowned count of layFree's places)].
+func _read(planet: int, touch: int, lake_max: float) -> Array:
+	WorldClimate.useGen(3)
+	WorldPlan.everywhereOverride = 1
+	WorldPlan.lakeMaxOverride = lake_max
+	WorldFieldCache.enabledOverride = 0   # a kept place is restored as it was laid, so the check lays them cold
+	WorldPlanet.forget()
+	var S := SimCore.createSim()
+	SimCore.newMatch(S, 4, {}, {"planet": planet, "touch": touch, "planetGen": 3, "intro": false})
+	var wet: int = 0
+	var worst: float = 0.0
+	var n: int = 0
+	for i in range(S.buildings.size()):
+		if not S.buildings[i].alive or i * 3 + 2 >= S.bDir.size():
+			continue
+		n += 1
+		var w: float = WorldField.recordWater(S, S.bDir[i * 3], S.bDir[i * 3 + 1], S.bDir[i * 3 + 2], SimField.buildingGround(S, i))
+		if w > 1.0:
+			wet += 1
+			worst = maxf(worst, w)
+	SimCore.dispose(S)
+	return [n, wet, worst]
+
+
+func _init() -> void:
+	var planet: int = 7
+	var touch: int = 3
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--planet="):
+			planet = int(a.substr(9))
+		elif a.begins_with("--touch="):
+			touch = int(a.substr(8))
+	var off: Array = _read(planet, touch, -1.0)
+	var on: Array = _read(planet, touch, 8.0)
+	print("      planet %d, touch %d: lakeMax off: %d buildings, %d in water over 1 (deepest %.0f); lakeMax 8: %d buildings, %d in water over 1 (deepest %.1f)" % [planet, touch, off[0], off[1], off[2], on[0], on[1], on[2]])
+	ok(int(off[1]) >= 5 and float(off[2]) > 40.0, "off: the towns stand in lakes (the fault: %d buildings, the deepest %.0f)" % [off[1], off[2]])
+	ok(float(on[2]) <= 8.0 + 1.0 and int(on[1]) <= 3, "lakeMax 8: no building's base is under more than 8 of water (%d in water over 1, deepest %.1f)" % [on[1], on[2]])
+	ok(int(on[0]) >= int(float(off[0]) * 0.97) and int(on[0]) < int(off[0]), "and the towns stay: %d of %d buildings are laid (at least 97 percent, and some were dropped)" % [on[0], off[0]])
+	WorldPlan.lakeMaxOverride = -2.0
+	WorldFieldCache.enabledOverride = -1
+	WorldPlan.everywhereOverride = -1
+	print("LAKEPLACES: %d check(s) failed" % fails)
+	quit(0 if fails == 0 else 1)
