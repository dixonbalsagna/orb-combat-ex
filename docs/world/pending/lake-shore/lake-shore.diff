--- /dev/null
+++ b/sim/world/tools/lake_shore_check.gd
@@ -0,0 +1,78 @@
+extends SceneTree
+# No lake's water begins above its shore (World, sim/world/waterrec.gd lakeOf, data/biomes/field.json plans.lakeSpill; docs/world/lake-shore.md). A gen 3 planet's lake is the ring plan's level (a valley's rim on one line) flooded
+# in 2D out to a distance. The land round it can open sideways below that level, and the flood used to stop at the distance, so the water ended in the air over a hillside: on planet 7 every lake had about half of its shore
+# links open (the ground beyond the water below its level), the worst 2,898 units. With lakeSpill the level is the lower of the plan's and the spill (the lowest pass out of the basin) and no link is open.
+#   godot --headless --path . --script res://sim/world/tools/lake_shore_check.gd
+var fails: int = 0
+
+
+func ok(cond: bool, what: String) -> void:
+	if cond:
+		print("  ok   ", what)
+	else:
+		fails += 1
+		print("  FAIL ", what)
+
+
+## [lakes, nodes, shore links, open links (a node with water in it beside a node outside the lake whose ground is below the level by more than 1), the deepest open one] over the planet's lake records.
+func _read(planet: int, touch: int, spill: int) -> Array:
+	WorldClimate.useGen(3)
+	WorldWaterRec.spillOverride = spill
+	WorldFieldCache.enabledOverride = 0
+	WorldPlanet.forget()
+	var S := SimCore.createSim()
+	SimCore.newMatch(S, 4, {}, {"planet": planet, "touch": touch, "planetGen": 3, "intro": false})
+	var F: WorldField.Field = WorldField.of(WorldPlanet.make(planet))
+	var s2: int = F.side * F.side
+	var lakes: int = 0
+	var nn: int = 0
+	var edge: int = 0
+	var open: int = 0
+	var worst: float = 0.0
+	for rec in S.fieldRecs:
+		if str(rec.k) != "lake":
+			continue
+		lakes += 1
+		var level: float = float(rec.level)
+		for idx in rec.nodes:
+			nn += 1
+			if float(F.h[idx]) >= level - 1.0:
+				continue   # a node at or above the level holds no water: a shore, not an edge of the water
+			var cf: int = int(idx) / s2
+			var rem: int = int(idx) - cf * s2
+			var j: int = rem / F.side
+			var i: int = rem - j * F.side
+			for nb in [[i - 1, j], [i + 1, j], [i, j - 1], [i, j + 1]]:
+				var ni: int = WorldWaterRec._nodeAcross(F, cf, nb[0], nb[1])
+				if not rec.nodes.has(ni):
+					edge += 1
+					if float(F.h[ni]) < level - 1.0:
+						open += 1
+						worst = maxf(worst, level - float(F.h[ni]))
+	SimCore.dispose(S)
+	return [lakes, nn, edge, open, worst]
+
+
+func _init() -> void:
+	var cases: Array = [[7, 3], [12, 1], [3, 2]]
+	var tot_off: int = 0
+	var tot_on: int = 0
+	var worst_off: float = 0.0
+	var nodes_off: int = 0
+	var nodes_on: int = 0
+	for c in cases:
+		var off: Array = _read(int(c[0]), int(c[1]), 0)
+		var on: Array = _read(int(c[0]), int(c[1]), 1)
+		print("      planet %d touch %d: %d lakes; off: %d nodes, %d of %d shore links open (worst %.0f); on: %d nodes, %d of %d open (worst %.1f)" % [c[0], c[1], off[0], off[1], off[3], off[2], off[4], on[1], on[3], on[2], on[4]])
+		tot_off += int(off[3])
+		tot_on += int(on[3])
+		worst_off = maxf(worst_off, float(off[4]))
+		nodes_off += int(off[1])
+		nodes_on += int(on[1])
+	ok(tot_off > 100 and worst_off > 500.0, "off: lakes' water meets dry land above its shore (%d shore links open, the worst %.0f units)" % [tot_off, worst_off])
+	ok(tot_on == 0, "lakeSpill: no lake's water begins above its shore: %d open shore links" % tot_on)
+	ok(nodes_on > 0, "and some water stays: %d nodes of the %d the plan's levels held (only the real basins: the rest was water over slopes)" % [nodes_on, nodes_off])
+	WorldWaterRec.spillOverride = -1
+	WorldFieldCache.enabledOverride = -1
+	print("LAKESHORE: %d check(s) failed" % fails)
+	quit(0 if fails == 0 else 1)
