diff --git a/sim/world/tools/civilians_removed_check.gd b/sim/world/tools/civilians_removed_check.gd
new file mode 100644
index 0000000..12d603f
--- /dev/null
+++ b/sim/world/tools/civilians_removed_check.gd
@@ -0,0 +1,83 @@
+extends SceneTree
+# QA's civilians-removed run (World, sim/world/collateral.gd removeCivilians, sim/world/planet_world.gd; Legal RL-244 condition 4; docs/world/civilians-removed.md): a setup with "civilians": false has no people; with the key
+# absent or true nothing changes; the buildings, the terrain and pop0 are the same either way, so the two runs differ only by the people.
+#   godot --headless --path . --script res://sim/world/tools/civilians_removed_check.gd -- [--planet=7] [--touch=1]
+var fails: int = 0
+
+
+func ok(cond: bool, what: String) -> void:
+	if cond:
+		print("  ok   ", what)
+	else:
+		fails += 1
+		print("  FAIL ", what)
+
+
+func _match(planet: int, touch: int, setup_extra: Dictionary) -> SimState:
+	WorldClimate.useGen(3)
+	WorldPlan.everywhereOverride = 1
+	WorldPlanet.forget()
+	var su := {"intro": false, "planet": planet, "touch": touch, "planetGen": 3}
+	su.merge(setup_extra)
+	var S := SimCore.createSim()
+	SimCore.newMatch(S, 1, {}, su)
+	for i in range(30):
+		SimCore.step(S)
+	return S
+
+
+func _people(S: SimState) -> float:
+	var n: float = 0.0
+	for b in S.buildings:
+		n += float(b.pop) + float(b.popAlive)
+	return n
+
+
+func _init() -> void:
+	var planet: int = 7
+	var touch: int = 1
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--planet="):
+			planet = int(a.substr(9))
+		elif a.begins_with("--touch="):
+			touch = int(a.substr(8))
+	var plans: Dictionary = WorldField.data().get("plans", {})
+	var keep_fp = plans.get("farPeople", false)
+	plans["farPeople"] = true
+	var A := _match(planet, touch, {})
+	var B := _match(planet, touch, {"civilians": true})
+	var C := _match(planet, touch, {"civilians": false})
+	ok(_people(A) > 100.0 and _people(A) == _people(B), "with the key absent or true there are people (%.0f) and nothing changes" % _people(A))
+	ok(str(SimHash.stateHash(A).gameplay) == str(SimHash.stateHash(B).gameplay), "a setup with civilians true is the same match as one without the key")
+	ok(_people(C) == 0.0, "with civilians false no building holds a person (pop and popAlive, first ring and far places: %.0f)" % _people(C))
+	var hist: float = 0.0
+	for v in C.popHist:
+		hist += v
+	ok(hist == 0.0, "and the lure histogram is empty")
+	ok(C.world.pop0 == A.world.pop0 and C.world.present == A.world.present, "pop0 and the budget's basis are what they were (%.0f), so the meters keep their scale" % C.world.pop0)
+	var same: bool = C.buildings.size() == A.buildings.size()
+	for i in range(mini(C.buildings.size(), A.buildings.size())):
+		var a = A.buildings[i]
+		var c = C.buildings[i]
+		if a.x != c.x or a.w != c.w or a.h != c.h or a.maxhp != c.maxhp or a.z != c.z:
+			same = false
+	ok(same, "the buildings are the same (%d, places, sizes, hit points)" % C.buildings.size())
+	var gdiff: bool = false
+	for i in range(0, SimConst.NC, 97):
+		if WorldTerrain.baseAt(A, i) != WorldTerrain.baseAt(C, i):
+			gdiff = true
+	ok(not gdiff, "and so is the ground")
+	# a blast over the first ring kills nobody
+	var bx: float = 0.0   # the most peopled building of the first ring
+	var best: float = -1.0
+	for i in range(A.bFirst):
+		if A.buildings[i].popAlive > best:
+			best = A.buildings[i].popAlive
+			bx = A.buildings[i].x
+	WorldStructures.damageArea(C, bx, 100.0, 3000.0, 1.0e6, C.fighters[0], false, 0.0, -1, 0.0, 1.0)
+	WorldStructures.damageArea(A, bx, 100.0, 3000.0, 1.0e6, A.fighters[0], false, 0.0, -1, 0.0, 1.0)
+	ok(C.world.casualties == 0.0 and C.world.evacuated == 0.0, "a blast over the town takes no one in the run without people (%.0f lost, %.0f fled)" % [C.world.casualties, C.world.evacuated])
+	ok(A.world.casualties > 0.0 or A.world.evacuated > 0.0, "control: the same blast takes people in the run with them (%.0f lost, %.0f fled)" % [A.world.casualties, A.world.evacuated])
+	plans["farPeople"] = keep_fp
+	print("CIVILIANSREMOVED: %d check(s) failed" % fails)
+	quit(0 if fails == 0 else 1)
