+	WorldStore.add(B, q[0], q[1], q[2], 100.0, 10.0, 2.0, 1.0, 0, 0, 5.0, 0, -1, 0, 3.5)
+	ok(A.storeHash != B.storeHash, "a record's water level is folded into the hash")
+	var C := _mk()
+	_hit(C, x)
+	WorldStore.add(C, q[0], q[1], q[2], 100.0, 10.0, 2.0, 1.0, 0, 0, 5.0, 0, -1, 1)
