+## Reads the columns round the blows at both levels, so the field's memos are filled.
+func _warm(S: SimState) -> void:
+	SimField._fresh(S)
+	var c: int = int(floor(SimWrap.wrap(S.fighters[0].x) / SimConst.COL))
+	for i in range(c - 120, c + 121):
