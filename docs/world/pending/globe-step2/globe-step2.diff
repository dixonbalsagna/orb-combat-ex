+		ok(inl != null and I.store[WorldStore.O_WATER] == WorldStore.DRY, "an inland crater with no source holds no water")
+		ok(WorldFill.floodDepth(I, qi[0], qi[1], qi[2], -50.0) == 0.0, "... and the flood reads nothing there")
