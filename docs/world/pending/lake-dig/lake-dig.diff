+	# the ground the bowl may take: joined to the seed through nodes of the footprint at most maxD over the level, other than the lower ground the natural flood did not hold
+	var C: Dictionary = {best: true}
+	var stack: Array = [best]
+	while not stack.is_empty():
+		var cur: int = stack.pop_back()
+		for ni in _nb4(F, cur):
+			if C.has(ni) or not fp.has(ni):
+				continue
+			var hn: float = float(F.h[ni])
+			if hn > L + maxD or (hn < L and not nat.has(ni)):
