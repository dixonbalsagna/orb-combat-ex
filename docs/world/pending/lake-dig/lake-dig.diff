+## Is the water over any of eight points on the circle round the footprint's centre (the half diagonal: the footprint turned to any line has its corners on it) deeper than `lake_max`? The same points as _overhangs.
+static func _cornersDrowned(S: SimState, P: WorldPlanet.Planet, id: int, yaw: float, u: float, v: float, hw: float, hd: float, lake_max: float) -> bool:
+	var r: float = sqrt(hw * hw + hd * hd)
+	var q4: float = SimMathx.f64("3fe921fb54442d18")   # pi/4 from its bits
+	for k in range(8):
+		var qc: Array = pointOf(P, id, yaw, u + r * SimDetMath.cos(float(k) * q4), v + r * SimDetMath.sin(float(k) * q4))
+		var gc: float = WorldField.applyRecords(S, qc[0], qc[1], qc[2], WorldField.heightBake(P, qc[0], qc[1], qc[2]), P)
+		if WorldField.recordWater(S, qc[0], qc[1], qc[2], gc, P) > lake_max:
+			return true
+	return false
+
+
