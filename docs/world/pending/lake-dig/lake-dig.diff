+	var slope: float = 0.97 * float(cfg.get("slope", 0.33)) / sqrt(2.0)   # the distance below is the length of the way along the grid (4-neighbours): a diagonal covers up to 1.41 times its straight length; 0.97 is a margin for the cube's face edges, where the grid's neighbours are not symmetric
