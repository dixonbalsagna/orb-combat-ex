+		return {}
+	# the distance of each cut node from the new shore (a cut node that touches a node not cut is the shore: 0), along the grid in units (a priority search)
+	var dist: Dictionary = {}
+	var heap: Array = []
+	for n in dug:
+		for ni in _nb4(F, n):
+			if not dug.has(ni):
+				dist[n] = 0.0
+				heap.append([0.0, n])
+				break
+	while not heap.is_empty():
+		var top: Array = heap.pop_front()
+		var cn: int = int(top[1])
+		var dn: float = float(top[0])
+		if dn > float(dist[cn]):
+			continue
+		for ni in _nb4(F, cn):
+			if not dug.has(ni):
+				continue
+			var nd2: float = dn + _edgeLen(F, cn, ni)
+			if not dist.has(ni) or nd2 < float(dist[ni]):
+				dist[ni] = nd2
+				var lo: int = 0
+				var hi: int = heap.size()
+				while lo < hi:
+					var mid: int = (lo + hi) / 2
+					if float(heap[mid][0]) <= nd2:
+						lo = mid + 1
+					else:
+						hi = mid
+				heap.insert(lo, [nd2, ni])
+	var g: Dictionary = {}
+	var seed: int = -1
+	var sg: float = 1.0e18
+	for n in dug:
+		var gd: float = L - minf(maxD, slope * float(dist.get(n, 0.0)))
+		var gn: float = minf(gd, float(F.h[n]))
+		if gd < float(F.h[n]):
+			g[n] = gd
+		if gn < sg:
+			sg = gn
+			seed = n
+	if seed < 0 or sg >= L:
+		digLog.append("footprint %d, cut %d, dug %d: nothing under the level: not dug" % [fp.size(), C.size(), dug.size()])
+		return {}
+	var fl: Dictionary = _spillFlood(F, seed, L, q, maxr, claimed, g)
+	var L2: float = float(fl.level)
+	var share: float = float(fl.members.size()) / float(fp.size())
+	digLog.append("footprint %d, cut %d, dug %d (rim %d), water %d (%.2f of the footprint), level %.1f (plan %.1f)%s%s" % [fp.size(), C.size(), g.size(), C.size() - dug.size(), fl.members.size(), share, L, planLevel, "" if L2 >= L - 0.001 else ", still leaks to %.1f" % L2, "" if fl.members.size() >= minNodes else ", under minNodes"])
+	if L2 < L - 0.001 or fl.members.size() < minNodes:
+		return {}
+	if not digNoTwins:   # a node on an edge of the cube is stored under its twin on the next face too (the water's nodes and the dug floors): a reader looks a cell's corners up by the face the point is on
+		var tg: Dictionary = {}
+		for n in g:
+			for t in _twinsOf(F, int(n)):
+				tg[t] = g[n]
+		for t in tg:
+			g[t] = tg[t]
+		var tm: Dictionary = {}
+		for n in fl.members:
+			for t in _twinsOf(F, int(n)):
+				tm[t] = true
+		for t in tm:
+			fl.members[t] = true
+		digEdgeAliases += tg.size()
+	return {"level": L, "nodes": fl.members, "dug": g, "area": fl.members.size(), "planned": fp.size()}
+
