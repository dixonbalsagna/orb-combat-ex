+## A big bowl brings down what stands in it (craters.json collapse, off by default; docs/world/crater-collapse.md; Legal RL-232). It follows from the size of the bowl, which is the energy spent: nothing here picks a place or reads
+## a block's size, its occupants or the people near it, and a barred landmark (noTarget) is not levelled (WorldStructures.levelIn). The cap is the existing one (the fighter's beamLevelCapShare of the first ring). The meteor's own
+## blast is Encounter's (DirArc), so a meteor dig skips this.
+static func _collapse(S: SimState, rec, cause, kind: String, z: float) -> void:
+	var c: Dictionary = WorldCraters.collapse()
+	if not bool(c.enabled) or rec.r < float(c.minR) or not (c.kinds as Array).has(kind):
+		return
+	var zz: float = z if not is_nan(z) else (float(cause.z) if (cause != null and "z" in cause) else 0.0)
+	var share: float = float(c.capShare)
+	if cause != null and "ld" in cause and cause.ld != null and cause.ld.beamLevelCapShare.size() > 3:
+		share = float(cause.ld.beamLevelCapShare[3])
+	var cap: int = maxi(1, int(SimMathx.jround(share * float(WorldStructures.ringCount(S)))))
+	WorldStructures.levelIn(S, float(rec.x), zz, float(c.reach) * float(rec.r), cause, cap, float(c.keep), float(rec.r), float(c.dent))
+
+
 static func _digRead(S: SimState, x: float, energy: float, cause, kind: String, dirx: float = 0.0, vert: float = 1.0, special: bool = false, z: float = NAN, shape: PackedFloat64Array = PackedFloat64Array(), meteor: bool = false):
 	if kind == "impact" and not meteor and int(WorldBrunt.cfg().repeatMarks) > 0:
 		var rp: Array = _repeat(S, x, energy, special, shape[WorldCraters.S_R] if shape.size() > 0 else 1.0)
