+        "maxS": {
+          "type": "number",
+          "exclusiveMinimum": 0.0,
+          "maximum": 1000.0,
+          "description": "The most (above minS: WorldCampaign's load)."
+        },
+        "climaxMaxS": {
+          "type": "number",
+          "exclusiveMinimum": 0.0,
+          "maximum": 1000.0,
+          "description": "The most for the climax before it counts as the build-up."
