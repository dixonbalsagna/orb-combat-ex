+		while left > 0 and not done:
+			if cur.is_empty():
+				if idx >= cand.size():
+					_finish()
+					continue
+				cur = cand[idx]
+				idx += 1
+				tried += 1
+				curCounts = WorldPlanet._evalCounts(P, cur, standing)
+				left -= 1
+				if curCounts[0] < needC or curCounts[1] < needT:
+					_judge(WorldPlanet._evalSkipped(curCounts[0], curCounts[1]))
+				else:
+					curSeen = [0, 0, 0, 0, 0, 0, 0]
+					curK = 0
+				continue
+			WorldPlanet._evalSample(P, cur, curK, cnt, curSeen)
+			curK += 1
+			left -= 1
+			if curK >= cnt:
+				_judge(WorldPlanet._evalFinish(P.c, curCounts[0], curCounts[1], curSeen, cnt))
+		return units - maxi(0, left)
+
+	func _judge(e: Dictionary) -> void:
+		var c: Dictionary = P.c
+		var circ: Dictionary = cur
+		cur = {}
+		if either:
+			if WorldPlanet.meets(c, e, false):
+				result = {"ok": true, "relaxed": false, "circle": circ, "tried": tried, "eval": e, "T": T, "index": tried - 1}
+				done = true
+			elif rel.is_empty() and WorldPlanet.meets(c, e, true):
+				rel = {"ok": true, "relaxed": true, "circle": circ, "tried": tried, "eval": e, "T": T, "index": tried - 1}
+		elif WorldPlanet.meets(c, e, relaxed):
+			result = {"ok": true, "circle": circ, "tried": tried, "eval": e, "T": T, "index": tried - 1}
+			done = true
+
+	func _finish() -> void:
+		if either and not rel.is_empty():
+			result = rel
+		elif either:
+			result = {"ok": false, "relaxed": false, "circle": {}, "tried": tried, "eval": {}, "T": T, "index": -1}
+		else:
+			result = {"ok": false, "circle": {}, "tried": tried, "eval": {}, "T": T, "index": -1}
+		done = true
+
+	func progress() -> float:
+		return 1.0 if done else minf(0.99, float(idx) / float(maxi(1, cand.size())))
+
+
+class SliceJob extends RefCounted:
+	var P: WorldPlanet.Planet
+	var circ: Dictionary
+	var standing: PackedByteArray
+	var S: WorldPlanet.Slice
+	var key: String = ""
+	var done: bool = false
+	var phase: int = 0            # 0 the coarse read, 1 the full read filling in
+	var pos: int = 0
+	var order := PackedInt32Array()
+	var coarse := PackedInt32Array()
+	var baseH := PackedFloat64Array()
+	var haveBase := PackedByteArray()
+	var nc: int = 0
+	var stride: int = 1
+
+	func _init(planet: WorldPlanet.Planet, circ_: Dictionary, T: Array, standing_: PackedByteArray, key_: String = "") -> void:
+		P = planet
+		circ = circ_
+		standing = standing_
+		key = key_
+		nc = SimConst.NC
+		stride = WorldPlanet.COARSE_STRIDE if nc % WorldPlanet.COARSE_STRIDE == 0 else 1
+		S = WorldPlanet.Slice.new()
+		S.seed = P.seed
+		S.circ = circ
+		S.T = T
+		S.provisional = true
+		S.heights.resize(nc)
+		S.biomes.resize(nc)
+		baseH.resize(nc)
+		haveBase.resize(nc)
+		order = WorldPlanet.columnOrder(nc)
+		for i in order:
+			if i % stride == 0:
+				coarse.append(i)
+
+	func step(units: int) -> int:
+		var left: int = units
+		var u: Array = circ.u
+		var v: Array = circ.v
+		var c: Dictionary = P.c
+		while left > 0 and not done:
+			if phase == 0:
+				if pos >= coarse.size():
+					_interpolate()
+					phase = 1
+					pos = 0
+					left -= 8
+					continue
+				var i: int = coarse[pos]
+				pos += 1
+				left -= 1
+				var ang: float = float(i - WorldPlanet.TOUCH_COL) * SimConst.COL / P.R
+				var co: float = SimDetMath.cos(ang)
+				var si: float = SimDetMath.sin(ang)
+				WorldPlanet.surfAt(P, u[0] * co + v[0] * si, u[1] * co + v[1] * si, u[2] * co + v[2] * si)
+				baseH[i] = P.outH
+				haveBase[i] = 1
+				S.heights[i] = P.outH
+				S.biomes[i] = P.outB
+			else:
+				if pos >= order.size():
+					_finish()
+					continue
+				var j: int = order[pos]
+				pos += 1
+				left -= 1
+				if haveBase[j] == 1:
+					WorldPlanet._columnInto(P, c, u, v, j, S, true, baseH[j], S.biomes[j])
+				else:
+					WorldPlanet._columnInto(P, c, u, v, j, S, false, 0.0, 0)
+		return units - maxi(0, left)
+
+	## The columns between the coarse ones: heights on a straight line between their neighbours, the biome of the nearer. Provisional: every one is replaced in phase 1.
+	func _interpolate() -> void:
+		for i in range(nc):
+			if haveBase[i] == 1:
+				continue
+			var a: int = (i / stride) * stride
+			var b: int = (a + stride) % nc
+			var t: float = float(i - a) / float(stride)
+			S.heights[i] = baseH[a] + (baseH[b] - baseH[a]) * t
+			S.biomes[i] = S.biomes[a] if t < 0.5 else S.biomes[b]
+
+	func _finish() -> void:
+		WorldPlanet._heldInto(P, S, circ, standing)
+		S.provisional = false
+		if key != "":
+			WorldPlanet._storeSlice(key, S)
+		done = true
+
+	func progress() -> float:
+		if done:
+			return 1.0
+		if phase == 0:
+			return 0.1 * float(pos) / float(maxi(1, coarse.size()))
+		return 0.1 + 0.9 * float(pos) / float(maxi(1, order.size()))
+
+
+## The whole load for a touch-down: the planet's places, the pick, the slice. `slice` is the provisional slice from the pick onward (coarse, then filling in), the final one
+## when `done`; `ok` is false when no circle met the minimum.
+class LoadJob extends RefCounted:
+	var seed: int
+	var touch: int
+	var standing: PackedByteArray
+	var relaxed: bool
+	var stage: int = 0            # 0 the planet, 1 the pick, 2 the slice, 3 done
+	var placeJob: WorldPlanet.PlaceJob
+	var pickJob: WorldPlanet.PickJob
+	var sliceJob: WorldPlanet.SliceJob
+	var slice: WorldPlanet.Slice = null
+	var key: String = ""
+	var ok: bool = true
+	var done: bool = false
+
+	func _init(seed_: int, touch_: int, standing_: PackedByteArray, relaxed_: bool) -> void:
+		seed = seed_
+		touch = touch_
+		standing = standing_
+		relaxed = relaxed_
+		key = WorldPlanet.sliceKey(seed, touch, standing, relaxed)
+		if WorldPlanet._slices.has(key):
+			slice = WorldPlanet._slices[key]
+			stage = 3
+			done = true
+			return
+		placeJob = WorldPlanet.PlaceJob.new(seed)
+
+	func step(units: int) -> int:
+		var left: int = units
+		while left > 0 and not done:
+			if stage == 0:
+				left -= placeJob.step(left)
+				if placeJob.done:
+					pickJob = WorldPlanet.PickJob.new(placeJob.P, touch, standing, relaxed, false)
+					stage = 1
+			elif stage == 1:
+				left -= pickJob.step(left)
+				if pickJob.done:
+					if not pickJob.result.ok:
+						ok = false
+						stage = 3
+						done = true
+					else:
+						sliceJob = WorldPlanet.SliceJob.new(placeJob.P, pickJob.result.circle, pickJob.result.T, standing, key)
+						slice = sliceJob.S
+						stage = 2
+			elif stage == 2:
+				left -= sliceJob.step(left)
+				if sliceJob.done:
+					stage = 3
+					done = true
+		return units - maxi(0, left)
+
+	## Does what is left in one call: for a skipped intro, a replay, a headless run. The result is the same bits.
+	func finishNow() -> void:
+		while not done:
+			step(1000000)
+
+	func progress() -> float:
+		if done:
+			return 1.0
+		if stage == 0:
+			return 0.25 * placeJob.progress()
+		if stage == 1:
+			return 0.25 + 0.05 * pickJob.progress()
+		return 0.3 + 0.7 * sliceJob.progress()
+
+	func stageName() -> String:
+		return ["the planet", "the slice's circle", "the ground", "ready"][stage]
+
+
+static func beginLoad(seed: int, touch: int, standing: PackedByteArray = PackedByteArray(), relaxed: bool = false) -> LoadJob:
+	return LoadJob.new(seed, touch, standing, relaxed)
diff --git a/sim/world/tools/planet_job_check.gd b/sim/world/tools/planet_job_check.gd
new file mode 100644
index 0000000..0d1ca7a
--- /dev/null
+++ b/sim/world/tools/planet_job_check.gd
@@ -0,0 +1,169 @@
+extends SceneTree
+# WorldPlanet's time-sliced loading: a job gives the same bits as the whole call however it is stepped.
+#   godot --headless --path . --script res://sim/world/tools/planet_job_check.gd
+var fails: int = 0
+
+
+func ok(c: bool, w: String) -> void:
+	print("  %s  %s" % ["ok  " if c else "FAIL", w])
+	if not c:
+		fails += 1
+
+
+func hexd(x: float) -> String:
+	var b := PackedByteArray()
+	b.resize(8)
+	b.encode_double(0, x)
+	return b.hex_encode()
+
+
+func placesKey(P: WorldPlanet.Planet) -> String:
+	var s: String = "%d:" % P.n
+	for i in range(P.n):
+		s += "%s%s%s%d%s;" % [hexd(P.px[i]), hexd(P.py[i]), hexd(P.pz[i]), P.kind[i], hexd(P.rad[i])]
+	for i in range(P.people.size()):
+		s += str(P.people[i]) + ","
+	return s
+
+
+func _init() -> void:
+	# ---- the order
+	var ord: PackedInt32Array = WorldPlanet.columnOrder(SimConst.NC)
+	var seen := {}
+	for i in ord:
+		seen[i] = true
+	ok(ord.size() == SimConst.NC and seen.size() == SimConst.NC and ord[0] == WorldPlanet.TOUCH_COL and ord[1] == WorldPlanet.TOUCH_COL + 1 and ord[2] == WorldPlanet.TOUCH_COL - 1, "the columns come nearest the touch-down first, each once (%d)" % ord.size())
+	# ---- the places: a job gives the planet the whole call gives, for any chunk
+	WorldPlanet.forget()
+	var Pw: WorldPlanet.Planet = WorldPlanet.make(7)
+	var want: String = placesKey(Pw)
+	var p11w: WorldPlanet.Planet = WorldPlanet.make(11)
+	var want11: String = placesKey(p11w)
+	var allSame: bool = true
+	var chunks := [1, 37, 1000000]
+	for ch in chunks:
+		WorldPlanet.forget()
+		var job := WorldPlanet.PlaceJob.new(7)
+		var guard: int = 0
+		while not job.done and guard < 100000:
+			job.step(ch)
+			guard += 1
+		if placesKey(job.P) != want:
+			allSame = false
+	ok(allSame, "the places of planet 7 are the same bits stepped by 1, 37 or all at once")
+	WorldPlanet.forget()
+	var j11 := WorldPlanet.PlaceJob.new(11)
+	while not j11.done:
+		j11.step(500)
+	ok(placesKey(j11.P) == want11, "and planet 11's")
+	var memo := WorldPlanet.PlaceJob.new(11)
+	ok(memo.done and memo.P == j11.P, "a finished planet is memoised: the next job is done at once")
+	# ---- the pick
+	WorldPlanet.forget()
+	var P: WorldPlanet.Planet = WorldPlanet.make(7)
+	var pickSame: bool = true
+	for t in range(14):
+		for mode in [0, 1, 2]:
+			var wholeD: Dictionary
+			var job2: WorldPlanet.PickJob
+			if mode == 0:
+				wholeD = WorldPlanet.pick(P, t)
+				job2 = WorldPlanet.PickJob.new(P, t, PackedByteArray(), false, false)
+			elif mode == 1:
+				wholeD = WorldPlanet.pick(P, t, PackedByteArray(), true)
+				job2 = WorldPlanet.PickJob.new(P, t, PackedByteArray(), true, false)
+			else:
+				wholeD = WorldPlanet.pickEither(P, t)
+				job2 = WorldPlanet.PickJob.new(P, t, PackedByteArray(), false, true)
+			var guard2: int = 0
+			while not job2.done and guard2 < 10000:
+				job2.step(1 + (t * 7) % 60)
+				guard2 += 1
+			var r2: Dictionary = job2.result
+			if r2.ok != wholeD.ok or r2.index != wholeD.index or r2.tried != wholeD.tried or hexd(r2.T[0]) != hexd(wholeD.T[0]):
+				pickSame = false
+			if mode == 2 and r2.relaxed != wholeD.relaxed:
+				pickSame = false
+	ok(pickSame, "a pick job gives the pick, relaxed pick and offers' pick of 14 touch-downs (same circle, index, tries, point), stepped by 1 to 60")
+	# ---- the slice
+	var pr: Dictionary = WorldPlanet.pick(P, 3)
+	var whole: WorldPlanet.Slice = WorldPlanet.readSlice(P, pr.circle, pr.T)
+	var wantHash: int = WorldPlanet.sliceHash(whole)
+	var hashes := []
+	for ch2 in [1, 13, 500, 1000000]:
+		var sj := WorldPlanet.SliceJob.new(P, pr.circle, pr.T, PackedByteArray())
+		var g: int = 0
+		while not sj.done and g < 100000:
+			sj.step(ch2)
+			g += 1
+		hashes.append(WorldPlanet.sliceHash(sj.S))
+		if ch2 == 1000000:
+			ok(sj.S.held.size() == whole.held.size() and not sj.S.provisional, "the finished slice holds the same places and is no longer provisional")
+	ok(hashes[0] == wantHash and hashes[1] == wantHash and hashes[2] == wantHash and hashes[3] == wantHash, "the slice hash is the whole read's (%08x) stepped by 1, 13, 500 or all at once" % wantHash)
+	# the coarse stage, and nearest first
+	var sj2 := WorldPlanet.SliceJob.new(P, pr.circle, pr.T, PackedByteArray())
+	var coarseUnits: int = sj2.coarse.size() + 8
+	sj2.step(coarseUnits)
+	var sumErr: float = 0.0
+	var worstErr: float = 0.0
+	var biomeSame: int = 0
+	for i in range(SimConst.NC):
+		var e: float = absf(sj2.S.heights[i] - whole.heights[i])
+		sumErr += e
+		worstErr = maxf(worstErr, e)
+		if sj2.S.biomes[i] == whole.biomes[i]:
+			biomeSame += 1
+	ok(sj2.S.provisional and sj2.phase == 1, "after the coarse stage (%d columns of work) the slice is provisional and the full read is next" % coarseUnits)
+	print("        coarse read against the full one: mean height error %.1f units, worst %.0f; biomes equal in %.1f%% of columns" % [sumErr / SimConst.NC, worstErr, 100.0 * float(biomeSame) / SimConst.NC])
+	sj2.step(300)
+	var nearFinal: bool = true
+	for k in range(ord.size()):
+		if k >= 300:
+			break
+		var col: int = ord[k]
+		if sj2.S.heights[col] != whole.heights[col] or sj2.S.biomes[col] != whole.biomes[col]:
+			nearFinal = false
+	ok(nearFinal, "after 300 units of the full read the 300 columns nearest the touch-down are already final")
+	# a slice through both poles (the floes and bergs the coarse read cannot see)
+	var poles: Dictionary = WorldPlanet.circleOf(pr.T, WorldPlanet._unit(WorldPlanet._cross(pr.T, [0.0, 1.0, 0.0])))
+	var wholeP: WorldPlanet.Slice = WorldPlanet.readSlice(P, poles, pr.T)
+	var sjp := WorldPlanet.SliceJob.new(P, poles, pr.T, PackedByteArray())
+	sjp.step(sjp.coarse.size() + 8)
+	var polarBiomeSame: int = 0
+	for i in range(SimConst.NC):
+		if sjp.S.biomes[i] == wholeP.biomes[i]:
+			polarBiomeSame += 1
+	print("        through both poles: coarse biomes equal in %.1f%% of columns" % (100.0 * float(polarBiomeSame) / SimConst.NC))
+	sjp.step(1000000)
+	ok(WorldPlanet.sliceHash(sjp.S) == WorldPlanet.sliceHash(wholeP), "a polar slice finishes to the whole read's bits as well")
+	# ---- the whole load
+	WorldPlanet.forget()
+	var lj := WorldPlanet.beginLoad(7, 3)
+	var stages := {}
+	var frames: int = 0
+	while not lj.done and frames < 100000:
+		lj.step(30)
+		stages[lj.stage] = true
+		frames += 1
+	var ref: WorldPlanet.Slice = WorldPlanet.sliceFor(7, 3)
+	ok(lj.done and lj.ok and WorldPlanet.sliceHash(lj.slice) == wantHash and ref == lj.slice, "a load job (planet, pick, slice) finishes in %d frames of 30 units to the same slice, and the memo holds it" % frames)
+	ok(lj.slice != null and not lj.slice.provisional and lj.progress() == 1.0, "and reports done")
+	WorldPlanet.forget()
+	var lj2 := WorldPlanet.beginLoad(7, 3)
+	lj2.step(5)
+	var prov: bool = lj2.stage == 0
+	lj2.step(9000)
+	var sawProv: bool = lj2.slice != null and lj2.slice.provisional
+	lj2.finishNow()
+	ok(prov and sawProv and lj2.done and WorldPlanet.sliceHash(lj2.slice) == wantHash, "finishNow after a partial step gives the same bits (a skipped intro does not skip the load)")
+	var lj3 := WorldPlanet.beginLoad(7, 3)
+	ok(lj3.done and lj3.slice == lj2.slice, "a load of a slice already memoised is done at once")
+	# a touch-down with no slice: ok is false and the job ends
+	WorldPlanet.forget()
+	var standingNone := PackedByteArray()
+	standingNone.resize(WorldPlanet.make(7).n)
+	var lj4 := WorldPlanet.beginLoad(7, 5, standingNone)
+	lj4.finishNow()
+	ok(lj4.done and not lj4.ok and lj4.slice == null, "with every place fallen no circle is found: the job ends with ok false")
+	print("PLANETJOB: %d check(s) failed" % fails)
+	quit()
diff --git a/sim/world/tools/planet_job_measure.gd b/sim/world/tools/planet_job_measure.gd
new file mode 100644
index 0000000..cbed2c6
--- /dev/null
+++ b/sim/world/tools/planet_job_measure.gd
@@ -0,0 +1,52 @@
+extends SceneTree
+# What the time-sliced load costs a frame. A host loop of 4 ms budgets is simulated: the module owns no clock; this tool does.
+#   godot --headless --path . --script res://sim/world/tools/planet_job_measure.gd      (run at below-normal priority; a busy machine makes every number an upper bound)
+func pct(a: Array, p: float) -> float:
+	if a.is_empty():
+		return 0.0
+	a.sort()
+	return float(a[mini(a.size() - 1, int(float(a.size()) * p))]) / 1000.0
+
+
+func run(label: String, seed: int, touch: int, budgetUs: int) -> void:
+	WorldPlanet.forget()
+	var frames: int = 0
+	var fr: Array = []
+	var calls := [[], [], []]
+	var t_all: int = Time.get_ticks_usec()
+	var job: WorldPlanet.LoadJob = WorldPlanet.beginLoad(seed, touch)
+	var firstCoarse: int = -1
+	while not job.done and frames < 100000:
+		var t0: int = Time.get_ticks_usec()
+		var stage: int = job.stage
+		while Time.get_ticks_usec() - t0 < budgetUs and not job.done:
+			var c0: int = Time.get_ticks_usec()
+			job.step(4)
+			if stage < 3:
+				calls[mini(stage, 2)].append(Time.get_ticks_usec() - c0)
+		fr.append(Time.get_ticks_usec() - t0)
+		frames += 1
+		if firstCoarse < 0 and job.stage == 2 and job.sliceJob.phase == 1:
+			firstCoarse = Time.get_ticks_usec() - t_all
+	var total: float = 0.0
+	for x in fr:
+		total += x
+	print("%s: %d frames at a %d us budget, %.0f ms of work; frame median %.1f ms, 99th %.1f ms, worst %.1f ms; coarse ground ready after %.0f ms" % [label, frames, budgetUs, total / 1000.0, pct(fr, 0.5), pct(fr, 0.99), pct(fr, 1.0), firstCoarse / 1000.0])
+	print("      a 4-unit call: places median %.2f / 99th %.2f ms; pick %.2f / %.2f ms; ground %.2f / %.2f ms" % [pct(calls[0], 0.5), pct(calls[0], 0.99), pct(calls[1], 0.5), pct(calls[1], 0.99), pct(calls[2], 0.5), pct(calls[2], 0.99)])
+
+
+func _init() -> void:
+	run("planet 7, touch 3", 7, 3, 4000)
+	run("planet 7, touch 9", 7, 9, 4000)
+	run("planet 11, touch 2", 11, 2, 4000)
+	# the whole call for comparison
+	WorldPlanet.forget()
+	var t0: int = Time.get_ticks_usec()
+	var P := WorldPlanet.make(7)
+	var t1: int = Time.get_ticks_usec()
+	var pr := WorldPlanet.pick(P, 3)
+	var t2: int = Time.get_ticks_usec()
+	WorldPlanet.readSlice(P, pr.circle, pr.T)
+	var t3: int = Time.get_ticks_usec()
+	print("the whole calls: places %.0f ms, pick %.0f ms, slice %.0f ms" % [(t1 - t0) / 1000.0, (t2 - t1) / 1000.0, (t3 - t2) / 1000.0])
+	quit()
