+	ok(WorldProps.local("tank", "frame").is_empty() and WorldProps.local("bike", "wing").is_empty() and WorldProps.holdPoint("tank", "top", 0.0, 0.0, 0.0).is_empty(), "an unknown class or slot gives []")
