+	if kind == "impact" and int(WorldBrunt.cfg().repeatMarks) > 0:
+		var rp: Array = _repeat(S, x, energy, special)
+		x = rp[0]
+		energy = rp[1]
 	if not S.depthOn:
 		return _dig(S, x, energy, cause, kind, dirx, vert, special)
 	var zz: float = z
