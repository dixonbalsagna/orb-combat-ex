@@ -467,3 +469,127 @@ static func bossRing(P: WorldPlanet.Planet, homeId: int, standing: PackedByteArr
 	if _dot(cr, cr) < 1.0e-12:
 		return null
 	return {"c": WorldPlanet._unit(cr), "t": a, "cols": SimConst.PLANET_NC, "other": best}
+
+
+# ===================================================================== story stages
+
+const GROUNDS_PATH := "res://data/narrative/opponent_grounds.json"
+static var _grounds: Dictionary = {}   # Narrative's claims by roster id: a pure read of a data file, memoised outside the sim state
+
+
+## Narrative's claims (data/narrative/opponent_grounds.json), by the opponent's roster id (RIVAL, EMPRESS, CYBORG, PROTAGONIST). {} if the file cannot be read.
+static func grounds() -> Dictionary:
+	if _grounds.is_empty():
+		var j = JSON.parse_string(FileAccess.get_file_as_string(GROUNDS_PATH))
+		if j is Dictionary and j.get("claims") is Dictionary:
+			_grounds = j.claims
+	return _grounds
+
+
+## The stand-in home until Orb names the homes (homework 39): the most populous city still standing (ties to the lower id); the most populous place if no city stands; -1 if nothing does.
+static func standInHome(P: WorldPlanet.Planet, standing: PackedByteArray = PackedByteArray()) -> int:
+	var best: int = -1
+	for pass_ in range(2):
+		for i in range(P.n):
+			if standing.size() > 0 and standing[i] == 0:
+				continue
+			if pass_ == 0 and int(P.kind[i]) != WorldPlanet.KIND_CITY:
+				continue
+			if best < 0 or P.people[i] > P.people[best]:
+				best = i
+		if best >= 0:
+			break
+	return best
+
+
+## The ring for a stage of a run, in steps (the host spends a few candidates a frame across the previous stage's beats: `step(n)`, true when it is made; `result` then). stage:
+##   kind       "first" (a Close ring round the player's home), "early", "mid", "late" (the stage before the boss), "proving" (a Proving ground), "boss" (the Whole circle through the boss's home and
+##              the most populous place still standing)
+##   opponent   the opponent's roster id (the key of his claim); a first stage and a boss's ring read no claim
+##   home       a place id: the player's home for "first", the boss's for "boss", the claim's for the rest (-1: none). Absent: standInHome
+##   standing   the places still standing (a byte each, as WorldPlanet's); absent: all
+##   damaged    the wear (the picker's `damaged`); absent: none
+##   size       "close", "half" or "whole": a size forced in place of the claim's (absent: the claim's, by data/biomes/rings.json stage.claimKey; a Proving ground's by stage.proving)
+## `stream`: the run's seeded stream for this stage (the picker's, as pick takes it). A pure function of the planet, the stage, the stream and the data, so a run replays.
+## result: {ok, arena (setup.arena: {cols, c, t} as exact bits), spec {c, t, cols}, stage, opponent, size, home, place, kind, score, must, relaxed, tried}, or {ok: false, error, arena: {}}.
+static func beginStage(P: WorldPlanet.Planet, stage: Dictionary, stream: int) -> StageJob:
+	var j := StageJob.new()
+	j.P = P
+	j.stage = stage
+	var kind: String = str(stage.get("kind", "early"))
+	var opp: String = str(stage.get("opponent", ""))
+	var standing: PackedByteArray = stage.get("standing", PackedByteArray())
+	var home: int = int(stage.home) if stage.has("home") else standInHome(P, standing)
+	j.home = home
+	if kind == "first":
+		if home < 0:
+			return j._fail("no home to fight round")
+		return j._made(firstRing(P, home, stream), "close", home, home, "round")
+	if kind == "boss":
+		var br = bossRing(P, home, standing) if home >= 0 else null
+		if br != null:
+			return j._made({"c": br.c, "t": br.t, "cols": br.cols}, "whole", home, int(br.other), "through")
+		pass   # no ring through two places: the claim's own Whole pick, below
+	var claims: Dictionary = grounds()
+	if not claims.has(opp):
+		return j._fail("no claim for '%s'" % opp)
+	var claim: Dictionary = claims[opp]
+	var sz: String = str(stage["size"]) if stage.has("size") else ""
+	if sz == "":
+		if kind == "proving":
+			sz = str(cfg().stage.proving)
+		else:
+			var key: String = str(cfg().stage.claimKey.get(kind, "mid"))
+			sz = str(claim.get("size", {}).get(key, "half"))
+	j.size = sz
+	j._pick = beginPick(P, claim, sz, stream, {"standing": standing, "damaged": stage.get("damaged", []), "home": home})
+	j.total = j._pick.cands.size()
+	return j
+
+
+## The same, all at once (a tool, a test, a host that does not mind the wait: 120 to 330 ms native).
+static func stageArena(P: WorldPlanet.Planet, stage: Dictionary, stream: int) -> Dictionary:
+	var job: StageJob = beginStage(P, stage, stream)
+	job.finishNow()
+	return job.result
+
+
+class StageJob extends RefCounted:
+	var P: WorldPlanet.Planet
+	var stage: Dictionary = {}
+	var home: int = -1
+	var size: String = ""
+	var total: int = 0          # candidates to read (0 for a first stage or a boss's ring: made at once)
+	var done: bool = false
+	var result: Dictionary = {}
+	var _pick: WorldRingPick.PickJob = null
+
+	## Reads up to n more candidates; true when the stage's ring is made.
+	func step(n: int) -> bool:
+		if not done and _pick != null and _pick.step(n):
+			var r: Dictionary = _pick.result
+			result = {"ok": r.ok, "arena": WorldRingPick.arenaOf(r.spec), "spec": r.spec, "stage": str(stage.get("kind", "early")), "opponent": str(stage.get("opponent", "")), "size": size, "home": home,
+				"place": r.place, "kind": r.kind, "score": r.score, "must": r.must, "relaxed": r.relaxed, "tried": r.tried}
+			done = true
+		return done
+
+	func finishNow() -> void:
+		step(1 << 30)
+
+	## 0 to 1: how much of the pick is read (a ring made at once is 1).
+	func progress() -> float:
+		if done or _pick == null:
+			return 1.0
+		return float(_pick.evs.size()) / float(maxi(total, 1))
+
+	func _made(spec: Dictionary, sz: String, homeId: int, place: int, kind: String) -> StageJob:
+		size = sz
+		result = {"ok": true, "arena": WorldRingPick.arenaOf(spec), "spec": spec, "stage": str(stage.get("kind", "early")), "opponent": str(stage.get("opponent", "")), "size": sz, "home": homeId,
+			"place": place, "kind": kind, "score": 0.0, "must": true, "relaxed": false, "tried": 0}
+		done = true
+		return self
+
+	func _fail(why: String) -> StageJob:
+		result = {"ok": false, "error": why, "arena": {}, "spec": {}, "stage": str(stage.get("kind", "early")), "opponent": str(stage.get("opponent", ""))}
+		done = true
+		return self
diff --git a/sim/world/tools/stage_check.gd b/sim/world/tools/stage_check.gd
new file mode 100644
index 0000000..b55f8ce
--- /dev/null
+++ b/sim/world/tools/stage_check.gd
@@ -0,0 +1,88 @@
+extends SceneTree
+# The ring picker's story-stage entry point (WorldRingPick.stageArena / beginStage / StageJob; data/biomes/rings.json stage):
+#   godot --headless --path . --script res://sim/world/tools/stage_check.gd
+var fails: int = 0
+
+
+func ok(c: bool, w: String) -> void:
+	print("  %s  %s" % ["ok  " if c else "FAIL", w])
+	if not c:
+		fails += 1
+
+
+func _init() -> void:
+	ok(WorldRingPick.dataErrors().is_empty(), "rings.json is clean with its stage block (%s)" % str(WorldRingPick.dataErrors()))
+	var claims: Dictionary = WorldRingPick.grounds()
+	ok(claims.keys() == ["RIVAL", "EMPRESS", "CYBORG", "PROTAGONIST"], "Narrative's claims load by roster id (%s)" % str(claims.keys()))
+	var P := WorldPlanet.make(7)
+	var home: int = WorldRingPick.standInHome(P)
+	var other: int = -1
+	for i in range(P.n):
+		if i != home and int(P.kind[i]) == WorldPlanet.KIND_CITY and (other < 0 or P.people[i] > P.people[other]):
+			other = i
+	ok(home >= 0 and int(P.kind[home]) == WorldPlanet.KIND_CITY and WorldRingPick.standInHome(P, PackedByteArray()) == home, "the stand-in home is the most populous city (place %d of planet 7)" % home)
+	# --- the first stage: a Close ring round the player's home
+	var f: Dictionary = WorldRingPick.stageArena(P, {"kind": "first", "opponent": "RIVAL"}, 11)
+	var fr: Dictionary = WorldRingPick.firstRing(P, home, 11)
+	var back: Dictionary = WorldRingPick.ringOfArena(JSON.parse_string(JSON.stringify(f.arena)))
+	var ring: Dictionary = WorldRingPick.ringFrom(fr.c, fr.cols, fr.t)
+	ok(f.ok and f.size == "close" and f.arena.cols == 1200 and f.spec.cols == fr.cols and f.spec.c == fr.c and f.spec.t == fr.t and f.spec.c[0] * P.px[home] + f.spec.c[1] * P.py[home] + f.spec.c[2] * P.pz[home] > 0.999999 and back.c == ring.c, "kind first: the Close ring centred on the home (firstRing), through setup.arena and JSON bit for bit")
+	# --- the boss: the Whole circle through the home and the next most populous place
+	var b: Dictionary = WorldRingPick.stageArena(P, {"kind": "boss", "opponent": "EMPRESS"}, 12)
+	var br = WorldRingPick.bossRing(P, home, PackedByteArray())
+	ok(b.ok and b.size == "whole" and b.arena.cols == 4800 and b.place == int(br.other) and b.spec.c == br.c and b.kind == "through", "kind boss: the Whole circle through the home and place %d, the most populous other (bossRing)" % b.place)
+	# --- the picks: sizes by claim and kind
+	var sizes := {}
+	for opp in ["RIVAL", "EMPRESS", "CYBORG", "PROTAGONIST"]:
+		for kind in ["early", "mid", "late", "proving"]:
+			var r: Dictionary = WorldRingPick.stageArena(P, {"kind": kind, "opponent": opp}, 21)
+			sizes["%s/%s" % [opp, kind]] = [r.size, r.ok]
+	var sizeOk: bool = sizes["RIVAL/early"][0] == "close" and sizes["EMPRESS/early"][0] == "half" and sizes["RIVAL/mid"][0] == "half" and sizes["CYBORG/late"][0] == "half" and sizes["PROTAGONIST/early"][0] == "close"
+	for k in sizes:
+		if k.ends_with("/proving") and sizes[k][0] != "close":
+			sizeOk = false
+	ok(sizeOk, "sizes: a claim's early, mid and late read its size keys (RIVAL early close, EMPRESS early half, mid and late half), a Proving ground is Close")
+	var okCount: int = 0
+	for k in sizes:
+		if sizes[k][1]:
+			okCount += 1
+	ok(okCount >= 14, "%d of 16 picks on planet 7 found a ring that meets their size's minimum" % okCount)
+	# --- stepped is the same as all at once, and the same twice
+	var stage := {"kind": "mid", "opponent": "CYBORG"}
+	var whole: Dictionary = WorldRingPick.stageArena(P, stage, 33)
+	var job: WorldRingPick.StageJob = WorldRingPick.beginStage(P, stage, 33)
+	var steps: int = 0
+	while not job.step(3):
+		steps += 1
+		if job.progress() > 1.0:
+			break
+	ok(job.done and JSON.stringify(job.result.arena) == JSON.stringify(whole.arena) and job.result.score == whole.score and steps > 5 and job.total > 10 and WorldRingPick.stageArena(P, stage, 33).arena == whole.arena, "a stepped pick (%d candidates, %d steps of 3) is the one made at once, and the same twice" % [job.total, steps + 1])
+	var different: bool = false
+	for sd in range(34, 40):
+		if WorldRingPick.stageArena(P, stage, sd).arena != whole.arena:
+			different = true
+	ok(different, "another stream gives another ring")
+	# --- the stage's inputs: standing, damaged, home, forced size, and errors
+	var standing := PackedByteArray()
+	standing.resize(P.n)
+	standing.fill(1)
+	standing[home] = 0
+	ok(WorldRingPick.standInHome(P, standing) != home and WorldRingPick.stageArena(P, {"kind": "boss", "standing": standing}, 5).place != home, "a fallen home is not the stand-in, nor a boss's second place")
+	var forced: Dictionary = WorldRingPick.stageArena(P, {"kind": "late", "opponent": "RIVAL", "size": "whole"}, 41)
+	ok(forced.size == "whole" and forced.arena.cols == 4800, "a size in the stage forces it")
+	var hnone: Dictionary = WorldRingPick.stageArena(P, {"kind": "early", "opponent": "RIVAL", "home": -1}, 42)
+	var hset: Dictionary = WorldRingPick.stageArena(P, {"kind": "early", "opponent": "RIVAL", "home": other}, 42)
+	ok(hnone.home == -1 and hset.home == other and hnone.ok and hset.ok, "home in the stage is used as given (-1 for none)")
+	var bad: Dictionary = WorldRingPick.stageArena(P, {"kind": "early", "opponent": "NOBODY"}, 1)
+	ok(not bad.ok and bad.has("error") and bad.arena.is_empty(), "an opponent with no claim is a refusal with its reason, not a crash")
+	# --- a stage's ring plays: the match takes setup.arena as it is
+	var S := SimCore.createSim()
+	SimCore.newMatch(S, 1, {}, {"planet": 7, "touch": 3, "arena": f.arena, "intro": false})
+	var S2 := SimCore.createSim()
+	SimCore.newMatch(S2, 1, {}, {"planet": 7, "touch": 3, "arena": whole.arena, "intro": false})
+	for t in range(60):
+		SimCore.step(S)
+		SimCore.step(S2)
+	ok(S.arenaCols == 1200 and S2.arenaCols == int(whole.arena.cols) and S.fighters.size() == 2 and S2.buildings.size() >= 0, "a first stage and a mid stage's arenas play (%d and %d columns, 60 ticks each)" % [S.arenaCols, S2.arenaCols])
+	print("STAGE: %d check(s) failed" % fails)
+	quit()
