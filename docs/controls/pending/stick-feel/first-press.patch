 ## SimCore.step took the intents: every device's edges are spent.
 func consumed() -> void:
+	var refuse: int = SimInputData.ti(["strike", "refuseTicks"], 30)
+	for s in range(2):
+		if int(_stick_wait[s]) >= 0:
+			_stick_wait[s] += 1
