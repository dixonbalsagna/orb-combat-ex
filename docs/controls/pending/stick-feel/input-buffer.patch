-## The rumble the hub itself asks for (switches.hapticLadder): the host calls this once a tick after the intents and plays each {slot, kind, scale} as it plays
-## a cue's. Empty with the switch off. A pulse is never the only cue.
+## The host's word each tick that a slot's fighter can start a strike now (true when it never says): the input buffer (strike.bufferTicks) waits for it. See SimLayout.set_can_act.
+func set_can_act(slot: int, on: bool) -> void:
+	if slot < 0 or slot > 1:
+		return
+	if slot_device[slot] == "pad":
+		var d: int = slot_pad[slot]
+		if pads.has(d):
+			pads[d].set_can_act(on)
+	elif slot_device[slot] != "touch":
+		_kb_layout(slot).set_can_act(on)
+
+
 ## The host's word that the director started a slot's stick strike (Encounter's `stick_start` cue): the request was answered, so no refusal. Call it from the cue loop.
 func note_stick_started(slot: int) -> void:
 	if slot >= 0 and slot <= 1:
 		_stick_wait[slot] = -1
 
 
+## The rumble the hub itself asks for (switches.hapticLadder): the host calls this once a tick after the intents and plays each {slot, kind, scale} as it plays
+## a cue's. Empty with the switch off. A pulse is never the only cue.
 func take_haptics() -> Array:
 	var out: Array = _haptic_pending
 	_haptic_pending = []
 	return out
 
 
-## The ladder's rumble (pitch 1): one pulse as each rung of a held strike's charge is reached, once. Called with each slot's intent as it is built.
+## A buffered request ran out of time (the layout's refused_edge): the pad is told, once.
+func _note_buffer_expired(slot: int) -> void:
+	var lay = null
+	if slot_device[slot] == "pad":
+		lay = pads.get(slot_pad[slot])
+	elif slot_device[slot] != "touch":
+		lay = _kb_layout(slot)
+	if lay != null and bool(lay.refused_edge) and SimInputData.haptic_refused_on():
+		_haptic_pending.append({"slot": slot, "kind": "stick_refused", "scale": 1.0})
+
+
 func _note_refusal(slot: int, i: SimIntent) -> void:
 	if not SimInputData.haptic_refused_on():
 		_stick_wait[slot] = -1
@@ -838,6 +861,7 @@ func _note_refusal(slot: int, i: SimIntent) -> void:
 		_stick_wait[slot] = 0
 
 
+## The ladder's rumble (pitch 1): one pulse as each rung of a held strike's charge is reached, once. Called with each slot's intent as it is built.
 func _note_ladder(slot: int, i: SimIntent) -> void:
 	if not SimInputData.haptic_ladder_on():
 		_ladder_prev[slot] = 0
