diff --git a/sim/input/test/stick_feel_test.gd b/sim/input/test/stick_feel_test.gd
index 666d0a8..5a2306f 100644
--- a/sim/input/test/stick_feel_test.gd
+++ b/sim/input/test/stick_feel_test.gd
@@ -33,6 +33,7 @@ func _init() -> void:
 	_zero()
 	_refused()
 	_specials_off()
+	_buffer()
 	_sw(true, true, false, false)
 	_off()
 	_sw(false, false, false, false)
@@ -606,3 +607,123 @@ func _specials_off() -> void:
 	SimInputData.timing["switches"] = sw
 	SimInputData.clear_overrides()
 	SimInputData.invalidate()
+
+
+## The input buffer (strike.bufferTicks): a stick request that finds the fighter unable to act waits for him, newest flick only, and is dropped (and told) if he cannot in time.
+func _set_buffer(n: int) -> void:
+	var st: Dictionary = SimInputData.timing.get("strike", {})
+	st["bufferTicks"] = n
+	SimInputData.timing["strike"] = st
+	SimInputData.clear_overrides()
+	SimInputData.invalidate()
+
+
+## A flick (right, or the direction given) at tick `at`, held `hold` ticks; can_act is false until tick `free_at` (-1: always true). Returns [start tick, release tick, dir, refused tick, intents].
+func _buf_run(free_at: int, at: int = 10, hold: int = 3, ang: float = 0.0, second: Array = [], faces: Array = []) -> Array:
+	var l: SimLayout = SimLayout.new(SimInputData.preset("arena"))
+	var its: Array = []
+	var refused: int = -1
+	for t in range(80):
+		l.set_can_act(free_at < 0 or t >= free_at)
+		var m: float = 1.0 if (t >= at and t < at + hold) else 0.0
+		var x: float = cos(deg_to_rad(ang)) * m
+		var y: float = sin(deg_to_rad(ang)) * m
+		for sec in second:
+			if t >= int(sec[0]) and t < int(sec[0]) + int(sec[1]):
+				x = cos(deg_to_rad(float(sec[2])))
+				y = sin(deg_to_rad(float(sec[2])))
+		l.axis("pad:rs", x, y)
+		for f in faces:
+			if t == int(f):
+				l.press("pad:west")
+			if t == int(f) + 2:
+				l.release("pad:west")
+		its.append(l.build())
+		if l.refused_edge and refused < 0:
+			refused = t
+		l.consumed()
+	return [_first(its, "rsStart"), _first(its, "rsRelease"), (its[maxi(_first(its, "rsStart"), 0)] as SimIntent).rsDir, refused, its]
+
+
+func _buffer() -> void:
+	var settle: int = SimInputData.ti(["strike", "settleQuick"], 1)
+	# off: the request starts as it always did, whatever the fighter can do
+	_set_buffer(0)
+	var off: Array = _buf_run(40)
+	ok(off[0] == 10 + settle and off[3] < 0, "buffer off: a flick starts at once even if he cannot act (start %d)" % off[0])
+	# on, he can act: no change
+	_set_buffer(9)
+	var free: Array = _buf_run(-1)
+	ok(free[0] == off[0], "buffer on, he can act: the same start (%d)" % free[0])
+	# on, he cannot act at first and can 5 ticks later: the request starts the first tick he can, with the flick's own direction, throwing at once if the stick is back
+	var late: Array = _buf_run(18)
+	ok(late[0] == 18 and late[1] == 18 and late[2] == SimStrikeRead.RIGHT and late[3] < 0, "buffer on: a flick made at 10 while he cannot act starts the tick he can (18), as a quick strike, toward (start %d, release %d, dir %d)" % [late[0], late[1], late[2]])
+	# on, the stick is still out when he can act: it starts then and is held
+	var held: Array = _buf_run(16, 10, 30)
+	ok(held[0] == 16 and held[1] > 16, "buffer on: a stick still out when he can act starts then and stays held (start %d, release %d)" % [held[0], held[1]])
+	# the window: waiting is allowed for the buffer's ticks from the earliest start, then the request is dropped and told once
+	var expired: Array = _buf_run(60)
+	ok(expired[0] < 0 and expired[3] == 10 + settle + 9, "buffer on: he cannot act for good: the request is dropped %d ticks after it could have started, and told once (refused at %d)" % [9, expired[3]])
+	var edge: Array = _buf_run(10 + settle + 8)
+	ok(edge[0] == 10 + settle + 8 and edge[3] < 0, "buffer on: he can act on the last tick of the window: it starts (%d)" % edge[0])
+	# the next flick after an expiry works
+	var l: SimLayout = SimLayout.new(SimInputData.preset("arena"))
+	var got: int = -1
+	for t in range(100):
+		l.set_can_act(t >= 60)
+		l.axis("pad:rs", 1.0 if ((t >= 10 and t < 13) or (t >= 70 and t < 73)) else 0.0, 0.0)
+		if l.build().rsStart and got < 0:
+			got = t
+		l.consumed()
+	ok(got >= 70, "buffer on: after an expiry the stick must rest, and a later flick starts normally (%d)" % got)
+	# newest flick only: a second flick to the left replaces the first while he cannot act
+	var two: Array = _buf_run(22, 10, 3, 0.0, [[16, 3, 180.0]])
+	ok(two[0] == 22 and two[2] == SimStrikeRead.LEFT, "buffer on: two flicks while he cannot act: the newest (left) is the one that starts (start %d, dir %d)" % [two[0], two[2]])
+	var n_starts: int = 0
+	for it in two[4]:
+		if (it as SimIntent).rsStart:
+			n_starts += 1
+	ok(n_starts == 1, "buffer on: only one strike starts")
+	# the law is unchanged: a face press while the request waits goes through and holds the strike R from it
+	var rev: int = SimInputData.ti(["strike", "reverseLockout"], 8)
+	var withface: Array = _buf_run(14, 10, 3, 0.0, [], [12])
+	var lt: int = -1
+	for t in range(withface[4].size()):
+		if (withface[4][t] as SimIntent).light and lt < 0:
+			lt = t
+	ok(lt == 12 and withface[0] >= 12 + rev, "buffer on: a face press at 12 while the request waits still goes out (light %d) and the strike waits R = %d from it (start %d)" % [lt, rev, withface[0]])
+	# the hub tells the pad when a buffered request expires (switches.hapticRefused)
+	var sw: Dictionary = SimInputData.timing.get("switches", {})
+	sw["hapticRefused"] = true
+	SimInputData.timing["switches"] = sw
+	var hub: SimInputHub = _hub_pad()
+	var knocks: int = 0
+	for t in range(80):
+		hub.set_can_act(0, false)
+		hub.pad_stick_right(7, 1.0 if (t >= 10 and t < 13) else 0.0, 0.0)
+		hub.intent(0)
+		knocks += hub.take_haptics().size()
+		hub.consumed()
+		knocks += hub.take_haptics().size()
+	ok(knocks == 1, "buffer on: an expired request knocks the pad once (%d)" % knocks)
+	sw["hapticRefused"] = false
+	SimInputData.timing["switches"] = sw
+	# the swapped layout makes the same stream under the buffer
+	var sa: SimLayout = SimLayout.new(SimInputData.preset("arena"))
+	var sb: SimLayout = SimLayout.new(SimInputData.preset("arena-swapped"))
+	var same: bool = true
+	for t in range(120):
+		var can: bool = (t % 40) >= 15
+		sa.set_can_act(can)
+		sb.set_can_act(can)
+		var mm: float = 1.0 if (t % 40) in [10, 11, 12] else 0.0
+		sa.axis("pad:rs", mm, 0.0)
+		sb.axis("pad:ls", mm, 0.0)
+		var ia: SimIntent = sa.build()
+		var ib: SimIntent = sb.build()
+		sa.consumed()
+		sb.consumed()
+		if SimIntent.pack(ia) != SimIntent.pack(ib) or SimIntent.pack2(ia) != SimIntent.pack2(ib):
+			same = false
+	ok(same, "buffer on: arena and arena-swapped make one stream")
+	_set_buffer(0)
