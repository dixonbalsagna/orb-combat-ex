diff --git a/sim/input/test/push_stick_test.gd b/sim/input/test/push_stick_test.gd
index 91c7dd5..be722f9 100644
--- a/sim/input/test/push_stick_test.gd
+++ b/sim/input/test/push_stick_test.gd
@@ -51,6 +51,8 @@ func _switches(right: bool, refused: bool, ladder: bool = false) -> void:
 	sw["specialsOff"] = false
 	sw["hapticRefused"] = refused
 	sw["hapticLadder"] = ladder
+	sw["hapticStages"] = false   # the hub's own ladder pulses (checks G) are the path with the director's stage cues off; hapticStages (on in the shipped data) hands them to the cues, which stage_cue_test checks
+	sw["flickKept"] = false   # and the hub's "no answer" after refuseTicks 30 (checks F); flickKept (on in the shipped data) waits 120
 	SimInputData.timing["switches"] = sw
 	SimInputData.clear_overrides()
 	SimInputData.invalidate()
diff --git a/sim/input/test/refusal_cue_test.gd b/sim/input/test/refusal_cue_test.gd
index 81bd86b..5c308bc 100644
--- a/sim/input/test/refusal_cue_test.gd
+++ b/sim/input/test/refusal_cue_test.gd
@@ -23,6 +23,8 @@ func _init() -> void:
 	sw["hapticRefused"] = true
 	sw["hapticStages"] = false
 	sw["hapticImpact"] = false
+	sw["chargeLostCue"] = false   # these checks are of the stick_refused knock for a charge a blow took; chargeLostCue (on in the shipped data) turns it into the lost-charge pulse, which charge_lost_test checks
+	sw["flickKept"] = false   # and of refuseTicks 30: flickKept (on in the shipped data) waits refuseTicksKept 120, which flick_kept's own checks (below) cover
 	SimInputData.timing["switches"] = sw
 	SimInputData.clear_overrides()
 	SimInputData.invalidate()
