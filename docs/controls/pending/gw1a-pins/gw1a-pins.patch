 	su["intro"] = false
 	su["power"] = true
 	su["travel"] = 1.5
+	su["dash"] = nine
+	su["kick"] = nine
+	su["slip"] = nine
+	var arrive_was = DirBands.data()["arrive"]["enabled"]
+	DirBands.data()["arrive"]["enabled"] = nine
 	var S := SimCore.createSim()
 	SimCore.newMatch(S, 5, {"p1": false, "p2": false}, su)
 	var a = S.fighters[0]
@@ -179,4 +201,5 @@ func _carry(release_at: int) -> float:
 		S.out.fx.clear()
