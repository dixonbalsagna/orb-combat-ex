diff -ruN a/tools/schemas/input-stances.schema.json b/tools/schemas/input-stances.schema.json
--- a/tools/schemas/input-stances.schema.json	1969-12-31 16:00:00.000000000 -0800
+++ b/tools/schemas/input-stances.schema.json	2026-10-04 20:51:44.860825200 -0700
@@ -0,0 +1,19 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "meridian/input-stances",
+  "title": "input stances (schema 1)",
+  "description": "data/input/stances.json: the hybrid stance masks that are switched on (docs/controls/lunge-control.md A2, sim/input/stance.gd). The mask is LB 1, RB 2, RT 4, LT 8. Until a mask is listed, a held pair reads as its newer button. RT (4) dominates and is never part of a hybrid. Version field: schema. Policy: closed except keys starting with an underscore.",
+  "type": "object",
+  "required": ["schema", "hybrids"],
+  "properties": {
+    "schema": { "const": 1 },
+    "hybrids": {
+      "type": "array",
+      "uniqueItems": true,
+      "items": { "enum": [3, 9, 10] },
+      "description": "3 is LB+RB (defensive ki), 9 is LT+LB (terrain while flying), 10 is LT+RB (evasive energy)."
+    }
+  },
+  "additionalProperties": false,
+  "patternProperties": { "^_": true }
+}
