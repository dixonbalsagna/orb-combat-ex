 	var pair: Array = _pair(S)
 	var a = pair[0]
 	if absf(SimWrap.sdx(fr.x0, a.x)) > SimConst.W * 0.125:
+		var synced: bool = SimField.keyedTo(S)
 		_applyTurn(fr, SimWrap.wrap(a.x + SimWrap.sdx(a.x, pair[1].x) * 0.5), 0.0)
+		if synced:
