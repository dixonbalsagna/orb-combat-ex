-          persist-credentials: false
-      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
-        with:
-          node-version: '24.19.0'
-      - uses: ./.github/actions/setup-godot
-        with:
-          linux-templates: 'true'
-      - name: Import project
-        run: '"$GODOT" --headless --path . --import'
-      # build_info.json (commit and commit date) for the feedback report; git-ignored, packed by the preset's include_filter.
-      - name: Write build_info.json
-        run: node tools/write-build-info.mjs --commit "${GITHUB_SHA}"
-      - name: Export Linux (release, Compatibility, x86_64)
-        run: |
-          mkdir -p "${RUNNER_TEMP}/linux"
-          "$GODOT" --headless --path . --export-release "Linux" "${RUNNER_TEMP}/linux/orb-combat-ex.x86_64"
-          chmod +x "${RUNNER_TEMP}/linux/orb-combat-ex.x86_64"
-          ls -l "${RUNNER_TEMP}/linux"
-      - name: The project's bench (the reference hash)
-        run: 'node tools/gate.mjs -- "$GODOT" --headless --path . --fixed-fps 60 -- --seed=4 --frames="${FRAMES}" --bench | tee "${RUNNER_TEMP}/bench-project.txt"'
-      - name: The exported binary's bench (it boots headless and plays)
