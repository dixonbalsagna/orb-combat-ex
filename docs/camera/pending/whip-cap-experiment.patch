diff --git a/render/camera/split_view.gd b/render/camera/split_view.gd
index 4ad3f707..0d7938ef 100644
--- a/render/camera/split_view.gd
+++ b/render/camera/split_view.gd
@@ -159,6 +159,13 @@ func set_depth_dolly(on: bool) -> void:
 ## The launch rule engages sooner under reduced flashing (docs/camera/buildings-in-frame.md section 15): after 0.25 of the width
 ## covered, or at a step of 0.05 of the width a tick, where the ordinary mode takes 0.6 and 0.15 (the reduced line is 0.03 where the
 ## ordinary is 0.045). Acts only with the launch rule on. Off by default. A build-time switch.
+## The whip cap (docs/camera/whip-pan.md): a pane's pan is held to 1.5 widths a second for a fast flight, until he is 0.36 of the
+## width from the focus, and the scroll governor aims lower and zooms out faster. Off by default. A build-time switch.
+func set_whip_cap(on: bool) -> void:
+	if main != null:
+		main.split_rig.whip_cap = on
+
+
 func set_launch_hold_eager(on: bool) -> void:
 	if main != null:
 		main.split_rig.launch_hold_eager = on
