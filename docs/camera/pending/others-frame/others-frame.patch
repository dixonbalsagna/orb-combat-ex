+	others_w = 0.0
+	for mw in members:
+		others_w = maxf(others_w, float(mw[1]))
+	var fx: float = mx
+	var out_d: Dictionary = {"mx": mx, "ahead": ahead, "dy": dy, "y_mid": y_mid}
+	if not members.is_empty():
+		var centre: float = (lo + hi) * 0.5
+		var pull_max: float = CamParams.MANY_PULL * vw / maxf(_mz, 0.1)
+		fx = SimWrap.wrap(mx + clampf(centre - rel_mid, -pull_max, pull_max))
+		var rel_f: float = SimWrap.sdx(A.x, fx)
+		var half: float = maxf(absf(rel_f), absf(r1 - rel_f))
+		for mw in members:
+			half = maxf(half, float(mw[1]) * absf(float(mw[0]) - rel_f))
+		out_d = {"mx": fx, "ahead": minf(SimConst.HALF, maxf(ahead, 2.0 * half)), "dy": maxf(dy, y_hi - y_lo), "y_mid": (y_lo + y_hi) * 0.5}
+	# Too far to join, near enough to show: the nearest standing other body not in the set leans the focus toward him until he
+	# stands at OTHERS_EDGE of the width from the centre, while the pair stays inside OTHERS_KEEP. The lean is an offset that moves at
+	# most OTHERS_EDGE_RATE of the width a tick (and the camera eases on top), fading out where the room left can't bring him in.
+	var zp: float = maxf(_mz, 0.001)
+	var keep_u: float = CamParams.OTHERS_KEEP * vw / zp
+	var dA: float = SimWrap.sdx(fx, A.x)
+	var dB: float = SimWrap.sdx(fx, B.x)
+	var lo_s: float = maxf(dA, dB) - keep_u
+	var hi_s: float = minf(dA, dB) + keep_u
+	var s_t: float = 0.0
+	var best: float = 1.0e18
+	for c in cand:
+		var g = c[1]
+		if float(_ow.get(int(c[0]), 0.0)) >= 0.5 or bool(g.get("out")) or float(g.y) - y_hi > CamParams.MANY_UP_BH * CamParams.BODY_H or absf(float(g.z) - fz) > CamParams.MANY_DEPTH:
+			continue
+		var rel: float = SimWrap.sdx(fx, g.x)
+		if absf(rel) >= best:
+			continue
+		best = absf(rel)
+		var need: float = absf(rel) - CamParams.OTHERS_EDGE * vw / zp
+		s_t = 0.0
+		if need > 0.0 and lo_s <= hi_s:
+			var sh: float = signf(rel) * need
+			var sh_c: float = clampf(sh, lo_s, hi_s)
+			if absf(sh_c) > 1.0:
+				s_t = sh_c * (1.0 - smoothstep(1.0, 1.3, absf(sh) / absf(sh_c)))
+	_oe_s = move_toward(_oe_s, s_t, CamParams.OTHERS_EDGE_RATE * vw / zp)
+	if lo_s <= hi_s:
+		_oe_s = clampf(_oe_s, minf(lo_s, 0.0), maxf(hi_s, 0.0))
+	if _oe_s != 0.0:
+		out_d["mx"] = SimWrap.wrap(float(out_d["mx"]) + _oe_s)
+	return out_d
+
+
 ## The framing set of a match of more than two bodies (docs/camera/one-v-many.md section 3): the principals are the one
