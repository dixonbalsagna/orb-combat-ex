diff --git a/render/camera/tests/others_frame_check.gd b/render/camera/tests/others_frame_check.gd
new file mode 100644
index 00000000..c4ccc74a
--- /dev/null
+++ b/render/camera/tests/others_frame_check.gd
@@ -0,0 +1,184 @@
+extends SceneTree
+## 2v2 with the other fight drawn: its bodies near the pair join the one view (SplitRig.frame_others, docs/camera/pending/others-frame).
+##   godot --headless --path . --script res://render/camera/tests/others_frame_check.gd
+## - the other pair comes in from far off, stays near, and goes again: all four in the picture while near, none of the
+##   others framed while far, and the moves eased (no cut, the picture's jolt and zoom jolt within launch_shots_check's limits)
+## - while the other pair is far, the frames are the same as with the switch off
+## - an other body that's out counts for nothing
+## - the fight held changes (a LAN PC whose player is out shows his partner's): the weights start again
+const JOLT_LIMIT: float = 0.06
+const ZJOLT_LIMIT: float = 0.012
+const VW: float = 1280.0
+const VH: float = 720.0
+var fails: int = 0
+var checks: int = 0
+
+
+func _ok(c: bool, what: String) -> void:
+	checks += 1
+	if not c:
+		fails += 1
+		print("FAIL  " + what)
+
+
+func _new(on: bool) -> Array:
+	var S := SimCore.createSim()
+	SimCore.newMatch(S, 77, {"p1": false, "p2": false, "p3": false, "p4": false}, {"intro": false, "fights": 2, "cross": true, "planet": 7, "touch": 3, "planetGen": 3})
+	S.dt = SplitRig.DT
+	var rig := SplitRig.new()
+	for k in ["swing_view", "peak_launch", "launch_director", "close_brawl", "readable", "follow_through", "flight_reveal"]:
+		rig.set(k, true)   # as main.gd sets the rig with tiles
+	rig.flat_mode = "wide"
+	rig.split_share = 0.7
+	rig.set("frame_others", on)   # (rig.set: the negative control runs on a rig without it)
+	SimStage.enter(S, 0)
+	var o: Array = S.stage.fights[1].fighters
+	o[0].x = SimWrap.wrap(S.fighters[0].x + 9000.0)
+	o[1].x = SimWrap.wrap(S.fighters[0].x + 9300.0)
+	rig.reset(S, VW, VH)
+	return [S, rig]
+
+
+func _place(S: SimState, d: float) -> void:
+	var o: Array = S.stage.fights[1].fighters
+	var base: float = (float(S.fighters[0].x) + float(S.fighters[1].x)) * 0.5 if absf(SimWrap.sdx(S.fighters[0].x, S.fighters[1].x)) < 2000.0 else float(S.fighters[0].x)
+	o[0].x = SimWrap.wrap(base + d)
+	o[1].x = SimWrap.wrap(base + d + 160.0)
+	for f in o:
+		f.vx = 0.0
+		f.vy = 0.0
+		f.y = (float(S.fighters[0].y) + float(S.fighters[1].y)) * 0.5   # at the pair's height (a body 8 heights over them counts for nothing)
+
+
+func _tick(S: SimState, rig: SplitRig) -> void:
+	SimStage.enter(S, 0)
+	SimCore.step(S)
+	SimStage.enter(S, 0)
+	rig.step(S, VW, VH, S.out.fx)
+	for i in range(S.stage.fights.size()):
+		var o = S.out if i == S.stage.cur else S.stage.fights[i].out
+		o.fx.clear()
+		o.feed.clear()
+
+
+func _in(f: SplitFrame, x: float, y: float) -> bool:
+	var p: Vector2 = f.screen_pos(0, x, y + CamParams.CHEST)
+	return p.x >= 0.0 and p.x <= VW and p.y >= 0.0 and p.y <= VH
+
+
+func _hash(f: SplitFrame) -> int:
+	return hash([snappedf(f.cam_x[0], 0.01), snappedf(f.cam_y[0], 0.01), snappedf(f.cam_z[0], 0.00001), snappedf(f.cam_x[1], 0.01), snappedf(f.cam_y[1], 0.01), snappedf(f.cam_z[1], 0.00001), snappedf(f.sep, 0.0001), f.mode, f.cut])
+
+
+func _comes_and_goes() -> void:
+	var sr: Array = _new(true)
+	var S: SimState = sr[0]
+	var rig: SplitRig = sr[1]
+	var prev: SplitFrame = rig.current().duplicate()
+	var last := Vector2.ZERO
+	var jolt: float = 0.0
+	var jolt_at: int = -1
+	var zj: float = 0.0
+	var cuts: int = 0
+	var near_all: int = 0
+	var near_one: int = 0
+	var near_n: int = 0
+	var far_w: float = 0.0
+	var pair_off: int = 0
+	var w_max: float = 0.0
+	for t in range(900):
+		# far (6,000) for 120 ticks, in to 1,000 over 300 (past the pair's own frame: main never shows them), near for 180, out again over 300
+		var d: float = 6000.0
+		if t >= 120 and t < 420:
+			d = lerpf(6000.0, 1000.0, smoothstep(0.0, 1.0, float(t - 120) / 300.0))
+		elif t >= 420 and t < 600:
+			d = 1000.0
+		elif t >= 600:
+			d = lerpf(1000.0, 6000.0, smoothstep(0.0, 1.0, float(t - 600) / 300.0))
+		_place(S, d)
+		_tick(S, rig)
+		var f: SplitFrame = rig.current()
+		w_max = maxf(w_max, float(rig.get("others_w") if rig.get("others_w") != null else 0.0))
+		if f.cut:
+			cuts += 1
+		if t > 10 and not f.cut and f.sep < 0.5 and prev.sep < 0.5:
+			var z: float = f.cam_z[0]
+			var s := Vector2(SimWrap.sdx(prev.cam_x[0], f.cam_x[0]) * z / VW, (f.cam_y[0] - prev.cam_y[0]) * z / VW)
+			if (s - last).length() > jolt:
+				jolt = (s - last).length()
+				jolt_at = t
+			zj = maxf(zj, absf(log(f.cam_z[0] / prev.cam_z[0])) * 0.5)
+			last = s
+		if f.sep < 0.5 and not (_in(f, S.fighters[0].x, S.fighters[0].y) and _in(f, S.fighters[1].x, S.fighters[1].y)):
+			pair_off += 1
+		if t >= 470 and t < 600:
+			near_n += 1
+			var o: Array = S.stage.fights[1].fighters
+			if f.sep < 0.5 and _in(f, o[0].x, o[0].y) and _in(f, o[1].x, o[1].y) and _in(f, S.fighters[0].x, S.fighters[0].y) and _in(f, S.fighters[1].x, S.fighters[1].y):
+				near_all += 1
+			if f.sep < 0.5 and _in(f, o[0].x, o[0].y) and _in(f, S.fighters[0].x, S.fighters[0].y) and _in(f, S.fighters[1].x, S.fighters[1].y):
+				near_one += 1
+		if t < 120 or t >= 880:
+			far_w = maxf(far_w, float(rig.get("others_w") if rig.get("others_w") != null else 0.0))
+		prev = f.duplicate()
+	print("comes and goes: all four in the picture %d of %d near ticks, the nearer other with the pair %d; weight far %.3f, most %.3f; jolt %.4f at %d, zoom jolt %.4f; cuts %d; pair off the one view %d ticks" % [near_all, near_n, near_one, far_w, w_max, jolt, jolt_at, zj, cuts, pair_off])
+	_ok(near_all == near_n, "all four in the picture only %d of %d near ticks" % [near_all, near_n])
+	_ok(far_w == 0.0, "an other body far off still weighs %.3f" % far_w)
+	_ok(w_max >= 0.999, "the other pair never fully joined (%.3f)" % w_max)
+	_ok(cuts == 0, "%d cuts" % cuts)
+	_ok(jolt <= JOLT_LIMIT, "a jolt of %.4f at tick %d" % [jolt, jolt_at])
+	_ok(zj <= ZJOLT_LIMIT, "a zoom jolt of %.4f" % zj)
+	_ok(pair_off == 0, "the pair was off the one view for %d ticks" % pair_off)
+	SimCore.dispose(S)
+
+
+func _far_same() -> void:
+	var a: Array = _new(true)
+	var b: Array = _new(false)
+	var diff: int = 0
+	for t in range(300):
+		_place(a[0], 6000.0)
+		_place(b[0], 6000.0)
+		_tick(a[0], a[1])
+		_tick(b[0], b[1])
+		if _hash(a[1].current()) != _hash(b[1].current()):
+			diff += 1
+	print("far: %d of 300 frames differ from the switch off" % diff)
+	_ok(diff == 0, "with the other pair far, %d frames differ from the switch off" % diff)
+	SimCore.dispose(a[0])
+	SimCore.dispose(b[0])
+
+
+func _out_and_change() -> void:
+	var sr: Array = _new(true)
+	var S: SimState = sr[0]
+	var rig: SplitRig = sr[1]
+	var o: Array = S.stage.fights[1].fighters
+	for t in range(120):
+		_place(S, 350.0)
+		o[0].out = true
+		o[1].out = true
+		_tick(S, rig)
+	print("out: weight %.3f" % float(rig.get("others_w") if rig.get("others_w") != null else 0.0))
+	_ok(float(rig.get("others_w") if rig.get("others_w") != null else 0.0) == 0.0, "bodies that are out weigh %.3f" % float(rig.get("others_w") if rig.get("others_w") != null else 0.0))
+	o[0].out = false
+	o[1].out = false
+	for t in range(60):
+		_place(S, 350.0)
+		_tick(S, rig)
+	var keys0: Array = rig.get("_ow").keys() if rig.get("_ow") != null else []
+	SimStage.enter(S, 1)
+	rig.step(S, VW, VH, [])
+	var keys1: Array = rig.get("_ow").keys() if rig.get("_ow") != null else []
+	print("change: keys %s then %s" % [str(keys0), str(keys1)])
+	_ok(keys0.has(8) and not keys1.has(8) and keys1.has(0), "the weights didn't start again on the fight change: %s then %s" % [str(keys0), str(keys1)])
+	SimStage.enter(S, 0)
+	SimCore.dispose(S)
+
+
+func _initialize() -> void:
+	_comes_and_goes()
+	_far_same()
+	_out_and_change()
+	print("others_frame_check: %d checks, %d failed" % [checks, fails] if fails > 0 else "others_frame_check: %d checks passed" % checks)
+	quit(1 if fails > 0 else 0)
