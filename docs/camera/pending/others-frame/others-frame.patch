+	var m: float = _m()
+	var rel_mid: float = SimWrap.sdx(A.x, mx)
+	var z0: float = zoom_u(vw, vh, maxf(ahead, hi - lo), maxf(dy, y_hi - y_lo), tier, m, false)
+	var z_lim: float = minf(maxf(CamParams.OTHERS_R_MIN * vh / CamParams.BODY_H, z0 * CamParams.OTHERS_ZKEEP), z0)   # wider than one-v-many's 0.75: another team's fight is worth a smaller pair
+	var fz: float = (float(A.z) + float(B.z)) * 0.5
+	var cand: Array = []
+	for i in range(S.stage.fights.size()):
+		if i == S.stage.cur:
+			continue
+		var fs: Array = S.stage.fights[i].fighters
+		for j in range(fs.size()):
+			cand.append([i * 8 + j, fs[j]])
+	cand.sort_custom(func(a, b): return absf(SimWrap.sdx(A.x, a[1].x) - rel_mid) < absf(SimWrap.sdx(A.x, b[1].x) - rel_mid))
+	var seen: Dictionary = {}
+	var members: Array = []
+	for c in cand:
+		var key: int = int(c[0])
+		var g = c[1]
+		seen[key] = true
+		var gy: float = float(g.y)
+		var rk: float = SimWrap.sdx(A.x, g.x)
+		var tgt: float = 0.0
+		if bool(g.get("out")) or gy - y_hi > CamParams.MANY_UP_BH * CamParams.BODY_H or absf(float(g.z) - fz) > CamParams.MANY_DEPTH:
+			tgt = 0.0
+		else:
+			var zc: float = zoom_u(vw, vh, maxf(ahead, maxf(hi, rk) - minf(lo, rk)), maxf(dy, maxf(y_hi, gy) - minf(y_lo, gy)), maxf(tier, float(g.tier)), m, false)
+			tgt = smoothstep(CamParams.MANY_JOIN * z_lim, CamParams.MANY_LEAVE * z_lim, zc)
+		var w: float = move_toward(float(_ow.get(key, 0.0)), tgt, CamParams.MANY_RATE)
+		_ow[key] = w
+		if w > 0.0:
+			lo = lerpf(lo, minf(lo, rk), w)
+			hi = lerpf(hi, maxf(hi, rk), w)
+			y_lo = lerpf(y_lo, minf(y_lo, gy), w)
+			y_hi = lerpf(y_hi, maxf(y_hi, gy), w)
+			members.append([rk, w])
+	for k in _ow.keys():
