+
+## The feed's sends, followed: before the touchdown, is the touchdown point in the picture that shows him, and how much room
+## is ahead of him (a share of the width, in the way he flies); after it, how long until the pair is in one view again, and
+## fighter-ticks outside the picture meanwhile (3 s at most).
+func _lead_tick(fr: SplitFrame, S) -> void:
+	var t: int = int(S.tick)
+	var vw: float = main.split_rig.vw
+	var vh: float = main.split_rig.vh
+	for sd in _sends:
+		if bool(sd["done"]):
+			continue
+		var v: int = int(sd["slot"])
+		var f = S.fighters[v]
+		var pi: int = v if fr.shows(v) else 0
+		if t < int(sd["n"]):
+			if f.state != "launched":
+				continue
+			var gy: float = WorldTerrain.groundY(S, float(sd["x"]))
+			var lp: Vector2 = fr.screen_pos(pi, float(sd["x"]), gy + CamParams.CHEST, float(f.z))
+			var bp: Vector2 = fr.screen_pos(pi, f.x, f.y + CamParams.CHEST, float(f.z))
+			sd["flight_n"] = int(sd["flight_n"]) + 1
+			if bp.x >= 0.0 and bp.x <= vw and bp.y >= 0.0 and bp.y <= vh:
+				sd["flight_in"] = int(sd["flight_in"]) + 1
+			if lp.x >= 0.0 and lp.x <= vw and lp.y >= 0.0 and lp.y <= vh:
+				if int(sd["seen_at"]) < 0:
+					sd["seen_at"] = t
+			else:
+				sd["seen_at"] = -1   # it must stay in view up to the touchdown to count
+			var dir: float = signf(SimWrap.sdx(f.x, float(sd["x"])))
+			if dir != 0.0:
+				sd["lead_sum"] = float(sd["lead_sum"]) + ((vw - bp.x) if dir > 0.0 else bp.x) / vw
+				sd["lead_n"] = int(sd["lead_n"]) + 1
+		else:
+			var both: bool = true
+			for fi in range(2):
+				var pj: int = fi if fr.shows(fi) else 0
+				var g = S.fighters[fi]
+				var q: Vector2 = fr.screen_pos(pj, g.x, g.y + CamParams.CHEST, float(g.z))
+				if q.x < 0.0 or q.x > vw or q.y < 0.0 or q.y > vh:
+					sd["ret_off"] = int(sd["ret_off"]) + 1
+					both = false
+			if fr.mode == "merged" and both and int(sd["ret_t"]) < 0:
+				sd["ret_t"] = t - int(sd["n"])
+			if int(sd["ret_t"]) >= 0 or t - int(sd["n"]) >= 180:
+				sd["done"] = true
+
+
+func _lead_report(label: String, mode: String) -> void:
+	var names: Array = ["up", "across", "down", "behind", "building"]
+	for sd in _sends_done:
+		var k: int = int(sd["k"])
+		var flight: int = int(sd["n"]) - int(sd["t0"])
+		var seen: int = (int(sd["n"]) - int(sd["seen_at"])) if int(sd["seen_at"]) >= 0 else 0
+		var lead: float = float(sd["lead_sum"]) / maxf(1.0, float(sd["lead_n"]))
+		print("SEND %s %s t %d %s flight %d ticks (%d chased) touchdown seen %d ticks ahead, room ahead %.2f, in frame %d of %d, back in one view after %s ticks, fighter-ticks outside %d" % [label, mode, int(sd["t0"]), names[k] if k >= 0 and k < 5 else str(k), flight, int(sd["lead_n"]), seen, lead, int(sd["flight_in"]), int(sd["flight_n"]), str(sd["ret_t"]) if int(sd["ret_t"]) >= 0 else "180+", int(sd["ret_off"])])
+
