 		var sh_l: float = CamParams.SCAPE_LEAN * vw / maxf(z, 0.001) * smoothstep(0.0, 1.0, _scape_w) * signf(SimWrap.sdx(mx, _scape_x))
@@ -5146,6 +5168,70 @@ func _ft_outputs() -> void:
 		_outs[i] = Vector3(SimWrap.wrap(o.x + ft_offset.x * w), o.y + ft_offset.y * w, o.z)
 
 
+## Once, as a brawl locks. Sky at the close size is the usual case. Then the low angle, as far as the ground rule lets it, at the close size; then today's size, with and without
+## the angle. If no normal shot would show sky, stay close: giving up size would buy nothing.
+func _brawl_sky_decide(S: SimState, mx: float, r_close: float, r_fit: float) -> void:
+	var t0: int = Time.get_ticks_usec()
+	_cbs_set = true
+	_cbs_tilt = 0.0
+	_cbs_wide = false
+	var fy: float = 0.5 * (float(S.fighters[0].y) + float(S.fighters[1].y)) + CamParams.CHEST
+	var r_c: float = maxf(r_close, r_fit)
+	var low_c: float = 0.0 if reduced_motion else _ground_low(-CamParams.SKY_TILT, r_c * vh / CamParams.BODY_H)
+	var low_f: float = 0.0 if reduced_motion else _ground_low(-CamParams.SKY_TILT, r_fit * vh / CamParams.BODY_H)
+	var g_c: PackedFloat64Array = _sky_ground(S, mx, r_c)
+	sky_choice = "none"
+	if _sky_shows(g_c, fy, r_c, 0.0):
+		sky_choice = "sky"
+	elif low_c < -0.5 and _sky_shows(g_c, fy, r_c, low_c):
+		sky_choice = "tilt"
+		_cbs_tilt = low_c
+	elif r_fit < r_c:
+		var g_f: PackedFloat64Array = _sky_ground(S, mx, r_fit)
+		if _sky_shows(g_f, fy, r_fit, 0.0):
+			sky_choice = "wide"
+			_cbs_wide = true
+		elif low_f < -0.5 and _sky_shows(g_f, fy, r_fit, low_f):
+			sky_choice = "wide tilt"
+			_cbs_wide = true
+			_cbs_tilt = low_f
+	sky_cost_us = Time.get_ticks_usec() - t0
+
+
+## The ground under the frame's columns, for a shot at size r: one read a column and depth, so a tilt's test at the same size costs nothing more.
+func _sky_ground(S: SimState, mx: float, r: float) -> PackedFloat64Array:
+	var z: float = r * vh / CamParams.BODY_H
+	var dist: float = CamParams.K_FACTOR * vh / z
+	var rad: float = CamPlaces.radius()
+	var out := PackedFloat64Array()
+	for fr in CamParams.SKY_COLS:
+		for dd in CamParams.SKY_DEPTHS:
+			var d: float = float(dd)   # behind the plane
+			var lat: float = float(fr) * 0.5 * vw / z * (dist + d) / dist
+			var sag: float = (lat * lat + d * d) / (2.0 * rad) if rad > 0.0 else 0.0
+			out.append(CamPlaces.ground_at(S, SimWrap.wrap(mx + lat), -d) - sag)
+	return out
+
+
+## Whether a shot at size r and angle deg (negative: low) shows a strip of sky: enough of the frame's columns where no ground behind the plane reaches its top.
+func _sky_shows(ground: PackedFloat64Array, fy: float, r: float, deg: float) -> bool:
+	var dist: float = CamParams.K_FACTOR * vh / (r * vh / CamParams.BODY_H)
+	var up: float = deg_to_rad(-deg)
+	var eye: float = fy - dist * tan(up - atan((CamParams.PLANE_Y - 0.5) / CamParams.K_FACTOR))
+	var top: float = tan(up + deg_to_rad(15.0 - CamParams.SKY_STRIP))
+	var nd: int = CamParams.SKY_DEPTHS.size()
+	var clear: int = 0
+	for c in range(CamParams.SKY_COLS.size()):
+		var seen: bool = true
+		for k in range(nd):
+			if ground[c * nd + k] - eye > top * (dist + float(CamParams.SKY_DEPTHS[k])):
+				seen = false
+				break
+		if seen:
+			clear += 1
+	return clear >= CamParams.SKY_NEED
+
+
 func m_close() -> float:
 	return _m()
 
diff --git a/render/camera/tests/brawl_sky_check.gd b/render/camera/tests/brawl_sky_check.gd
new file mode 100644
index 0000000..bcb295a
--- /dev/null
+++ b/render/camera/tests/brawl_sky_check.gd
@@ -0,0 +1,149 @@
+extends SceneTree
+## The latch on a skyless flank (docs/camera/launch-director.md): the decision's ladder on made-up ground, that it holds through a brawl, and what it does in real AI fights.
+##   godot --headless --path . --script res://render/camera/tests/brawl_sky_check.gd -- [--fights=4] [--list]
+
+var fails: int = 0
+var checks: int = 0
+var ridge: float = 0.0
+var list: bool = false
+
+
+func _ok(c: bool, what: String) -> void:
+	checks += 1
+	if not c:
+		fails += 1
+		print("FAIL ", what)
+
+
+func _rig(S: SimState) -> SplitRig:
+	var rig := SplitRig.new()
+	rig.swing_view = true
+	rig.peak_launch = true
+	rig.launch_director = true
+	rig.close_brawl = true
+	rig.brawl_sky = true
+	rig.reset(S, 1280.0, 720.0)
+	return rig
+
+
+func _match(seed: int, planet: int = 7) -> SimState:
+	var S: SimState = SimCore.createSim()
+	SimCore.newMatch(S, seed, {"p1": true, "p2": true}, {"planet": planet, "touch": 1, "planetGen": 3, "intro": false})
+	S.dt = SplitRig.DT
+	return S
+
+
+func _step(S: SimState, rig: SplitRig) -> SplitFrame:
+	SimCore.step(S)
+	var ev: Array = S.out.fx.duplicate()
+	S.out.fx.clear()
+	S.out.feed.clear()
+	rig.step(S, 1280.0, 720.0, ev)
+	return rig.current()
+
+
+## Ground that's `ridge` above the fighters' feet from 1,500 behind the plane on, flat in front of that.
+func _ground(S: SimState, _x: float, z: float) -> float:
+	return float(S.fighters[0].y) + (ridge if z <= -1500.0 else 0.0)
+
+
+func _ladder() -> void:
+	CamPlaces.ground_source = Callable(self, "_ground")
+	var S: SimState = _match(12345)
+	for f in S.fighters:
+		f.y = WorldTerrain.groundY(S, f.x) + 700.0
+	var rig: SplitRig = _rig(S)
+	var seen: Dictionary = {}
+	for h in [0.0, 300.0, 500.0, 600.0, 700.0, 800.0, 900.0, 1000.0, 1100.0, 1250.0, 1600.0, 2400.0, 60000.0]:
+		ridge = h
+		rig._cbs_set = false
+		rig._brawl_sky_decide(S, float(S.fighters[0].x), 0.17, 0.12)
+		if not seen.has(rig.sky_choice):
+			seen[rig.sky_choice] = h
+		print("ridge %.0f: %s, tilt %.1f" % [h, rig.sky_choice, rig._cbs_tilt])
+	_ok(seen.has("sky") and float(seen["sky"]) == 0.0, "low ground shows sky: %s" % str(seen))
+	_ok(rig.sky_choice == "none", "a huge ridge shows none: %s" % rig.sky_choice)
+	_ok(not rig._cbs_wide and rig._cbs_tilt == 0.0, "with no sky to win, the close shot stays")
+	_ok(seen.has("tilt"), "a tilt is tried first: %s" % str(seen))
+	var first_size: float = minf(float(seen.get("wide", 1.0e9)), float(seen.get("wide tilt", 1.0e9)))
+	_ok(float(seen.get("tilt", 1.0e9)) < first_size, "size only after the tilt: %s" % str(seen))
+	CamPlaces.ground_source = Callable()
+
+
+## Real fights: every lock's choice, that it never changes inside a brawl, that the angle moves eased, and the decision's cost.
+func _fights(n: int) -> void:
+	var worst_us: int = 0
+	var tally: Dictionary = {}
+	var costs: Array = []
+	for seed in range(1, n + 1):
+		var sd: int = 12345 if seed == 1 else seed
+		var S: SimState = _match(sd, 7 if seed <= 2 else [3, 11][seed % 2])
+		var rig: SplitRig = _rig(S)
+		var prev_set: bool = false
+		var big_p: float = 0.0
+		var last_p: float = 0.0
+		var changes: int = 0
+		var last_choice: String = ""
+		for t in range(3600):
+			_step(S, rig)
+			if rig._cbs_set and not prev_set:
+				tally[rig.sky_choice] = int(tally.get(rig.sky_choice, 0)) + 1
+				costs.append(rig.sky_cost_us)
+				worst_us = maxi(worst_us, rig.sky_cost_us)
+				last_choice = rig.sky_choice
+				if list:
+					print("seed %d tick %d: %s tilt %.1f, %d us, x %.0f" % [sd, S.tick, rig.sky_choice, rig._cbs_tilt, rig.sky_cost_us, S.fighters[0].x])
+			elif rig._cbs_set and rig.sky_choice != last_choice:
+				changes += 1
+			prev_set = rig._cbs_set
+			big_p = maxf(big_p, absf(rig._cbs_ang - last_p))
+			last_p = rig._cbs_ang
+		_ok(changes == 0, "seed %d: the choice changed %d times inside a brawl" % [sd, changes])
+		_ok(big_p <= CamParams.PITCH_CUT_DEG, "seed %d: the angle stepped %.2f in a tick" % [sd, big_p])
+	costs.sort()
+	var med: int = int(costs[costs.size() / 2]) if costs.size() > 0 else 0
+	print("real fights: %s, a decision costs %d us (median), %d at worst" % [str(tally), med, worst_us])
+	_ok(costs.size() > 10, "only %d decisions" % costs.size())
+	_ok(med < 3000, "a decision's median cost %d us (a busy machine reads high: it is 12 to 24 ground reads)" % med)
+
+
+## Where on the planet a brawl would need it, at two heights over the ground.
+func _scan() -> void:
+	var S: SimState = _match(12345)
+	var rig: SplitRig = _rig(S)
+	for over in [100.0, 500.0]:
+		var tally: Dictionary = {}
+		var first: Dictionary = {}
+		var worst: int = 0
+		var x: float = 0.0
+		while x < SimConst.W:
+			var g: float = WorldTerrain.groundY(S, x)
+			S.fighters[0].x = x
+			S.fighters[1].x = x
+			S.fighters[0].y = g + over
+			S.fighters[1].y = g + over
+			rig._cbs_set = false
+			rig._brawl_sky_decide(S, x, 0.17, 0.12)
+			tally[rig.sky_choice] = int(tally.get(rig.sky_choice, 0)) + 1
+			worst = maxi(worst, rig.sky_cost_us)
+			if rig.sky_choice != "sky" and int(first.get(rig.sky_choice, []).size()) < 4:
+				var a0: Array = first.get(rig.sky_choice, [])
+				a0.append(int(x))
+				first[rig.sky_choice] = a0
+			x += 400.0
+		print("scan at %.0f over the ground: %s; where: %s; worst %d us" % [over, str(tally), str(first), worst])
+
+
+func _initialize() -> void:
+	var nf: int = 4
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--fights="):
+			nf = int(a.substr(9))
+		elif a == "--list":
+			list = true
+	_ladder()
+	_fights(nf)
+	if list:
+		_scan()
+	print("brawl_sky_check: %d checks, %d failed" % [checks, fails] if fails > 0 else "brawl_sky_check: %d checks passed" % checks)
+	quit(1 if fails > 0 else 0)
