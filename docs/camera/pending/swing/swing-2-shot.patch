+## Off: a frame present with the switch off isn't read.
+func _off() -> void:
+	var S: SimState = _match()
+	S.dt = SplitRig.DT
+	var rig := SplitRig.new()
+	rig.reset(S, VW, VH)
+	theta = 1.0
+	for _t in range(10):
+		_tick(S, rig)
+	_ok(rig.current().place.is_empty() and rig.swing_gesture == 0.0 and rig._sw_ticks == 0, "the switch off read the frame")
+	theta = 0.0
