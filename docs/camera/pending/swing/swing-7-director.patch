+	var w: float = vw / z
+	var left: float = Vector2(SimWrap.sdx(pp.x, aim.x), aim.y - pp.y).length() + Vector2(_mv[i]).length()
+	_soft_on[i] = left > CamParams.SPEED_SETTLED * w
+	return bool(_soft_on[i])
+
