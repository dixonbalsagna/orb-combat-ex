 	f.flash = lerpf(a.flash, b.flash, t)
 	f.pitch = lerpf(a.pitch, b.pitch, t)
 	f.held_u = lerpf(a.held_u, b.held_u, t)
+	if a.place.size() == 7 and b.place.size() == 7:
+		f.place = _lerp_place(a.place, b.place, t)
