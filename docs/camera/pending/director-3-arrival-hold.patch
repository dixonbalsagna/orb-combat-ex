+## The arrival's widening for fighter i's pane: in over ARR_IN from the `arrive` cue, held until ARR_HOLD past the contact, out over ARR_OUT.
+func _arr_mult(i: int) -> float:
+	var t: float = float(_arr_t[i])
+	if t < 0.0:
+		return 1.0
+	var w: float = smoothstep(0.0, CamParams.ARR_IN, t)
+	var te: float = float(_arr_end[i])
+	if te >= 0.0:
+		w *= 1.0 - smoothstep(te + CamParams.ARR_HOLD, te + CamParams.ARR_HOLD + CamParams.ARR_OUT, time)
+	return 1.0 - CamParams.ARR_WIDE * w
