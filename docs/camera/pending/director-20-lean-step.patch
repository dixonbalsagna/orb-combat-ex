+## The match's landmark buildings, in S.buildings order. Made again when the list is another (a new match, a relocation's new
+## ground): another array, another size, or other buildings at its ends (World makes the buildings and their landmark at
+## generation; a building that falls stays in the list, `alive` false).
+func _landmarks(S: SimState) -> Array:
+	var bs: Array = S.buildings
+	var n: int = bs.size()
+	if is_same(bs, _lm_src) and n == _lm_n and (n == 0 or (is_same(bs[0], _lm_ends[0]) and is_same(bs[n - 1], _lm_ends[1]))):
+		return _lm_list
+	_lm_list = []
+	for b in bs:
+		if b.landmark != 0:
+			_lm_list.append(b)
+	_lm_src = bs
+	_lm_n = n
+	_lm_ends = [bs[0], bs[n - 1]] if n > 0 else [null, null]
+	return _lm_list
+
