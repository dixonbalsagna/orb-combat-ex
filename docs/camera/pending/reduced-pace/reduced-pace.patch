+++ b/render/camera/cam_places.gd
@@ -33,6 +33,14 @@ static func piece(key: String) -> bool:
 	return p is Dictionary and bool(p.get(key, false))
 
 
+## Under Reduce flashing, the camera's slower pace (data/camera/swing.json "reducedPace"): `key`'s number, or -1 when the pace is off.
+static func reduced_pace(key: String) -> float:
+	var rp = data().get("reducedPace", {})
+	if not (rp is Dictionary) or not bool(rp.get("enabled", false)):
+		return -1.0
+	return float(rp.get(key, -1.0))
+
+
 ## A flat send's shot from the data: "wide", "hold" or "" (none).
 static func flat_mode() -> String:
 	return String(data().get("flatMode", ""))
