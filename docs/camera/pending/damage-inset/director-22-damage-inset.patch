 	}
 
 
+## The damage inset (docs/camera/damage-inset.md; `damage_inset`, off): a dodged beam's damage to a structure out of the dodger's
+## picture, shown live in the corner on the building's side (a collapse: the strip's band). A steady camera on a place, so it adds
+## no camera move to the main view. With no event naming a beam, the cause is the stand-in: the other fighter's beam, dodged inside
+## the window, whose line passes the building (and a stage's own `owner`). A second way in (GD's rulings 2026-10-30d): a skyscraper's fall
+## of any cause, out of the picture. Legal's conditions: it reads the structure's events only, never a casualty or a head count, so a
+## collapse with no deaths opens the same inset as one with deaths, and it awards nothing.
+func _dmg_read(S: SimState, events: Array) -> void:
+	var d: Dictionary = CameraData.damage_inset()
+	for ev in events:
+		var t: String = String(_ef(ev, "type", ""))
+		if t == "beam_outcome":
+			var k: String = String(_ef(ev, "kind", ""))
+			var a: int = int(_ef(ev, "actor", -1))
+			var g: int = int(_ef(ev, "target", -1))
+			var avoided: Array = d["avoided"]
+			if avoided.has(k) and a >= 0 and a < 2 and g >= 0 and g < 2 and a != g:
+				var A = S.fighters[a]
+				var D = S.fighters[g]
+				var dir0: Vector2 = Vector2(SimWrap.sdx(A.x, D.x), D.y - A.y - 2.0).normalized()
+				_dmg_beam_n += 1
+				var rec0: Dictionary = {"id": _dmg_beam_n, "owner": a, "dodger": g, "fork": k == "DEFLECT", "t": time, "ox": A.x, "oy": A.y + 38.0, "ux": dir0.x, "uy": dir0.y, "len": 4200.0 * SimConst.WS}
+				for bm in S.beams:
+					if bm.A == A:
+						rec0 = {"id": _dmg_beam_n, "owner": a, "dodger": g, "fork": k == "DEFLECT", "t": time, "ox": bm.ox, "oy": bm.oy, "ux": bm.ux, "uy": bm.uy, "len": bm.len}   # the line it was on
+				_dmg_dodges.append(rec0)
+				if _dmg_dodges.size() > 4:
+					_dmg_dodges.pop_front()
+				var held: Array = _dmg_held
+				_dmg_held = []
+				for rec in held:
+					if time - float(rec["at"]) <= float(d["windowS"]):
+						_dmg_match(S, rec, d)
+		elif t == "building_stage" or t == "floors_fall" or t == "building_fall":
+			_dmg_damage(S, ev, t, d)
+
+
+func _dmg_building(S: SimState, idx: int):
+	if idx >= 0 and idx < S.buildings.size() and S.buildings[idx].idx == idx:
+		return S.buildings[idx]
+	for b in S.buildings:
+		if b.idx == idx:
+			return b
+	return null
+
+
+## Whether the avoided beam reached the building: each live beam of its line (a perfect block's swat is the defender's own and leaves on a
+## new line, so a fork may be either fighter's), else the line it was on; within the blast's reach of it.
+func _dmg_on_line(S: SimState, dg: Dictionary, b, reach: float) -> bool:
+	var found: bool = false
+	var ow = S.fighters[int(dg["owner"])]
+	var dd = S.fighters[int(dg["dodger"])]
+	for bm in S.beams:
+		if bm.A == ow or (bool(dg["fork"]) and bm.A == dd):
+			found = true
+			if _dmg_line_hits(S, bm.ox, bm.oy, Vector2(bm.ux, bm.uy), bm.len, b, reach):
+				return true
+	if found or bool(dg["fork"]):
+		return false
+	return _dmg_line_hits(S, float(dg["ox"]), float(dg["oy"]), Vector2(float(dg["ux"]), float(dg["uy"])), float(dg["len"]), b, reach)
+
+
+func _dmg_line_hits(S: SimState, ox: float, oy: float, dir: Vector2, ln: float, b, reach: float) -> bool:
+	var base: float = WorldStructures.baseY(S, b)
+	var x1: float = dir.x * maxf(ln, 0.0)   # its whole length: the beam goes on biting past where it meets the ground
+	var along: float = SimWrap.sdx(ox, b.x)
+	var hw: float = 0.5 * b.w + reach
+	if along < minf(0.0, x1) - hw or along > maxf(0.0, x1) + hw:
+		return false
+	var at: float = clampf(along, minf(0.0, x1), maxf(0.0, x1))
+	var y: float = oy + dir.y * (at / dir.x) if absf(dir.x) > 0.001 else base
+	return y <= base + b.h + reach
+
+
+## A damage event, matched to a dodge in the window; with none yet it waits, since a beam carves on its way and the outcome is called
+## when it reaches the dodger.
+func _dmg_damage(S: SimState, ev, t: String, d: Dictionary) -> void:
+	var idx: int = int(_ef(ev, "b", -1))
+	if _dmg_building(S, idx) == null:
+		return
+	if t == "building_stage" and float(_ef(ev, "to", 0.0)) <= float(_ef(ev, "from", 0.0)):
+		return
+	var rec: Dictionary = {"t": t, "b": idx, "from": float(_ef(ev, "from", 0.0)), "to": float(_ef(ev, "to", 0.0)), "owner": int(_ef(ev, "owner", -1)) if t == "building_stage" else -1, "at": time}
+	if not _dmg_match(S, rec, d) and not (t == "building_fall" and _dmg_fall(S, rec, d)):
+		_dmg_held.append(rec)
+		if _dmg_held.size() > 24:
+			_dmg_held.pop_front()
+
+
+func _dmg_match(S: SimState, rec: Dictionary, d: Dictionary) -> bool:
+	var idx: int = int(rec["b"])
+	var b = _dmg_building(S, idx)
+	var t: String = String(rec["t"])
+	if not _dmg.is_empty() and int(_dmg["b"]) == idx:
+		_dmg["last_t"] = time
+		if t == "building_fall":
+			_dmg["fell"] = true
+		return true
+	var match_dg: Dictionary = {}
+	for i in range(_dmg_dodges.size() - 1, -1, -1):
+		var dg: Dictionary = _dmg_dodges[i]
+		if absf(float(rec["at"]) - float(dg["t"])) > float(d["windowS"]):
+			continue
+		var by: int = int(rec["owner"])
+		if by >= 0 and by != int(dg["owner"]) and not (bool(dg["fork"]) and by == int(dg["dodger"])):
+			continue
+		if _dmg_on_line(S, dg, b, float(d["reach"])):
+			match_dg = dg
+			break
+	if match_dg.is_empty():
+		return false
+	if not _dmg_sites.has(idx):
+		_dmg_sites[idx] = {"b": idx, "by": "beam", "beam": int(match_dg["id"]), "dodger": int(match_dg["dodger"]), "stages": 0.0, "share": 0.0, "fell": false, "last_t": time}
+	var site: Dictionary = _dmg_sites[idx]
+	site["last_t"] = time
+	match t:
+		"building_stage":
+			site["stages"] = float(site["stages"]) + float(rec["to"]) - float(rec["from"])
+		"floors_fall":
+			site["share"] = float(site["share"]) + (float(rec["to"]) - float(rec["from"]) + 1.0) / maxf(float(b.floors), 1.0)
+		"building_fall":
+			site["fell"] = true
+	return true
+
+
+## A fall no avoided beam explains: a building of `fallMinBh` body heights or more (its height is its generation's, what it stood before
+## the fight; 0 turns this off) goes in the pane of the fighter nearer it. A blast's other towers meet the ration's gap.
+func _dmg_fall(S: SimState, rec: Dictionary, d: Dictionary) -> bool:
+	var idx: int = int(rec["b"])
+	var b = _dmg_building(S, idx)
+	var least: float = float(d["fallMinBh"])
+	if least <= 0.0 or b.h < least * CamParams.BODY_H:
+		return false
+	if _dmg_sites.has(idx):
+		_dmg_sites[idx]["fell"] = true
+		_dmg_sites[idx]["last_t"] = time
+		return true
+	var near: int = 0 if absf(SimWrap.sdx(S.fighters[0].x, b.x)) <= absf(SimWrap.sdx(S.fighters[1].x, b.x)) else 1
+	_dmg_sites[idx] = {"b": idx, "by": "fall", "beam": -1, "dodger": near, "stages": 0.0, "share": 0.0, "fell": true, "last_t": time}
+	return true
+
+
+func _dmg_score(site: Dictionary, b, d: Dictionary) -> float:
+	var sc: Dictionary = d["score"]
+	var pts: float = float(site["stages"]) * float(sc["perStage"]) + float(site["share"]) * float(sc["perFloorShare"])
+	if bool(site["fell"]):
+		pts += float(sc["perFall"])
+	pts += minf(maxf(0.0, b.h / CamParams.BODY_H - float(sc["towerBh"])) * float(sc["perBhOver"]), float(sc["towerMax"]))
+	return pts * (float(sc["landmarkMul"]) if b.landmark > 0 else 1.0)
+
+
+## A moment it does not open over (data's `blocked`), and which closes a running one.
+func _dmg_blocked(d: Dictionary) -> bool:
+	if intro_active or fold_active or _ov_kind != "":
+		return true
+	var list: Array = d["blocked"]
+	return list.has(solo_kind) or (_lg_slot >= 0 and list.has("lunge"))
+
+
+func _dmg_pane(f: SplitFrame, dodger: int) -> int:
+	return dodger if f.shows(dodger) else 0
+
+
+## The player can already see the damage well: the building's centre is in the dodger's pane and it is drawn at seenShare of the pane's
+## height or more (GD's rulings 2026-10-30b). A tower small in a wide shot, or off the top of a close shot, is not in the picture.
+func _dmg_in_picture(S: SimState, b, pi: int, d: Dictionary) -> bool:
+	var base: float = WorldStructures.baseY(S, b)
+	var c: Vector2 = _cur.screen_pos(pi, b.x, base + 0.5 * b.h, b.z)
+	if c.x < 0.0 or c.x > vw or c.y < 0.0 or c.y > vh or _cur.weight1(c) != float(pi):
+		return false
+	var drawn: float = absf(_cur.screen_pos(pi, b.x, base + b.h, b.z).y - _cur.screen_pos(pi, b.x, base, b.z).y)
+	return drawn >= float(d["seenShare"]) * vh
+
+
+## The rect lies wholly in pane pi (a split's divider never crosses it).
+func _dmg_in_pane(f: SplitFrame, r: Rect2, pi: int) -> bool:
+	if not f.shows(pi):
+		return false
+	for p in [r.position, Vector2(r.end.x, r.position.y), r.end, Vector2(r.position.x, r.end.y)]:
+		if f.weight1(p) != float(pi):
+			return false
+	return true
+
+
+## A fighter's box in pane pi, as the strip's band tests it, moved `ahead` ticks on by his step on the screen.
+func _dmg_box(f: SplitFrame, S: SimState, k: int, pi: int, ahead: float) -> Rect2:
+	var fk = S.fighters[k]
+	var feet: Vector2 = f.screen_pos(pi, fk.x, fk.y, float(fk.z))
+	var head: Vector2 = f.screen_pos(pi, fk.x, fk.y + CamParams.BODY_H, float(fk.z))
+	var fh: float = absf(feet.y - head.y)
+	var box: Rect2 = Rect2(feet.x - fh * 0.4, minf(head.y, feet.y), fh * 0.8, fh)
+	if ahead > 0.0 and _dmg_fp[k] != null:
+		var step: Vector2 = feet - Vector2(_dmg_fp[k])
+		if step.length() < 0.5 * vw:
+			box.position += step * ahead
+	return box
+
+
+func _dmg_rect_free(f: SplitFrame, S: SimState, r: Rect2, pi: int, ahead: float) -> bool:
+	var g: Rect2 = r.grow(8.0)
+	for k in range(2):
+		if g.intersects(_dmg_box(f, S, k, pi, 0.0)) or (ahead > 0.0 and g.intersects(_dmg_box(f, S, k, pi, ahead))):
+			return false
+	return true
+
+
+## The thumbnail's rect: the top corner on the building's side, else the other one, where it lies in the pane with no fighter under it.
+## In a split only the pane's outer corner: the divider wanders over the inner one, and it would be gone a few ticks after it opened.
+func _dmg_thumb_rect(S: SimState, b, pi: int, d: Dictionary) -> Rect2:
+	var th: Dictionary = d["thumb"]
+	var w: float = float(th["w"]) * vw
+	var h: float = float(th["h"]) * vh
+	var m: float = float(th["margin"]) * vw
+	var y0: float = maxf(vh * CamParams.PANEL_TOP_Y, panel_floor)
+	var right: bool = SimWrap.sdx(_cur.cam_x[pi], b.x) >= 0.0
+	var sides: Array = [right, not right]
+	if sep > 0.001:
+		sides = [SimWrap.sdx(S.fighters[pi].x, S.fighters[1 - pi].x) < 0.0]
+	for side in sides:
+		var r: Rect2 = Rect2(vw - m - w if side else m, y0, w, h)
+		if _dmg_in_pane(_cur, r, pi) and _dmg_rect_free(_cur, S, r, pi, float(d["lookTicks"])):
+			return r
+	return Rect2()
+
+
+func _dmg_still(d: Dictionary) -> bool:
+	return reduced_motion or panel_mode == "still" or (flash_reduced and bool(d["flash"]["stillWhenReduced"]))
+
+
+func _dmg_update(S: SimState) -> void:
+	var d: Dictionary = CameraData.damage_inset()
+	if not _dmg.is_empty():
+		_dmg["t"] = float(_dmg["t"]) + DT
+		var tm: Dictionary = d["time"]
+		if float(_dmg["close"]) >= 0.0:
