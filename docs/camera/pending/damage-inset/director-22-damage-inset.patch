+	var pw: float = vw * CamParams.PANEL_W + ph * CamParams.PANEL_SLANT
+	f.panel = {
+		"kind": "site", "slot": dodger, "open": open, "still": still, "band": -1, "rect": r, "slant": float(_dmg["slant"]),
+		"size": Vector2i(int(ceil(pw)), int(ceil(ph))), "cam_x": SimWrap.wrap(b.x),
+		"cam_y": clampf(focus - (ph * CamParams.PLANE_Y - ph * 0.5) / z, CamParams.CAM_Y_MIN, SimConst.CEILING - CamParams.CAM_Y_TOP),
+		"cam_z": z,
+	}
+
+
 ## Which side of the winner holds more wreckage: the craters (area times depth, a signature's double), the buildings
 ## lost (their face area, scaled by how much is gone) and the knockback trenches, inside the part of the screen that side
