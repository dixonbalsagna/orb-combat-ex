+{
+  "schema": "camera.damage_inset/1",
+  "_about": "The live inset of a dodged beam's damage (docs/camera/damage-inset.md, docs/camera/damage-inset-build.md). enabled is the switch (off). It opens when a beam the defender avoided carries on and damages a structure that is not already in the dodger's picture, scored from the damage events it caused. Numbers are first values. Score: points per stage stepped, per share of a building's floors cleared, for a fall, a multiplier for a landmark, and a bonus for a tower (per body height over towerBh, at most towerMax). open and big are the score thresholds. windowS: the damage counts if it comes within this many seconds of the dodge, before or after (a beam carves on its way). reach: how far from the beam's line a building counts as hit (the blast's radius and a margin; it only decides which damage is this beam's, not a design lever). seenShare: a structure whose centre is in the dodger's pane and drawn at this share of the pane's height needs no inset (GD's rulings 2026-10-30b). avoided: the beam outcomes that count: the beam was avoided and carries on. fallMinBh: it also opens on the fall, of any cause, of a building that stood at least this many body heights before the fight, out of the picture, in the pane of the fighter nearer it; 0 turns this off (GD's rulings 2026-10-30d). ration: at most one in gapS, perMinute a minute; waitForStripS: how long it waits for a fighter strip to end before it is dropped. blocked: shots and moments it never opens over, and which close it. thumb: the size as shares of the screen, margin its distance from the pane's edge. frame: where the inset's camera stands (centerY a share of the building's height), margin and landmarkMargin the room around it, minPx its smallest drawn height, pushIn an eased push over pushS. time: minS and maxS its life, maxFallS with a fall and its rubble, tailS after the last event, wipeIn and wipeOut (the strip's own speeds). lookTicks: a fighter who will be under it this many ticks ahead starts its close. flash: stillWhenReduced (a frozen frame under Reduce flashing or reduced motion), stillAtS how long after the first event the still is taken.",
+  "enabled": false,
+  "score": { "perStage": 0.5, "perFloorShare": 1.0, "perFall": 2.0, "landmarkMul": 1.5, "towerBh": 10, "perBhOver": 0.1, "towerMax": 0.5 },
+  "thresholds": { "open": 1.0, "big": 2.0 },
+  "windowS": 2.0,
+  "reach": 400,
+  "seenShare": 0.5,
+  "avoided": ["DODGE", "ESCAPE", "DEFLECT"],
+  "fallMinBh": 20,
+  "ration": { "gapS": 15, "perMinute": 3, "waitForStripS": 1.0 },
+  "blocked": ["intro", "transform", "finisher", "ko", "launch", "lunge"],
+  "thumb": { "w": 0.22, "h": 0.16, "margin": 0.02 },
+  "frame": { "centerY": 0.55, "margin": 0.20, "landmarkMargin": 0.35, "minPx": 60, "pushIn": 0.04, "pushS": 1.0 },
+  "time": { "minS": 1.4, "maxS": 4.0, "maxFallS": 6.0, "tailS": 0.6, "wipeIn": 0.08, "wipeOut": 0.12 },
+  "lookTicks": 8,
+  "flash": { "stillWhenReduced": true, "stillAtS": 0.5 }
+}
