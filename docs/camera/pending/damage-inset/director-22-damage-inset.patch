+
+
+func _dmg_close() -> void:
+	if reduced_motion or panel_mode == "still":
+		_dmg = {}
+	elif float(_dmg["close"]) < 0.0:
+		_dmg["close"] = 0.0
+
+
+## The frame's record, in the panel's shape (kind "site"): it takes the one inset slot. Nothing about the main view changes. It goes
+## at once if a fighter has got under it or the divider has reached it (never drawn over a fighter); it starts to close if he is about to.
+func _dmg_frame(S: SimState, f: SplitFrame) -> void:
+	if _dmg.is_empty():
+		_dmg_fp = [null, null]
+		return
+	var d: Dictionary = CameraData.damage_inset()
+	var r: Rect2 = _dmg["rect"]
+	var dodger: int = int(_dmg["dodger"])
+	var pi: int = _dmg_pane(f, dodger)
+	var t: float = float(_dmg["t"])
+	if t < 0.0:
+		return   # a still waits for its moment
+	if not _dmg_in_pane(f, r, pi) or not _dmg_rect_free(f, S, r, pi, 0.0):
+		_dmg = {}
+		return
+	if float(_dmg["close"]) < 0.0 and not _dmg_rect_free(f, S, r, pi, float(d["lookTicks"])):
+		_dmg_close()
+		if _dmg.is_empty():
+			return
+	for k in range(2):
+		_dmg_fp[k] = f.screen_pos(pi, S.fighters[k].x, S.fighters[k].y, float(S.fighters[k].z))
+	var tm: Dictionary = d["time"]
+	var still: bool = _dmg_still(d)
+	var open: float = 1.0
+	if not (reduced_motion or panel_mode == "still"):
+		open = smoothstep(0.0, float(tm["wipeIn"]), t)
+		if float(_dmg["close"]) >= 0.0:
+			open *= 1.0 - smoothstep(0.0, float(tm["wipeOut"]), float(_dmg["close"]))
+	var b = _dmg_building(S, int(_dmg["b"]))
+	var fr: Dictionary = d["frame"]
+	var ph: float = vh * CamParams.PANEL_H
+	var mg: float = 1.0 + 2.0 * float(fr["landmarkMargin"] if b.landmark > 0 else fr["margin"])
+	var rw: float = r.size.x - absf(float(_dmg["slant"]))
+	var z: float = minf(rw / maxf(b.w * mg, 1.0), r.size.y / maxf(b.h * mg, 1.0))
+	z = maxf(z, float(fr["minPx"]) / maxf(b.h, 1.0))
+	if not still:
+		z *= 1.0 + float(fr["pushIn"]) * _smootherstep(clampf(t / float(fr["pushS"]), 0.0, 1.0))   # the one move it has, eased at both ends
+	var wz: float = -float(b.z)
+	if absf(wz) > 1.0:
+		var den: float = 1.0 / z - wz / (CamParams.K_FACTOR * ph)
+		if den > 1e-6:
+			z = 1.0 / den
