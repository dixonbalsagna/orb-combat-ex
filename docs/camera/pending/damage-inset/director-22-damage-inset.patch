+# ------------------------------------------------------------------------------------------------ the damage inset
+
+## A building with the pair on a line through it, A firing past B, and the rig settled: the building 3,200 units beyond B (out of the
+## picture), or 120 (`near`, in it). `tall`: the tallest; else a short one, with no tower bonus in its score.
+func _dmg_setup(split: bool = false, near: bool = false, tall: bool = true):
+	var b = null
+	var lim: float = float(CameraData.damage_inset()["score"]["towerBh"]) * CamParams.BODY_H
+	for c in _S.buildings:
+		if not tall and c.h > lim:
+			continue
+		if b == null or (tall and c.h > b.h) or (not tall and c.h < b.h):
+			b = c
+	var y: float = WorldStructures.baseY(_S, b) + 0.5 * b.h - 38.0
+	var gap: float = 9000.0 if split else 400.0
+	var bx: float = b.x - (120.0 if near else 3200.0)
+	_pose(bx - gap, y, bx, y)
+	_rig.damage_inset = true
+	_seed_rig()
+	for _i in range(150):
+		_tick_rig()
+	return b
+
+
+func _dmg_ev(type: String, b, fields: Dictionary) -> SimState.FxEvent:
+	var fl: Dictionary = {"b": float(b.idx), "x": b.x, "w": b.w, "z": b.z, "h": b.h}
+	fl.merge(fields, true)
+	return _shot_events(type, fl)
+
+
+func _dmg_dodge(kind: String = "DODGE") -> SimState.FxEvent:
+	return _shot_events("beam_outcome", {"actor": 0.0, "target": 1.0, "kind": kind})
