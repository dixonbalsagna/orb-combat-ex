+		r = _dmg_thumb_rect(S, b, pi, d)
+	if r.size == Vector2.ZERO:
+		return
+	_dmg = {"b": int(best["b"]), "dodger": dodger, "rect": r, "slant": slant, "t": (-float(d["flash"]["stillAtS"]) if _dmg_still(d) else 0.0), "t0": time, "last_t": float(best["last_t"]), "fell": bool(best["fell"]), "close": -1.0, "by": String(best["by"]), "beam": int(best["beam"]), "score": best_sc}
