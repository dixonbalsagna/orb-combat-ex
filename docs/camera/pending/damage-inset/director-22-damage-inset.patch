+	var dodger: int = int(best["dodger"])
+	var pi: int = _dmg_pane(_cur, dodger)
+	if _dmg_in_picture(S, b, pi, d):
+		return
+	var big: bool = best_sc >= float(d["thresholds"]["big"]) and sep <= 0.001   # (in a split a collapse is the thumbnail too: the strip's slant is not cut at the divider)
+	var r: Rect2 = Rect2()
+	var slant: float = 0.0
+	if big:
+		var band: int = _panel_band(S)
+		if band >= 0:
+			r = _panel_rect(band)
+			slant = (1.0 if dodger == 0 else -1.0) * r.size.y * CamParams.PANEL_SLANT
