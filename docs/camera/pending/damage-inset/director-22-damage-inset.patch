+## A fighter's box under the rect in this frame.
+func _dmg_under(fr: SplitFrame, r: Rect2, pi: int) -> bool:
+	for k in range(2):
+		var fk = _S.fighters[k]
+		var feet: Vector2 = fr.screen_pos(pi, fk.x, fk.y, float(fk.z))
+		var head: Vector2 = fr.screen_pos(pi, fk.x, fk.y + CamParams.BODY_H, float(fk.z))
+		var fh: float = absf(feet.y - head.y)
+		if Rect2(feet.x - fh * 0.4, minf(head.y, feet.y), fh * 0.8, fh).intersects(r):
+			return true
+	return false
