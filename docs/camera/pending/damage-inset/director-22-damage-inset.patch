index 0000000..d94ed88
--- /dev/null
+++ b/render/camera/tests/inset_rate.gd
@@ -0,0 +1,264 @@
+extends SceneTree
+## The damage inset's rate (GD's rulings 2026-10-30b row 5): whole AI matches through the rig, the inset on, slot 0 a scripted defender
+## who avoids every third beam aimed at him (a tap of the dodge through the tell, his queued answer dropped). The AI's own dodges can't
+## measure this: it avoids about one beam in 12 matches. It also checks that `reach` credits a beam's damage: each building stage the sim
+## credits to a fighter with a live beam, within the window of a beam avoided, read at several reaches. It writes the scripted tap into
+## its own sim and nothing else; the rig only reads. BEAM lines (GD's rulings 2026-10-30c row 3): each of slot 0's avoided beams, its tier,
+## whether a standing building was within reach of its line, the best building's score and height, the sum of its scores. OPENS lines:
+## when slot 0's openings come, and building_fall events: all, off every pane, in a pane under seenShare, the sum of their n.
+## TRIG lines (GD's rulings 2026-10-30d): each opening under a fallMinBh of --fall's list, its tick, trigger, side, kind, whether an
+## exchange is on, and how many ticks it lived; a rig only reads, so all of them watch one sim.
+##   godot --headless --path . --script res://render/camera/tests/inset_rate.gd -- --gen=2 --from=1 --to=30 [--every=3] [--max=36000] [--fall=15,20,25,30]
+## --gen=1 or 2 plays QA's planets (qa/godot/qa_planet.gd's list and touches); --gen=0 the hand-made world.
+
+const PLANETS: Array = [3, 7, 11, 13, 17, 19, 23, 25, 37, 31]
+const TOUCHES: Array = [0, 1, 2, 3]
+const REACHES: Array = [400.0, 600.0, 800.0, 1200.0, 2400.0, 1.0e9]
+const TALL: Array = [15.0, 20.0, 25.0, 30.0]
+
+var fall_list: Array = []
+
+
+func _initialize() -> void:
+	var gen: int = 2
+	var from: int = 1
+	var to: int = 30
+	var every: int = 3
+	var max_ticks: int = 36000
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--gen="):
+			gen = int(a.substr(6))
+		elif a.begins_with("--from="):
+			from = int(a.substr(7))
+		elif a.begins_with("--to="):
+			to = int(a.substr(5))
+		elif a.begins_with("--every="):
+			every = int(a.substr(8))
+		elif a.begins_with("--max="):
+			max_ticks = int(a.substr(6))
+		elif a.begins_with("--fall="):
+			fall_list = Array(a.substr(7).split_floats(","))
+	for seed in range(from, to + 1):
+		_match(gen, seed, every, max_ticks)
+	quit(0)
+
+
+func _match(gen: int, seed: int, every: int, max_ticks: int) -> void:
+	var S: SimState = SimCore.createSim()
+	var su: Dictionary = {}
+	if gen > 0:
+		var i: int = seed - 1
+		su = {"planet": int(PLANETS[i % PLANETS.size()]), "touch": int(TOUCHES[(i / PLANETS.size()) % TOUCHES.size()]), "arena": {"cols": 2400}, "planetGen": gen, "intro": false}
+	SimCore.newMatch(S, seed, {"p1": true, "p2": true}, su)
+	if gen > 0 and S.planetCols.is_empty():
+		print("MATCH gen %d seed %d FELL BACK to the hand-made world: not counted" % [gen, seed])
+		SimCore.dispose(S)
+		return
+	var rig := SplitRig.new()
+	rig.damage_inset = true
+	rig.test_human_slot = 0
+	rig.reset(S, 1280.0, 720.0)
+	var watch: Array = []
+	for v in fall_list:
+		var wr := SplitRig.new()
+		wr.damage_inset = true
+		wr.test_human_slot = 0
+		wr.reset(S, 1280.0, 720.0)
+		watch.append({"bh": float(v), "rig": wr, "was": false, "opens": []})
+	var tall: Array = [0, 0, 0, 0]   # falls out of the picture of buildings of at least TALL's heights
+	var beams: Dictionary = {}   # slot 0's avoided beams, by id
+	var open_a: Array = []       # slot 0's openings: [tick, the beam's tier]
+	var falls: Array = [0, 0, 0, 0]   # building_fall events: all, off every pane, in a pane under seenShare, folded into a summary
+	S.dt = SplitRig.DT
+	var P = S.fighters[0]
+	var t: int = 0
+	var aimed: int = 0
+	var cur_ex: int = 0
+	var avoid: bool = false
+	var outcomes: Dictionary = {}
+	var opens: Array = [0, 0]
+	var was_open: bool = false
+	var qualified: Dictionary = {}
+	var open_at: Array = []
+	var why: Dictionary = {"picture": 0, "blocked": 0, "strip": 0, "ration": 0, "norect": 0}
+	var reach_ok: Array = []
+	for _r in REACHES:
+		reach_ok.append(0)
+	var reach_n: int = 0
+	var held: Array = []
+	var d: Dictionary = CameraData.damage_inset()
+	var funnel: Dictionary = {"avoided": 0, "scored": 0, "opened": 0, "last": ""}   # slot 0's avoided beams: how many damaged a building to the score, how many opened
+	var f_t: float = -100.0
+	var f_scored: bool = false
+	var f_opened: bool = false
+	while t < max_ticks and not (S.game.ko != null and S.game.koT > 3.0):
+		var ex = S.dirS.ex
+		if ex != null and ex.kind == "sig" and ex.D == P and ex.branch == "":
+			var id: int = ex.get_instance_id()
+			if id != cur_ex:
+				cur_ex = id
+				aimed += 1
+				avoid = (aimed + seed) % every == 0
+			if avoid:
+				P.act.dodgeTick = S.tick
+				P.act.queue.clear()
+		SimCore.step(S)
+		var ev: Array = S.out.fx.duplicate()
+		S.out.fx.clear()
+		S.out.feed.clear()
+		var data_bh: float = float(d["fallMinBh"])
+		for wa in watch:
+			d["fallMinBh"] = float(wa["bh"])
+			var wr2: SplitRig = wa["rig"]
+			wr2.step(S, 1280.0, 720.0, ev)
+			var up: bool = not wr2._dmg.is_empty()
+			if up and not bool(wa["was"]):
+				(wa["opens"] as Array).append([t, String(wr2._dmg["by"]), int(wr2._dmg["dodger"]), absf(float(wr2._dmg["slant"])) > 0.0, S.dirS.ex != null, -1])
+			elif bool(wa["was"]) and not up:
+				var last: Array = (wa["opens"] as Array)[-1]
+				last[5] = t - int(last[0])
+			wa["was"] = up
+		d["fallMinBh"] = data_bh
+		rig.step(S, 1280.0, 720.0, ev)
+		for dg in rig._dmg_dodges:
+			if int(dg["dodger"]) == 0 and not beams.has(int(dg["id"])):
+				beams[int(dg["id"])] = {"tier": int(S.fighters[int(dg["owner"])].tier), "tick": t, "fork": bool(dg["fork"]), "dg": dg, "reach": false, "sites": {}}
+		for id in beams:
+			var bq: Dictionary = beams[id]
+			if not bool(bq["reach"]) and rig.time - float(bq["dg"]["t"]) <= float(d["windowS"]):
+				for bb in S.buildings:
+					if bb.alive and rig._dmg_on_line(S, bq["dg"], bb, float(d["reach"])):
+						bq["reach"] = true
+						break
+		for key in rig._dmg_sites:
+			var ls: Dictionary = rig._dmg_sites[key]
+			if int(ls["dodger"]) == 0 and beams.has(int(ls["beam"])):
+				_note(beams[int(ls["beam"])], int(key), rig._dmg_score(ls, rig._dmg_building(S, int(key)), d), rig._dmg_building(S, int(key)))
+		for e in ev:
+			if e.type == "building_fall":
+				falls[0] = int(falls[0]) + 1
+				falls[3] = int(falls[3]) + int(e.n)
+				var fb = rig._dmg_building(S, int(e.b))
+				if fb != null:
+					var seen: int = _seen(rig, S, fb, d)
+					if seen < 2:
+						for it in range(TALL.size()):
+							if fb.h >= float(TALL[it]) * CamParams.BODY_H:
+								tall[it] = int(tall[it]) + 1
+					if seen == 0:
+						falls[1] = int(falls[1]) + 1
+					elif seen == 1:
+						falls[2] = int(falls[2]) + 1
+		t += 1
+		var dodges_new: bool = false
+		for e in ev:
+			if e.type == "beam_outcome" and int(e.target) == 0:
+				outcomes[String(e.kind)] = int(outcomes.get(String(e.kind), 0)) + 1
+			if e.type == "beam_outcome":
+				dodges_new = true
+			if e.type == "beam_outcome" and int(e.target) == 0 and (d["avoided"] as Array).has(String(e.kind)):
+				funnel["avoided"] = int(funnel["avoided"]) + 1
+				f_t = rig.time
+				f_scored = false
+				f_opened = false
+			if e.type == "building_stage" and int(e.owner) >= 0 and float(e.to) > float(e.from):
+				var live: bool = false
+				for bm in S.beams:
+					if bm.A == S.fighters[int(e.owner)]:
+						live = true
+				if live:
+					held.append({"b": int(e.b), "owner": int(e.owner), "t": rig.time, "done": false})
+		# the reach check: a stage by a live beam's owner, within the window of an avoided beam of that fighter (or a fork)
+		for rec in held:
