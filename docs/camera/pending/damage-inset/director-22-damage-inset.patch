@@ -0,0 +1,19 @@
+class_name CameraData
+extends RefCounted
+## Camera's data files: read once, and a file or a key that is missing falls back to the constants in CamParams, so the rig never
+## depends on the file being there. It reads no sim state.
+
+const DAMAGE_INSET_PATH: String = "res://data/camera/damage_inset.json"
+static var _damage_inset: Dictionary = {}
+
+
+## The damage inset's numbers (docs/camera/damage-inset.md), each top-level key from the file or else the defaults.
+static func damage_inset() -> Dictionary:
+	if _damage_inset.is_empty():
+		_damage_inset = CamParams.DAMAGE_INSET.duplicate(true)
+		if FileAccess.file_exists(DAMAGE_INSET_PATH):
+			var parsed = JSON.parse_string(FileAccess.get_file_as_string(DAMAGE_INSET_PATH))
+			if parsed is Dictionary:
+				for k in parsed:
+					_damage_inset[k] = parsed[k]
+	return _damage_inset
