+
+  flash-cases:
+    name: Flash count, ${{ matrix.set }} (the worst cases played)
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30   # budget 20; each set plays 11 to 13 minutes of cases (82 runs measured on run 44881357568: 42 of 28 to 31 s, 40 `ai` runs of 55 s) and about 2 minutes of set-up
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - { set: scenes-1, args: '--only=mash,mashcity,clash,signature,signaturecity,rushcity,transform,collapse,plumedesert,plumeice,plumevolc' }
+          - { set: scenes-2, args: '--only=mashdummy,ring,launchai,clashcity,signaturedummy,blastdummy' }
+          # the `ai` scenario is one run per pairing and seed of tools/flash/sources.json (PROTAGONIST and RIVAL, PROTAGONIST and REFERENCE, RIVAL and REFERENCE); each set plays one pairing with its own seeds
+          - { set: ai-1, args: '--only=ai --slots=PROTAGONIST,RIVAL --seeds=4,39,104,106,7,9,43' }
+          - { set: ai-2, args: '--only=ai --slots=PROTAGONIST,REFERENCE --seeds=98,100,74,4,49,8,13' }
+          - { set: ai-3, args: '--only=ai --slots=RIVAL,REFERENCE --seeds=15,29,107,88,100,36' }
+    steps:
