+      - name: Play the worst cases of this set
+        env:
+          ARGS: ${{ matrix.args }}
+        run: 'node tools/gate.mjs -- "$GODOT" --headless --path . --script res://tools/flash/flash_worst.gd -- --out="${RUNNER_TEMP}/flash" ${ARGS}'
       - name: Negative control (the recount must fail on four unrefusable flashes)
+        if: matrix.set == 'scenes-1'
         run: |
           "$GODOT" --headless --path . --script res://tools/flash/flash_worst.gd -- --only=mash --ticks=300 --negative-control --out="${RUNNER_TEMP}/flash-neg"
           if node tools/flash/check-log.js "${RUNNER_TEMP}/flash-neg" --allow-missing > "${RUNNER_TEMP}/flash-neg.txt"; then echo "the negative control passed: the check cannot fail"; exit 1; fi
           grep -q "in the 60 ticks from" "${RUNNER_TEMP}/flash-neg.txt"
+      - name: Keep the run files of this set for the recount (one day)
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: flash-run-${{ matrix.set }}
+          path: ${{ runner.temp }}/flash
+          retention-days: 1
+          if-no-files-found: error
+
+  flash:
+    name: Flash count (worst cases, flash register)
+    needs: flash-cases
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15   # budget 10; downloads the five sets and recounts them as one (a few seconds of node)
+    steps:
