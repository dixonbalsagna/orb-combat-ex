+          pattern: flash-run-*
+          merge-multiple: true
+          path: ${{ runner.temp }}/flash
+      - name: Recount the register's log (every scenario of the required set, from all five sets)
+        run: node tools/flash/check-log.js "${RUNNER_TEMP}/flash"
 
