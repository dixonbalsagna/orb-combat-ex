+    { file: 'ui/data/terms.json', pointer: '/prompt/menu_notice', row: 'RL-192' },
+    { file: 'ui/data/settings.json', locate: { key: 'action', equals: 'photo_notice' }, field: 'help', row: 'RL-192' },
