diff --git a/tools/lib/xref-combat-energy.js b/tools/lib/xref-combat-energy.js
new file mode 100644
index 0000000..ea9c9ef
--- /dev/null
+++ b/tools/lib/xref-combat-energy.js
@@ -0,0 +1,51 @@
+'use strict';
+// Cross-reference rules for Combat's energy kits, data/combat/energy/<fighter>.json (combat.energy/1; docs/combat/pending/energy/README.md; called from xref-fight.js):
+//   combat-energy-name      the file's name is its fighter in lower case (an "energy." prefix is allowed: energy.rival.json)
+//   combat-energy-lane      `lane` is a key of data/art/energy-lanes.json lanes, and light.colour is that lane's light_colour
+//   combat-energy-atoms     every atom a cell lists (light, medium, heavy, beam, grab, trap) is a key of the kit's `atoms`
+//   combat-energy-distinct  two kits differ in at least three of five things: the grab's look, the grab's payoff, the lob's level-2 template, the trap's template and the beam trait's kind
+//                           (Game Design's kit sheet, section 14)
+// "Every fighter is a roster id" waits for the roster to hold all four.
+
+const DIR = /^data\/combat\/energy\/[^/]+\.json$/;
+const CELLS = ['light', 'medium', 'heavy', 'beam', 'grab', 'trap'];
+const NEEDED = 3;
+
+function xrefCombatEnergy({ get, err, esc, isObj, docsFor }) {
+  const files = docsFor(DIR);
+  if (!files.length) return;
+  const lanesDoc = get('data/art/energy-lanes.json');
+  const lanes = isObj(lanesDoc) && isObj(lanesDoc.lanes) ? lanesDoc.lanes : null;
+  const kits = [];
+  for (const file of files) {
+    const k = get(file);
+    if (!isObj(k)) continue;
+    kits.push({ file, k });
+    const base = file.slice(file.lastIndexOf('/') + 1).replace(/\.json$/, '').replace(/^energy\./, '');
+    if (typeof k.fighter === 'string' && base !== k.fighter.toLowerCase()) err(file, '/fighter', 'combat-energy-name', `the file is "${base}" but the fighter is "${k.fighter}": a kit's file is its fighter in lower case`);
+    if (lanes && typeof k.lane === 'string') {
+      const lane = lanes[k.lane];
+      if (!isObj(lane)) err(file, '/lane', 'combat-energy-lane', `lane "${k.lane}" is not a lane of data/art/energy-lanes.json (${Object.keys(lanes).join(', ')})`);
+      else if (isObj(k.light) && typeof k.light.colour === 'string' && typeof lane.light_colour === 'string' && k.light.colour.toLowerCase() !== lane.light_colour.toLowerCase()) err(file, '/light/colour', 'combat-energy-lane', `light.colour ${k.light.colour} is not the lane's light_colour ${lane.light_colour}`);
+    }
+    if (isObj(k.atoms)) {
+      const have = new Set(Object.keys(k.atoms));
+      for (const cell of CELLS) {
+        const c = k[cell];
+        if (isObj(c) && Array.isArray(c.atoms)) c.atoms.forEach((a, i) => { if (typeof a === 'string' && !have.has(a)) err(file, `/${cell}/atoms/${i}`, 'combat-energy-atoms', `the atom "${a}" is not a key of this kit's atoms`); });
+      }
+    }
+  }
+  const sig = ({ k }) => [isObj(k.grab) ? k.grab.look : null, isObj(k.grab) ? k.grab.payoff : null, isObj(k.medium) && isObj(k.medium.l2) ? k.medium.l2.template : null, isObj(k.trap) ? k.trap.template : null, isObj(k.beam) && isObj(k.beam.trait) ? k.beam.trait.kind : null];
+  const names = ['grab look', 'grab payoff', "lob's level-2 template", 'trap template', 'beam trait'];
+  for (let i = 0; i < kits.length; i++) for (let j = i + 1; j < kits.length; j++) {
+    const a = sig(kits[i]), b = sig(kits[j]);
+    const differ = a.filter((v, n) => v !== null && b[n] !== null && v !== b[n]).length;
+    if (differ < NEEDED) {
+      const same = names.filter((_, n) => a[n] !== null && a[n] === b[n]).join(', ');
+      for (const [me, other] of [[kits[i], kits[j]], [kits[j], kits[i]]]) err(me.file, '/fighter', 'combat-energy-distinct', `this kit differs from ${other.file.slice(other.file.lastIndexOf('/') + 1)} in only ${differ} of 5 things (at least ${NEEDED} are needed); the same: ${same}`);
+    }
+  }
+}
+
+module.exports = { xrefCombatEnergy };
