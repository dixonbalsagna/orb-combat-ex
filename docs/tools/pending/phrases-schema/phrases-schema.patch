diff --git a/tools/schemas/combat-phrases.schema.json b/tools/schemas/combat-phrases.schema.json
new file mode 100644
index 0000000..4703391
--- /dev/null
+++ b/tools/schemas/combat-phrases.schema.json
@@ -0,0 +1,172 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "meridian/combat-phrases",
+  "title": "combat.phrases/1",
+  "description": "docs/combat/pending/phrases/README.md: data/combat/phrases.json, each fighter's phrases, written by gen_phrases.mjs from a fixed seed (rule-of-cool-map.md row 1). Read only with `enabled` true. Policy: closed except keys starting with an underscore.",
+  "type": "object",
+  "required": [
+    "schema",
+    "enabled",
+    "generator",
+    "gapTicks",
+    "classes",
+    "fighters"
+  ],
+  "patternProperties": {
+    "^_": {}
+  },
+  "additionalProperties": false,
+  "properties": {
+    "schema": {
+      "const": "combat.phrases/1"
+    },
+    "enabled": {
+      "type": "boolean"
+    },
+    "generator": {
+      "type": "object",
+      "required": [
+        "seed",
+        "version"
+      ],
+      "additionalProperties": false,
+      "properties": {
+        "seed": {
+          "type": "integer"
+        },
+        "version": {
+          "type": "integer",
+          "minimum": 1
+        }
+      }
+    },
+    "gapTicks": {
+      "type": "integer",
+      "minimum": 1
+    },
+    "classes": {
+      "type": "array",
+      "items": {
+        "enum": [
+          "open",
+          "street",
+          "water",
+          "slick",
+          "face",
+          "trees",
+          "lowAir",
+          "highAir"
+        ]
+      },
+      "minItems": 8,
+      "maxItems": 8
+    },
+    "fighters": {
+      "type": "object",
+      "propertyNames": {
+        "pattern": "^[a-z]+$"
+      },
+      "additionalProperties": {
+        "type": "object",
+        "required": [
+          "seed",
+          "phrases"
+        ],
+        "additionalProperties": false,
+        "properties": {
+          "seed": {
+            "type": "integer"
+          },
+          "phrases": {
+            "type": "array",
+            "minItems": 8,
+            "maxItems": 12,
+            "items": {
+              "type": "object",
+              "required": [
+                "id",
+                "parts",
+                "enders"
+              ],
+              "additionalProperties": false,
+              "properties": {
+                "id": {
+                  "type": "string",
+                  "pattern": "^[a-z][0-9]{2}$"
+                },
+                "parts": {
+                  "type": "array",
+                  "minItems": 2,
+                  "maxItems": 4,
+                  "items": {
+                    "type": "object",
+                    "required": [
+                      "b",
+                      "g"
+                    ],
+                    "additionalProperties": false,
+                    "properties": {
+                      "b": {
+                        "enum": [
+                          "X",
+                          "Y",
+                          "stick"
+                        ]
+                      },
+                      "g": {
+                        "enum": [
+                          "tap",
+                          "mash",
+                          "hold",
+                          "flick"
+                        ]
+                      },
+                      "dir": {
+                        "enum": [
+                          "up",
+                          "down",
+                          "toward",
+                          "away"
+                        ]
+                      },
+                      "piece": {
+                        "type": "string",
+                        "pattern": "^strike\\."
+                      },
+                      "pieces": {
+                        "type": "array",
+                        "items": {
+                          "type": "string",
+                          "pattern": "^strike\\."
+                        },
+                        "minItems": 1,
+                        "maxItems": 3
+                      }
+                    }
+                  }
+                },
+                "enders": {
+                  "type": "object",
+                  "required": [
+                    "open",
+                    "street",
+                    "water",
+                    "slick",
+                    "face",
+                    "trees",
+                    "lowAir",
+                    "highAir"
+                  ],
+                  "additionalProperties": {
+                    "type": "string",
+                    "pattern": "^strike\\."
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
