+  `Desktop builds\tPack\t${T} -rw-r--r-- 1 runner runner 34758997 Nov 23 21:03 orb-combat-ex-linux-x86_64.tar.gz`,
+  `Desktop builds\tPack\t${T} ${'b'.repeat(64)}  ./orb-combat-ex-windows-x86_64.zip`,
