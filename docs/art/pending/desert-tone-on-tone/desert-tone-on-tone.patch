+// Origin: the ground ladders' tone-on-tone cut (desert, savanna, beach, plains) for the signature clip's flash fix. Written by the Art Director session (Claude, claude-sonnet-5-5), 2026-10-27. Human direction: Orb via the EP.
+// Measured on Rendering's still (docs/rendering/img/lookgate/lookgate-sigdesert-faces-t91.png, main e1521ef5): the desert's three faces draw as the authored colour x 1.10 per channel (the front depth step, clipped at 255): #ecd28c, #d8b868 and #a88a44 came out #ffe79a, #eeca73 and #b9984b (relative luminance 0.807, 0.617, 0.333). The band's depth steps are x1.10, x1.02 and x0.94 (RenderLook.DEPTH_STEP).
+// The frame analyser counts a change of 0.1 relative luminance or more where its darker side is under 0.8, so the three faces of a ground are kept within RenderLook.PATTERN_BUDGET (0.085) of each other as drawn, and told apart by hue.
+// Usage: node ground.mjs            (the table for all fifteen, as authored in data/art/biomes.json)
+//        node ground.mjs solve      (the new cuts, printed as spec.mjs lines)
+import fs from 'fs';
+import { hex2rgb, rgb2hex, lchOf, fromOklab, dE00 } from '../sky/colour.mjs';
+
+export const PATTERN_BUDGET = 0.085;
+export const DEPTH = [1.1, 1.02, 0.94];
+const lin = c => { c /= 255; return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4; };
+export const rlRgb = ([r, g, b]) => 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
+// the relative luminance a stored face draws at, by depth step (clipped at 255 as the shader's output is)
+export const drawn = (hex, d = 1.1) => rlRgb(hex2rgb(hex).map(v => Math.min(255, Math.round(v * d))));
+const oklch = ([L, C, H]) => { const h = H * Math.PI / 180; return fromOklab([L, C * Math.cos(h), C * Math.sin(h)]); };
+// a colour of this hue and chroma whose drawn luminance (front step) is the target; chroma is reduced if the colour leaves the gamut
+export function solve(H, C, target, d = 1.1) {
+  let c = C;
+  for (let k = 0; k < 40; k++) {
+    let lo = 0.2, hi = 0.98;
+    for (let i = 0; i < 40; i++) { const mid = (lo + hi) / 2; if (drawn(oklch([mid, c, H]), d) < target) lo = mid; else hi = mid; }
+    const hex = oklch([(lo + hi) / 2, c, H]);
+    const rgb = hex2rgb(hex);
+    const raw = (() => { const L = (lo + hi) / 2, h = H * Math.PI / 180; return [L, c * Math.cos(h), c * Math.sin(h)]; })();
+    // gamut check through the unclamped linear sRGB of the Oklab triple
+    const l_ = raw[0] + 0.3963377774 * raw[1] + 0.2158037573 * raw[2], m_ = raw[0] - 0.1055613458 * raw[1] - 0.0638541728 * raw[2], s_ = raw[0] - 0.0894841775 * raw[1] - 1.291485548 * raw[2];
+    const l3 = l_ ** 3, m3 = m_ ** 3, s3 = s_ ** 3;
+    const lr = [4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3, -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3, -0.0041960863 * l3 - 0.7034186147 * m3 + 1.707614701 * s3];
+    if (lr.every(v => v >= -0.002 && v <= 1.002) && rgb.every(v => v >= 0 && v <= 255)) return hex;
+    c *= 0.96;
+  }
+  return null;
+}
+const spread = tri => { const r = tri.map(h => drawn(h)); return [r, Math.max(...r) - Math.min(...r)]; };
+
+if (process.argv[2] !== 'solve') {
+  const j = JSON.parse(fs.readFileSync(new URL('../../../data/art/biomes.json', import.meta.url), 'utf8'));
+  for (const [id, b] of Object.entries(j.biomes)) {
+    const g = b.palette.ground, [r, s] = spread(g);
+    const adj = [r[0] - r[1], r[1] - r[2]].map(x => x.toFixed(3));
+    console.log(id.padEnd(10), g.join(' '), 'drawn', r.map(x => x.toFixed(3)).join(' '), 'adjacent', adj.join(' '), 'spread', s.toFixed(3), s <= PATTERN_BUDGET ? 'OK' : 'over', 'scar', b.scar.fill, drawn(b.scar.fill, 1).toFixed(3));
+  }
+} else {
+  // target drawn luminance (lit, mid, shade) and the hue and chroma moves from the old mid, per biome
+  const CUT = {
+    desert: { t: [0.655, 0.62, 0.585], mid: '#d8b868', lit: [+10, 0.85], shade: [-14, 1.22] },
+    beach: { t: [0.675, 0.64, 0.605], mid: '#d8c088', lit: [+10, 0.85], shade: [-14, 1.25] },
+    savanna: { t: [0.515, 0.48, 0.445], mid: '#c0a650', lit: [+10, 0.9], shade: [-14, 1.22] },
+    plains: { t: [0.40, 0.365, 0.33], mid: '#70a246', lit: [-12, 1.1], shade: [+14, 1.15] },
+  };
+  for (const [id, c] of Object.entries(CUT)) {
+    const [, C, H] = lchOf(c.mid);
+    const tri = [solve(H + c.lit[0], C * c.lit[1], c.t[0]), solve(H, C, c.t[1]), solve(H + c.shade[0], C * c.shade[1], c.t[2])];
+    const [r, s] = spread(tri);
+    const de = [dE00(tri[0], tri[1]), dE00(tri[1], tri[2])].map(x => x.toFixed(1));
+    console.log(id.padEnd(8), JSON.stringify(tri), 'drawn', r.map(x => x.toFixed(3)).join(' '), 'spread', s.toFixed(3), 'dE00 faces', de.join(' '), 'depth steps (lit mid shade):', DEPTH.map(d => tri.map(h => drawn(h, d).toFixed(2)).join('/')).join('  '));
+  }
+}
+if (process.argv[2] === 'scar') {
+  // a glass band on sand: the scar is drawn after the depth step (x1.0), so it is solved at 1.0; its drawn luminance sits inside 0.1 of the sand's faces at the front and middle steps
+  for (const [id, t, te] of [['desert', 0.555, 0.68], ['beach', 0.575, 0.70]]) {
+    const fill = solve(170, 0.05, t, 1.0), edge = solve(178, 0.035, te, 1.0);
+    console.log(id, fill, drawn(fill, 1).toFixed(3), edge, drawn(edge, 1).toFixed(3), 'old', '#1f3d38 0.039', '#bfe0d8', drawn('#bfe0d8', 1).toFixed(3));
+  }
+}
+if (process.argv[2] === 'crater') {
+  const hex = h => lchOf(h).map(v => +v.toFixed(3)).join(' ');
+  console.log('old rock', hex('#d29a5a'), hex('#b87a44'), hex('#8a5634'), 'old sub', hex('#a07a44'), 'sand mid', hex('#d9b868'));
+  const D = JSON.parse(process.env.CR || '{}');
+  const rock = [solve(D.rh + D.dh, D.rc, D.rt[0]), solve(D.rh, D.rc, D.rt[1]), solve(D.rh - D.dh, D.rc * 1.1, D.rt[2])];
+  const sub = [solve(D.sh + D.dh, D.sc, D.st[0], 1.0), solve(D.sh, D.sc, D.st[1], 1.0), solve(D.sh - D.dh, D.sc * 1.1, D.st[2], 1.0)];
+  const sand = ['#cfc17d', '#d9b868', '#ebac51'];
+  console.log('rock', JSON.stringify(rock), rock.map(h => drawn(h).toFixed(3)).join(' '), 'sub', JSON.stringify(sub), sub.map(h => drawn(h, 1).toFixed(3)).join(' '));
+  console.log('dE00 rock-sand (lit,mid,shade)', rock.map((h, i) => dE00(h, sand[i]).toFixed(1)).join(' '), ' sub-sand', sub.map((h, i) => dE00(h, sand[i]).toFixed(1)).join(' '), ' sub-rock', sub.map((h, i) => dE00(h, rock[i]).toFixed(1)).join(' '), ' faces rock', dE00(rock[0], rock[1]).toFixed(1), dE00(rock[1], rock[2]).toFixed(1), 'faces sub', dE00(sub[0], sub[1]).toFixed(1), dE00(sub[1], sub[2]).toFixed(1));
+}
+if (process.argv[2] === 'beachsub') {
+  const sand = ['#cdc392', '#d4bc84', '#e1b172'];
+  const sub = [solve(78, 0.085, 0.541, 1.0), solve(70, 0.08, 0.516, 1.0), solve(54, 0.10, 0.487, 1.0)];
+  console.log(JSON.stringify(sub), sub.map(h => drawn(h, 1).toFixed(3)).join(' '), 'dE00 vs sand', sub.map((h, i) => dE00(h, sand[i]).toFixed(1)).join(' '), 'faces', dE00(sub[0], sub[1]).toFixed(1), dE00(sub[1], sub[2]).toFixed(1));
+}
