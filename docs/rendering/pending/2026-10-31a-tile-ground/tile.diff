+	# x' = x c - z s, z' = x s + z c.
+	if turned == 0.0 or absf(SimWrap.sdx(cam_x, _pivot_x)) > 3000.0:
+		_pivot_x = SimWrap.wrap(S.fighters[0].x)
+	var ap: float = SimWrap.sdx(cam_x, _pivot_x) / field.R
