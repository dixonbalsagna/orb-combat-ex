+// The tile ground's vertex stage (RenderTileGround; terrain_tile.gdshader). A tile is an instance: its face's axes and its place on
+// the face (s, t, size), its layer and the data's level, its morph. The heights are the field's nodes, read as the mesh's own two
+// triangles, so a mesh finer than the data keeps the ground the sim will stand on. What lies on the ground today (craters, scorch,
+// streets, a groove's heat) still comes from the strip's own rows, read at this vertex's place in the strip's frame.
+uniform sampler2DArray hts : filter_nearest, repeat_disable;
+uniform sampler2DArray ids : filter_nearest, repeat_disable;
+uniform vec3 pv = vec3(1.0, 0.0, 0.0);
+uniform vec3 hd = vec3(0.0, 1.0, 0.0);
+uniform vec3 sd = vec3(0.0, 0.0, 1.0);
+uniform vec3 pv0 = vec3(1.0, 0.0, 0.0);
+uniform vec3 hd0 = vec3(0.0, 1.0, 0.0);
+uniform vec3 sd0 = vec3(0.0, 0.0, 1.0);
+uniform vec3 pvp = vec3(1.0, 0.0, 0.0);   // the plan's frame at the camera: the land's light stays with the land through a swing
+uniform vec3 hdp = vec3(0.0, 1.0, 0.0);
+uniform vec3 sdp = vec3(0.0, 0.0, 1.0);
+uniform float strip_x = 0.0;
+uniform sampler2D plane_tex : filter_nearest, repeat_disable;
+uniform float plane_span = 3000.0;
+uniform float fore_tone = 1.0;   // one tone in front of the plane (RenderTileGround.fore_tone)
+varying vec2 v_uv;
+varying float v_layer;
+varying float v_rad;
+varying float v_h0;
+varying vec2 v_pv;
+varying float v_wet;     // a lake's or a river's depth here (RenderTileField.WET_STEP)
+varying vec3 v_q;        // the planet's direction, in nodes: what a border's wander is keyed to, so it stays with the land
+
+// A straight-sided wave, -1 to 1: a border wanders in straight runs, as the flat look draws an edge.
+float tile_tri(float x) {
+	return abs(fract(x * 0.37) * 2.0 - 1.0) * 2.0 - 1.0;
+}
+
+vec2 tile_chart(vec3 d, vec3 h, vec3 s, vec3 p) {
+	float x = dot(d, h);
+	float z = dot(d, s);
+	float q = sqrt(x * x + z * z);
+	float k = q > 1.0e-5 ? atan(q, dot(d, p)) / q : 1.0;
+	return vec2(x, z) * k * globe_r;
+}
+
+float tile_h(ivec2 a, int layer) {
+	return texelFetch(hts, ivec3(clamp(a.x, 0, 27), clamp(a.y, 0, 27), layer), 0).r;
+}
+
+vec3 tile_dir(vec3 n, vec3 u, vec3 w, vec2 st) {
+	return normalize(n + u * tan(st.x * 0.7853982) + w * tan(st.y * 0.7853982));
+}
+
+void vertex() {
+	vec3 n = MODEL_MATRIX[0].xyz;
+	vec3 u = MODEL_MATRIX[1].xyz;
+	vec3 wv = MODEL_MATRIX[2].xyz;
+	vec3 place = MODEL_MATRIX[3].xyz;
+	vec2 uvc = clamp(UV, vec2(0.0), vec2(1.0));
+	float skirt = (UV.x != uvc.x || UV.y != uvc.y) ? 1.0 : 0.0;
+	vec2 g = uvc * 25.0;
+	vec2 st0 = place.xy + uvc * place.z;
+	vec3 d0 = tile_dir(n, u, wv, st0);
+	float dist = atan(length(cross(d0, pv)), dot(d0, pv)) * globe_r;
+	float mk = smoothstep(INSTANCE_CUSTOM.g * 1000.0, INSTANCE_CUSTOM.b * 1000.0, dist);
+	// To the parent's lattice: every other node of this level's own grid across the face (25 is odd, so a tile's parity is its place's).
+	vec2 cellxy = floor((place.xy + 1.0) / place.z + 0.5);
+	vec2 odd = mod(cellxy, 2.0);
+	vec2 gm = g - mod(g + odd, 2.0) * mk;
+	vec2 st = place.xy + gm / 25.0 * place.z;
+	vec3 dir = tile_dir(n, u, wv, st);
+	float lf = INSTANCE_CUSTOM.r + 0.01;
+	int layer = int(lf);
+	float dl = floor((lf - float(layer)) * 4.0);
+	float dsize = 2.0 / (3.0 * pow(2.0, dl));
+	vec2 d0xy = floor((place.xy + vec2(1.0)) / dsize + 0.001) * dsize - vec2(1.0);
+	vec2 dg = (st - d0xy) / dsize * 25.0 + vec2(1.0);   // on the layer: the ring outside the tile is its first row
+	ivec2 i0 = ivec2(floor(dg));
+	vec2 f = dg - vec2(i0);
+	float h00 = tile_h(i0, layer);
+	float h10 = tile_h(i0 + ivec2(1, 0), layer);
+	float h01 = tile_h(i0 + ivec2(0, 1), layer);
+	float h11 = tile_h(i0 + ivec2(1, 1), layer);
+	float h = f.x + f.y <= 1.0 ? h00 + f.x * (h10 - h00) + f.y * (h01 - h00) : h11 + (1.0 - f.x) * (h01 - h11) + (1.0 - f.y) * (h10 - h11);
+	// The slope, by the strip frame's own axes, so its light stays with the land: a solid thing under a fixed sun.
+	ivec2 ic = ivec2(floor(dg + 0.5));
+	float cell = dsize / 25.0;
+	vec2 c0 = tile_chart(dir, hdp, sdp, pvp);
+	vec2 cs = tile_chart(tile_dir(n, u, wv, st + vec2(cell, 0.0)), hdp, sdp, pvp) - c0;
+	vec2 ct = tile_chart(tile_dir(n, u, wv, st + vec2(0.0, cell)), hdp, sdp, pvp) - c0;
+	float hs = 0.5 * (tile_h(ic + ivec2(1, 0), layer) - tile_h(ic - ivec2(1, 0), layer));
+	float ht = 0.5 * (tile_h(ic + ivec2(0, 1), layer) - tile_h(ic - ivec2(0, 1), layer));
+	float det = cs.x * ct.y - cs.y * ct.x;
