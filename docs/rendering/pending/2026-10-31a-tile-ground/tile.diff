+
+
+func _copy_ground(src: ShaderMaterial) -> void:
+	for u in src.shader.get_shader_uniform_list():
+		var nm: String = u.name
+		if nm in ["fore_tone", "hts", "ids", "plane_tex", "pv", "pv0", "pvp", "hdp", "sdp", "hd", "sd", "hd0", "sd0", "strip_x", "plane_span", "globe_sx", "globe_off", "globe_lift_on", "globe_m"]:
+			continue
