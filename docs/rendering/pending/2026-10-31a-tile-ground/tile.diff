+		field.keep_off(cam_x, RenderLook.TILE_OFF_COLS)
+		field.fill(RenderLook.TILE_FILL_US)
+
+
+## The planet is being built again, so its copies are going: this drive ends with them.
+func drop() -> void:
+	if _node != null:
+		_node.queue_free()
+		_node = null
+	_chunks.clear()
+
+
+func _begin() -> void:
+	var planet: PlanetView = pane.planet
