+		var k: int = int(c.get_meta("k"))
+		for g in c.get_children():
+			if not (g is GeometryInstance3D):
+				continue
+			var nm: String = g.name
+			if k != 0 or nm.begins_with("Terrain") or nm.begins_with("Water") or nm.begins_with("FarTowns"):
