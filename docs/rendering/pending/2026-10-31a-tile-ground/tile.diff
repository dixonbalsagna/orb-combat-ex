+	if absf(cam_x - _walk_x) > RenderLook.TILE_WALK_STEP or _hd.dot(_walk_hd) < 0.99999 or absf(cam_d - _walk_z) > 0.02 * cam_d or absf(cam_h - _walk_y) > 0.05 * cam_h or field.version != _walk_v:
+		_walk_hd = _hd
+		_walk_v = field.version
+		_walk_x = cam_x
+		_walk_z = cam_d
+		_walk_y = cam_h
