+#!/usr/bin/env node
+// Civilians at a chosen place on the screen for the look gate: a scratch hook on Performance's pb scene. It edits a scratch
+// copy of the game (git archive into a folder of your own), never the repo. Apply after
+// docs/perf/tools/scratch-hooks/hook-perf.mjs, hook-slice.mjs and hook-pbiome.mjs.
+//
+//   node docs/rendering/tools/crowd-hook.mjs <scratch tree>
+//
+// Page words it adds (the pb scene's, in the scratch copy only):
+//   crowdfar=<dx>    the pair stands dx units along the planet from the populated building whose figures stand nearest crowdz
+//   crowdz=<z>       that depth (default -600)
+//   crowdsep=<s>     how far apart the pair stands (default 120): a wider pair zooms the camera out
+//   crowdhand=1      the match is on the hand-made world, not a planet
+// Node 24 built-ins only. No Godot, no browser. Owner: Rendering and Technical Art.
+import { readFileSync, writeFileSync, existsSync } from 'node:fs';
+import { join } from 'node:path';
+
+const root = process.argv[2];
+if (!root || !existsSync(join(root, 'project.godot'))) { console.error('usage: node docs/rendering/tools/crowd-hook.mjs <scratch tree holding project.godot>'); process.exit(2); }
+const f = join(root, 'render/tools/flash_capture.gd');
+let s = readFileSync(f, 'utf8');
+if (s.includes('func _crowd_place(')) process.exit(0);
+const edits = [
+  ['\t\t\t\t_pb_place(S)\n', '\t\t\t\t_pb_place(S)\n\t\t\t\t_crowd_place(S)\n'],
+  ['\tmain.start_match(seed if seed != 0 else SEED, ai_set, su_p)', '\tif _page_kv("crowdhand") != "":\n\t\tsu_p = {}\n\tmain.start_match(seed if seed != 0 else SEED, ai_set, su_p)'],
+];
+for (const [a, b] of edits) {
+  if (s.split(a).length !== 2) { console.error(`crowd-hook: the anchor is missing or not once (apply the pb hooks first): ${a.slice(0, 60)}`); process.exit(1); }
+  s = s.replace(a, () => b);
+}
+s += `
+
+## SCRATCH (docs/rendering/tools/crowd-hook.mjs): the pair at crowdfar from a populated building, its figures near crowdz deep.
+func _crowd_place(S: SimState) -> void:
+	if _page_kv("crowdfar") == "":
+		return
+	var P = main.planet
+	var want: float = float(_page_kv("crowdz")) if _page_kv("crowdz") != "" else -600.0
+	var best: int = -1
+	var best_d: float = INF
+	for bi in range(S.buildings.size()):
+		var first: int = P._crowd_first[bi]
+		if P._crowd_first[bi + 1] - first < 4:
+			continue
+		var d: float = absf(float(P._crowd_z[first]) - want)
+		if d < best_d:
+			best_d = d
+			best = bi
+	if best < 0:
+		return
+	var sep: float = float(_page_kv("crowdsep")) if _page_kv("crowdsep") != "" else 120.0
+	for i in range(2):
+		var fx = S.fighters[i]
+		fx.x = SimWrap.wrap(float(S.buildings[best].x) - float(_page_kv("crowdfar")) + sep * (float(i) - 0.5))
+		fx.y = WorldTerrain.groundY(S, fx.x)
+		fx.vx = 0.0
+		fx.vy = 0.0
+		fx.face = 1.0 if i == 0 else -1.0
+	JavaScriptBridge.eval("window.__crowdinfo = %s;" % JSON.stringify({"building": best, "x": S.buildings[best].x, "z": P._crowd_z[P._crowd_first[best]]}), true)
+`;
+writeFileSync(f, s);
+console.log('crowd hook applied');
