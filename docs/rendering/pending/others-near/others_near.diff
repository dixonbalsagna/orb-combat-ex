+## other_events, with an empty list for a fight no pane drew a body of last frame (other_near): what the other fights'
+## hubs take. The pairing by order stays (VfxStageFeed).
+func other_events_near() -> Array:
+	var out: Array = []
+	if S.stage == null:
+		return out
+	for k in range(S.stage.fights.size()):
+		if k != S.stage.cur:
+			out.append(S.stage.fights[k].out.fx if other_near.has(k) else [])
+	return out
+
+
+## 2v2: a pane drew a body of fight k this frame (PaneWorld._draw_others).
+func saw_other(k: int) -> void:
+	_near_acc[k] = true
+
+
+## The frame's drawing is done: the fights the panes drew are the near ones until the next (main.frame).
+func near_done() -> void:
+	other_near = _near_acc
+	_near_acc = {}
+
