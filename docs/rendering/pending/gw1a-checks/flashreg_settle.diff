 ## A beam put into the tool's own match for one ask: [how many times `beam` was asked of the register, whether its
 ## bright form was granted, the weight it was asked with, the weight its area should give at this camera's scale]. It is
 ## taken out again before the sim steps.
+## A match's first frames can pull the camera's zoom by more than the camera rows' 5% in a frame (GW1a's opening, 2026-11-14): step until it moves
+## less than 0.2% a frame (at most 240 frames), so the register's scale and its frame-old copy are read on a steady camera. Each frame runs one
+## tick (the register copies the scale as it consumes a tick's events), so the last frame leaves the copy current, as the rows' one frame did.
+func _settle(host: SimHost) -> void:
+	for k in range(240):
+		var was: float = host.vfx.px_per_unit
+		host.acc = SimConst.DT * 0.9999
+		main.frame(SimConst.DT)
+		if was > 0.0 and absf(host.vfx.px_per_unit - was) < 0.002 * was:
+			return
+
+
 func _beam_asks(host: SimHost) -> Array:
 	var before: int = _rows_of(host, "beam")
 	var b := SimState.Beam.new()
