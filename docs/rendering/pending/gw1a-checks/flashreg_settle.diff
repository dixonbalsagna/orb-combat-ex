+	_expect(absf(host.vfx.px_per_unit - want_ppu) < 0.05 * want_ppu and is_equal_approx(reg4.ppu, ppu_set), "the camera's scale reaches the register every frame: %.2f pixels a world unit at 1024 by 768 (the reference camera's %.2f)" % [reg4.ppu, want_ppu])
