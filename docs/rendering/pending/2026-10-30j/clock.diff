+## The crowd's clock for this pane's chunks: the sim's tick in seconds (it runs through a hit-stop and an intro, as the
+## wall clock did, and holds in a pause), so two captures of a tick draw the same figures.
+func _send_crowd_clock(S: SimState) -> void:
+	if S.tick == _crowd_clock_sent:
+		return
+	_crowd_clock_sent = S.tick
+	var now: float = float(S.tick) * SimConst.DT
+	for m in _crowd_mats:
+		m.set_shader_parameter("crowd_now", now)
 
 
