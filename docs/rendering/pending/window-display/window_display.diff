+
+## The window, from the Display row's Window (A-PERF-08; UI's row, "fullscreen" or "windowed"). The project file starts a
+## desktop build full screen at the screen's own size (display/window/size/mode), so a 1280 by 800 screen is filled. A saved
+## "windowed" makes it a window at the start, and a change on the Settings screen does so at once. The web page owns its
+## canvas. A headless run, a tool, the capture hook, a bench and a scripted run keep the window they were given, and so does
+## a start whose command line names one of Godot's own window flags (WINDOW_FLAGS). Vertical sync is a fixed choice: on
+## (Godot's default), off only for --bench and --novsync. There's no frame cap: the sync caps the frame rate.
+func _apply_display(at_start: bool) -> void:
+	if DisplayServer.get_name() == "headless" or OS.has_feature("web") or get_parent() != get_tree().root:
+		return
+	if manual or flashcap != null or args.has("bench") or args.has("frames") or args.has("shot"):
+		return
+	var windowed: bool = str(ui_hud.opts.get("window_mode", "fullscreen")) == "windowed"
+	if at_start:
+		if not windowed:
+			return
+		for a in OS.get_cmdline_args():
+			if WINDOW_FLAGS.has(a):
+				return
+	var mode: int = DisplayServer.window_get_mode()
+	var full: bool = mode == DisplayServer.WINDOW_MODE_FULLSCREEN or mode == DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN
+	if not windowed:
+		if not full:
+			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
+		return
+	if not full:
+		return   # already a window, maximised or not: the player's size stays
+	DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
+	var area: Rect2i = DisplayServer.screen_get_usable_rect(DisplayServer.window_get_current_screen())
+	var wsize := Vector2i(mini(WINDOWED_SIZE.x, int(area.size.x * 0.9)), mini(WINDOWED_SIZE.y, int(area.size.y * 0.9)))
+	DisplayServer.window_set_size(wsize)
+	DisplayServer.window_set_position(area.position + (area.size - wsize) / 2)
 
 
