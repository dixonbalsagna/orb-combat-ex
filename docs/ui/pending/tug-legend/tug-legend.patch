+## The beam struggle's legend (docs/controls/struggle-input.md): LET GO on A (on Guard for Simple), "on the beat" on the buttons that surge, and on a touch screen a caption that teaches a tap, never a swipe.
+func _tug_legend_rules() -> void:
+	root.size = Vector2i(1280, 720)
+	var hud: UiHud = load("res://ui/hud/ui_hud.tscn").instantiate()
+	hud.size = Vector2(1280, 720)
+	root.add_child(hud)
+	await process_frame
+	hud.setup(["protagonist", "anti_hero"], ["ONE", "TWO"])
+	hud.hub.patch(0, {"ai": false})
+	hud.hub.patch(1, {"ai": true})
+	var m0: UiFighterModel = hud.hub.model(0)
+	var m1: UiFighterModel = hud.hub.model(1)
+	var notes := func(m: UiFighterModel, scheme: String) -> Dictionary:
+		var out := {}
+		m.stance_kind = 0
+		for r in UiHints.rows(m, scheme, "hold"):
+			out[str((r["acts"] as Array)[0])] = str(r.get("note", ""))
+		return out
+	hud.advance(1.0 / 60.0)
+	var before: Dictionary = notes.call(m0, "arena")
+	_ok(not m0.in_struggle and str(before.get("context", "")) != "LET GO" and str(before.get("light", "")) != "on the beat", "tug legend: nothing about a struggle while there is none")
+	hud.hub.consume({"type": "cue", "actor": 0, "kind": "beam_struggle", "text": "start", "target": 1, "n": 600})
+	hud.advance(1.0 / 60.0)
+	_ok(m0.in_struggle and not m1.in_struggle, "tug legend: a human in the struggle is marked, the computer is not")
+	for sc in ["arena", "kb-solo", "kb-shared-p1", "kb-shared-p2"]:
+		var n: Dictionary = notes.call(m0, sc)
+		_ok(str(n.get("context", "")) == "LET GO" and str(n.get("light", "")) == "on the beat" and str(n.get("heavy", "")) == "on the beat" and str(n.get("signature", "")) == "on the beat", "tug legend: %s says LET GO on A and on the beat on X, Y and B (%s)" % [sc, str(n)])
+	var ns: Dictionary = notes.call(m0, "simple-pad")
+	_ok(str(ns.get("guard", "")) == "LET GO" and str(ns.get("light", "")) == "on the beat" and str(ns.get("context", "")) == "", "tug legend: Simple says LET GO on Guard and on the beat on Attack (%s)" % str(ns))
+	# A touch screen has no legend: a caption teaches a tap.
+	hud.set_option("touch_ui", true)
+	hud.advance(1.0 / 60.0)
+	var caps_simple: Array = hud._tug_caps()
+	hud._slot_presets[0] = "touch-full"
+	var caps_full: Array = hud._tug_caps()
+	_ok(caps_simple == ["Tap Attack on the beat", "Tap Guard to let go"] and caps_full == ["Tap on the beat", "Tap Action to let go"], "tug legend: touch captions %s %s" % [str(caps_simple), str(caps_full)])
+	var no_swipe := true
+	for c in caps_simple + caps_full:
+		no_swipe = no_swipe and not str(c).to_lower().contains("swipe") and str(c).to_lower().contains("tap")
+	_ok(no_swipe, "tug legend: the captions teach a tap and never a swipe")
+	hud._slot_presets.erase(0)
+	hud.set_option("touch_ui", false)
+	_ok(hud._tug_caps().is_empty(), "tug legend: no captions off a touch screen (the legend says it)")
+	# The end clears it.
+	hud.hub.consume({"type": "cue", "actor": 0, "kind": "beam_end", "text": "time", "x": 0.5})
+	hud.advance(1.0 / 60.0)
+	var after: Dictionary = notes.call(m0, "arena")
+	_ok(not m0.in_struggle and str(after.get("context", "")) != "LET GO", "tug legend: the words go when the struggle ends")
+	hud.queue_free()
+	await process_frame
+
+
 ## The photosensitivity rule for the HUD (docs/ui/hud-spec.md section 57): no block of the HUD may come and go twice inside 60 ticks, whatever the presses do. A mash is played at the HUD
 ## (a refused or empty press every 4 ticks, a wind-up on and off every 6, a stance change every 10, the launch window, banners, the touch flag flipping), at a keyboard-and-pad size and on a
 ## phone, and every layer's presence is sampled each tick; a layer that changes state twice in 60 ticks (after the first 30 ticks) fails.
