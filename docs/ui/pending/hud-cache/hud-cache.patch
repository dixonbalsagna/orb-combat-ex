diff -ruN a/ui/hud/ui_layer.gd b/ui/hud/ui_layer.gd
--- a/ui/hud/ui_layer.gd	2026-10-17 03:38:07.679878800 -0700
+++ b/ui/hud/ui_layer.gd	2026-10-17 03:38:07.805602600 -0700
@@ -10,6 +10,25 @@
 var redraws: int = 0                 # how many times this layer has been redrawn (the perf counters read it)
 
 
+## Texture caching (features.json `hud_cache`, docs/ui/hud-cache.md): a layer that has a `rect_fn` and whose picture changes seldom is painted into a small SubViewport when its signature changes, and
+## drawn as one textured rectangle every frame: a layer of fifty draw calls becomes one. The painter runs unchanged, with a canvas the size of the layer; the viewport sees only the layer's rectangle.
+var rect_fn: Callable = Callable()   # returns the layer's bounding rectangle in layer coordinates (the layout's rectangle for it); empty = never cached
+var cached_paints: int = 0           # how many times the cache has been repainted (the tests read it)
+var _vp: SubViewport
+var _cv: Control
+var _crect := Rect2()
+const CACHE_MAX_PX := 400000.0      # a layer whose rectangle is larger than this is drawn directly (a full-screen layer would cost more memory than it saves)
+const CACHE_MARGIN := 16.0           # the layout's rectangle grown by this, so an edge, a shadow or a ring that overhangs it is kept
+
+
+class PaintCanvas extends Control:
+	var layer: UiLayer
+
+	func _draw() -> void:
+		if layer != null and layer.sig != null and layer.painter.is_valid():
+			layer.painter.call(self)
+
+
 var dirty: bool = false
 var force: bool = false              # bench only: redraw every frame whatever the signature (the cost of not caching)
 
@@ -39,8 +58,61 @@
 	dirty = true
 
 
+## True when this layer should be drawn through its texture: the switch is on, it has a rectangle, and the rectangle is a size worth caching.
+func has_cache() -> bool:
+	return _vp != null
+
+
+func uses_cache() -> bool:
+	if not rect_fn.is_valid() or not UiData.feature("hud_cache"):
+		return false
+	var r: Rect2 = _cache_rect()
+	return r.size.x >= 4.0 and r.size.y >= 4.0 and r.size.x * r.size.y <= CACHE_MAX_PX
+
+
+func _cache_rect() -> Rect2:
+	var r: Rect2 = (rect_fn.call() as Rect2).grow(CACHE_MARGIN).intersection(Rect2(Vector2.ZERO, size))
+	var p0 := Vector2(floorf(r.position.x), floorf(r.position.y))
+	var p1 := Vector2(ceilf(r.end.x), ceilf(r.end.y))
+	return Rect2(p0, p1 - p0)
+
+
 func _draw() -> void:
 	if sig == null or not painter.is_valid():
 		return
 	redraws += 1
+	if uses_cache():
+		_draw_cached()
+		return
 	painter.call(self)
+
+
+func _draw_cached() -> void:
+	var r: Rect2 = _cache_rect()
+	if _vp == null:
+		_vp = SubViewport.new()
+		_vp.transparent_bg = true
+		_vp.disable_3d = true
+		_vp.gui_disable_input = true
+		_vp.render_target_update_mode = SubViewport.UPDATE_DISABLED
+		add_child(_vp)
+		var cv := PaintCanvas.new()
+		cv.layer = self
+		cv.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		cv.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED   # the bars' tiled stripe
+		_vp.add_child(cv)
+		_cv = cv
+		var mat := CanvasItemMaterial.new()
+		mat.blend_mode = CanvasItemMaterial.BLEND_MODE_PREMULT_ALPHA   # the viewport holds premultiplied colour
+		material = mat
+		texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
+	if Vector2i(r.size) != _vp.size:
+		_vp.size = Vector2i(r.size)
+	_vp.canvas_transform = Transform2D(0.0, -r.position)
+	_cv.size = size
+	_cv.position = Vector2.ZERO
+	_cv.queue_redraw()
+	_vp.render_target_update_mode = SubViewport.UPDATE_ONCE
+	cached_paints += 1
+	_crect = r
+	draw_texture_rect(_vp.get_texture(), r, false)
diff -ruN a/ui/tools/hud_cache_stills.mjs b/ui/tools/hud_cache_stills.mjs
--- a/ui/tools/hud_cache_stills.mjs	1969-12-31 16:00:00.000000000 -0800
+++ b/ui/tools/hud_cache_stills.mjs	2026-10-17 03:38:07.859805500 -0700
@@ -0,0 +1,40 @@
+// The pixel proof for the HUD's texture cache (docs/ui/hud-cache.md): the same still of the HUD demo, taken twice (layers drawn directly, and through the cache), compared pixel by pixel.
+// Needs a web export of the HUD demo scene (scratch copy with run/main_scene=res://ui/demo/hud_demo.tscn, --export-release "Web") and the capture launcher; takes headless Chrome, so it waits for
+// the machine's quiet window. Run from the repo root:
+//   node ui/tools/hud_cache_stills.mjs <built site dir> [--tol 2] [--out stills-folder] [--session ui-ux]
+// For each scenario and size it writes <out>/<name>-direct.png and -cache.png, runs ui/tools/png_diff.mjs and prints the result; exit code 1 if any pair differs by more than --max-bad pixels (default 0).
+import { spawnSync } from 'node:child_process';
+import { mkdirSync } from 'node:fs';
+import { decodePng, diffPng } from './png_diff.mjs';
+import { readFileSync } from 'node:fs';
+
+const args = process.argv.slice(2);
+const opt = (n, d) => { const i = args.indexOf(n); return i >= 0 ? args[i + 1] : d; };
+const dir = args.find((a) => !a.startsWith('--') && a !== opt('--tol') && a !== opt('--out') && a !== opt('--session') && a !== opt('--max-bad'));
+if (!dir) { console.error('usage: node ui/tools/hud_cache_stills.mjs <built demo site dir> [--tol 2] [--out folder] [--session name] [--max-bad 0]'); process.exit(2); }
+const out = opt('--out', 'scratch-stills'), tol = Number(opt('--tol', 2)), maxBad = Number(opt('--max-bad', 0)), session = opt('--session', 'ui-ux');
+mkdirSync(out, { recursive: true });
+// scenario, query, width, height. `at` fast-forwards the mock feed, `hold` stops its clock so both loads show the same frame.
+const cases = [
+  ['hero-720', 'scenario=hero_vs_proud&at=12&hold&nolegend', 1280, 720],
+  ['hero-legend-720', 'scenario=hero_vs_proud&at=12&hold', 1280, 720],
+  ['hero-phone', 'scenario=hero_vs_proud&at=12&hold&touch=ready', 844, 390],
+  ['hero-portrait', 'scenario=hero_vs_proud&at=12&hold&portrait', 390, 844],
+  ['toll-720', 'scenario=hero_vs_proud&at=12&hold&toll=134:425:9:14&nolegend', 1280, 720],
+  ['empress-cyborg', 'scenario=empress_vs_cyborg&at=14&hold', 1280, 720],
+  ['stress', 'scenario=stress&at=10&hold', 1280, 720],
+];
+let worst = 0;
+for (const [name, q, w, h] of cases) {
+  const files = {};
+  for (const mode of ['direct', 'cache']) {
+    files[mode] = `${out}/${name}-${mode}.png`;
+    const r = spawnSync('node', ['tools/machine/capture.mjs', 'still', '--dir', dir, '--path', `/index.html?${q}${mode === 'cache' ? '&cache' : ''}`, '--out', files[mode], '--width', String(w), '--height', String(h),
+      '--wait-ms', '45000', '--session', session, '--purpose', 'hudcache', '--time-limit', '300', '--software', '--quiet'], { stdio: 'inherit' });
+    if (r.status !== 0) { console.error(`capture failed for ${name} ${mode}`); process.exit(2); }
+  }
+  const d = diffPng(decodePng(readFileSync(files.direct)), decodePng(readFileSync(files.cache)), tol);
+  console.log(`${name}: ${d.error ? d.error : `${d.bad} pixels over ${tol} of ${d.w * d.h} (max difference ${d.maxDiff}, worst at ${d.worst})`}`);
+  worst = Math.max(worst, d.bad < 0 ? 1e9 : d.bad);
+}
+process.exit(worst <= maxBad ? 0 : 1);
