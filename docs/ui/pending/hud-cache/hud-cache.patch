diff -ruN a/ui/tools/hud_layers.gd b/ui/tools/hud_layers.gd
--- a/ui/tools/hud_layers.gd	1969-12-31 16:00:00.000000000 -0800
+++ b/ui/tools/hud_layers.gd	2026-10-17 03:38:07.859302500 -0700
@@ -0,0 +1,81 @@
+extends SceneTree
+## Which of the HUD's layers redraw, and how often, in a real brawl: plays AI against AI through the sim host with a moving anchor for each fighter, feeds the HUD the way the game does, and
+## counts every layer's redraws (UiLayer.redraws) and the frames it had something to draw (a signature). A layer that redraws on a few frames in a hundred is worth caching as a texture
+## (docs/ui/hud-cache.md); one that redraws on most is not. Headless: no draw calls are counted here (the engine's renderer is off); Performance's layer cut reads those.
+## Run: godot --headless --path . --script res://ui/tools/hud_layers.gd [-- --seed=4 --ticks=1800 --cache]
+
+func _initialize() -> void:
+	_run.call_deferred()
+
+
+func _run() -> void:
+	var seed: int = 4
+	var ticks: int = 1800
+	var cache: bool = false
+	for a in OS.get_cmdline_user_args():
+		if a.begins_with("--seed="):
+			seed = int(a.substr(7))
+		elif a.begins_with("--ticks="):
+			ticks = int(a.substr(8))
+		elif a == "--cache":
+			cache = true
+	if cache:
+		UiData.set_feature("hud_cache", true)
+	var host := SimHost.new()
+	host.new_match(seed)
+	root.size = Vector2i(1280, 720)
+	var hud: UiHud = load("res://ui/hud/ui_hud.tscn").instantiate()
+	hud.size = Vector2(1280, 720)
+	root.add_child(hud)
+	await process_frame
+	var f: Array = UiSimBridge.fighters(host.S)
+	hud.setup(f[0], f[1])
+	var vp: Vector2 = hud.layout.vp
+	hud.anchor_fn = func(slot: int) -> Dictionary:
+		var fi = host.S.fighters[slot]
+		var mid: float = float(host.S.fighters[0].x) + SimWrap.sdx(float(host.S.fighters[0].x), float(host.S.fighters[1].x)) * 0.5
+		var dx: float = SimWrap.sdx(mid, float(fi.x))
+		return {"pos": Vector2(vp.x * 0.5 + dx * 0.35, vp.y * 0.62 - float(fi.y) * 0.35), "h": vp.y * 0.11, "visible": true}
+	host.drained.connect(func(evs: Array, _lines: Array): hud.consume_all(evs))
+	var layers: Array = hud._all_layers()
+	var base: Dictionary = {}
+	var drawn: Dictionary = {}
+	for l in layers:
+		if l != null:
+			base[l] = 0
+			drawn[l] = 0
+	for i in range(ticks):
+		host.tick(1280.0, 720.0)
+		UiSimBridge.patch(hud, host.S)
+		UiSimBridge.feed(hud, host.feed.slice(maxi(0, host.feed.size() - 1)))
+		hud.hub.model(0).ai = false
+		hud.advance(1.0 / 60.0)
+		await process_frame
+		if i == 60:
+			for l in layers:
+				if l != null:
+					base[l] = l.redraws
+					drawn[l] = 0
+		elif i > 60:
+			for l in layers:
+				if l != null and l.sig != null:
+					drawn[l] += 1
+	var n: int = ticks - 61
+	var rows: Array = []
+	var names := {}
+	for l in layers:
+		if l == null:
+			continue
+		var nm: String = str(l.painter.get_method()) if l.painter.is_valid() else "?"
+		if l.painter.is_valid() and l.painter.get_bound_arguments_count() > 0:
+			nm += str(l.painter.get_bound_arguments())
+		rows.append([nm, int(l.redraws) - int(base[l]), int(drawn[l])])
+	rows.sort_custom(func(a, b): return int(a[1]) > int(b[1]))
+	print("HUD layers over %d frames (seed %d, cache %s): redraws, frames with something to draw" % [n, seed, str(cache)])
+	var total_draw_frames := 0
+	for r in rows:
+		print("  %-34s redraws %5d (%3d%%)   drawn %5d (%3d%%)" % [r[0], r[1], int(round(100.0 * float(r[1]) / float(n))), r[2], int(round(100.0 * float(r[2]) / float(n)))])
+		total_draw_frames += int(r[2])
+	print("layers drawn per frame on average: %.1f" % (float(total_draw_frames) / float(n)))
+	hud.queue_free()
+	quit()
diff -ruN a/ui/tools/png_diff.mjs b/ui/tools/png_diff.mjs
--- a/ui/tools/png_diff.mjs	1969-12-31 16:00:00.000000000 -0800
+++ b/ui/tools/png_diff.mjs	2026-10-17 03:38:07.859805500 -0700
@@ -0,0 +1,90 @@
+// Compares two PNG stills pixel by pixel, with no dependencies (node's zlib only): the proof that the HUD's texture cache draws what the layers draw (docs/ui/hud-cache.md).
+//   node ui/tools/png_diff.mjs a.png b.png [--tol 2] [--max-bad 0] [--out diff.png]
+// Prints one JSON line: {w, h, bad (pixels whose largest channel difference is over tol), maxDiff, worst: [x, y], share}. Exit code 0 when bad <= max-bad, 1 otherwise, 2 on a read error.
+// Reads 8-bit RGB and RGBA PNGs without interlacing (what headless Chrome and the capture launcher write). --out writes the difference (red where bad) as an RGBA PNG.
+import { readFileSync, writeFileSync } from 'node:fs';
+import { inflateSync, deflateSync } from 'node:zlib';
+
+export function decodePng(buf) {
+  const sig = [137, 80, 78, 71, 13, 10, 26, 10];
+  for (let i = 0; i < 8; i++) if (buf[i] !== sig[i]) throw new Error('not a PNG');
+  let pos = 8, w = 0, h = 0, depth = 0, ctype = 0, interlace = 0;
+  const idat = [];
+  while (pos < buf.length) {
+    const len = buf.readUInt32BE(pos), type = buf.toString('ascii', pos + 4, pos + 8);
+    const data = buf.subarray(pos + 8, pos + 8 + len);
+    if (type === 'IHDR') { w = data.readUInt32BE(0); h = data.readUInt32BE(4); depth = data[8]; ctype = data[9]; interlace = data[12]; }
+    else if (type === 'IDAT') idat.push(data);
+    else if (type === 'IEND') break;
+    pos += 12 + len;
+  }
+  if (depth !== 8 || interlace !== 0 || (ctype !== 6 && ctype !== 2)) throw new Error(`unsupported PNG (depth ${depth}, colour type ${ctype}, interlace ${interlace})`);
+  const bpp = ctype === 6 ? 4 : 3, stride = w * bpp;
+  const raw = inflateSync(Buffer.concat(idat));
+  const out = Buffer.alloc(w * h * 4);
+  let prev = Buffer.alloc(stride), cur = Buffer.alloc(stride), p = 0;
+  for (let y = 0; y < h; y++) {
+    const f = raw[p++];
+    for (let i = 0; i < stride; i++) {
+      const x = raw[p++];
+      const a = i >= bpp ? cur[i - bpp] : 0, b = prev[i], c = i >= bpp ? prev[i - bpp] : 0;
+      let v;
+      if (f === 0) v = x;
+      else if (f === 1) v = x + a;
+      else if (f === 2) v = x + b;
+      else if (f === 3) v = x + ((a + b) >> 1);
+      else { const pa = Math.abs(b - c), pb = Math.abs(a - c), pc = Math.abs(a + b - 2 * c); v = x + (pa <= pb && pa <= pc ? a : pb <= pc ? b : c); }
+      cur[i] = v & 255;
+    }
+    for (let xx = 0; xx < w; xx++) {
+      const o = (y * w + xx) * 4;
+      out[o] = cur[xx * bpp]; out[o + 1] = cur[xx * bpp + 1]; out[o + 2] = cur[xx * bpp + 2]; out[o + 3] = bpp === 4 ? cur[xx * bpp + 3] : 255;
+    }
+    [prev, cur] = [cur, prev];
+  }
+  return { w, h, rgba: out };
+}
+
+function crc32(buf) {
+  let c, crc = 0xffffffff;
+  for (let n = 0; n < buf.length; n++) { c = (crc ^ buf[n]) & 255; for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; crc = (crc >>> 8) ^ c; }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+
+export function encodePng(w, h, rgba) {
+  const rows = Buffer.alloc((w * 4 + 1) * h);
+  for (let y = 0; y < h; y++) { rows[y * (w * 4 + 1)] = 0; rgba.copy(rows, y * (w * 4 + 1) + 1, y * w * 4, (y + 1) * w * 4); }
+  const chunk = (type, data) => { const b = Buffer.alloc(12 + data.length); b.writeUInt32BE(data.length, 0); b.write(type, 4, 'ascii'); data.copy(b, 8); b.writeUInt32BE(crc32(b.subarray(4, 8 + data.length)), 8 + data.length); return b; };
+  const ihdr = Buffer.alloc(13); ihdr.writeUInt32BE(w, 0); ihdr.writeUInt32BE(h, 4); ihdr[8] = 8; ihdr[9] = 6;
+  return Buffer.concat([Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]), chunk('IHDR', ihdr), chunk('IDAT', deflateSync(rows)), chunk('IEND', Buffer.alloc(0))]);
+}
+
+export function diffPng(a, b, tol = 2) {
+  if (a.w !== b.w || a.h !== b.h) return { w: a.w, h: a.h, error: `sizes differ: ${a.w}x${a.h} and ${b.w}x${b.h}`, bad: -1 };
+  let bad = 0, maxDiff = 0, worst = [0, 0];
+  const diff = Buffer.alloc(a.w * a.h * 4);
+  for (let i = 0; i < a.w * a.h; i++) {
+    let d = 0;
+    for (let c = 0; c < 4; c++) d = Math.max(d, Math.abs(a.rgba[i * 4 + c] - b.rgba[i * 4 + c]));
+    if (d > maxDiff) { maxDiff = d; worst = [i % a.w, Math.floor(i / a.w)]; }
+    const isBad = d > tol;
+    if (isBad) bad++;
+    diff[i * 4] = isBad ? 255 : a.rgba[i * 4] >> 2; diff[i * 4 + 1] = isBad ? 0 : a.rgba[i * 4 + 1] >> 2; diff[i * 4 + 2] = isBad ? 0 : a.rgba[i * 4 + 2] >> 2; diff[i * 4 + 3] = 255;
+  }
+  return { w: a.w, h: a.h, bad, maxDiff, worst, share: bad / (a.w * a.h), diff };
+}
+
+if (process.argv[1] && process.argv[1].endsWith('png_diff.mjs')) {
+  const args = process.argv.slice(2);
+  const opt = (n, d) => { const i = args.indexOf(n); return i >= 0 ? args[i + 1] : d; };
+  const files = args.filter((x, i) => !x.startsWith('--') && !(i > 0 && args[i - 1].startsWith('--')));
+  try {
+    const A = decodePng(readFileSync(files[0])), B = decodePng(readFileSync(files[1]));
+    const r = diffPng(A, B, Number(opt('--tol', 2)));
+    const out = opt('--out');
+    if (out && r.diff) writeFileSync(out, encodePng(r.w, r.h, r.diff));
+    delete r.diff;
+    console.log(JSON.stringify(r));
+    process.exit(r.bad >= 0 && r.bad <= Number(opt('--max-bad', 0)) ? 0 : 1);
+  } catch (e) { console.error(String(e.message || e)); process.exit(2); }
+}
