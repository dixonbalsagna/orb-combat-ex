+
+## The texture cache (docs/ui/hud-cache.md), behind features.json hud_cache: which layers, how big, repainted only when their signature changes, and the same words drawn.
+func _hud_cache_rules() -> void:
+	root.size = Vector2i(1280, 720)
+	var hud: UiHud = load("res://ui/hud/ui_hud.tscn").instantiate()
+	hud.size = Vector2(1280, 720)
+	root.add_child(hud)
+	await process_frame
+	hud.setup(["protagonist", "anti_hero"], ["ONE", "TWO"])
+	var words_of := func(layer: UiLayer) -> String:
+		UiText.tracing = true
+		UiText.trace = []
+		layer.invalidate()
+		hud.advance(1.0 / 60.0)
+		for i in range(3):
+			await process_frame
+		UiText.tracing = false
+		var seen := {}
+		for x in UiText.trace:
+			seen[str(x)] = true
+		var keys: Array = seen.keys()
+		keys.sort()
+		UiText.trace = []
+		return " ".join(PackedStringArray(keys))   # the distinct strings drawn: a texture repaint draws once, a direct layer once for each redraw
+	hud.advance(1.0 / 60.0)
+	await process_frame
+	var plate: UiLayer = hud._l_plate[0]
+	_ok(not UiData.feature("hud_cache") and not plate.uses_cache() and not plate.has_cache(), "hud cache: off by default, and a layer draws directly")
+	var direct: String = await words_of.call(plate)
+	UiData.set_feature("hud_cache", true)
+	var cached: String = await words_of.call(plate)
+	_ok(plate.uses_cache() and plate.has_cache() and plate.cached_paints >= 1, "hud cache: with the switch on the plate paints into a texture (%d paints)" % plate.cached_paints)
+	var same_words: bool = cached != "" and direct != ""
+	for tok in cached.split(" "):
+		same_words = same_words and direct.split(" ").has(tok)
+	_ok(same_words and cached.contains("ONE") and cached.contains("MARTIAL"), "hud cache: the plate's words are drawn through the texture's canvas as through the layer (the direct trace holds both plates: %s | %s)" % [cached, direct])
+	# Repainted only when the signature changes.
+	var p0: int = plate.cached_paints
+	for i in range(30):
+		hud.advance(1.0 / 60.0)
+		await process_frame
+	_ok(plate.cached_paints - p0 <= 1, "hud cache: thirty still frames repaint the texture at most once (%d)" % (plate.cached_paints - p0))
+	hud.hub.patch(0, {"charge": 55.0})
+	hud.advance(1.0 / 60.0)
+	await process_frame
+	_ok(plate.cached_paints > p0, "hud cache: a change of the plate's state repaints it")
+	# The rectangle: the layout's, grown, inside the layer; small enough; and the total memory is small at every size.
+	var bad := PackedStringArray()
+	for cs in [[Vector2(1280, 720), 1.0], [Vector2(1920, 1080), 1.0], [Vector2(844, 390), 1.0], [Vector2(390, 844), 1.0], [Vector2(2532, 1170), 3.0]]:
+		var h2: UiHud = load("res://ui/hud/ui_hud.tscn").instantiate()
+		h2.size = cs[0]
+		root.add_child(h2)
+		await process_frame
+		h2.setup(["protagonist", "anti_hero"], ["ONE", "TWO"])
+		h2.advance(1.0 / 60.0)
+		var total := 0.0
+		for l in h2._all_layers():
+			if l != null and (l as UiLayer).rect_fn.is_valid():
+				var r: Rect2 = (l as UiLayer)._cache_rect()
+				var raw: Rect2 = (l as UiLayer).rect_fn.call()
+				total += r.size.x * r.size.y
+				if raw.size.x > 4.0 and not (Rect2(Vector2.ZERO, h2.layout.vp)).encloses(r) and r.size.x * r.size.y > 0.0:
+					bad.append("%s outside %s" % [str(cs[0]), str(r)])
+				if raw.size.x > 4.0 and not r.encloses(raw.intersection(Rect2(Vector2.ZERO, h2.layout.vp))):
+					bad.append("%s does not hold its layout rect %s" % [str(cs[0]), str(raw)])
+		if total > 2000000.0:
+			bad.append("%s total %d px" % [str(cs[0]), int(total)])
+		h2.queue_free()
+		await process_frame
+	_ok(bad.is_empty(), "hud cache: at five sizes every cached rectangle holds its layout's and stays on screen, and all of them together are under two million pixels (8 MB) (%d bad %s)" % [bad.size(), str(bad.slice(0, 3))])
+	# A layer too big to cache is drawn directly; with the switch off nothing is cached.
+	var big := UiLayer.new()
+	big.size = Vector2(1280, 720)
+	big.rect_fn = func() -> Rect2: return Rect2(0, 0, 1280, 720)
+	_ok(not big.uses_cache(), "hud cache: a full-screen layer is not cached (the memory would cost more than the draw calls saved)")
+	big.free()
+	UiData.set_feature("hud_cache", null)
+	hud.hub.patch(0, {"charge": 20.0})
+	hud.advance(1.0 / 60.0)
