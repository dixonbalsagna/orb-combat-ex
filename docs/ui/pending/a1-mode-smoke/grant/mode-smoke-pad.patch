+	for _i in range(_menu_rows().size() + 2):
+		if _menu_lit() == id:
+			return true
+		await _pad(JOY_BUTTON_DPAD_DOWN)
+	return _menu_lit() == id
+
+
+## The pause card's items and the lit one.
+func _pause_ids() -> Array:
+	var ids: Array = []
