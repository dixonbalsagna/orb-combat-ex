@@ -0,0 +1,15 @@
+{
+  "schema": 1,
+  "note": "The start menu's list of modes (docs/ui/menus-a1.md), in the order the list shows them. A row appears when its mode lands: change its state from \"coming\" to \"ready\" and give it the number of people who play (players) and, when it needs one, the setup the match starts with. `testers` says whether the row is shown in the testers' package (features.json testers_package): the campaign and the network row are off for testers until Orb answers decisions 13 and 18. `mirror_pick` says whether two players may pick the same fighter: false until the two can be told apart on screen (a second colour, decision 17). Every label and line is for Orb to read before it is used.",
+  "mirror_pick": false,
+  "modes": [
+    {"id": "solo", "label": "Against the computer", "detail": "You against the computer, at the level you choose.", "state": "ready", "players": 1, "testers": true},
+    {"id": "versus", "label": "Two players, one PC", "detail": "Two people on this PC, each on a controller or half the keyboard.", "state": "ready", "players": 2, "testers": true},
+    {"id": "couch_2v2", "label": "Two against two, one PC", "detail": "Two teams of two on this PC.", "state": "coming", "testers": true},
+    {"id": "horde", "label": "Horde", "detail": "You and a friend against waves of weaker fighters.", "state": "coming", "testers": true},
+    {"id": "practice", "label": "Practice", "detail": "A fighter that stands still, to try moves on.", "state": "coming", "testers": true},
+    {"id": "custom_planet", "label": "Custom planet", "detail": "Pick the planet and shape it before the match.", "state": "coming", "testers": true},
+    {"id": "lan", "label": "Play over a network", "detail": "Host a match or join one on your local network.", "state": "coming", "testers": false},
+    {"id": "campaign", "label": "Campaign", "detail": "A run of fights across the planet.", "state": "coming", "testers": false}
+  ]
+}
