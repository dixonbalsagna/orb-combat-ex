+## The launch marks with no rest (docs/design/launch-anywhere.md; docs/ui/launch-marks-no-rest.md), behind features.json launch_anywhere.
+func _launch_anywhere_rules() -> void:
+	UiPrefs.path = "user://ui_prefs_test_anywhere.json"
+	if FileAccess.file_exists(UiPrefs.path):
+		DirAccess.remove_absolute(ProjectSettings.globalize_path(UiPrefs.path))
+	root.size = Vector2i(1280, 720)
+	var hud: UiHud = load("res://ui/hud/ui_hud.tscn").instantiate()
+	hud.size = Vector2(1280, 720)
+	root.add_child(hud)
+	await process_frame
+	hud.setup(["protagonist", "anti_hero"], ["ONE", "TWO"])
+	hud.hub.patch(0, {"ai": false})
+	hud.hub.patch(1, {"ai": true})
+	var m0: UiFighterModel = hud.hub.model(0)
+	var m1: UiFighterModel = hud.hub.model(1)
+	var open := func(safe: String, power: int, fresh: int, dur: int) -> void:
+		var d := {"type": "cue", "actor": 0, "kind": "launcher_open", "target": 1, "text": safe, "power": power}
+		if fresh >= 0:
+			d["fresh"] = fresh
+		if dur > 0:
+			d["dur"] = dur
+		hud.hub.consume(d)
+	var b_note := func() -> String:
+		m0.stance_kind = 0
+		for r in UiHints.rows(m0, "arena", "hold"):
+			if str(r.get("cell", "")) == "b":
+				return str(r.get("note", ""))
+		return "?"
+	_ok(not UiStance.anywhere() and UiHints.launch_pips(m0) == 0, "launch anywhere: off by default (the marks are as built)")
+	# With it on: the rest marks go whatever the director sends; the lit B carries the marks.
+	UiData.set_feature("launch_anywhere", true)
+	hud.hub.patch(0, {"launcher_ready": false, "launcher_rest_left": 20.0, "launcher_rest_total": 30.0})
+	hud.hub.patch(1, {"launcher_ready": false, "launcher_rest_left": 20.0, "launcher_rest_total": 30.0})
+	hud.advance(1.0 / 60.0)
+	_ok(not UiStance.rest_marks() and UiStance.launch_marks() and b_note.call() == "", "launch anywhere: no RECHARGING chip, ring or legend note even if the director still sends a rest")
