+			UiText.draw(ci, str(p["walk_hint"]), Vector2((p["walk"] as Rect2).position.x, (p["walk"] as Rect2).position.y - 6.0 * k), maxi(fb - 1, int(UiLook.text_floor)), dim, -1)
+	button_draw(ci, p["take"], w("run_boon_take"), true, int(p["btn"]) == 1, fs(20.0, s))
