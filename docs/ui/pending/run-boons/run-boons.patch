+	_ok(seen["taken"] == [1] and not hud.is_run_open(), "boons: right, down, accept takes the second card (%s)" % str(seen["taken"]))
+	hud.show_run_boons(_run_boons_rec(true))
+	hud.run_action("down")
+	hud.run_action("left")
+	hud.run_action("accept")
+	_ok(seen["walked"] == 1 and not hud.is_run_open(), "boons: from Take this, left reaches Walk on and accept walks on")
