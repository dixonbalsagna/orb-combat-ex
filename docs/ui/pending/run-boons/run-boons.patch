+	if str(p["sub"]) != "":
+		UiText.draw(ci, str(p["sub"]), p["sub_pos"], fb, dim, -1)
+	var boons: Array = (p["rec"] as Dictionary).get("boons", [])
+	var f_name: int = fs(20.0 if mode != "full" else 24.0, s)
+	var f_text: int = fs(15.0, s)
+	for c in p["cards"]:
+		var r: Rect2 = c["rect"]
+		var b: Dictionary = boons[int(c["idx"])]
