+## The boons screen (docs/design/run-mode.md section 1.4): one of three, and on a temptation's offer the choice to walk on; and the results' lives line.
+func _run_boons_rec(walk_on: bool, of: int = 1) -> Dictionary:
+	return {"pick": 1, "of": of, "lives": 2, "tier": "UPHEAVAL", "walk_on": walk_on, "boons": [
+		{"kind": "form", "name": "The next form", "gives": "You can reach the next form in every fight from now on."},
+		{"kind": "ability", "name": "Might", "gives": "You hit a little harder for the rest of the run."},
+		{"kind": "temptation", "name": "Something is offered", "gives": "SECRET PRICE AND GAIN", "line": "This will be remembered."}]}
+
+
+func _run_boon_rules() -> void:
+	var sizes: Array = [[Vector2(1920, 1080), 1.0], [Vector2(1280, 720), 1.0], [Vector2(1024, 576), 1.0], [Vector2(2400, 1080), 2.6], [Vector2(2532, 1170), 3.0], [Vector2(844, 390), 1.0], [Vector2(667, 375), 1.0],
+		[Vector2(390, 844), 1.0], [Vector2(360, 640), 1.0], [Vector2(1170, 2532), 3.0]]
+	var bad := PackedStringArray()
+	for cs in sizes:
+		var vp: Vector2 = cs[0]
+		var lay := UiLayout.new()
+		lay.dp = cs[1]
+		lay.compute(vp, false)
+		for walk in [false, true]:
+			var p: Dictionary = UiRun.boons_plan(vp, lay.s, cs[1], false, {"rec": _run_boons_rec(walk), "sel": 0})
+			if not bool(p["fits"]) or (p["cards"] as Array).size() != 3 or (walk != (p["walk"] as Rect2).has_area()):
+				bad.append("%s walk %s %s" % [str(vp), str(walk), str(p["mode"])])
+	_ok(bad.is_empty(), "boons: three cards, the buttons and the Walk on choice fit at ten sizes, every button a 48 dp target; Walk on exists only when it is offered (%d bad %s)" % [bad.size(), str(bad.slice(0, 4))])
+	var p1: Dictionary = UiRun.boons_plan(Vector2(1280, 720), 0.667, 1.0, false, {"rec": _run_boons_rec(true, 2), "sel": 0})
+	_ok(p1["title"] == "Take a boon (1 of 2)" and UiRun.boons_plan(Vector2(1280, 720), 0.667, 1.0, false, {"rec": _run_boons_rec(false), "sel": 0})["title"] == "Take a boon", "boons: two in a row say which one it is")
+	_ok(UiRun._boon_text({"kind": "temptation", "gives": "SECRET", "line": "This will be remembered."}) == "This will be remembered." and UiRun._boon_text({"kind": "form", "gives": "A form."}) == "A form.", "boons: a temptation's card says only that it will be remembered, never what it brings")
+	root.size = Vector2i(1280, 720)
+	var hud: UiHud = load("res://ui/hud/ui_hud.tscn").instantiate()
+	hud.size = Vector2(1280, 720)
+	root.add_child(hud)
+	await process_frame
+	hud.setup(["protagonist", "anti_hero"], ["ONE", "TWO"])
+	UiData.set_feature("run_mode", true)
+	var seen := {"taken": [], "walked": 0}
+	hud.run_boon_chosen.connect(func(i): seen["taken"].append(i))
+	hud.run_boon_walked_on.connect(func(): seen["walked"] += 1)
+	hud.show_run_boons(_run_boons_rec(true))
+	hud.advance(1.0 / 60.0)
+	UiText.tracing = true
+	UiText.trace = []
+	hud._l_run.invalidate()
