+# --- the boons (docs/design/run-mode.md section 1.4): one of three after a won fight, and on a temptation's offer the choice to walk on --------------------------------------------------
+
+static func boon_mark(ci: CanvasItem, c: Vector2, r: float, kind: String) -> void:
+	var ink: Color = _col(UiLook.INK)
+	var lw: float = maxf(2.0, r * 0.3)
+	match kind:
+		"form":   # a chevron pointing up, twice: the next form
+			ci.draw_polyline(PackedVector2Array([c + Vector2(-r, r * 0.1), c + Vector2(0, -r * 0.6), c + Vector2(r, r * 0.1)]), ink, lw)
+			ci.draw_polyline(PackedVector2Array([c + Vector2(-r, r * 0.9), c + Vector2(0, r * 0.2), c + Vector2(r, r * 0.9)]), ink, lw)
+		"ability":   # a plus
+			ci.draw_line(c + Vector2(-r, 0), c + Vector2(r, 0), ink, lw)
+			ci.draw_line(c + Vector2(0, -r), c + Vector2(0, r), ink, lw)
+		"lifeline":   # a ring with a dot
+			ci.draw_arc(c, r, 0.0, TAU, 20, ink, lw)
+			ci.draw_circle(c, r * 0.35, ink)
+		"rest":   # three bars
+			for i in range(3):
+				ci.draw_line(c + Vector2(-r, (float(i) - 1.0) * r * 0.7), c + Vector2(r, (float(i) - 1.0) * r * 0.7), ink, lw)
+		_:   # a temptation: a diamond with its corners left open
+			var pts: Array = [Vector2(0, -r), Vector2(r, 0), Vector2(0, r), Vector2(-r, 0)]
+			for i in range(4):
+				var a: Vector2 = pts[i]
+				var b: Vector2 = pts[(i + 1) % 4]
+				ci.draw_line(c + a.lerp(b, 0.12), c + a.lerp(b, 0.88), ink, lw)
+
+
+static func boon_kind_word(kind: String) -> String:
+	return w("run_bk_" + kind) if ["form", "ability", "lifeline", "rest", "temptation"].has(kind) else ""
+
+
+static func _boon_text(b: Dictionary) -> String:
+	if str(b.get("kind", "")) == "temptation":
+		return str(b.get("line", ""))   # it says it will be remembered, never what it brings
+	return str(b.get("gives", ""))
+
+
+## `st`: {rec, sel, btn (0 the cards, 1 Take this, 2 Walk on)}. Returns {mode, cards, take, walk (empty when walking on is not offered), title, sub, fits, ...}.
+static func boons_plan(vp: Vector2, s: float, dp: float, touch: bool, st: Dictionary) -> Dictionary:
+	var rec: Dictionary = st.get("rec", {})
+	var boons: Array = rec.get("boons", [])
+	var k: float = u(s)
+	var tm: float = maxf(48.0 * dp, 44.0)
+	var mode: String = "rows" if upright(vp) else ("compact" if compact(vp, dp, 620.0) else "full")
+	var m: float = (14.0 if mode == "compact" else 20.0) * k
+	var fb: int = fs(14.0, s)
+	var plan := {"mode": mode, "cards": [], "tm": tm, "fits": true, "fb": fb}
+	var f_title: int = fs(26.0 if mode == "compact" else (30.0 if mode != "rows" else 28.0), s)
+	var pick: int = int(rec.get("pick", 1))
+	var of: int = int(rec.get("of", 1))
+	plan["title"] = UiData.fmt("prompt.run_boon_title_n", {"n": pick, "total": of}) if of > 1 else w("run_boon_title")
+	plan["f_title"] = f_title
+	plan["title_pos"] = Vector2(m, m + UiText.ascent(f_title))
+	var y: float = m + UiText.height(f_title) * 1.1
+	plan["sub"] = UiData.fmt("prompt.run_boon_sub", {"lives": int(rec.get("lives", 0)), "tier": str(rec.get("tier", ""))}) if rec.has("lives") else ""
+	plan["sub_pos"] = Vector2(m, y + UiText.ascent(fb))
+	if plan["sub"] != "":
+		y += UiText.height(fb) * 1.3
+	var btn_h: float = maxf(tm, 48.0 * k)
+	var area_top: float = y + 10.0 * k
+	var area_bot: float = vp.y - btn_h - m - (30.0 if (bool(rec.get("walk_on", false)) and mode != "compact") else 8.0) * k   # room for the words over Walk on (a compact screen puts them in the button)
+	var n: int = boons.size()
+	var f_name: int = fs(20.0 if mode != "full" else 24.0, s)
+	var f_text: int = fs(15.0, s)
+	var need_max: float = 0.0
+	if mode == "rows":
+		var gap: float = 8.0 * k
+		var rh: float = minf((area_bot - area_top - gap * float(maxi(n - 1, 0))) / float(maxi(n, 1)), 150.0 * k)
+		for i in range(n):
+			var rr := Rect2(m, area_top + float(i) * (rh + gap), vp.x - 2.0 * m, rh)
+			plan["cards"].append({"rect": rr, "idx": i})
+			need_max = maxf(need_max, _boon_need(boons[i], mode, rr.size.x, s))
+		var rh_need: float = need_max
+		if rh < rh_need - 0.5:
+			plan["fits"] = false
+	else:
+		var gap2: float = 16.0 * k
+		var cw: float = (vp.x - 2.0 * m - gap2 * float(maxi(n - 1, 0))) / float(maxi(n, 1))
+		var ch: float = minf(area_bot - area_top - 6.0 * k, (230.0 if mode == "compact" else 330.0) * k)
+		var x0: float = (vp.x - (cw * float(n) + gap2 * float(maxi(n - 1, 0)))) * 0.5
+		for i in range(n):
+			var rr2 := Rect2(x0 + float(i) * (cw + gap2), area_top, cw, ch)
+			plan["cards"].append({"rect": rr2, "idx": i})
+			if ch < _boon_need(boons[i], mode, cw, s) - 0.5:
+				plan["fits"] = false
+	var bw: float = (vp.x - 2.0 * m) if mode == "rows" else minf(240.0 * k, vp.x * 0.36)
+	var take := Rect2(vp.x - m - bw, vp.y - m - btn_h, bw, btn_h)
+	var walk := Rect2()
+	if bool(rec.get("walk_on", false)):
+		if mode == "rows":
+			take = Rect2(m, vp.y - m - btn_h, (vp.x - 2.0 * m - 10.0 * k) * 0.5, btn_h)
+			walk = Rect2(take.end.x + 10.0 * k, take.position.y, take.size.x, btn_h)
+		else:
+			walk = Rect2(take.position.x - 12.0 * k - bw, take.position.y, bw, btn_h)
+	plan["take"] = take
+	plan["walk"] = walk
+	plan["walk_label"] = w("run_boon_walk_life") if mode == "compact" else w("run_boon_walk")
+	plan["walk_hint"] = w("run_boon_walk_hint") if (walk.has_area() and mode != "compact") else ""
+	plan["walk_hint_pos"] = Vector2(m, take.position.y - UiText.height(maxi(fb - 1, 14)) * 0.4) if mode != "rows" else Vector2(m, take.position.y - 6.0 * k)
+	var vpr := Rect2(Vector2.ZERO, vp)
+	for c in plan["cards"]:
+		var rr3: Rect2 = c["rect"]
+		if not vpr.encloses(rr3) or rr3.size.y < 60.0 or rr3.intersects(take) or (walk.has_area() and rr3.intersects(walk)):
+			plan["fits"] = false
+	if not vpr.encloses(take) or take.size.y < tm - 0.01:
+		plan["fits"] = false
+	if walk.has_area() and (not vpr.encloses(walk) or walk.size.y < tm - 0.01 or walk.intersects(take)):
+		plan["fits"] = false
+	for bt in [[take, w("run_boon_take")], [walk, str(plan["walk_label"])]]:
+		if (bt[0] as Rect2).has_area() and UiText.width(str(bt[1]), fs(20.0, s)) + 16.0 > (bt[0] as Rect2).size.x:
+			plan["fits"] = false
+	plan["focus"] = clampi(int(st.get("sel", 0)), 0, maxi(n - 1, 0))
+	plan["btn"] = int(st.get("btn", 0))
+	plan["rec"] = rec
+	return plan
+
+
+static func _boon_need(b: Dictionary, mode: String, cw: float, s: float) -> float:
+	var k: float = u(s)
+	var pad: float = (11.0 if mode == "compact" else 14.0) * k
+	var inner: float = cw - 2.0 * pad
+	var f_name: int = fs(20.0 if mode != "full" else 24.0, s)
+	var f_text: int = fs(15.0, s)
+	if mode == "rows":
+		return pad + UiText.height(fs(14.0, s)) * 1.3 + UiText.height(f_name) * 1.2 + _text_h(_boon_text(b), f_text, inner - 36.0 * k) + pad
+	return pad + 26.0 * k + UiText.height(f_name) * 1.3 + _text_h(str(b.get("name", "")), f_name, inner) + _text_h(_boon_text(b), f_text, inner) + pad
+
+
+static func boons_hit(p: Dictionary, pos: Vector2) -> Dictionary:
+	if (p["take"] as Rect2).has_point(pos):
+		return {"kind": "take"}
+	if (p["walk"] as Rect2).has_area() and (p["walk"] as Rect2).has_point(pos):
+		return {"kind": "walk"}
+	for c in p["cards"]:
+		if (c["rect"] as Rect2).has_point(pos):
+			return {"kind": "card", "idx": int(c["idx"])}
+	return {}
+
+
+static func boons_sig(p: Dictionary) -> Array:
+	var c: Rect2 = p["take"]
+	return ["boons", int(p["focus"]), int(p["btn"]), int(c.position.x), int(c.position.y), (p["cards"] as Array).size(), (p["walk"] as Rect2).has_area(), hash(str(p["rec"]))]
+
+
