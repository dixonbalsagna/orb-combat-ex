+	UiText.tracing = false
+	var wds := " ".join(PackedStringArray(UiText.trace))
+	UiText.trace = []
+	_ok(wds.contains("Take a boon") and wds.contains("TEMPTATION") and wds.contains("This will be remembered.") and wds.contains("Walk on") and not wds.contains("SECRET"), "boons: the screen draws its title, the temptation's line and Walk on, and not what the temptation brings")
+	hud.run_action("right")
