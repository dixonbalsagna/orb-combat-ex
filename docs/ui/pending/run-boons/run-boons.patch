+		var pad: float = (11.0 if mode == "compact" else 14.0) * k
+		var inner: float = r.size.x - 2.0 * pad
+		UiIcons.rrect(ci, r, 12.0 * k, Color(0.09, 0.10, 0.15, 1.0), ink if (sel or (int(c["idx"]) == int(p["focus"]))) else Color(0.17, 0.19, 0.24, 1.0), 3.0 if int(c["idx"]) == int(p["focus"]) else 1.4)
+		var kind: String = str(b.get("kind", ""))
+		if mode == "rows":
+			boon_mark(ci, Vector2(r.position.x + pad + 12.0 * k, r.get_center().y), 11.0 * k, kind)
+			var tx: float = r.position.x + pad + 36.0 * k
+			UiText.draw(ci, boon_kind_word(kind), Vector2(tx, r.position.y + pad + UiText.ascent(fb) - 2.0 * k), fb, dim, -1)
+			var ny: float = r.position.y + pad + UiText.height(fb) * 1.3
+			UiText.draw(ci, str(b.get("name", "")), Vector2(tx, ny + UiText.ascent(f_name)), f_name, ink, -1)
+			_draw_lines(ci, tx, ny + UiText.height(f_name) * 1.2, _boon_text(b), f_text, inner - 36.0 * k, dim)
+		else:
+			boon_mark(ci, Vector2(r.position.x + pad + 9.0 * k, r.position.y + pad + 9.0 * k), 9.0 * k, kind)
+			UiText.draw(ci, boon_kind_word(kind), Vector2(r.position.x + pad + 28.0 * k, r.position.y + pad + UiText.ascent(fb) + 1.0 * k), fb, dim, -1)
+			var cy: float = r.position.y + pad + 26.0 * k
+			cy += _draw_lines(ci, r.position.x + pad, cy, str(b.get("name", "")), f_name, inner, ink) + UiText.height(f_name) * 0.3
+			_draw_lines(ci, r.position.x + pad, cy, _boon_text(b), f_text, inner, dim)
+	if (p["walk"] as Rect2).has_area():
