+# --- The Window row (A-PERF-08; Rendering's docs/rendering/pending/window-display) -----------------------------------------------
+
+func _window_row_rules() -> void:
+	var o: Dictionary = UiData.options().get("window_mode", {})
+	_ok(not o.is_empty() and str(o["default"]) == "fullscreen" and (o["choices"] as Array) == ["fullscreen", "windowed"] and str(o["group"]) == "display" and str(o["label"]) == "Window", "window row: the option is 'Window', in the Display group, Full screen by default, or Windowed")
+	var setd: Dictionary = UiData.settings()
+	var in_display := false
+	for sec in setd["sections"]:
+		if str(sec["id"]) == "display" and (sec["items"] as Array).has("window_mode"):
+			in_display = true
+	_ok(in_display and str(setd["labels"]["window_mode"]["fullscreen"]) == "Full screen" and str(setd["labels"]["window_mode"]["windowed"]) == "Windowed", "window row: Settings lists it in Display with the words Full screen and Windowed")
+	UiSettings.web_forced = false
+	var listed := false
+	for r in UiSettings.rows():
+		listed = listed or str(r["key"]) == "window_mode"
+	UiSettings.web_forced = true
+	var listed_web := false
+	for r in UiSettings.rows():
+		listed_web = listed_web or str(r["key"]) == "window_mode"
+	UiSettings.web_forced = false
+	_ok(listed and not listed_web, "window row: listed on a desktop build and not in the browser (it has its own full screen)")
+	UiPrefs.path = "user://ui_prefs_test_window.json"
+	if FileAccess.file_exists(UiPrefs.path):
+		DirAccess.remove_absolute(ProjectSettings.globalize_path(UiPrefs.path))
+	var hud := UiHud.new()
+	hud.size = Vector2(1280, 720)
+	root.add_child(hud)
+	await process_frame
+	hud.setup(["protagonist", "anti_hero"], ["ONE", "TWO"])
+	var seen: Array = []
+	hud.option_changed.connect(func(k, v):
+		if k == "window_mode":
+			seen.append(v))
+	var default_ok: bool = str(hud.opts["window_mode"]) == "fullscreen"
+	hud.show_settings("window_mode")
+	var rec_idx: int = hud.settings_focus()
+	var row: Dictionary = UiSettings.rows()[rec_idx]
+	hud.settings_action("right")
+	var after_one: String = str(hud.opts["window_mode"])
+	hud.settings_action("right")
+	var after_two: String = str(hud.opts["window_mode"])
+	_ok(default_ok and str(row["key"]) == "window_mode" and after_one == "windowed" and after_two == "fullscreen" and seen == ["windowed", "fullscreen"], "window row (hud): the row steps between Full screen and Windowed and tells the host each change through option_changed (%s)" % str(seen))
+	hud.hide_settings()
+	hud.set_option("window_mode", "windowed")
+	hud.set_option("window_mode", "sideways")
+	_ok(str(hud.opts["window_mode"]) == "fullscreen", "window row (hud): a value that is not a choice becomes the default, Full screen (a hand-edited saved file never leaves the window in a mode the host does not know)")
+	hud.queue_free()
