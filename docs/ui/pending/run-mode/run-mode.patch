+
+static func _draw_lines(ci: CanvasItem, x: float, y: float, text: String, f: int, wd: float, col: Color) -> float:
+	var lines: PackedStringArray = UiText.wrap(text, f, wd)
+	var lh: float = UiText.height(f) * 1.2
+	for i in range(lines.size()):
+		UiText.draw(ci, lines[i], Vector2(x, y + UiText.ascent(f) + float(i) * lh), f, col, -1)
+	return float(lines.size()) * lh
+
+
+static func _text_h(text: String, f: int, wd: float) -> float:
+	return float(UiText.wrap(text, f, wd).size()) * UiText.height(f) * 1.2
