 ## The photosensitivity rule for the HUD (docs/ui/hud-spec.md section 57): no block of the HUD may come and go twice inside 60 ticks, whatever the presses do. A mash is played at the HUD
 ## (a refused or empty press every 4 ticks, a wind-up on and off every 6, a stance change every 10, the launch window, banners, the touch flag flipping), at a keyboard-and-pad size and on a
 ## phone, and every layer's presence is sampled each tick; a layer that changes state twice in 60 ticks (after the first 30 ticks) fails.
diff -ruN a/ui/widgets/ui_run.gd b/ui/widgets/ui_run.gd
--- a/ui/widgets/ui_run.gd	1969-12-31 16:00:00.000000000 -0800
+++ b/ui/widgets/ui_run.gd	2026-10-17 03:38:07.059879500 -0700
@@ -0,0 +1,715 @@
+class_name UiRun
+extends RefCounted
+## The run mode's screens (docs/ui/run-mode-screens.md; Game Design's docs/design/run-mode.md; Legal c08): the offers ("Where to next?"), the beats between fights and the last night, and the results.
+## All static draws from a record the host passes (the HUD reads, never writes the sim), behind features.json `run_mode`. Every function here is pure: `*_plan` is geometry (so hud_check proves the fit
+## and the 48 dp targets at every size), `*_hit` says what a point is on, `*_draw` paints from a plan.
+##
+## Legal c08 holds in every line below: a count is a plain line of the same type as its neighbours (no icon, no colour, no emphasis, no counting up, no sound); nothing scores a death; the
+## menace meter and Dread appear nowhere. Words are in terms.json (prompt.run_*), plain, Narrative's to own. A mark is a shape, never a hue; the strip's biome blocks are scenery.
+##
+## Records (every key optional; a missing one draws nothing rather than a wrong thing):
+##   offers  {fight, of, planet: {cities: {standing, damaged, fallen}}, boss: bool, offers: [{kind: rampage|proving|crossing|boss, name, line, opp, harder, tiers: [from, to], holds: {cities, towns}, reward,
+##            strip: {biomes: [[biome, share]], places: [{at, kind: city|town, state: fresh|damaged|fallen}], start}}]}
+##   beat    {approach: bool, place, step, of_steps, states: [state x12], changed: [index], changed_text, lost, present, beat_n, beat_of, lines: [{who, text}]}
+##   results {won: bool, ending, route: [{place, kind, won}], chances: [used, total], ticks, path: {witness, trial}, planet: {states, cities: {standing, damaged, fallen}, towns: {...}, lost, present, sky_dark},
+##            score: [{label, points}], total}
+
+const BIOMES := {"sea": "#3b6a94", "plain": "#7f9a58", "forest": "#4a7a52", "desert": "#b79b62", "mountain": "#7c7a78", "ice": "#aab7c4"}
+const REWARDS := {"rampage": "run_rw_rampage", "proving_cards": "run_rw_proving_cards", "proving_score": "run_rw_proving_score", "crossing": "run_rw_crossing"}
+const SPEAKERS := {"hero": "run_who_hero", "rival": "run_who_rival", "boss": "run_who_boss", "crowd": "run_who_crowd", "radio": "run_who_radio"}
+
+
+static func w(key: String) -> String:
+	return UiData.t("prompt." + key)
+
+
+static func u(s: float) -> float:
+	return maxf(1.5 * s, 1.0)   # one design pixel of this file's layout: 1 at the smallest, the HUD's scale otherwise
+
+
+static func fs(x: float, s: float) -> int:
+	return maxi(int(round(x * u(s))), int(UiLook.text_floor))
+
+
+static func compact(vp: Vector2, dp: float = 1.0, limit: float = 500.0) -> bool:
+	return vp.y / maxf(dp, 1.0) < limit and vp.x >= vp.y   # a phone on its side (a dense screen's size is in CSS pixels)
+
+
+static func upright(vp: Vector2) -> bool:
+	return vp.y > vp.x * 1.05
+
+
+# --- shared drawing --------------------------------------------------------------------------------------------------------------------------
+
+static func _col(id: String) -> Color:
+	return Color(UiLook.col(id))
+
+
+## A mark for a place on the strip: a city is tall and a town short; untouched is solid, damaged half-filled with a crack, fallen hollow with a slash. Shape carries it, never a hue.
+static func place_mark(ci: CanvasItem, bx: float, base: float, kind: String, state: String, k: float) -> void:
+	var big: bool = kind == "city"
+	var pw: float = (15.0 if big else 9.0) * k
+	var ph: float = (26.0 if big else 13.0) * k
+	var ink: Color = _col(UiLook.INK)
+	var dark: Color = _col(UiLook.INK_DARK)
+	var gx: float = bx - pw * 0.5
+	var gy: float = base - ph
+	match state:
+		"damaged":
+			ci.draw_rect(Rect2(gx, gy, pw, ph), dark)
+			ci.draw_rect(Rect2(gx, gy, pw, ph), ink, false, maxf(1.6, 1.8 * k))
+			ci.draw_rect(Rect2(gx, gy + ph * 0.5, pw, ph * 0.5), ink)
+			ci.draw_line(Vector2(gx, gy + ph * 0.28), Vector2(gx + pw, gy + ph * 0.5), dark, maxf(1.4, 1.6 * k))
+		"fallen":
+			ci.draw_rect(Rect2(gx, gy + ph * 0.55, pw, ph * 0.45), dark)
+			ci.draw_rect(Rect2(gx, gy + ph * 0.55, pw, ph * 0.45), ink, false, maxf(1.6, 1.8 * k))
+			ci.draw_line(Vector2(gx - 1.0, gy + ph * 0.45), Vector2(gx + pw + 1.0, base + 1.0), ink, maxf(1.6, 1.8 * k))
+		_:
+			ci.draw_rect(Rect2(gx, gy, pw, ph), ink)
+			ci.draw_rect(Rect2(gx, gy, pw, ph), dark, false, maxf(1.2, 1.4 * k))
+
+
+## World's strip: the arena as a bar of biome blocks with the places on it and a small triangle where the fight starts.
+static func strip_draw(ci: CanvasItem, r: Rect2, spec: Dictionary, k: float) -> void:
+	var cx: float = r.position.x
+	for b in spec.get("biomes", []):
+		var bw: float = r.size.x * float(b[1])
+		ci.draw_rect(Rect2(cx, r.position.y, bw, r.size.y), Color(BIOMES.get(str(b[0]), "#7f9a58")))
+		cx += bw
+	UiIcons.rrect(ci, r, 3.0 * k, Color(0, 0, 0, 0), _col(UiLook.EDGE), maxf(1.2, 1.2 * k))
+	for p in spec.get("places", []):
+		place_mark(ci, r.position.x + r.size.x * float(p["at"]), r.end.y - 3.0 * k, str(p.get("kind", "town")), str(p.get("state", "fresh")), k)
+	if spec.has("start"):
+		var sx: float = r.position.x + r.size.x * float(spec["start"])
+		ci.draw_colored_polygon(PackedVector2Array([Vector2(sx, r.position.y + 1.0), Vector2(sx - 6.0 * k, r.position.y - 10.0 * k), Vector2(sx + 6.0 * k, r.position.y - 10.0 * k)]), _col(UiLook.INK))
+
+
+## The planet's places as one row of marks (up to twelve), the ones a fight changed ringed with a dashed ring.
+static func planet_row(ci: CanvasItem, r: Rect2, states: Array, changed: Array, k: float) -> void:
+	UiIcons.rrect(ci, r, 8.0 * k, Color(0.06, 0.08, 0.13, 1.0), Color(UiLook.col(UiLook.EDGE), 0.3), 1.0)
+	var n: int = maxi(states.size(), 1)
+	for i in range(states.size()):
+		var gx: float = r.position.x + 12.0 * k + (r.size.x - 24.0 * k) * (float(i) + 0.5) / float(n)
+		var base: float = r.end.y - 8.0 * k
+		place_mark(ci, gx, base, "city", str(states[i]), k * 0.9)
+		if changed.has(i):
+			for seg in range(8):
+				var a0: float = float(seg) * TAU / 8.0
+				ci.draw_arc(Vector2(gx, base - 11.0 * k), 16.0 * k, a0, a0 + TAU / 14.0, 6, _col(UiLook.INK), maxf(1.6, 2.0 * k), true)   # a dashed ring: this fight changed it
+
+
+static func button_draw(ci: CanvasItem, r: Rect2, label: String, primary: bool, focus: bool, f: int) -> void:
+	var ink: Color = _col(UiLook.INK)
+	UiIcons.rrect(ci, r, r.size.y * 0.3, Color(ink, 0.95) if primary else Color(UiLook.col(UiLook.SCRIM), 0.9), _col(UiLook.EDGE), 2.0)
+	UiText.draw(ci, label, Vector2(r.get_center().x, r.get_center().y - UiText.height(f) * 0.5 + UiText.ascent(f)), f, _col(UiLook.INK_DARK) if primary else ink, 0)
+	if focus:
+		UiIcons.rrect(ci, r.grow(3.0), r.size.y * 0.34, Color(0, 0, 0, 0), Color(1.0, 0.85, 0.35), 3.0)
+
+
+static func kind_mark(ci: CanvasItem, c: Vector2, r: float, kind: String) -> void:
+	var ink: Color = _col(UiLook.INK)
+	match kind:
+		"rampage":
+			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0, -r), c + Vector2(r, r * 0.8), c + Vector2(-r, r * 0.8)]), ink)
+		"proving":
+			ci.draw_colored_polygon(PackedVector2Array([c + Vector2(0, -r), c + Vector2(r, 0), c + Vector2(0, r), c + Vector2(-r, 0)]), ink)
+		_:
+			var lw: float = maxf(2.0, r * 0.3)
+			ci.draw_polyline(PackedVector2Array([c + Vector2(-r, -r * 0.35), c + Vector2(r, -r * 0.35)]), ink, lw)
+			ci.draw_polyline(PackedVector2Array([c + Vector2(r * 0.5, -r * 0.9), c + Vector2(r, -r * 0.35), c + Vector2(r * 0.5, r * 0.2)]), ink, lw)
+			ci.draw_polyline(PackedVector2Array([c + Vector2(r, r * 0.45), c + Vector2(-r, r * 0.45)]), ink, lw)
+			ci.draw_polyline(PackedVector2Array([c + Vector2(-r * 0.5, 0), c + Vector2(-r, r * 0.45), c + Vector2(-r * 0.5, r * 0.95)]), ink, lw)
+
+
+static func kind_word(kind: String) -> String:
+	match kind:
+		"rampage":
+			return w("run_rampage")
+		"proving":
+			return w("run_proving")
+		"crossing":
+			return w("run_crossing")
+		"boss":
+			return w("run_boss_kind")
