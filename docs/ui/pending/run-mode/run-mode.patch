+# --- the run mode's screens (docs/ui/run-mode-screens.md): a record from the host, drawn by UiRun; the HUD never writes the sim ------------------------------------------
+
+func _run_open_screen(kind: String, rec: Dictionary, extra: Dictionary = {}) -> void:
+	if not UiData.feature("run_mode"):
+		return
+	var was_open: bool = not _run.is_empty()
+	_run = {"kind": kind, "rec": rec, "sel": 0, "btn": false, "page": 1, "parts": false, "focus": 0}
+	_run.merge(extra, true)
+	if not was_open:
+		howto_opened.emit(false)   # the host holds the match, as for every card
+	if _pm_open:
+		_pm_close("run")
+
+
+func show_run_offers(rec: Dictionary) -> void:
+	_run_open_screen("offers", rec)
+
+
+func show_run_beat(rec: Dictionary) -> void:
+	_run_open_screen("beat", rec)
+
+
+func show_run_results(rec: Dictionary) -> void:
+	_run_open_screen("results", rec)
+
+
+func hide_run() -> void:
+	if _run.is_empty():
+		return
+	_run = {}
+	howto_closed.emit(false)
+
+
+func is_run_open() -> bool:
+	return not _run.is_empty()
+
+
+func run_plan() -> Dictionary:
+	if _run.is_empty():
+		return {}
+	var dp: float = layout.dp if "dp" in layout else 1.0
+	var st: Dictionary = _run
+	match str(_run["kind"]):
+		"offers":
+			return UiRun.offers_plan(layout.vp, layout.s, dp, bool(opts["touch_ui"]), st)
+		"beat":
+			return UiRun.beat_plan(layout.vp, layout.s, dp, bool(opts["touch_ui"]), st)
+		"results":
+			return UiRun.results_plan(layout.vp, layout.s, dp, bool(opts["touch_ui"]), st)
+	return {}
+
+
+## A key, pad or tap, as an action: "left", "right", "up", "down", "accept", "skip" (any button on a beat), "page" (not used by the host). Returns true when the screen took it.
+func run_action(act: String) -> bool:
+	if _run.is_empty():
+		return false
+	var kind: String = str(_run["kind"])
+	if kind == "offers":
+		var n: int = ((_run["rec"] as Dictionary).get("offers", []) as Array).size()
+		match act:
+			"left", "up":
+				if bool(_run["btn"]):
+					_run["btn"] = false
+				else:
+					_run["sel"] = maxi(int(_run["sel"]) - 1, 0)
+			"right":
+				if not bool(_run["btn"]):
+					_run["sel"] = mini(int(_run["sel"]) + 1, maxi(n - 1, 0))
+			"down":
+				if not bool(_run["btn"]):
+					if UiRun.upright(layout.vp) and int(_run["sel"]) < n - 1:
+						_run["sel"] = int(_run["sel"]) + 1
+					else:
+						_run["btn"] = true
+			"accept":
+				if bool(_run["btn"]) or n <= 1:
+					_run_confirm()
+				else:
+					_run["btn"] = true
+		return true
+	if kind == "beat":
+		if act == "accept":
+			run_beat_next.emit()
+		else:
+			hide_run()
+			run_beat_skipped.emit()
+		return true
+	if kind == "results":
+		var plan: Dictionary = run_plan()
+		var btns: Array = plan.get("buttons", [])
+		match act:
+			"left", "up":
+				_run["focus"] = maxi(int(_run["focus"]) - 1, 0)
+			"right", "down":
+				_run["focus"] = mini(int(_run["focus"]) + 1, maxi(btns.size() - 1, 0))
+			"accept":
+				if not btns.is_empty():
+					_run_results_press(str(btns[clampi(int(_run["focus"]), 0, btns.size() - 1)]["id"]))
+		return true
+	return false
+
+
+func _run_results_press(id: String) -> void:
+	if id == "next":
+		_run["page"] = 2
+		_run["focus"] = 0
+		return
+	hide_run()
+	run_results_action.emit(id)
+
+
+func _run_input(event: InputEvent) -> void:
+	var act := ""
+	if event is InputEventKey and event.pressed and not event.echo:
+		match event.keycode:
+			KEY_LEFT, KEY_A:
+				act = "left"
+			KEY_RIGHT, KEY_D:
+				act = "right"
+			KEY_UP, KEY_W:
+				act = "up"
+			KEY_DOWN, KEY_S:
+				act = "down"
+			KEY_ENTER, KEY_KP_ENTER, KEY_SPACE:
+				act = "accept"
+			_:
+				act = "skip" if event.keycode != KEY_ESCAPE else ""
+	elif event is InputEventJoypadButton and event.pressed:
+		match event.button_index:
+			JOY_BUTTON_DPAD_LEFT:
+				act = "left"
+			JOY_BUTTON_DPAD_RIGHT:
+				act = "right"
+			JOY_BUTTON_DPAD_UP:
+				act = "up"
+			JOY_BUTTON_DPAD_DOWN:
+				act = "down"
+			JOY_BUTTON_A:
+				act = "accept"
+			_:
+				act = "skip"
+	elif event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
+		_run_tap(event.position)
+		get_viewport().set_input_as_handled()
+		return
+	if act != "":
+		run_action(act)
+	get_viewport().set_input_as_handled()
+
+
+func _run_tap(pos: Vector2) -> void:
+	var plan: Dictionary = run_plan()
+	match str(_run["kind"]):
+		"offers":
+			var h: Dictionary = UiRun.offers_hit(plan, pos)
+			if str(h.get("kind", "")) == "card":
+				if int(_run["sel"]) == int(h["idx"]) and not bool(_run["btn"]):
+					_run["btn"] = true   # a second tap on the chosen card confirms
+				else:
+					_run["sel"] = int(h["idx"])
+					_run["btn"] = false
+			elif str(h.get("kind", "")) == "button":
+				_run_confirm()
+		"beat":
+			var hb: Dictionary = UiRun.beat_hit(plan, pos)
+			run_action("accept" if str(hb.get("kind", "")) == "next" else "skip")
+		"results":
+			var hr: Dictionary = UiRun.results_hit(plan, pos)
+			if str(hr.get("kind", "")) == "button":
+				_run_results_press(str(hr["id"]))
+			elif str(hr.get("kind", "")) == "score":
+				_run["parts"] = not bool(_run["parts"])
+
+
+func _run_confirm() -> void:
+	var chosen: int = int(_run["sel"])
+	hide_run()
+	run_offer_chosen.emit(chosen)
+
+
+func _paint_run(ci: CanvasItem) -> void:
+	if _run.is_empty():
+		return
+	var plan: Dictionary = run_plan()
+	match str(_run["kind"]):
+		"offers":
+			UiRun.offers_draw(ci, plan, layout.s)
+		"beat":
+			UiRun.beat_draw(ci, plan, layout.s)
+		"results":
+			UiRun.results_draw(ci, plan, layout.s)
+
+
 func _paint_tug(ci: CanvasItem) -> void:
 	UiTug.draw(ci, hub, _tug_plan, _o())
 
