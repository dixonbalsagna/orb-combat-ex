+
+# --- the offers ------------------------------------------------------------------------------------------------------------------------------
+
+static func _offer_opp(o: Dictionary, short: bool) -> String:
+	var who: String = str(o.get("opp", ""))
+	if who == "":
+		return ""
+	if bool(o.get("harder", false)):
+		who += (", " + w("run_harder_short")) if short else (", " + w("run_harder"))
+	return who if short else UiData.fmt("prompt.run_opp", {"who": who})   # a compact card drops the word Opponent: the name says it
+
+
+static func _offer_reward(o: Dictionary) -> String:
+	return w(str(REWARDS.get(str(o.get("reward", "")), ""))) if REWARDS.has(str(o.get("reward", ""))) else str(o.get("reward", ""))
+
+
+## The geometry of the offers screen for a viewport. `st`: {rec, sel (the selected card), btn (the button has focus)}. Returns {mode, cards: [{rect, idx, ...parts}], button, title_pos, sub_pos, fight_pos,
+## legend_pos, note_pos, fits, tm}. Modes: "full" (three cards side by side), "compact" (a phone on its side: the one line, what it holds and how hard it is wait), "rows" (a phone upright).
+static func offers_plan(vp: Vector2, s: float, dp: float, touch: bool, st: Dictionary) -> Dictionary:
+	var rec: Dictionary = st.get("rec", {})
+	var offers: Array = rec.get("offers", [])
+	var k: float = u(s)
+	var tm: float = maxf(48.0 * dp, 44.0)
+	var mode: String = "rows" if upright(vp) else ("compact" if compact(vp, dp, 620.0) else "full")   # the offers need more height than the other screens: under 620 CSS px they are compact
+	var m: float = (14.0 if mode == "compact" else 20.0) * k
+	var boss: bool = bool(rec.get("boss", false)) or (offers.size() == 1 and str(offers[0].get("kind", "")) == "boss")
+	var fb: int = fs(14.0, s)
+	var plan := {"mode": mode, "cards": [], "tm": tm, "fits": true, "boss": boss}
+	var title: String = w("run_last") if boss else w("run_where")
+	var f_title: int = fs(26.0 if mode == "compact" else (30.0 if mode != "rows" else 28.0), s)
+	plan["title"] = title
+	plan["f_title"] = f_title
+	plan["title_pos"] = Vector2(m, m + UiText.ascent(f_title))
+	var y: float = m + UiText.height(f_title) * 1.1
+	var planet: Dictionary = (rec.get("planet", {}) as Dictionary).get("cities", {})
+	plan["sub"] = UiData.fmt("prompt.run_planet", {"a": int(planet.get("standing", 0)), "b": int(planet.get("standing", 0)) + int(planet.get("damaged", 0)) + int(planet.get("fallen", 0)), "c": int(planet.get("damaged", 0)), "d": int(planet.get("fallen", 0))}) if not planet.is_empty() else ""
+	plan["sub_pos"] = Vector2(m, y + UiText.ascent(fb))
+	if plan["sub"] != "":
+		y += UiText.height(fb) * 1.3
+	plan["fight"] = UiData.fmt("prompt.run_fight", {"n": int(rec.get("fight", 1)), "total": int(rec.get("of", 4))}) if rec.has("fight") else ""
+	plan["fight_pos"] = Vector2(vp.x - m, m + UiText.ascent(fb))
+	plan["fb"] = fb
+	var btn_h: float = maxf(tm, 48.0 * k)
+	var foot: float = btn_h + m
+	var n: int = offers.size()
+	var area_top: float = y + 10.0 * k
+	var area_bot: float = vp.y - foot - 8.0 * k
+	if mode == "rows":
+		var gap: float = 8.0 * k
+		var rh: float = minf((area_bot - area_top - 26.0 * k - gap * float(maxi(n - 1, 0))) / float(maxi(n, 1)), 175.0 * k)
+		for i in range(n):
+			plan["cards"].append({"rect": Rect2(m, area_top + float(i) * (rh + gap), vp.x - 2.0 * m, rh), "idx": i})
+		plan["legend_pos"] = Vector2(m, area_top + float(n) * (rh + gap) + 14.0 * k)
+	else:
+		var gap2: float = 16.0 * k
+		var ncol: int = maxi(n, 1)
+		var cw: float = (vp.x - 2.0 * m - gap2 * float(ncol - 1)) / float(ncol)
+		if boss:
+			cw = minf(cw, 460.0 * k)
+		var ch: float = minf(area_bot - area_top - 6.0 * k, (270.0 if mode == "compact" else 430.0) * k)
+		var total_w: float = cw * float(ncol) + gap2 * float(ncol - 1)
+		var x0: float = (vp.x - total_w) * 0.5
+		for i in range(n):
+			plan["cards"].append({"rect": Rect2(x0 + float(i) * (cw + gap2), area_top, cw, ch), "idx": i})
+		plan["legend_pos"] = Vector2(m, vp.y - m - 8.0 * k)
+	var bw: float = (vp.x - 2.0 * m) if mode == "rows" else minf(260.0 * k, vp.x * 0.4)
+	plan["button"] = Rect2(vp.x - m - bw, vp.y - m - btn_h, bw, btn_h)
+	plan["note_pos"] = Vector2(m + (270.0 if mode == "compact" else 300.0) * k, vp.y - m - 6.0 * k)
+	# the fit: every card and the button inside the screen, none overlapping, the button a 48 dp target, and each card's own content inside its rect
+	var fits: bool = Rect2(Vector2.ZERO, vp).encloses(plan["button"]) and (plan["button"] as Rect2).size.y >= tm - 0.01
+	for c in plan["cards"]:
+		var rr: Rect2 = c["rect"]
+		if not Rect2(Vector2.ZERO, vp).encloses(rr) or rr.size.y < 60.0 or rr.intersects(plan["button"]):
+			fits = false
+		if rr.size.y < _card_need(offers[int(c["idx"])], mode, rr.size.x, s) - 0.5:
+			fits = false
+	plan["fits"] = fits
+	plan["focus"] = clampi(int(st.get("sel", 0)), 0, maxi(n - 1, 0))
+	plan["btn"] = bool(st.get("btn", false))
+	plan["rec"] = rec
+	return plan
+
+
+## The height a card's content needs at a width (so the plan can say it fits).
+static func _card_need(o: Dictionary, mode: String, cw: float, s: float) -> float:
+	var k: float = u(s)
+	var pad: float = (11.0 if mode == "compact" else 14.0) * k
+	var inner: float = cw - 2.0 * pad
+	var f: int = fs(14.0, s)
+	if mode == "rows":
+		return pad + 86.0 * k + UiText.height(f) * 1.3 + pad * 0.5
+	var hh: float = pad + (24.0 if mode == "compact" else 32.0) * k + (24.0 if mode == "compact" else 40.0) * k + (48.0 if mode == "compact" else 106.0) * k
+	hh += _text_h(_offer_opp(o, mode == "compact"), f, inner) + 6.0 * k
+	if mode == "full":
+		hh += UiText.height(f) * 1.5 + 24.0 * k + 8.0 * k + 18.0 * k
+		hh += _text_h(_offer_reward(o), fs(15.0, s), inner) + 12.0 * k + _text_h(str(o.get("line", "")), f, inner)
+	else:
+		hh += 4.0 * k + _text_h(_offer_reward(o), fs(15.0, s), inner) + 8.0 * k
+	return hh + pad * 0.5
+
+
+static func offers_hit(p: Dictionary, pos: Vector2) -> Dictionary:
+	if (p["button"] as Rect2).has_point(pos):
+		return {"kind": "button", "idx": -1}
+	for c in p["cards"]:
+		if (c["rect"] as Rect2).has_point(pos):
+			return {"kind": "card", "idx": int(c["idx"])}
+	return {}
+
+
+static func offers_sig(p: Dictionary) -> Array:
+	var c: Rect2 = p["button"]
+	return ["offers", int(p["focus"]), p["btn"], int(c.position.x), int(c.position.y), int(c.size.x), (p["cards"] as Array).size(), hash(str(p["rec"]))]
+
+
+static func offers_draw(ci: CanvasItem, p: Dictionary, s: float) -> void:
+	var vp: Vector2 = ci.size if ci is Control else Vector2(1280, 720)
+	var k: float = u(s)
+	var ink: Color = _col(UiLook.INK)
+	var dim: Color = _col(UiLook.INK_DIM)
+	var mode: String = str(p["mode"])
+	var fb: int = int(p["fb"])
+	UiText.no_outline = true
+	ci.draw_rect(Rect2(Vector2.ZERO, vp), Color(0.04, 0.05, 0.08, 1.0))
+	UiText.draw(ci, str(p["title"]), p["title_pos"], int(p["f_title"]), ink, -1)
+	if str(p["sub"]) != "":
+		UiText.draw(ci, str(p["sub"]), p["sub_pos"], fb, dim, -1)
+	if str(p["fight"]) != "":
+		UiText.draw(ci, str(p["fight"]), p["fight_pos"], fb, dim, 1)
+	var offers: Array = (p["rec"] as Dictionary).get("offers", [])
+	for c in p["cards"]:
+		_card_draw(ci, c["rect"], offers[int(c["idx"])], int(c["idx"]) == int(p["focus"]) and not bool(p["btn"]), mode, s)
+	if mode != "rows" or true:
+		_legend_draw(ci, p["legend_pos"], fb, k)
+	if mode != "rows":
+		UiText.draw(ci, w("run_strip_note_short" if mode == "compact" else "run_strip_note"), p["note_pos"], maxi(fb - 2, int(UiLook.text_floor)), dim, -1)
+	button_draw(ci, p["button"], w("run_go"), true, bool(p["btn"]), fs(20.0, s))
+	UiText.no_outline = false
+
+
+static func _legend_draw(ci: CanvasItem, pos: Vector2, f: int, k: float) -> void:
+	var x: float = pos.x
+	for it in [["fresh", "run_fresh"], ["damaged", "run_damaged"], ["fallen", "run_fallen"]]:
+		place_mark(ci, x + 5.0 * k, pos.y, "city", str(it[0]), k * 0.6)
+		var wd: float = UiText.draw(ci, w(str(it[1])), Vector2(x + 14.0 * k, pos.y - UiText.height(f) * 0.5 + UiText.ascent(f) - 2.0 * k), f, _col(UiLook.INK_DIM), -1)
+		x += 14.0 * k + wd + 16.0 * k
+
+
+static func _card_draw(ci: CanvasItem, r: Rect2, o: Dictionary, selected: bool, mode: String, s: float) -> void:
+	var k: float = u(s)
+	var ink: Color = _col(UiLook.INK)
+	var dim: Color = _col(UiLook.INK_DIM)
+	var pad: float = (11.0 if mode == "compact" else 14.0) * k
+	var inner: float = r.size.x - 2.0 * pad
+	var f: int = fs(14.0, s)
+	UiIcons.rrect(ci, r, 12.0 * k, Color(0.09, 0.10, 0.15, 1.0), ink if selected else Color(0.17, 0.19, 0.24, 1.0), 3.0 if selected else 1.4)
+	var kind: String = str(o.get("kind", ""))
+	var spec: Dictionary = o.get("strip", {})
+	if mode == "rows":
+		kind_mark(ci, Vector2(r.position.x + pad + 8.0 * k, r.position.y + pad + 9.0 * k), 8.0 * k, kind)
+		UiText.draw(ci, kind_word(kind), Vector2(r.position.x + pad + 26.0 * k, r.position.y + pad + UiText.ascent(f) - 2.0 * k), f, dim, -1)
+		UiText.draw(ci, str(o.get("name", "")), Vector2(r.position.x + pad + 26.0 * k, r.position.y + pad + 20.0 * k + UiText.ascent(fs(19.0, s))), fs(19.0, s), ink, -1)
+		strip_draw(ci, Rect2(r.position.x + pad, r.position.y + pad + 50.0 * k, inner, 24.0 * k), spec, k)
+		var ry: float = r.position.y + pad + 86.0 * k
+		UiText.draw(ci, _offer_reward(o), Vector2(r.position.x + pad, ry + UiText.ascent(f)), f, ink, -1)
+		var h: Dictionary = o.get("holds", {})
+		if not h.is_empty():
+			UiText.draw(ci, UiData.fmt("prompt.run_holds_short", {"cities": int(h.get("cities", 0)), "towns": int(h.get("towns", 0))}), Vector2(r.end.x - pad, ry + UiText.ascent(f)), f, dim, 1)
+		return
+	var cy: float = r.position.y + pad
+	kind_mark(ci, Vector2(r.position.x + pad + 8.0 * k, cy + 9.0 * k), 8.0 * k, kind)
+	UiText.draw(ci, kind_word(kind), Vector2(r.position.x + pad + 26.0 * k, cy + UiText.ascent(f) + 1.0 * k), f, dim, -1)
+	cy += (24.0 if mode == "compact" else 32.0) * k
+	var fn: int = fs(20.0 if mode == "compact" else 26.0, s)
+	UiText.draw(ci, str(o.get("name", "")), Vector2(r.position.x + pad, cy + UiText.ascent(fn)), fn, ink, -1)
+	cy += (24.0 if mode == "compact" else 40.0) * k
+	strip_draw(ci, Rect2(r.position.x + pad, cy + 12.0 * k, inner, (30.0 if mode == "compact" else 70.0) * k), spec, k)
+	cy += (48.0 if mode == "compact" else 106.0) * k
+	if mode == "full":
+		var hd: Dictionary = o.get("holds", {})
+		if not hd.is_empty():
+			UiText.draw(ci, UiData.fmt("prompt.run_holds", {"cities": int(hd.get("cities", 0)), "towns": int(hd.get("towns", 0))}), Vector2(r.position.x + pad, cy + UiText.ascent(f)), f, dim, -1)
+			cy += UiText.height(f) * 1.5
+	cy += _draw_lines(ci, r.position.x + pad, cy, _offer_opp(o, mode == "compact"), f, inner, ink) + 6.0 * k
+	if mode == "full":
+		var tiers: Array = o.get("tiers", [])
+		if tiers.size() == 2:
+			UiText.draw(ci, UiData.fmt("prompt.run_starts", {"a": str(tiers[0]), "b": str(tiers[1])}), Vector2(r.position.x + pad, cy + UiText.ascent(f)), f, dim, -1)
+		cy += 24.0 * k
+		ci.draw_rect(Rect2(r.position.x + pad, cy - 8.0 * k, inner, 1.0), Color(0.17, 0.19, 0.24, 1.0))
+		cy += 4.0 * k
+		UiText.draw(ci, w("run_reward"), Vector2(r.position.x + pad, cy + UiText.ascent(maxi(f - 2, 14))), maxi(f - 2, int(UiLook.text_floor)), dim, -1)
+		cy += 18.0 * k
+		cy += _draw_lines(ci, r.position.x + pad, cy, _offer_reward(o), fs(15.0, s), inner, ink) + 12.0 * k
+		_draw_lines(ci, r.position.x + pad, cy, str(o.get("line", "")), f, inner, dim)
+	else:
+		cy += 4.0 * k
+		_draw_lines(ci, r.position.x + pad, cy, _offer_reward(o), fs(15.0, s), inner, ink)   # a compact card says the reward without its label: the line reads as one
+
+
+# --- the beats -------------------------------------------------------------------------------------------------------------------------------
+
+static func _speaker(l: Dictionary) -> String:
+	var who: String = str(l.get("who", ""))
+	if SPEAKERS.has(who):
+		return w(str(SPEAKERS[who]))
+	return who.to_upper()
+
+
+## `st`: {rec}. Returns {panel, next, skip (the whole screen but the button), lines: [{who, text, y}], planet (the places row rect), top..., fits}.
+static func beat_plan(vp: Vector2, s: float, dp: float, touch: bool, st: Dictionary) -> Dictionary:
+	var rec: Dictionary = st.get("rec", {})
+	var approach: bool = bool(rec.get("approach", false))
+	var k: float = u(s)
+	var small: bool = compact(vp, dp)
+	var m: float = (14.0 if small else 24.0) * k
+	var tm: float = maxf(48.0 * dp, 44.0)
+	var pw: float = minf(vp.x - 2.0 * m, 820.0 * k) if not upright(vp) else vp.x - 2.0 * m
+	var px: float = (vp.x - pw) * 0.5
+	var f: int = fs(14.0, s)
+	var fl: int = fs(16.0 if (small or vp.x < 460.0) else 20.0, s)
+	var plan := {"approach": approach, "fits": true, "tm": tm, "f": f, "fl": fl, "px": px, "pw": pw}
+	var y: float = m
+	plan["head_l"] = w("run_last_night") if approach else w("run_after")
+	plan["head_r"] = UiData.fmt("prompt.run_step", {"n": int(rec.get("step", 1)), "total": int(rec.get("of_steps", 8))}) if approach else str(rec.get("place", ""))
+	plan["head_y"] = y + UiText.ascent(f)
+	y += UiText.height(f) * 1.6
+	if approach:
+		plan["pips_y"] = y + 6.0 * k
+		y += 26.0 * k
+		plan["planet"] = Rect2()
+	else:
+		var rh: float = (26.0 if small else 70.0) * k
+		plan["planet"] = Rect2(px, y, pw, rh)
+		y += rh + 6.0 * k
+		plan["changed"] = UiText.wrap(UiData.fmt("prompt.run_changed", {"text": str(rec.get("changed_text", ""))}), f, pw) if (str(rec.get("changed_text", "")) != "" and not small) else PackedStringArray()   # a phone on its side keeps the ringed places and the count, and drops this line
+		plan["changed_y"] = y
+		y += float((plan["changed"] as PackedStringArray).size()) * UiText.height(f) * 1.25 + 4.0 * k
+		if rec.has("lost"):
+			plan["lost"] = UiData.fmt("prompt.run_lost_fight", {"n": _num(int(rec.get("lost", 0))), "total": _num(int(rec.get("present", 0)))})
+			plan["lost_y"] = y
+			y += UiText.height(f) * 1.3 + (3.0 if small else 14.0) * k
+	var btn_h: float = maxf(tm, 46.0 * k)
+	var by: float = vp.y - m - btn_h
+	var ph: float = by - 16.0 * k - y
+	if not small and not upright(vp):
+		ph = minf(ph, 310.0 * k)
+		by = minf(by, y + ph + 16.0 * k)
+	plan["panel"] = Rect2(px, y, pw, ph)
+	var ip: float = (10.0 if small else 18.0) * k
+	var ly: float = y + ip + (3.0 if small else 12.0) * k
+	var lines: Array = []
+	for l in rec.get("lines", []):
+		var tw: PackedStringArray = UiText.wrap(str(l.get("text", "")), fl, pw - 2.0 * ip)
+		var need: float = UiText.height(int(fl * 0.82)) * 1.1 + float(tw.size()) * UiText.height(fl) * 1.15 + 8.0 * k
+		if ly + need > y + ph - ip * 0.5 and not lines.is_empty():
+			plan["fits"] = false
+			break
+		lines.append({"who": _speaker(l), "lines": tw, "y": ly})
+		ly += need
+	plan["lines"] = lines
+	plan["ip"] = ip
+	plan["next"] = Rect2(px + pw - 150.0 * k, by, 150.0 * k, btn_h)
+	plan["skip_pos"] = Vector2(px, by + btn_h * 0.5)
+	plan["foot"] = (w("run_skip_touch") if touch else w("run_skip"))
+	plan["beat_of"] = UiData.fmt("prompt.run_beat_of", {"n": int(rec.get("beat_n", 1)), "total": int(rec.get("beat_of", 2))}) if rec.has("beat_of") else ""
+	plan["skip"] = Rect2(Vector2.ZERO, vp)
+	plan["rec"] = rec
+	if ph < 60.0 * k or lines.is_empty() and not (rec.get("lines", []) as Array).is_empty():
+		plan["fits"] = false
+	if not Rect2(Vector2.ZERO, vp).encloses(plan["next"]) or (plan["next"] as Rect2).size.y < tm - 0.01:
+		plan["fits"] = false
+	return plan
+
+
+static func _num(n: int) -> String:
+	var t: String = str(n)
+	var out: String = ""
+	while t.length() > 3:
+		out = "," + t.substr(t.length() - 3) + out
+		t = t.substr(0, t.length() - 3)
+	return t + out
+
+
+## What a point is on: the Next button, else the screen (a tap to skip).
+static func beat_hit(p: Dictionary, pos: Vector2) -> Dictionary:
+	if (p["next"] as Rect2).has_point(pos):
+		return {"kind": "next"}
+	return {"kind": "skip"}
+
+
+static func beat_sig(p: Dictionary) -> Array:
+	return ["beat", int((p["panel"] as Rect2).size.y), (p["lines"] as Array).size(), hash(str(p["rec"]))]
+
+
+static func beat_draw(ci: CanvasItem, p: Dictionary, s: float) -> void:
+	var vp: Vector2 = ci.size if ci is Control else Vector2(1280, 720)
+	var k: float = u(s)
+	var ink: Color = _col(UiLook.INK)
+	var dim: Color = _col(UiLook.INK_DIM)
+	var f: int = int(p["f"])
+	var fl: int = int(p["fl"])
+	var px: float = float(p["px"])
+	var pw: float = float(p["pw"])
+	UiText.no_outline = true
+	ci.draw_rect(Rect2(Vector2.ZERO, vp), Color(0.08, 0.07, 0.11, 1.0) if bool(p["approach"]) else Color(0.04, 0.05, 0.08, 1.0))
+	UiText.draw(ci, str(p["head_l"]), Vector2(px, float(p["head_y"])), f, dim, -1)
+	UiText.draw(ci, str(p["head_r"]), Vector2(px + pw, float(p["head_y"])), f, dim, 1)
+	var rec: Dictionary = p["rec"]
+	if bool(p["approach"]):
+		var of: int = int(rec.get("of_steps", 8))
+		for i in range(of):
+			var c := Vector2(px + 5.0 * k + float(i) * 13.0 * k, float(p["pips_y"]))
+			if i < int(rec.get("step", 1)):
+				ci.draw_circle(c, 5.0 * k, ink)
+			else:
+				ci.draw_arc(c, 5.0 * k, 0.0, TAU, 14, ink, 1.6, true)
+	else:
+		planet_row(ci, p["planet"], rec.get("states", []), rec.get("changed", []), k)
+		var cy: float = float(p["changed_y"])
+		for ln in p["changed"]:
+			UiText.draw(ci, str(ln), Vector2(px, cy + UiText.ascent(f)), maxi(f - 1, int(UiLook.text_floor)), dim, -1)
+			cy += UiText.height(f) * 1.25
+		if p.has("lost"):
+			UiText.draw(ci, str(p["lost"]), Vector2(px, float(p["lost_y"]) + UiText.ascent(f)), f, ink, -1)   # a count, in the same type as the rest: no icon, no colour, no emphasis, no counting up
+	var panel: Rect2 = p["panel"]
+	UiIcons.rrect(ci, panel, 14.0 * k, Color(0.09, 0.10, 0.15, 1.0), Color(0.17, 0.19, 0.24, 1.0), 1.4)
+	var ip: float = float(p["ip"])
+	for l in p["lines"]:
+		var ty: float = float(l["y"])
+		UiText.draw(ci, str(l["who"]), Vector2(px + ip, ty + UiText.ascent(int(fl * 0.82))), int(fl * 0.82), dim, -1)
+		ty += UiText.height(int(fl * 0.82)) * 1.1
+		for tl in l["lines"]:
+			UiText.draw(ci, str(tl), Vector2(px + ip, ty + UiText.ascent(fl)), fl, ink, -1)
+			ty += UiText.height(fl) * 1.15
+	if str(p["beat_of"]) != "":
+		UiText.draw(ci, str(p["beat_of"]), Vector2(panel.end.x - ip, panel.end.y - 10.0 * k), maxi(f - 2, int(UiLook.text_floor)), dim, 1)
+	UiText.draw(ci, str(p["foot"]), Vector2((p["skip_pos"] as Vector2).x, (p["skip_pos"] as Vector2).y - UiText.height(f) * 0.5 + UiText.ascent(f)), f, dim, -1)
+	button_draw(ci, p["next"], w("run_next"), true, true, fs(20.0, s))
+	UiText.no_outline = false
+
+
+# --- the results -----------------------------------------------------------------------------------------------------------------------------
+
+## `st`: {rec, page (1 or 2 on a phone on its side), parts (the score's parts are open: a phone upright)}. Returns the rows to draw and the buttons.
+static func results_plan(vp: Vector2, s: float, dp: float, touch: bool, st: Dictionary) -> Dictionary:
+	var rec: Dictionary = st.get("rec", {})
+	var k: float = u(s)
+	var m: float = 24.0 * k
+	var tm: float = maxf(48.0 * dp, 44.0)
+	var f: int = fs(14.0, s)
+	var two_page: bool = compact(vp, dp)
+	var page: int = clampi(int(st.get("page", 1)), 1, 2) if two_page else 0
+	var up: bool = upright(vp)
+	var plan := {"two_page": two_page, "page": page, "up": up, "fits": true, "tm": tm, "f": f, "rows": [], "buttons": []}
+	var won: bool = bool(rec.get("won", false))
+	var f_title: int = fs(26.0 if up else 28.0, s)
+	plan["title"] = w("run_over_won") if (won and up) else (w("run_over_won_long") if won else w("run_over_lost"))
+	plan["f_title"] = f_title
+	plan["title_pos"] = Vector2(m, m + UiText.ascent(f_title))
+	var y: float = m + UiText.height(f_title) * 1.15
+	var show_planet: bool = not two_page or page == 1
+	var show_route: bool = not two_page or page == 2
+	if two_page:
+		plan["page_text"] = UiData.fmt("prompt.run_page", {"n": page, "total": 2})
+		plan["page_pos"] = Vector2(vp.x - m, m + UiText.ascent(f))
+	var fe: int = fs(15.0 if two_page else 17.0, s)
+	plan["f_end"] = fe
+	if show_planet and str(rec.get("ending", "")) != "":
+		plan["ending"] = UiText.wrap(str(rec["ending"]), fe, vp.x - 2.0 * m)
+		plan["ending_y"] = y
+		y += float((plan["ending"] as PackedStringArray).size()) * UiText.height(fe) * 1.25 + 8.0 * k
+	var colw: float = (vp.x - 2.0 * m) if (up or two_page) else (vp.x - 2.0 * m - 30.0 * k) * 0.5
+	var rows: Array = plan["rows"]
+	var ly: float = y
+	var rx: float = m
+	var ry: float = y
+	if not up and not two_page:
+		rx = m + colw + 30.0 * k
+	# route
+	if show_route:
+		if two_page:
+			ly = m + 54.0 * k
+		rows.append({"t": "h", "text": w("run_route"), "x": m, "y": ly})
+		ly += UiText.height(f) * 1.9
+		var rh: float = (26.0 if two_page else 32.0) * k
+		var cw: float = ((vp.x - 2.0 * m) * 0.5 - 20.0 * k) if two_page else colw
+		var i: int = 0
+		for r in rec.get("route", []):
+			rows.append({"t": "route", "n": str(i + 1), "place": str(r.get("place", "")), "kind": kind_word(str(r.get("kind", ""))) if str(r.get("kind", "")) != "" else "", "won": bool(r.get("won", false)), "x": m, "w": cw, "y": ly})
+			ly += rh
+			i += 1
+		ly += 10.0 * k
+		var ch: Array = rec.get("chances", [])
+		var ticks: int = int(rec.get("ticks", 0))
+		var secs: int = ticks / 60
+		var line1: String = ""
+		if ch.size() == 2:
+			line1 = UiData.fmt("prompt.run_chances", {"n": int(ch[0]), "total": int(ch[1])})
+		if ticks > 0:
+			line1 += ("   " if line1 != "" else "") + UiData.fmt("prompt.run_time", {"m": secs / 60, "s": "%02d" % (secs % 60)})
+		if line1 != "":
+			rows.append({"t": "small", "text": line1, "x": m, "y": ly})
+			ly += UiText.height(f) * 1.5
+		var pth: Dictionary = rec.get("path", {})
+		if not pth.is_empty():
+			rows.append({"t": "small", "text": UiData.fmt("prompt.run_path", {"w": int(pth.get("witness", 0)), "t": int(pth.get("trial", 0))}), "x": m, "y": ly})
+			ly += UiText.height(f) * 1.7
+		if up:
+			ry = ly
+		if two_page:
+			rx = vp.x * 0.5 + 10.0 * k
+			ry = m + 54.0 * k
+	if show_planet:
+		if two_page:
+			ry = y
+			rx = m
+		rows.append({"t": "h", "text": w("run_planet_h"), "x": rx, "y": ry})
+		ry += UiText.height(f) * 1.6
+		var prh: float = (48.0 if two_page else 64.0) * k
+		var pr := Rect2(rx, ry, (vp.x - 2.0 * m) if two_page else colw, prh)
+		rows.append({"t": "planet", "rect": pr, "states": (rec.get("planet", {}) as Dictionary).get("states", [])})
+		ry += prh + 8.0 * k
+		var pl: Dictionary = rec.get("planet", {})
+		var lh: float = UiText.height(f) * 1.35
+		var cs: Dictionary = pl.get("cities", {})
+		if not cs.is_empty():
+			rows.append({"t": "line", "text": UiData.fmt("prompt.run_cities", {"a": int(cs.get("standing", 0)), "b": int(cs.get("damaged", 0)), "c": int(cs.get("fallen", 0))}), "x": rx, "y": ry})
+			ry += lh
+		var ts: Dictionary = pl.get("towns", {})
+		if not ts.is_empty():
+			rows.append({"t": "line", "text": UiData.fmt("prompt.run_towns", {"a": int(ts.get("standing", 0)), "b": int(ts.get("damaged", 0)), "c": int(ts.get("fallen", 0))}), "x": rx, "y": ry})
+			ry += lh
+		if pl.has("lost"):
+			var present: int = maxi(int(pl.get("present", 0)), 1)
+			rows.append({"t": "line", "text": UiData.fmt("prompt.run_people", {"n": _num(int(pl.get("lost", 0))), "total": _num(present), "p": int(round(100.0 * float(pl.get("lost", 0)) / float(present)))}), "x": rx, "y": ry})   # a count: the same type as the lines around it
+			ry += lh
+		if pl.has("sky_dark"):
+			rows.append({"t": "line", "text": UiData.fmt("prompt.run_sky", {"s": w("run_sky_dark") if bool(pl["sky_dark"]) else w("run_sky_clear")}), "x": rx, "y": ry})
+			ry += lh + 8.0 * k
+	if show_route:
+		var sw: float = ((vp.x - 2.0 * m) * 0.5 - 10.0 * k) if two_page else colw
+		var sx: float = rx if not up else m
+		var sy: float = ry if not up else ly
+		if two_page:
+			sx = vp.x * 0.5 + 10.0 * k
+			sy = m + 54.0 * k
+		var parts: Array = rec.get("score", [])
+		var open_parts: bool = (not up) or bool(st.get("parts", false))
+		if up:
+			rows.append({"t": "total", "text": w("run_score"), "points": _num(int(rec.get("total", 0))), "x": sx, "y": sy, "w": sw})
+			sy += UiText.height(f) * 1.8
+			if not parts.is_empty() and not open_parts:
+				rows.append({"t": "small", "text": w("run_score_tap"), "x": sx, "y": sy})
+				sy += UiText.height(f) * 1.4
+		else:
+			rows.append({"t": "h", "text": w("run_score"), "x": sx, "y": sy})
+			sy += UiText.height(f) * 1.7
+		if open_parts:
+			for pt in parts:
+				rows.append({"t": "part", "text": str(pt.get("label", "")), "points": _num(int(pt.get("points", 0))), "x": sx, "y": sy, "w": sw})
+				sy += UiText.height(f) * 1.45
+		if not up:
+			sy += 4.0 * k
+			rows.append({"t": "rule", "x": sx, "y": sy, "w": sw})
+			rows.append({"t": "total", "text": w("run_total"), "points": _num(int(rec.get("total", 0))), "x": sx, "y": sy + 4.0 * k, "w": sw})
+	# buttons
+	var bh: float = maxf(tm, 48.0 * k)
+	var by: float = vp.y - m - bh
+	var labels: Array = []
+	if two_page and page == 1:
+		labels = [["next", w("run_next")]]
+	else:
+		labels = [["new", w("run_new")], ["again", w("run_again")], ["menu", w("run_menu")]]
+	var btns: Array = plan["buttons"]
+	if up:
+		for i in range(labels.size()):
+			btns.append({"id": labels[i][0], "label": labels[i][1], "rect": Rect2(m, by - float(labels.size() - 1 - i) * (bh + 8.0 * k), vp.x - 2.0 * m, bh)})
+	else:
+		var bw: float = minf(220.0 * k, (vp.x - 2.0 * m - 12.0 * k * 2.0) / 3.0) if labels.size() > 1 else 160.0 * k
+		for i in range(labels.size()):
+			btns.append({"id": labels[i][0], "label": labels[i][1], "rect": Rect2(vp.x - m - float(labels.size() - i) * bw - float(labels.size() - 1 - i) * 12.0 * k, by, bw, bh)})
+	plan["focus"] = clampi(int(st.get("focus", 0)), 0, maxi(btns.size() - 1, 0))
+	# fit: the buttons on screen at 48 dp, and (not upright) nothing below the buttons' line
+	for b in btns:
+		var rr: Rect2 = b["rect"]
+		if not Rect2(Vector2.ZERO, vp).encloses(rr) or rr.size.y < tm - 0.01:
+			plan["fits"] = false
+		if UiText.width(str(b["label"]), fs(20.0, s)) + 16.0 > rr.size.x:
+			plan["fits"] = false
+	var lowest: float = 0.0
+	for r in rows:
+		if r.has("y"):
+			lowest = maxf(lowest, float(r["y"]))
+		if r.has("rect"):
+			lowest = maxf(lowest, (r["rect"] as Rect2).end.y)
+	plan["lowest"] = lowest
+	if lowest > (btns[0]["rect"] as Rect2).position.y - (0.0 if up else 4.0) - (UiText.height(f) if not up else 0.0) and not up:
+		plan["fits"] = false
+	plan["rec"] = rec
+	plan["parts"] = bool(st.get("parts", false))
+	return plan
+
+
+static func results_hit(p: Dictionary, pos: Vector2) -> Dictionary:
+	for b in p["buttons"]:
+		if (b["rect"] as Rect2).has_point(pos):
+			return {"kind": "button", "id": str(b["id"])}
+	if bool(p["up"]):
+		for r in p["rows"]:
+			if str(r.get("t", "")) == "total" and Rect2(float(r["x"]), float(r["y"]) - 4.0, float(r["w"]), 36.0).has_point(pos):
+				return {"kind": "score"}
+	return {}
+
+
+static func results_sig(p: Dictionary) -> Array:
+	return ["results", int(p["page"]), int(p["focus"]), bool(p["parts"]), hash(str(p["rec"]))]
+
+
+static func results_draw(ci: CanvasItem, p: Dictionary, s: float) -> void:
+	var vp: Vector2 = ci.size if ci is Control else Vector2(1280, 720)
+	var k: float = u(s)
+	var ink: Color = _col(UiLook.INK)
+	var dim: Color = _col(UiLook.INK_DIM)
+	var f: int = int(p["f"])
+	UiText.no_outline = true
+	ci.draw_rect(Rect2(Vector2.ZERO, vp), Color(0.04, 0.05, 0.08, 1.0))
+	UiText.draw(ci, str(p["title"]), p["title_pos"], int(p["f_title"]), ink, -1)
+	if p.has("page_text"):
+		UiText.draw(ci, str(p["page_text"]), p["page_pos"], f, dim, 1)
+	if p.has("ending"):
+		var ey: float = float(p["ending_y"])
+		for ln in p["ending"]:
+			UiText.draw(ci, str(ln), Vector2(24.0 * k, ey + UiText.ascent(int(p["f_end"]))), int(p["f_end"]), dim, -1)
+			ey += UiText.height(int(p["f_end"])) * 1.25
+	for r in p["rows"]:
+		var rx: float = float(r.get("x", 0.0))
+		var ry: float = float(r.get("y", 0.0))
+		match str(r["t"]):
+			"h":
+				UiText.draw(ci, str(r["text"]), Vector2(rx, ry + UiText.ascent(f)), f, ink, -1)
+			"small":
+				UiText.draw(ci, str(r["text"]), Vector2(rx, ry + UiText.ascent(f)), maxi(f - 1, int(UiLook.text_floor)), dim, -1)
+			"line":
+				UiText.draw(ci, str(r["text"]), Vector2(rx, ry + UiText.ascent(f)), f, ink, -1)   # the people-lost line is drawn exactly like the cities line above it (Legal c08)
+			"route":
+				var wd: float = float(r["w"])
+				UiText.draw(ci, str(r["n"]), Vector2(rx, ry + UiText.ascent(f)), f, dim, -1)
+				UiText.draw(ci, str(r["place"]), Vector2(rx + 26.0 * k, ry + UiText.ascent(f)), f, ink, -1)
+				if str(r["kind"]) != "":
+					UiText.draw(ci, str(r["kind"]), Vector2(rx + wd - 72.0 * k, ry + UiText.ascent(f)), maxi(f - 1, int(UiLook.text_floor)), dim, 1)
+				UiText.draw(ci, w("run_won") if bool(r["won"]) else w("run_lost"), Vector2(rx + wd, ry + UiText.ascent(f)), f, ink, 1)
+			"planet":
+				planet_row(ci, r["rect"], r["states"], [], k)
+			"part":
+				UiText.draw(ci, str(r["text"]), Vector2(rx, ry + UiText.ascent(f)), f, dim, -1)
+				UiText.draw(ci, str(r["points"]), Vector2(rx + float(r["w"]), ry + UiText.ascent(f)), f, ink, 1)
+			"rule":
+				ci.draw_rect(Rect2(rx, ry, float(r["w"]), 1.0), Color(0.17, 0.19, 0.24, 1.0))
+			"total":
+				var ft: int = fs(17.0, s)
+				UiText.draw(ci, str(r["text"]), Vector2(rx, ry + UiText.ascent(ft)), ft, ink, -1)
+				UiText.draw(ci, str(r["points"]), Vector2(rx + float(r["w"]), ry + UiText.ascent(ft)), ft, ink, 1)
+	var i: int = 0
+	for b in p["buttons"]:
+		button_draw(ci, b["rect"], str(b["label"]), i == 0, i == int(p["focus"]), fs(20.0, s))
+		i += 1
+	UiText.no_outline = false
