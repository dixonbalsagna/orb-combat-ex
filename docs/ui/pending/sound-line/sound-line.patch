+	hud.advance(1.0 / 60.0)
+	await process_frame
+	var on_hud: bool = bool(hud.menu_plan()["sound_blocked"]) and UiMenu.sig(hud.menu_plan()) != sig_off
+	flag["on"] = false
+	hud.advance(1.0 / 60.0)
+	await process_frame
+	var off_again: bool = not bool(hud.menu_plan()["sound_blocked"]) and UiMenu.sig(hud.menu_plan()) == sig_off
+	_ok(unset_off and on_hud and off_again, "sound line: in the HUD an unset hook shows nothing, the hook saying true adds the line and changes the card's redraw key, and false takes it away again (unset %s on %s off again %s)" % [unset_off, on_hud, off_again])
+	hud.queue_free()
+	await process_frame
