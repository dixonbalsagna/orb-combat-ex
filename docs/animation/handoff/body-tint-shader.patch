@@ -104,5 +107,5 @@ void fragment() {
 			}
 		}
 	}
-	ALBEDO = flat_shade(albedo.rgb * c, n, shade);
+	ALBEDO = flat_shade(albedo.rgb * c * mix(vec3(1.0), tint.rgb, COLOR.a), n, shade);
 }
