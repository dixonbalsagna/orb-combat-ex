+		if not rf._reacts.is_empty():
+			var near: float = 1.0 - smoothstep(150.0, 400.0, absf(SimWrap.sdx(f.x, rv.x)))
+			if near > 0.01:
+				kind = "flinch"
+				_mix_pose(AnimData.pose("react.flinch_b", vface_s), 0.5 * near)
