+			var mm = JSON.parse_string(FileAccess.get_file_as_string("res://data/anim/waves/" + String(fn)))
+			for st in mm.get("strikes", []):
+				offs[String(st.id)] = float(st.get("offset", 58.0))
+	var totals := {}
+	for own in [false, true]:
+		var n30: int = 0
+		var n20: int = 0
