diff --git a/render/anim/anim_fighter.gd b/render/anim/anim_fighter.gd
index 9192af6..b72b379 100644
--- a/render/anim/anim_fighter.gd
+++ b/render/anim/anim_fighter.gd
@@ -3107,6 +3107,16 @@ func _contact_one(S: SimState, f, base_limb: String, second: bool) -> void:
 		excess = d3.length() - reach   # the target is behind the shoulder (the fighters overlap): no step forward helps
 	var lunge: float = minf(need, lunge_max) * _ci_w
 	var step: float = clampf(need - lunge_max, 0.0, step_max) * _ci_w
+	# a kick whose hips are already past its target (the pose's own lunge, or a defender closer than the blow's range) would have to swing the thigh back through its limit: the body gives ground
+	# instead, as far as data `min_fwd` asks (the foot's target at least that far ahead of the hip), at most `retreat_max` (homework 4's pulled frames: a front kick's thigh pulled 100 degrees)
+	var min_fwd: float = float(sk.get("min_fwd", 0.0))
+	if min_fwd > 0.0 and not aim and need <= 0.0 and RenderAnim.kick_retreat:
+		var back: float = clampf(min_fwd - d3.x, 0.0, float(sk.get("retreat_max", 12.0)))
+		if side2 < reach * reach:
+			back = minf(back, maxf(sqrt(reach * reach - side2) - d3.x - 1.0, 0.0))   # never so far that the foot no longer reaches
+		if back > 0.0:
+			step = -back * _ci_w
+			debug["retreats"] = int(debug.get("retreats", 0)) + 1
 	_step_x = (_step_x + step) if second else step
 	var ik_t: Vector3 = tgt - Vector3(lunge + step, 0.0, 0.0)
 	var qa0: Quaternion = q[a]
@@ -3969,8 +3979,19 @@ func _aim_arms(alpha: float, w: float) -> void:
 		return
 	var a: float = alpha * w * _rd_amp()
 	var ix: Dictionary = AnimRig.index
-	for nm in ["upper_arm_l", "upper_arm_r"]:
-		q[ix[nm]] = q[ix[nm]] * Quaternion(Vector3(0, 0, 1), a)
+	# the turn is shortened until neither upper arm is past its limit (homework 4: a cast pose's arm turned to a steep aim was pulled 77 degrees by the last pass: an arm that snaps)
+	var base_l: Quaternion = q[ix["upper_arm_l"]]
+	var base_r: Quaternion = q[ix["upper_arm_r"]]
+	var sc: float = 1.0
+	for it in range(6):
+		var qa := Quaternion(Vector3(0, 0, 1), a * sc)
+		q[ix["upper_arm_l"]] = base_l * qa
+		q[ix["upper_arm_r"]] = base_r * qa
+		var el: Vector2 = AnimJoints.ball_excess(q, ix["upper_arm_l"], _rd.shape_key) if AnimJoints.ik_limits else Vector2.ZERO
+		var er: Vector2 = AnimJoints.ball_excess(q, ix["upper_arm_r"], _rd.shape_key) if AnimJoints.ik_limits else Vector2.ZERO
+		if el.x + el.y + er.x + er.y <= 0.02:
+			break
+		sc *= 0.7
 	q[ix["spine_2"]] = q[ix["spine_2"]] * Quaternion(Vector3(0, 0, 1), a * 0.25)
 	debug["aims"] += 1
 
diff --git a/render/anim/render_anim.gd b/render/anim/render_anim.gd
index 50fd1cd..68ecc72 100644
--- a/render/anim/render_anim.gd
+++ b/render/anim/render_anim.gd
@@ -30,6 +30,7 @@ static var hand_tips: bool = true             # a blow shows the hand state of i
 static var intro_gestures: bool = true         # the sim's intro_gesture events play the fighter's own motion for the intent (docs/animation/intro-gestures.md); inert until the composer sends them; --no-intro-gestures switches it off
 static var strength_styles: bool = false      # force a brawl beat's strength and burst number over the beat's own explicit `style` (`speed` for a light, `heavy` for a wound blow): the nine cells' looks (Y the medium row, B the super row, a held X's blows the burst row, the wind-ups whole, the held charge, the armour read) on a sim that still stamps the style. false (the shipped default) is today's picture.
 static var fighter_ease: bool = true          # each fighter's own ease rows (data fighters.json `ease`): fluid arcs for one, snappy lines for the other, inside the one clock; false is the before
+static var kick_retreat: bool = true          # a kick whose hips are past its target gives ground instead of swinging the thigh back through its limit (data sockets.json limbs.foot.min_fwd); false is the before
 static var mash_press: bool = true            # a run of mashed blows leans in (data styles.<style>.press_run); false is the before
 static var march: bool = true                  # a mashed heavy takes a footfall (data styles.super.march); false is the before
 static var dig_in: bool = true               # the held X digs in: the legs keep the set pose through a burst's stream (data styles.burst.dig); false is the before
diff --git a/render/anim/tools/anim_check.gd b/render/anim/tools/anim_check.gd
index ea35b53..3ea7903 100644
--- a/render/anim/tools/anim_check.gd
+++ b/render/anim/tools/anim_check.gd
@@ -1412,6 +1412,55 @@ func _test_arms() -> void:
 	print("arms: wings %d of %d keys, the air tech's feet low, the mash's beat" % [wings, total])
 
 
+func _test_pulls() -> void:
+	AnimData.load_every_wave()
+	main.start_match(4, {"p1": false, "p2": false})
+	for i in range(10):
+		main.frame(1.0 / 60.0)
+	var S: SimState = main.host.S
+	RenderAnim.ground_feet = false
+	RenderAnim.press_styles = true
+	# a beam's aim turns both upper arms; the turn is shortened until neither is past its limit (live seed 4 tick 1121 had the last pass pull one 77 degrees)
+	var bad: int = 0
+	for pid in ["bm.hold.fire_protagonist", "bm.hold.charge_protagonist", "bm.hold.fire_antihero", "bm.hold.charge_antihero", "beam.fire", "beam.charge"]:
+		for alpha in [-1.2, -0.6, 0.0, 0.6, 1.2]:
+			var af := AnimFighter.new(0)
+			af.q = AnimData.pose(pid).q.duplicate()
+			af._aim_arms(alpha, 1.0)
+			for nm in ["upper_arm_l", "upper_arm_r"]:
+				var e: Vector2 = AnimJoints.ball_excess(af.q, AnimRig.index[nm], af._rd.shape_key)
+				if e.x + e.y > 0.02:
+					bad += 1
+	_expect(bad == 0, "pulls: a beam's aim leaves an upper arm past its limit in %d of 60 cases" % bad)
+	# the heavies' kicks at their own striking distance: no frame of the last pass pulling over 30 degrees (the pose's own lunge used to leave the hip past the target)
+	var dad := DirAccess.open("res://data/anim/waves")
+	var offs := {}
+	for fn in dad.get_files():
+		if String(fn).ends_with(".manifest.json"):
+			var mm = JSON.parse_string(FileAccess.get_file_as_string("res://data/anim/waves/" + String(fn)))
+			for st in mm.get("strikes", []):
+				offs[String(st.id)] = float(st.get("offset", 58.0))
+	var dist_was: float = _tier_dist
+	for pc in [["protagonist", "su_edge_step", "pu.su_edge_step"], ["protagonist", "su_edge_unwind", "pu.su_edge_unwind"], ["antihero", "su_heel", "ru.su_heel"]]:
+		_tier_dist = float(offs.get(String(pc[2]), 58.0))
+		var r: Dictionary = _tier_scene(S, String(pc[0]), "super", [String(pc[1])], [44], {"windup": 28}, "heavy")
+		_expect(int(r.get("fix_n30", 0)) == 0, "pulls: %s at its own range (%.0f) has %d frames of the last pass pulling over 30 degrees" % [String(pc[2]), _tier_dist, int(r.get("fix_n30", 0))])
+	# a defender closer than a kick's range: the body gives ground instead of the thigh being pulled back through its limit (data sockets.json limbs.foot.min_fwd)
+	var retreat_was: bool = RenderAnim.kick_retreat
+	var closes := {}
+	for on in [false, true]:
+		RenderAnim.kick_retreat = on
+		_tier_dist = 38.0
+		var tot: int = 0
+		for nm in ["front_kick", "snap_round", "side_kick"]:
+			tot += int(_tier_scene(S, "protagonist", "medium", [nm], [44], {"windup": 12}, "heavy").get("fix_n30", 0))
+		closes[on] = tot
+	RenderAnim.kick_retreat = retreat_was
+	_expect(int(closes[true]) == 0 and int(closes[false]) > int(closes[true]), "pulls: three kicks at 38 units pull the last pass over 30 degrees on %d frames without the retreat and %d with it" % [int(closes[false]), int(closes[true])])
+	_tier_dist = dist_was
+	print("pulls: a beam's aim stays inside the limits; the three heavies' kicks need no big correction at their range")
+
+
 func _test_march() -> void:
 	AnimData.load_every_wave()
 	main.start_match(4, {"p1": false, "p2": false})
@@ -3893,6 +3942,7 @@ func _run() -> void:
 	_test_round10()
 	_test_pieces()
 	_test_arms()
+	_test_pulls()
 	_test_medium_wind()
 	_test_energy_reach()
 	_test_free_arm()
