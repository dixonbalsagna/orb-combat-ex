+## A tick with the clock by body. The first pair is the fight an exchange runs in today; the rest are other bodies. Two exchanges will make that a list.
+static func _stepByBody(S: SimState, inputs, dt: float, dtReal: float) -> bool:
+	var world: float = S.T + dt
+	var n: int = S.fighters.size()
+	if not S.holdBegun:
+		S.holdBegun = true
+		for f in S.fighters:
+			f.clock = S.T
+	var held: Array = []
+	for f in S.fighters:
+		var h: bool = f.held > 0.0
+		held.append(h)
+		if h:
+			f.held -= dtReal
+			if S.hitstopOn and f.held < SimHitstop.RESIDUE:   # as SimHitstop.frozen does
+				f.held = 0.0
+		else:
+			f.clock += dt
+	var live: bool = not held[0] and not held[1]
+	S.T = S.fighters[0].clock
+	if live:
+		if S.frame != null:
+			SimSwing.tick(S)
+		if S.epoch != null:
+			WorldEpoch.tick(S, DirCalm.hold(S))
+		if S.hitstopOn:
+			SimHitstop.live(S)
+		SimPause.liveTick(S)
+		if S.game.ko != null:
+			S.game.koT += dt
+			if S.game.koT > 2.2:
+				S.game.ts = 1.0
+	var ord: Array = []
+	if live:
+		ord = [0, 1] if S.rng.next() < 0.5 else [1, 0]
+	for k in range(2, n):
+		ord.append(k)
+	for k in ord:
+		if not held[k]:
+			S.T = S.fighters[k].clock
+			SimControl.control(S, S.fighters[k], inputs[k] if inputs != null and k < inputs.size() else null)
+	for k in range(n):
+		if not held[k]:
+			S.T = S.fighters[k].clock
+			SimFighter.stepFighter(S, S.fighters[k], dt)
+	S.T = S.fighters[0].clock
+	if live:
+		DirExchange.dirUpdate(S, dt)
+		DirBeam.beamStep(S, dt)
+	if live or S.holdWorld:
+		if S.holdWorld:
+			S.T = world
+		SimShots.step(S, dt)
+		WorldWater.step(S)
+		SimMood.tick(S)
+		if S.cata != null and S.cata.ashLeft > 0:
+			SimCata.tick(S)
+		if S.formsOn:
+			SimForms.events(S)
+		WorldCollateral.tick(S)
+	SimFx.tickMark(S, dt, not live)
+	if S.dirS.stop > 0.0:   # whatever this tick asked for holds the exchange's fighters, from the next tick. Every writer will name its own in the build
+		var ex = S.dirS.ex
+		var a = ex.A if ex != null else S.fighters[0]
+		var d = ex.D if ex != null else S.fighters[1]
+		a.held = maxf(a.held, S.dirS.stop)
+		d.held = maxf(d.held, S.dirS.stop)
+		S.dirS.stop = 0.0
+	S.T = world
+	return live
+
+
+## A body changes fights: his clock becomes the new fight's, and every deadline he carries moves with it, so what he had left, he still has. Clocks drift apart by the time each was held.
+static func rebase(f, clock: float) -> void:
+	var d: float = clock - f.clock
+	f.clock = clock
+	for k in STAMPS:
+		f.set(k, f.get(k) + d)
+	if f.beamCharge != null:
+		f.beamCharge += d
+	if f.rush != null:
+		f.rush.end += d
+
+
+const STAMPS: Array = ["hurtT", "breathT", "ambushUntil", "lockBackT", "sigReadyT", "lastAtkT", "exT", "embedCool"]
+
+
 static func toggleAI(S: SimState, idx: int) -> void:
 	var f = S.fighters[idx]
 	f.ai = null if f.ai != null else SimState.AiState.new()
