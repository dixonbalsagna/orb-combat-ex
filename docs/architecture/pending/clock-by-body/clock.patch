diff --git a/sim/core/tools/hold_check.gd b/sim/core/tools/hold_check.gd
new file mode 100644
index 0000000..1b41db4
--- /dev/null
+++ b/sim/core/tools/hold_check.gd
@@ -0,0 +1,276 @@
+extends SceneTree
+## The clock by body, a prototype: godot --headless --path . --script res://sim/core/tools/hold_check.gd
+## Does a fight survive its hit-stop holding only its own fighters? Against a plain 1v1 of the same seed, tick by tick; bystanders move through its holds; a second body's hold; a rollback.
+
+var fails: int = 0
+const WORLDS: Array = [{"intro": false}, {"intro": false, "planet": 7, "touch": 1, "planetGen": 3}, {"intro": false, "planet": 12, "touch": 1, "planetGen": 3}]
+const SEEDS: Array = [77, 5, 101]
+
+
+func ok(c: bool, what: String) -> void:
+	if not c:
+		fails += 1
+		print("FAIL  " + what)
+
+
+func _slots() -> Array:
+	var o: Array = FighterData.order()
+	var out: Array = o.slice(0, 2)
+	var i: int = 0
+	while out.size() < 4:
+		out.append(o[i % o.size()])
+		i += 1
+	return out
+
+
+func _new(seed: int, world: Dictionary, four: bool, hold: bool, keepWorld: bool = false) -> SimState:
+	var su: Dictionary = world.duplicate()
+	if four:
+		su["slots"] = _slots()
+		su["holdBody"] = hold
+	var S := SimCore.createSim()
+	SimCore.newMatch(S, seed, {"p1": true, "p2": true}, su)
+	if four:
+		S.holdWorld = keepWorld
+		for k in range(2, 4):
+			S.fighters[k].x = SimWrap.wrap(S.fighters[0].x + 40000.0 + 2000.0 * float(k))
+			S.fighters[k].y = 3000.0
+	return S
+
+
+func _inputs(t: int) -> Array:
+	var a := SimIntent.new()
+	a.mx = 1.0 if t % 120 < 60 else -1.0
+	var b := SimIntent.new()
+	b.mx = -1.0 if t % 200 < 100 else 1.0
+	return [null, null, a, b]
+
+
+func _row(S) -> Array:
+	var a = S.fighters[0]
+	var b = S.fighters[1]
+	return [a.x, a.y, a.hp, a.state, b.x, b.y, b.hp, b.state]
+
+
+## A plain 1v1, then the same pair with two bystanders under the clock by body, the world under the pair's hold: the pair's every number on every tick.
+func _same(seed: int, world: Dictionary) -> void:
+	var R := _new(seed, world, false, false)
+	var rows: Array = []
+	var ko: int = -1
+	for t in range(3600):
+		SimCore.step(R)
+		R.out.fx.clear()
+		R.out.feed.clear()
+		rows.append(_row(R))
+		if R.game.ko != null and ko < 0:
+			ko = t
+	SimCore.dispose(R)
+	var S := _new(seed, world, true, true)
+	var by: Array = [S.fighters[2].x, S.fighters[3].x]
+	var first: int = -1
+	var heldTicks: int = 0
+	var movedHeld: int = 0
+	for t in range(3600):
+		var x2: float = S.fighters[2].x
+		var live: bool = SimCore.step(S, _inputs(t))
+		S.out.fx.clear()
+		S.out.feed.clear()
+		if not live:
+			heldTicks += 1
+			if S.fighters[2].x != x2:
+				movedHeld += 1
+		if first < 0 and _row(S) != rows[t]:
+			first = t
+			print("  first difference at tick %d: %s against %s" % [t, str(_row(S)), str(rows[t])])
+	print("same: seed %d %s: %d ticks, %d of them the pair held, a bystander moved on %d; first difference %d (1v1's KO %d)" % [seed, "planet %d" % world.planet if world.has("planet") else "flat", rows.size(), heldTicks, movedHeld, first, ko])
+	ok(first < 0, "the pair's numbers match a 1v1, tick by tick (seed %d, first differ at %d)" % [seed, first])
+	ok(heldTicks > 0 and movedHeld > heldTicks / 2, "a bystander keeps moving through the pair's holds (%d of %d)" % [movedHeld, heldTicks])
+	SimCore.dispose(S)
+
+
+## With the world and shots running on, as Game Design rules: how far does the fight's course move?
+func _worldOn(seed: int, world: Dictionary) -> Dictionary:
+	var S := _new(seed, world, true, true, true)
+	var hits: int = 0
+	var launches: int = 0
+	var t: int = 0
+	while t < 3600 and S.game.ko == null:
+		SimCore.step(S, _inputs(t))
+		for e in S.out.fx:
+			if e.type == "damage":
+				hits += 1
+			if e.type == "launch":
+				launches += 1
+		S.out.fx.clear()
+		S.out.feed.clear()
+		t += 1
+	var out: Dictionary = {"t": t, "hits": hits, "launches": launches, "hash": str(SimHash.stateHash(S).gameplay)}
+	SimCore.dispose(S)
+	return out
+
+
+func _plain(seed: int, world: Dictionary) -> Dictionary:
+	var S := _new(seed, world, false, false)
+	var hits: int = 0
+	var launches: int = 0
+	var t: int = 0
+	while t < 3600 and S.game.ko == null:
+		SimCore.step(S)
+		for e in S.out.fx:
+			if e.type == "damage":
+				hits += 1
+			if e.type == "launch":
+				launches += 1
+		S.out.fx.clear()
+		S.out.feed.clear()
+		t += 1
+	SimCore.dispose(S)
+	return {"t": t, "hits": hits, "launches": launches}
+
+
+## A second body's hold: he stands still, the pair fights on, and his own clock waits.
+func _second() -> void:
+	var S := SimCore.createSim()
+	var su: Dictionary = WORLDS[0].duplicate()
+	su["slots"] = _slots()
+	su["holdBody"] = true
+	SimCore.newMatch(S, 77, {"p1": false, "p2": false}, su)
+	for k in range(2, 4):
+		S.fighters[k].x = SimWrap.wrap(S.fighters[0].x + 40000.0 + 2000.0 * float(k))
+		S.fighters[k].y = 3000.0
+	S.fighters[0].y = 3000.0
+	S.fighters[1].y = 3000.0
+	for t in range(200):
+		SimCore.step(S, _inputs(t))
+	S.out.fx.clear()
+	S.out.feed.clear()
+	var f = S.fighters[2]
+	f.held = 0.2
+	var x0: float = f.x
+	var c0: float = f.clock
+	var pairMoved: int = 0
+	for k in range(13):
+		var p0: float = S.fighters[0].x + S.fighters[1].x
+		var ins: Array = _inputs(200 + k)
+		var pa := SimIntent.new()
+		pa.mx = 1.0
+		ins[0] = pa
+		SimCore.step(S, ins)
+		S.out.fx.clear()
+		S.out.feed.clear()
+		if S.fighters[0].x + S.fighters[1].x != p0:
+			pairMoved += 1
+	ok(f.x == x0, "a held body stays where he is (%.2f moved)" % (f.x - x0))
+	ok(pairMoved > 0, "the pair goes on meanwhile (%d of 13 ticks moved)" % pairMoved)
+	ok(f.clock == c0 and f.held <= 0.0, "his clock waited, and his hold ran out (clock moved %.3f, held %.3f)" % [f.clock - c0, f.held])
+	SimCore.step(S, _inputs(213))
+	ok(f.x != x0, "then he moves")
+	SimCore.dispose(S)
+
+
+## Two runs one hash, and a rollback across holds: the same hash on every tick of the re-run.
+func _rollback(world: Dictionary) -> void:
+	var run := func() -> String:
+		var A := _new(77, world, true, true, true)
+		for t in range(1500):
+			SimCore.step(A, _inputs(t))
+			A.out.fx.clear()
+			A.out.feed.clear()
+		var h: String = str(SimHash.stateHash(A).gameplay)
+		SimCore.dispose(A)
+		return h
+	ok(run.call() == run.call(), "two runs give one hash")
+	var S := _new(77, world, true, true, true)
+	var snap: NetSnapshot = null
+	var hs: Array = []
+	var held: int = 0
+	for t in range(1500):
+		if t == 700:
+			snap = NetSnapshot.take(S)
+		var live: bool = SimCore.step(S, _inputs(t))
+		S.out.fx.clear()
+		S.out.feed.clear()
+		if t >= 700:
+			hs.append(str(SimHash.stateHash(S).gameplay))
+			held += 0 if live else 1
+	NetSnapshot.restore(S, snap)
+	var bad: int = 0
+	for t in range(700, 1500):
+		SimCore.step(S, _inputs(t))
+		S.out.fx.clear()
+		S.out.feed.clear()
+		if str(SimHash.stateHash(S).gameplay) != hs[t - 700]:
+			bad += 1
+	print("rollback: %d ticks, %d of them held, %d differ" % [hs.size(), held, bad])
+	ok(bad == 0 and held > 0, "a rollback across holds is the same on every tick (%d differ, %d held)" % [bad, held])
+	SimCore.dispose(S)
+
+
+## A body moves between fights mid-rush, on clocks that have drifted apart. Without a re-base his rush is wrong by the drift; with one it ends on the tick it would have.
+func _move() -> void:
+	var run := func(mode: int) -> Array:
+		var S := _new(77, WORLDS[0], true, true)
+		for t in range(1500):
+			SimCore.step(S, _inputs(t))
+			S.out.fx.clear()
+			S.out.feed.clear()
+		var f = S.fighters[2]
+		var pair = S.fighters[0]
+		var drift: float = f.clock - pair.clock
+		f.state = "free"
+		var r := SimState.Rush.new()
+		r.px = f.x + 3000.0
+		r.py = f.y
+		r.end = f.clock + 1.0
+		f.rush = r
+		f.sigReadyT = f.clock + 2.0
+		f.hurtT = f.clock - 0.5
+		for t in range(20):
+			SimCore.step(S, [null, null, null, null])
+			S.out.fx.clear()
+			S.out.feed.clear()
+		if mode == 1:
+			f.clock = pair.clock   # on the new fight's clock, the deadlines left as they were
+		elif mode == 2:
+			SimCore.rebase(f, pair.clock)
+		var n: int = 0
+		var held: int = 0
+		while f.rush != null and n < 2000:
+			var live: bool = SimCore.step(S, [null, null, null, null])
+			S.out.fx.clear()
+			S.out.feed.clear()
+			if not live:
+				held += 1
+			n += 1
+		var hurtAgo: float = f.clock - f.hurtT
+		var sigLeft: float = f.sigReadyT - f.clock
+		SimCore.dispose(S)
+		return [drift, n, hurtAgo, sigLeft, held]
+	var a: Array = run.call(0)
+	var b: Array = run.call(1)
+	var c: Array = run.call(2)
+	print("move: drift %.2f s; rush's ticks left: stayed %d, moved with no re-base %d, re-based %d" % [a[0], a[1], b[1], c[1]])
+	ok(absf(a[0]) > 1.0, "the clocks have drifted (%.2f s)" % a[0])
+	ok(b[1] != a[1], "with no re-base the rush is wrong (%d against %d)" % [b[1], a[1]])
+	ok(c[1] == a[1], "re-based, it ends on its tick (%d against %d)" % [c[1], a[1]])
+
+
+func _init() -> void:
+	_move()
+	for w in WORLDS:
+		for sd in SEEDS:
+			_same(sd, w)
+	var a: Array = [0, 0, 0]
+	var b: Array = [0, 0, 0]
+	for w in WORLDS:
+		for sd in SEEDS:
+			var p: Dictionary = _plain(sd, w)
+			var q: Dictionary = _worldOn(sd, w)
+			a[0] += p.t; a[1] += p.hits; a[2] += p.launches
+			b[0] += q.t; b[1] += q.hits; b[2] += q.launches
+	print("world on: over 9 fights: ticks %d against a 1v1's %d, blows %d against %d, launches %d against %d" % [b[0], a[0], b[1], a[1], b[2], a[2]])
+	_second()
+	_rollback(WORLDS[0])
+	_rollback(WORLDS[1])
+	print("HOLD: %d check(s) failed" % fails)
+	quit(1 if fails > 0 else 0)
