+			debris.dust_puff(VfxPalette.biome_key(fv.x), fv.x - dir * (4.0 + 8.0 * float(k)), fv.y + 4.0, 0.0, dir * (40.0 + 20.0 * float(k)), 14.0, 16.0, 40.0, 0.5, 0)
+		made["cash_dust"] = int(made.get("cash_dust", 0)) + 2
