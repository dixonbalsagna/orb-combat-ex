+	_check(all_n == am + 20, "a crater's own chunks are never turned away, whatever the pool holds (%d, then %d)" % [am, all_n])
+	var mode0: int = hck.debris.bits.size()
+	hck.debris.chunk(plains, gy + 40.0, 0.0, 0.0, 300.0, 10.0, 2.0, [Color.GRAY, Color.WHITE, Color.BLACK], 0, 0.0)
