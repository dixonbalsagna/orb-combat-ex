+## A signature beam over one ground (the beam clips, Legal's follow-up to the plume clips): the pair is set down on the plains between the harbour village and the city, clear of every building (nothing falls), and the biome is forced for the run (the default world has no ice or lava)
+## (VfxBiome.override_biome), so the beam's ground scorch throws what that ground is made of and a plume rises where it lands; player one fires the signature on a cycle at the AI
+## (the `signature` scene). The same in tools/flash/flash_worst.gd and render/tools/flash_capture.gd (the drift check).
+func _beam_ground(t: int, S: SimState, biome: String) -> void:
+	if t == 0:
+		VfxBiome.override_biome = biome
+		for i in range(2):
+			var f = S.fighters[i]
+			f.x = SimWrap.wrap(2062.5 * SimConst.PS + (-110.0 if i == 0 else 110.0))
+			f.y = WorldTerrain.groundY(S, f.x) + 10.0
+			f.vx = 0.0
+			f.vy = 0.0
+			f.tier = 3.0
+	_signature(t, S)
+
+
 func _apply_variant(S: SimState, variant: int) -> void:
 	for f in S.fighters:
 		f.x = SimWrap.wrap(f.x + 450.0 * float(variant))
