+## The background carries a launch's speed (Research's cinematic paper, recs 8 and 12): while a body is flying fast, thin streaks anchored in the WORLD (a hashed grid, so they stay put as the camera chases him and
+## slide past it) lie along his line of flight, behind the fighters' plane, in his lane colour lightened, quiet. They are never over a fighter: they stand at the background's depth and skip anything within a
+## body height and a half of either fighter. No flicker, no random number (a hash of the cell), none when the body is slow or lands. Reads the fighters' velocity and state only.
+const FLIGHT_MIN_SPEED := 700.0
+const FLIGHT_FULL_SPEED := 2400.0
+const FLIGHT_CELL_X := 110.0
+const FLIGHT_CELL_Y := 70.0
+const FLIGHT_MAX := 56
+
+
+func _flight_streaks(n: int, hub: VfxHub, host, a: float, cam_x: float, half_w: float, bh: float, minpx: float) -> int:
+	if not hub.speedlines_enabled:
+		return n
+	var S: SimState = host.S
+	var made: int = 0
+	var share: float = 0.5 if hub.reduced_motion else 1.0
+	for i in range(mini(2, S.fighters.size())):
+		var f = S.fighters[i]
+		if String(f.state) != "launched":
+			continue
+		var vx: float = float(f.vx)
+		var vy: float = float(f.vy)
+		var sp: float = sqrt(vx * vx + vy * vy)
+		if sp < FLIGHT_MIN_SPEED:
+			continue
+		var amt: float = clampf((sp - FLIGHT_MIN_SPEED) / (FLIGHT_FULL_SPEED - FLIGHT_MIN_SPEED), 0.0, 1.0)
+		var dv: Vector2 = Vector2(vx, vy) / sp
+		var pose: Vector3 = host.fighter_pose(i, a)
+		var fz: float = host.fighter_z(i, a)
+		var lane: Color = VfxAura.lane_color(String(f.aura))
+		var k0: int = int(floor((cam_x - half_w) / FLIGHT_CELL_X))
+		var k1: int = int(ceil((cam_x + half_w) / FLIGHT_CELL_X))
+		var gy: float = WorldTerrain.groundY(S, cam_x)       # the rows stand on the ground under the view, up to ten body heights above it (the view follows the pair, not the body that has flown off)
+		var j0: int = int(floor((gy + 0.5 * bh) / FLIGHT_CELL_Y))
+		var j1: int = int(ceil((gy + 10.0 * bh) / FLIGHT_CELL_Y))
+		for k in range(k0, k1 + 1):
+			for j in range(j0, j1 + 1):
+				if made >= FLIGHT_MAX or n >= CAP - 4:
+					return n
+				var h: float = VfxTremor.hash01(posmod(k, 4096) * 131 + j * 7, 17 + i)
+				if h > 0.3 * share * (0.4 + 0.6 * amt):
+					continue
+				var wx: float = (float(k) + VfxTremor.hash01(k * 3 + j, 29)) * FLIGHT_CELL_X
+				var cy: float = (float(j) + VfxTremor.hash01(k + j * 5, 31)) * FLIGHT_CELL_Y
+				var rel: float = SimWrap.sdx(cam_x, SimWrap.wrap(wx))
+				var c := Vector2(rel, cy)
+				var fr: float = SimWrap.sdx(cam_x, host.fighter_x(i, a))
+				for who in range(mini(2, S.fighters.size())):
+					var fxr: float = SimWrap.sdx(cam_x, host.fighter_x(who, a))
+					var pyr: float = host.fighter_pose(who, a).y
+					if absf(rel - fxr) < 1.5 * bh + 60.0 and absf(cy - (pyr + 0.5 * bh)) < 1.5 * bh + 40.0:
+						made = made
+						c = Vector2(1e9, 0.0)
+				if c.x > 1e8:
+					continue
+				var ln: float = 60.0 + minf(sp, 4000.0) * 0.03 * (0.6 + 0.8 * VfxTremor.hash01(k + j, 41))
+				var col: Color = lane
+				col.a = 0.75 * (0.5 + 0.5 * amt) * (0.6 + 0.4 * VfxTremor.hash01(k * 7 + j, 43))
+				n = _line(n, c - dv * ln * 0.5, c + dv * ln * 0.5, maxf(3.0, minpx * 2.0), fz - 2.0, col)
+				made += 1
+	return n
+
+
