+## never additive; every rate under 2 Hz, the calm form (Reduce flashing or Reduced motion) slower and with nothing popping. It never appears with a crouch-and-scream (the stacking rule is the director's).
+
+const DEFAULTS: Dictionary = {
+	"common": {
+		"alpha_max": 0.5, "pattern_alpha": 0.8,
+		"hull_bh": [0.065, 0.08, 0.1, 0.12], "hull_rag": 0.7,
+		"calm_pulse_k": 0.4, "calm_shimmer": 0.5, "tint_lift": 0.3, "max_hz": 2.0,
+	},
+	"themes": {
+		"protagonist": {"theme": 0.0, "scale": 1.08, "pulse_hz": 0.9, "pulse_amp": 0.1, "pulse_dir": 1.0, "flow": [0.0, 0.3, 0.0], "cells": [3.0, 3.3, 3.6, 4.0], "cell_rate": 0.55, "rim_k": 1.8, "disp": 0.12, "fill": 0.08, "froth": [0.0, 0.35, 0.7, 1.0], "band": 0.4},
+		"rival": {"theme": 1.0, "scale": 0.9, "pulse_hz": 0.5, "pulse_amp": 0.06, "pulse_dir": -1.0, "flow": [0.0, -0.18, 0.0], "cells": [2.6, 3.0, 3.4, 3.8], "cell_rate": 0.14, "rim_k": 3.0, "disp": 0.03, "fill": 0.16, "froth": [0.0, 0.0, 0.0, 0.0], "band": 0.3},
+		"default": {"theme": 0.0, "scale": 1.0, "pulse_hz": 0.7, "pulse_amp": 0.05, "pulse_dir": 1.0, "flow": [0.0, 0.2, 0.0], "cells": [3.0, 3.3, 3.6, 4.0], "cell_rate": 0.4, "rim_k": 2.6, "disp": 0.05, "fill": 0.1, "froth": [0.0, 0.2, 0.4, 0.6], "band": 0.35},
+	},
+}
+
+## The hull material of a fighter (Rendering's FighterView chains it after his outline pass): one per fighter object, made on first ask, written each frame by the view. `level` 0 until it is up.
+static var _hulls: Dictionary = {}
+
+
+static func hull_material(f) -> ShaderMaterial:
+	var id: int = f.get_instance_id()
+	if _hulls.has(id):
+		return _hulls[id]
+	var m := ShaderMaterial.new()
+	m.shader = preload("res://render/vfx/shaders/aura3d.gdshader")
+	m.set_shader_parameter("ortho", 1.0)
+	m.set_shader_parameter("level", 0.0)
+	m.render_priority = 1
+	_hulls[id] = m
+	return m
+
+
+static func clear_hulls() -> void:
+	_hulls.clear()
+
+
+static var _data: Dictionary = {}
+static var _loaded: bool = false
+
+
+static func warm() -> void:
+	if _loaded:
+		return
+	_loaded = true
+	var path := "res://data/vfx/aura3d.json"
+	if FileAccess.file_exists(path):
+		var v = JSON.parse_string(FileAccess.get_file_as_string(path))
+		if v is Dictionary:
+			_data = v
+
+
+static func common(key: String):
+	warm()
+	var g = _data.get("common")
+	if g is Dictionary and g.has(key):
+		return g[key]
+	return DEFAULTS["common"][key]
+
+
+## A theme's block: the fighter's own (by roster id, lower case) or `default`.
+static func theme_block(id: String) -> Dictionary:
+	warm()
+	var th = _data.get("themes")
+	if not (th is Dictionary):
+		th = DEFAULTS["themes"]
+	var k: String = id if (th.has(id) or DEFAULTS["themes"].has(id)) else "default"
+	var d: Dictionary = DEFAULTS["themes"][k] if DEFAULTS["themes"].has(k) else DEFAULTS["themes"]["default"]
+	var got = th.get(k)
+	if got is Dictionary:
+		var m: Dictionary = d.duplicate(true)
+		for kk in got.keys():
+			m[kk] = got[kk]
+		return m
+	return d
+
+
+## The lighter tint of a lane colour for the surface: lifted a little, never white (the saturation keeps a floor and the value a ceiling).
+static func tint(c: Color) -> Color:
+	var lift: float = float(common("tint_lift"))
+	var o := Color.from_hsv(c.h, clampf(c.s * (1.0 - lift * 0.6), 0.3, 1.0), clampf(c.v + (1.0 - c.v) * lift, 0.0, 0.93))
+	o.a = 1.0
+	return o
+
+
+## The dark shade of a lane colour for the seams: the same hue, a third of the value.
+static func shade(c: Color) -> Color:
+	var o := Color.from_hsv(c.h, clampf(c.s * 1.05, 0.0, 1.0), c.v * 0.32)
+	o.a = 1.0
+	return o
+
+
+## Everything a fighter's shell needs this frame, as shader uniforms plus the shell's size: the fighter's roster id, his tier (1 to 4), the aura's eased level, the calm form, the clock in seconds, his
+## lane colour. Pure.
+static func params(id: String, tier: int, level: float, calm: bool, t: float, lane: Color, seed_v: float) -> Dictionary:
+	var th: Dictionary = theme_block(id)
+	var ti: int = clampi(tier, 1, 4) - 1
+	var cells: Array = th["cells"]
+	var hp: Array = common("hull_bh")
+	var fl: Array = th["flow"]
+	var cm: float = 1.0 if calm else 0.0
+	var sh: float = float(common("calm_shimmer")) if calm else 1.0
+	var pk: float = float(common("calm_pulse_k")) if calm else 1.0
+	var sc: float = float(th["scale"])
+	return {
+		"t": t, "level": level, "theme": float(th["theme"]), "tier": float(ti + 1),
+		"col_a": lane, "col_b": tint(lane), "col_c": shade(lane),
+		"alpha_max": float(common("alpha_max")), "pattern_alpha": float(common("pattern_alpha")),
+		"fill_alpha": float(th["fill"]), "froth": float(th["froth"][ti]), "band": float(th["band"]) * (0.5 if calm else 1.0),
+		"pulse_hz": float(th["pulse_hz"]) * (0.6 if calm else 1.0), "pulse_amp": float(th["pulse_amp"]) * pk, "pulse_dir": float(th["pulse_dir"]),
+		"flow": Vector3(float(fl[0]), float(fl[1]), float(fl[2])) * sh, "cells": float(cells[ti]), "cell_rate": float(th["cell_rate"]) * sh, "rim_k": float(th["rim_k"]), "disp": float(th["disp"]) * pk,
+		"shimmer": sh, "calm": cm, "seed": seed_v,
+		"hull_bh": float(hp[ti]) * sc,
+	}
+
+
+## The fastest rate in a theme, in hertz (the pulse, the bubbles' lives, a facet's glint at 0.85 rad/s), in the normal or the calm form: the check holds it under `max_hz`.
+static func max_rate_hz(id: String, calm: bool) -> float:
+	var th: Dictionary = theme_block(id)
+	var sh: float = float(common("calm_shimmer")) if calm else 1.0
+	var pulse: float = float(th["pulse_hz"]) * (0.6 if calm else 1.0)
+	return maxf(pulse, maxf(float(th["cell_rate"]) * sh, 0.85 * sh / TAU))
