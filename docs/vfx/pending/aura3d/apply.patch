--- a/render/vfx/aura3d_view.gd
+++ b/render/vfx/aura3d_view.gd
@@ -0,0 +1,69 @@
+class_name VfxAura3DView
+extends Node3D
+## The 3D auras for one pane (aura3d.gd has the rules, shaders/aura3d.gdshader the look): one shell per fighter, a sphere mesh scaled to his tier's oval, placed round his body, its material
+## carrying his theme. A child of the trail view, like the dust and cloud views. Reads only. Hidden unless `hub.aura3d_enabled`; the shell is drawn while the standing aura's eased level
+## (aura.gd) is up, or always at full level in the showcase (`hub.aura3d_demo`, the capture and the prototype).
+
+const SLOTS: int = 2
+
+var shells: Array = []
+var shown: int = 0                  # shells visible last frame (for the tests)
+
+
+func _ready() -> void:
+	var sm := SphereMesh.new()
+	sm.radius = 1.0
+	sm.height = 2.0
+	sm.radial_segments = 64
+	sm.rings = 32
+	for i in range(SLOTS):
+		var mi := MeshInstance3D.new()
+		mi.mesh = sm
+		var m := ShaderMaterial.new()
+		m.shader = preload("res://render/vfx/shaders/aura3d.gdshader")
+		m.render_priority = 1
+		mi.material_override = m
+		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+		mi.visible = false
+		mi.extra_cull_margin = 4000.0
+		add_child(mi)
+		shells.append(mi)
+
+
+## a: the frame's interpolation between the last two ticks. cam_x: this pane's wrapped camera x; half_w: half the visible width in world units.
+func update(hub: VfxHub, host: SimHost, a: float, cam_x: float, half_w: float) -> void:
+	shown = 0
+	if not hub.aura3d_enabled:
+		for mi in shells:
+			mi.visible = false
+		return
+	var calm: bool = hub.flashes.reduced
+	var t: float = (float(hub.aura.clock) + a) / 60.0
+	for i in range(mini(SLOTS, host.S.fighters.size())):
+		var mi: MeshInstance3D = shells[i]
+		var f = host.S.fighters[i]
+		var lvl: float = 1.0 if hub.aura3d_demo else lerpf(hub.aura.prev[i], hub.aura.level[i], a)
+		var in_form: bool = false
+		for fm in hub.xform.forms:
+			if fm.slot == i:
+				in_form = true
+		if lvl < 0.01 or (in_form and not hub.aura3d_demo):
+			mi.visible = false
+			continue
+		var rel: float = SimWrap.sdx(cam_x, host.fighter_x(i, a))
+		if absf(rel) > half_w + 8.0 * VfxLook.BH:
+			mi.visible = false
+			continue
+		var ps: Vector3 = host.fighter_pose(i, a)
+		var fz: float = host.fighter_z(i, a)
+		var id: String = VfxBeamLook.key_of(f)
+		var pr: Dictionary = VfxAura3D.params(id, int(floor(float(f.tier) + 0.001)), smoothstep(0.0, 1.0, lvl), calm, t, VfxAura.lane_color(String(f.aura)), float(i) * 7.31)
+		var m: ShaderMaterial = mi.material_override
+		for k in pr.keys():
+			if k != "size":
+				m.set_shader_parameter(k, pr[k])
+		var sz: Vector3 = pr["size"] * VfxLook.BH
+		mi.scale = sz
+		mi.position = Vector3(rel, ps.y + float(VfxAura3D.common("centre_y_bh")) * VfxLook.BH, fz + float(VfxAura3D.common("z_off")))
+		mi.visible = true
+		shown += 1
