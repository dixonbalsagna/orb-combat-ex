+// The 3D aura as an inverted hull on the fighter's OWN mesh (docs/vfx/aura3d.md; Orb's direction 2026-10-18 and the look gate of 2026-10-22: the energy follows the sprite's real silhouette, the body stays visible).
+// It is a second outline pass: the fighter's skinned body already has an outline (fighter_hull.gdshader: back faces only, each vertex pushed along the direction baked into NORMAL, by its reach in UV2.x,
+// a few pixels). This pass is chained after it (the outline's `next_pass`) and pushes the same vertices several pixels further, so it appears only as a band just OUTSIDE the body's actual silhouette,
+// pose and all (the body's front faces hide the rest through the depth test). Inside the band the surface is alive, in OBJECT space, so it wraps the limbs and the torso and moves with them:
+//   0, the Protagonist's BOIL (a furnace giving heat away): the band swells OUTWARD and relaxes (an exhale), its skin froths with round bubbles that grow, ring and thin out, drifting UP like
+//      convection; each pulse sends a brighter band UP the body; the edge is ragged and breathing. Bright RINGS on a clear skin.
+//   1, the Anti-hero's FACETS (cold pride, held in): the band draws INWARD and holds (a smooth inhale), tight to the body, its surface a lattice of crystal facets between hard dark seams, each facet
+//      glinting in its own slow turn like frost, settling DOWN like cold air; each pulse sends a band DOWN; a smooth, crisp edge; at tier 3 and up the seams are lit from inside (pride cracking).
+// Both are the same machinery with every motion, polarity and rhythm inverted. Alpha-blended in the fighter's lane colour, a lighter tint and a dark shade of it: never additive, so never white (Legal's aura
+// rule: no gold, white or red). No clock of its own: `t` is the sim's, so a pause and a hit-stop hold it still.
+shader_type spatial;
+render_mode unshaded, cull_front, blend_mix, depth_draw_never;
+
+#include "res://render/shaders/bend.gdshaderinc"
+#include "res://render/shaders/ortho.gdshaderinc"
+
+uniform float t = 0.0;                 // seconds of unfrozen sim time
+uniform float level = 0.0;             // 0 to 1, the standing aura's own ease: 0 draws nothing
+uniform float theme = 0.0;             // 0 boil, 1 facets
+uniform float tier = 1.0;
+uniform vec4 col_a : source_color = vec4(0.56, 0.84, 1.0, 1.0);    // the lane colour
+uniform vec4 col_b : source_color = vec4(0.72, 0.9, 1.0, 1.0);     // a lighter tint of it, never white
+uniform vec4 col_c : source_color = vec4(0.1, 0.2, 0.3, 1.0);      // a dark shade of it (the seams)
+uniform float alpha_max = 0.5;
+uniform float pattern_alpha = 0.8;
+uniform float froth = 0.0;             // 0 to 1: the fine froth between the big bubbles (grows with the tier)
+uniform float band = 0.4;              // the travelling band's strength
+uniform float pulse_hz = 0.9;
+uniform float pulse_amp = 0.07;
+uniform float pulse_dir = 1.0;         // +1 swells outward and sends the band up, -1 draws inward and sends it down
+uniform vec3 flow = vec3(0.0, 0.3, 0.0);
+uniform float cells = 4.0;
+uniform float cell_rate = 0.5;
+uniform float disp = 0.05;             // how ragged the outer edge is (the boil undulates, the facets stay smooth)
+uniform float shimmer = 1.0;           // the calm form halves it
+uniform float calm = 0.0;              // 1 under Reduce flashing / Reduced motion: no popping, a still lattice that glints slowly
+uniform float seed = 0.0;
+uniform float hull_bh = 0.06;          // how far the band stands off the body's outline, in body heights (a share of it breathes with the pulse): the body is about 90 units tall
+uniform float outline_px = 1.5;        // the body's own outline (RenderLook.OUTLINE_PX): the band starts outside it
+uniform float min_px = 0.75;
+uniform float fringe_lo = 0.22;         // the share of the surface turned toward the camera that still shows: below this much facing it is the fringe, above fringe_hi it is hidden
+uniform float fringe_hi = 0.5;
+uniform float hull_gap = 60.0;         // a stroke may land only where the opaque scene behind it is at least this many units farther: open air or ground behind, never the body (or the other fighter) just behind it
+uniform sampler2D depth_tex : hint_depth_texture, repeat_disable, filter_nearest;
+
+varying vec3 v_obj;
+
+float h31(vec3 p) {
+	p = fract(p * vec3(0.1031, 0.1030, 0.0973));
+	p += dot(p, p.yxz + 33.33);
+	return fract((p.x + p.y) * p.z);
+}
+
+vec3 h33(vec3 p) {
+	p = vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)));
+	return fract(sin(p) * 43758.5453);
+}
+
+float vn3(vec3 p) {
+	vec3 i = floor(p);
+	vec3 f = fract(p);
+	f = f * f * (3.0 - 2.0 * f);
+	float a = mix(mix(h31(i), h31(i + vec3(1, 0, 0)), f.x), mix(h31(i + vec3(0, 1, 0)), h31(i + vec3(1, 1, 0)), f.x), f.y);
+	float b = mix(mix(h31(i + vec3(0, 0, 1)), h31(i + vec3(1, 0, 1)), f.x), mix(h31(i + vec3(0, 1, 1)), h31(i + vec3(1, 1, 1)), f.x), f.y);
+	return mix(a, b, f.z);
+}
+
+// Cellular distance: x the nearest feature point, y the second nearest, z a hash of the nearest cell.
+vec3 worley(vec3 p) {
+	vec3 i = floor(p);
+	vec3 f = fract(p);
+	float d1 = 8.0;
+	float d2 = 8.0;
+	float id = 0.0;
+	for (int z = -1; z <= 1; z++) {
+		for (int y = -1; y <= 1; y++) {
+			for (int x = -1; x <= 1; x++) {
+				vec3 g = vec3(float(x), float(y), float(z));
+				vec3 o = h33(i + g + seed);
+				vec3 r = g + o - f;
+				float d = dot(r, r);
+				if (d < d1) {
+					d2 = d1;
+					d1 = d;
+					id = h31(i + g + seed * 1.7);
+				} else if (d < d2) {
+					d2 = d;
+				}
+			}
+		}
+	}
+	return vec3(sqrt(d1), sqrt(d2), id);
+}
+
+void vertex() {
+	v_obj = VERTEX * (1.0 / 45.0);       // object space in body halves: the body is about 90 units tall
+	vec4 wp = MODEL_MATRIX * vec4(VERTEX, 1.0);
+	float w = ortho > 0.5 ? (PROJECTION_MATRIX * (VIEW_MATRIX * vec4(anchor, 1.0))).w : (PROJECTION_MATRIX * (VIEW_MATRIX * wp)).w;
+	float world_per_px = 2.0 * w / (abs(PROJECTION_MATRIX[1][1]) * VIEWPORT_SIZE.y);
+	float s = max(length(MODEL_MATRIX[0].xyz), 1e-6);
+	float w0 = (PROJECTION_MATRIX * (VIEW_MATRIX * vec4(anchor.xy, 0.0, 1.0))).w;
+	// the band's width in pixels: the boil breathes out fast and back slowly (an exhale), the facets draw in and hold (a smooth inhale); the edge is ragged by 3D noise, a lot for the boil and little for the facets
+	float ph = t * pulse_hz * 6.2831853;
+	float sw = 0.5 + 0.5 * sin(ph);
+	float pl = mix(sw * sw * sw, 0.5 - 0.5 * cos(ph), theme);
+	float n = vn3(v_obj * 2.4 + flow * t * 0.8 + seed) - 0.5;
+	float dn = mix(1.0, 0.35, theme);
+	float k_band = clamp(1.0 + disp * dn * 6.0 * n, 0.6, 1.5);       // a constant distance off the body, ragged only a little at the edge: no whole-aura pulse, no tongues (Legal fx06)
+	float depth_k = ortho > 0.5 ? clamp(w0 / max(w, 1e-6), 0.0, 2.0) : 1.0;
+	float outline_u = max(outline_px * depth_k, min(outline_px, min_px)) * world_per_px / s;     // the body's own outline, in model units, as fighter_hull has it
+	float band_u = hull_bh * 90.0 * k_band * step(0.001, level);        // the band: a share of the body's height in model units, so it is as thick on a small fighter as on a big one
+	vec3 d = NORMAL * UV2.x;
+	vec3 v = VERTEX + d * (outline_u + band_u);
+	POSITION = ortho > 0.5 ? ortho_clip(MODEL_MATRIX, VIEW_MATRIX, PROJECTION_MATRIX, v) : bent_clip(MODEL_MATRIX, VIEW_MATRIX, PROJECTION_MATRIX, v);
+}
+
+void fragment() {
+	// Only the silhouette's fringe: an inflated hull's back faces also lie in front of the body parts behind them (an arm over the chest, the head over the shoulders), where they would tint the body. Those
+	// faces turn away from the camera; the fringe outside the outline is where the surface is at a grazing angle to it. Keep the grazing ones, fade the rest out.
+	// No stroke inside the body's outline (the EP's look gate, 2026-10-22): read the opaque depth behind this fragment. A hull face lying over the torso (an arm's, the head's) has the body just behind it; the fringe
+	// outside the silhouette has the ground or the sky far behind. Compare the two depths in view units.
+	float scene_d = texture(depth_tex, SCREEN_UV).x * 2.0 - 1.0;
+	float frag_d = FRAGCOORD.z * 2.0 - 1.0;
+	float zs = PROJECTION_MATRIX[3][2] / (scene_d + PROJECTION_MATRIX[2][2]);
+	float zf = PROJECTION_MATRIX[3][2] / (frag_d + PROJECTION_MATRIX[2][2]);
+	if (zs - zf < hull_gap) {
+		discard;
+	}
+	float graze = abs(dot(normalize(NORMAL), normalize(VIEW)));
+	float fringe = 1.0 - smoothstep(fringe_lo, fringe_hi, graze);
+	if (fringe < 0.01) {
+		discard;
+	}
+	float yy = v_obj.y * 0.5 + 0.5;
+	// the travelling band: once a pulse, up for the boil and down for the facets
+	float bp = fract(t * pulse_hz * 0.5 + seed * 0.37);
+	float bpos = pulse_dir > 0.0 ? bp : 1.0 - bp;
+	float bnd = band * exp(-pow((yy - bpos) / 0.12, 2.0));
+	vec3 q = v_obj * cells;
+	vec3 pq = q - flow * t * 1.2 * mix(1.0, shimmer, theme);
+	vec3 w = worley(pq);
+
+	// ---- the boil: big bubbles that grow, ring and thin out, and a fine froth between them
+	float life = fract(t * cell_rate + w.z);
+	float rr = mix(0.14, 0.40, mix(life, 1.0, calm * 0.6));
+	float ring = 1.0 - smoothstep(0.0, 0.075, abs(w.x - rr));
+	float fade = mix(1.0 - smoothstep(0.78, 1.0, life), 1.0, calm);
+	float inside = (1.0 - smoothstep(0.0, 0.34, w.x)) * 0.35;
+	vec3 w2 = worley(pq * 2.6 + vec3(5.0, 1.0, 3.0));
+	float life2 = fract(t * cell_rate * 1.7 + w2.z);
+	float ring2 = (1.0 - smoothstep(0.0, 0.09, abs(w2.x - mix(0.1, 0.36, mix(life2, 1.0, calm * 0.6))))) * mix(1.0 - smoothstep(0.7, 1.0, life2), 1.0, calm) * froth;
+	float boil = clamp(ring * fade + ring2 * 0.8 + inside * fade, 0.0, 1.0);
+	float a_boil = 0.34 + pattern_alpha * boil * 0.9 + bnd * 0.6;
+	vec3 c_boil = mix(col_a.rgb, col_b.rgb, clamp(boil * 0.9 + bnd, 0.0, 1.0));
+
+	// ---- the facets: bright cells between dark seams; each cell glints in its own slow turn; at tier 3 and up the seams are lit from inside
+	float seam = 1.0 - smoothstep(0.015, 0.075, w.y - w.x);
+	float glint = pow(0.5 + 0.5 * sin(t * 0.85 * shimmer + w.z * 6.2831853), 4.0);
+	float crack = smoothstep(2.5, 3.5, tier);
+	float fill_f = 0.5 + 0.3 * w.z;
+	float a_facet = 0.34 + pattern_alpha * fill_f * (1.0 - seam) * (1.0 - 0.45 * crack) * 0.9 + seam * mix(0.35, 0.6, crack) + bnd * 0.6;
+	vec3 c_facet = mix(col_a.rgb, col_b.rgb, clamp(glint * 0.9 + 0.15 * w.z + bnd, 0.0, 1.0));
+	c_facet = mix(c_facet, col_c.rgb, seam * (1.0 - crack));
+	c_facet = mix(c_facet, col_b.rgb, seam * crack);
+	c_facet = mix(c_facet, col_a.rgb * 0.8, crack * (1.0 - seam) * 0.35);
+
+	float a = mix(a_boil, a_facet, theme);
+	vec3 col = mix(c_boil, c_facet, theme);
+	ALPHA = clamp(level * a * fringe, 0.0, alpha_max);
+	ALBEDO = col;
+}
