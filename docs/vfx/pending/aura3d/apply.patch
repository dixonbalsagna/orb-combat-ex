@@ -0,0 +1,165 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "meridian/vfx-aura3d",
+  "title": "vfx 3D auras (version 1)",
+  "description": "data/vfx/aura3d.json: Orb's 3D auras (docs/vfx/aura3d.md): the shell's size and alpha, and one theme per fighter by lower-case roster id (the Protagonist's boil and the Anti-hero's facets are inversions of one another), with a `default`. Read by render/vfx/aura3d.gd; every key has a built-in default there. Presentation only. Policy: closed except keys starting with an underscore at the top; every rate is capped at 2 Hz and the drawn alpha at 0.5 (`alpha_max`; rim and pattern are weights that the cap clamps).",
+  "type": "object",
+  "required": [
+    "version"
+  ],
+  "properties": {
+    "version": {
+      "const": 1
+    },
+    "common": {
+      "type": "object",
+      "properties": {
+        "alpha_max": {
+          "type": "number",
+          "exclusiveMinimum": 0,
+          "maximum": 0.5
+        },
+        "pattern_alpha": {
+          "type": "number",
+          "exclusiveMinimum": 0,
+          "maximum": 1.0
+        },
+        "calm_pulse_k": {
+          "type": "number",
+          "minimum": 0,
+          "maximum": 1.0
+        },
+        "calm_shimmer": {
+          "type": "number",
+          "minimum": 0.05,
+          "maximum": 1.0
+        },
+        "tint_lift": {
+          "type": "number",
+          "minimum": 0,
+          "maximum": 0.6
+        },
+        "max_hz": {
+          "type": "number",
+          "exclusiveMinimum": 0,
+          "maximum": 2.0
+        },
+        "hull_rag": {
+          "type": "number",
+          "minimum": 0,
+          "maximum": 2
+        },
+        "hull_bh": {
+          "type": "array",
+          "minItems": 4,
+          "maxItems": 4,
+          "items": {
+            "type": "number",
+            "exclusiveMinimum": 0,
+            "maximum": 0.3
+          }
+        }
+      },
+      "additionalProperties": false
+    },
+    "themes": {
