+class_name VfxAura3DView
+extends Node3D
+## The 3D auras for one pane (aura3d.gd has the rules, shaders/aura3d.gdshader the look). The aura is an inverted hull on the fighter's own skinned mesh, chained after his outline pass (Rendering's
+## FighterView does that: `VfxAura3D.hull_material(fighter)` is the outline's next pass), so this view draws nothing of its own: each frame it writes the fighters' hull materials, one per fighter, shared by
+## every pane. A child of the trail view, like the dust and cloud views. Reads only. The material draws nothing (`level` 0) unless `hub.aura3d_enabled`; the aura is drawn while the standing aura's
+## eased level (aura.gd) is up, or always at full level in the showcase (`hub.aura3d_demo`, the capture and the prototype).
+
+const SLOTS: int = 2
+
+var shown: int = 0                  # fighters whose aura was up last frame (for the tests)
+
+
+## a: the frame's interpolation between the last two ticks. cam_x and half_w are the pane's (unused: the hull follows the body wherever he is).
+func update(hub: VfxHub, host, a: float, _cam_x: float, _half_w: float) -> void:
+	shown = 0
+	var calm: bool = hub.flashes.reduced
+	var t: float = (float(hub.aura.clock) + a) / 60.0
+	for i in range(mini(SLOTS, host.S.fighters.size())):
+		var f = host.S.fighters[i]
+		var m: ShaderMaterial = VfxAura3D.hull_material(f)
+		var lvl: float = 0.0
+		if hub.aura3d_enabled:
+			lvl = 1.0 if hub.aura3d_demo else lerpf(hub.aura.prev[i], hub.aura.level[i], a)
+			var in_form: bool = false
+			for fm in hub.xform.forms:
+				if fm.slot == i:
+					in_form = true
+			if in_form and not hub.aura3d_demo:
+				lvl = 0.0
+		if lvl < 0.01:
+			m.set_shader_parameter("level", 0.0)
+			continue
+		var id: String = VfxBeamLook.key_of(f)
+		var pr: Dictionary = VfxAura3D.params(id, int(floor(float(f.tier) + 0.001)), smoothstep(0.0, 1.0, lvl), calm, t, VfxAura.lane_color(String(f.aura)), float(i) * 7.31)
+		for k in pr.keys():
+			m.set_shader_parameter(k, pr[k])
+		shown += 1
