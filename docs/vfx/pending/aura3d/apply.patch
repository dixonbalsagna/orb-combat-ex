+
+## The hull material of a fighter (Rendering's FighterView chains it after his outline pass): one per fighter object, made on first ask, written each frame by the view. `level` 0 until it is up.
+static var _hulls: Dictionary = {}
+
+
+static func hull_material(f) -> ShaderMaterial:
+	var id: int = f.get_instance_id()
+	if _hulls.has(id):
+		return _hulls[id]
+	var m: ShaderMaterial = _new_hull()
+	_hulls[id] = m
+	return m
+
+
+static func _new_hull() -> ShaderMaterial:
+	var m := ShaderMaterial.new()
+	m.shader = preload("res://render/vfx/shaders/aura3d.gdshader")
+	m.set_shader_parameter("ortho", 1.0)
+	m.set_shader_parameter("level", 0.0)
+	m.render_priority = -1       # before the water (priority 0): a fighter below the waterline gets his band under the water's tint, as his body has it
