--- a/render/vfx/shaders/aura3d.gdshader
+++ b/render/vfx/shaders/aura3d.gdshader
@@ -0,0 +1,141 @@
+// The 3D aura (docs/vfx/aura3d.md): a shell round a fighter, a real mesh seen from the side camera, its surface alive with a pattern in OBJECT space, so it wraps round the body, drifts and
+// turns the way a volume would, and the fighter's own body hides the shell's far half. One shader, two inverted themes (`theme` 0 to 1):
+//   0, the Protagonist's BOIL (a furnace that is giving heat away): the shell swells OUTWARD and relaxes, its surface froths with round bubbles that grow, ring and thin out (a fine froth
+//      between them that thickens with the tier), the whole skin drifting UP the shell like convection, and each pulse sends a bright band UP the shell; a soft rim. Bright RINGS on a clear skin.
+//   1, the Anti-hero's FACETS (cold pride, held in): the shell draws INWARD and holds, its surface is a lattice of crystal facets with hard dark seams, the facets glinting in turn like frost, the
+//      whole skin settling DOWN the shell like cold air, each pulse sending a band DOWN it; a crisp rim; at tier 3 and up the seams fracture and are lit from inside (pride cracking). Bright
+//      FACETS between dark SEAMS (the boil's polarity inverted).
+// Both are a shell, a fresnel rim, a cellular pattern and a travelling band; every motion, polarity and rhythm is inverted. Alpha-blended in the fighter's lane colour, a lighter tint of it and a dark
+// shade of it: never additive, so it can never add up to white (Legal's aura rule: no gold, white or red). No clock of its own: `t` is the sim's, so a pause and a hit-stop hold it still.
+shader_type spatial;
+render_mode unshaded, cull_disabled, blend_mix, depth_draw_never;
+
+uniform float t = 0.0;                 // seconds of unfrozen sim time
+uniform float level = 0.0;             // 0 to 1, the standing aura's own ease
+uniform float theme = 0.0;             // 0 boil, 1 facets
+uniform float tier = 1.0;
+uniform vec4 col_a : source_color = vec4(0.56, 0.84, 1.0, 1.0);    // the lane colour
+uniform vec4 col_b : source_color = vec4(0.72, 0.9, 1.0, 1.0);     // a lighter tint of it, never white
+uniform vec4 col_c : source_color = vec4(0.1, 0.2, 0.3, 1.0);      // a dark shade of it (the seams)
+uniform float alpha_max = 0.5;
+uniform float rim_alpha = 0.4;
+uniform float pattern_alpha = 0.55;
+uniform float fill_alpha = 0.08;
+uniform float froth = 0.0;             // 0 to 1: the fine froth between the big bubbles (grows with the tier)
+uniform float band = 0.4;              // the travelling band's strength
+uniform float pulse_hz = 0.9;
+uniform float pulse_amp = 0.07;
+uniform float pulse_dir = 1.0;         // +1 swells outward and sends the band up, -1 draws inward and sends it down
+uniform vec3 flow = vec3(0.0, 0.3, 0.0);
+uniform float cells = 4.0;
+uniform float cell_rate = 0.5;
+uniform float rim_k = 2.2;
+uniform float disp = 0.05;
+uniform float shimmer = 1.0;           // the calm form halves it
+uniform float calm = 0.0;              // 1 under Reduce flashing / Reduced motion: no popping, a still lattice that glints slowly
+uniform float seed = 0.0;
+
+varying vec3 v_obj;
+
+float h31(vec3 p) {
+	p = fract(p * vec3(0.1031, 0.1030, 0.0973));
+	p += dot(p, p.yxz + 33.33);
+	return fract((p.x + p.y) * p.z);
+}
+
+vec3 h33(vec3 p) {
+	p = vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)));
+	return fract(sin(p) * 43758.5453);
+}
+
+float vn3(vec3 p) {
+	vec3 i = floor(p);
+	vec3 f = fract(p);
+	f = f * f * (3.0 - 2.0 * f);
+	float a = mix(mix(h31(i), h31(i + vec3(1, 0, 0)), f.x), mix(h31(i + vec3(0, 1, 0)), h31(i + vec3(1, 1, 0)), f.x), f.y);
+	float b = mix(mix(h31(i + vec3(0, 0, 1)), h31(i + vec3(1, 0, 1)), f.x), mix(h31(i + vec3(0, 1, 1)), h31(i + vec3(1, 1, 1)), f.x), f.y);
+	return mix(a, b, f.z);
+}
+
+// Cellular distance: x the nearest feature point, y the second nearest, z a hash of the nearest cell.
+vec3 worley(vec3 p) {
+	vec3 i = floor(p);
+	vec3 f = fract(p);
+	float d1 = 8.0;
+	float d2 = 8.0;
+	float id = 0.0;
+	for (int z = -1; z <= 1; z++) {
+		for (int y = -1; y <= 1; y++) {
+			for (int x = -1; x <= 1; x++) {
+				vec3 g = vec3(float(x), float(y), float(z));
+				vec3 o = h33(i + g + seed);
+				vec3 r = g + o - f;
+				float d = dot(r, r);
+				if (d < d1) {
+					d2 = d1;
+					d1 = d;
+					id = h31(i + g + seed * 1.7);
+				} else if (d < d2) {
+					d2 = d;
+				}
+			}
+		}
+	}
+	return vec3(sqrt(d1), sqrt(d2), id);
+}
+
+void vertex() {
+	v_obj = VERTEX;
+	float ph = t * pulse_hz * 6.2831853;
+	float sw = 0.5 + 0.5 * sin(ph);
+	// the boil breathes out fast and back slowly (an exhale); the facets draw in and hold (a smooth inhale): the pulse's shape is inverted too
+	float pl = mix(sw * sw * sw, 0.5 - 0.5 * cos(ph), theme);
+	float n = vn3(VERTEX * 2.1 + flow * t * 0.8 + seed) - 0.5;
+	float dn = mix(1.0, 0.35, theme);       // the facets stay smooth: a crystal does not undulate
+	float r = 1.0 + pulse_dir * pulse_amp * (pl - 0.4) + disp * dn * n;
+	VERTEX = v_obj * r;
+}
+
+void fragment() {
+	vec3 nrm = normalize(NORMAL);
+	float fr = pow(1.0 - clamp(abs(dot(nrm, normalize(VIEW))), 0.0, 1.0), rim_k);
+	float yy = v_obj.y * 0.5 + 0.5;
+	// the travelling band: once a pulse, up for the boil and down for the facets; a pixel is in it for about a quarter of a second
+	float bp = fract(t * pulse_hz * 0.5 + seed * 0.37);
+	float bpos = pulse_dir > 0.0 ? bp : 1.0 - bp;
+	float bnd = band * exp(-pow((yy - bpos) / 0.09, 2.0));
+	vec3 q = v_obj * cells;
+	vec3 pq = q - flow * t * 1.2 * mix(1.0, shimmer, theme);
+	vec3 w = worley(pq);
+
+	// ---- the boil: big bubbles that grow, ring and thin out, and a fine froth between them
+	float life = fract(t * cell_rate + w.z);
+	float rr = mix(0.14, 0.40, mix(life, 1.0, calm * 0.6));
+	float ring = 1.0 - smoothstep(0.0, 0.075, abs(w.x - rr));
+	float fade = mix(1.0 - smoothstep(0.78, 1.0, life), 1.0, calm);
+	float inside = (1.0 - smoothstep(0.0, 0.34, w.x)) * 0.35;
+	vec3 w2 = worley(pq * 2.6 + vec3(5.0, 1.0, 3.0));
+	float life2 = fract(t * cell_rate * 1.7 + w2.z);
+	float ring2 = (1.0 - smoothstep(0.0, 0.09, abs(w2.x - mix(0.1, 0.36, mix(life2, 1.0, calm * 0.6))))) * mix(1.0 - smoothstep(0.7, 1.0, life2), 1.0, calm) * froth;
+	float boil = clamp(ring * fade + ring2 * 0.8 + inside * fade, 0.0, 1.0);
+	float a_boil = rim_alpha * fr + fill_alpha * (1.0 - fr * 0.5) + pattern_alpha * boil * (0.55 + 0.45 * fr) + bnd * (0.4 + 0.6 * fr);
+	vec3 c_boil = mix(col_a.rgb, col_b.rgb, clamp(boil * 0.9 + fr * 0.3 + bnd, 0.0, 1.0));
+
+	// ---- the facets: bright cells between dark seams; each cell glints in its own slow turn; at tier 3 and up the seams are lit from inside
+	float seam = 1.0 - smoothstep(0.015, 0.075, w.y - w.x);
+	float glint = pow(0.5 + 0.5 * sin(t * 0.85 * shimmer + w.z * 6.2831853), 4.0);
+	float crack = smoothstep(2.5, 3.5, tier);
+	float fill_f = 0.5 + 0.3 * w.z;
+	float a_facet = rim_alpha * fr + fill_alpha * (1.0 - fr * 0.4) + pattern_alpha * fill_f * (1.0 - seam) * (0.6 + 0.4 * fr) * (1.0 - 0.45 * crack) + seam * mix(0.5, 0.75, crack) + bnd * (0.4 + 0.6 * fr);
+	vec3 c_facet = mix(col_a.rgb, col_b.rgb, clamp(glint * 0.9 + 0.15 * w.z + fr * 0.25 + bnd, 0.0, 1.0));
+	c_facet = mix(c_facet, col_c.rgb, seam * (1.0 - crack));
+	c_facet = mix(c_facet, col_b.rgb, seam * crack);
+	c_facet = mix(c_facet, col_a.rgb * 0.8, crack * (1.0 - seam) * 0.35);   // the facets darken a little so the lit seams read
+
+	float a = mix(a_boil, a_facet, theme);
+	vec3 col = mix(c_boil, c_facet, theme);
+	// the aura's brightness breathes with the pulse, a few percent, and by a smaller amount in the calm form
+	a *= 1.0 + 0.5 * pulse_amp * pulse_dir * sin(t * pulse_hz * 6.2831853);
+	ALPHA = clamp(level * a, 0.0, alpha_max);
+	ALBEDO = col;
+}
