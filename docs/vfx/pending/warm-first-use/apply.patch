+
 func _process(_delta: float) -> void:
 	if _vp == null:
 		return
 	_frames += 1
+	# VFX's and Rendering's first draws in the REAL pane (Performance's audit, docs/perf/inset-hitches-aura-2026-10-22.md: the first hit, the first crater and the first beam hitch for 50 to 160 ms; the driver sets a
+	# pipeline up per viewport, so a draw in the warm-up's own 64 pixel viewport does not warm the pane's). For these frames, behind the notice, every MultiMesh the pane's views built is drawn again from a copy with
+	# its own real material and one invisible instance (alpha 0), and render/vfx/warm.gd's real meshes (a crack, a beam's prisms, the aura's body) stand in the pane's view. Measured on Performance's cold repro (the AI
+	# match, 400 ticks, reduced and full): the hitches at ticks 71, 74, 131 and 238 (56 to 213 ms) are gone, the worst frame 35 to 45 ms.
+	if _frames == 1:
+		var m = get_parent()
+		if m != null and m.get("pane") != null and m.get("host") != null and m.host != null:
+			var at := Vector3(0.0, m.host.S.fighters[0].y + 40.0, 0.0)
+			_real = _real_nodes(m.pane, at)
+			real_nodes = _real.size()
+			for n in _real:
+				m.pane.add_child(n)
 	if _frames >= WARM_FRAMES:
+		for n in _real:
+			n.queue_free()
 		queue_free()
+
+
+## One invisible copy of every MultiMesh under `pane` (same mesh, instance format and buffer size, its real material, one instance with alpha 0), plus VFX's real meshes, all at `at`.
+func _real_nodes(pane: Node, at: Vector3) -> Array:
+	var out: Array = []
+	var stack: Array = [pane]
+	while not stack.is_empty():
+		var n: Node = stack.pop_back()
+		for c in n.get_children():
+			stack.append(c)
+		if not (n is MultiMeshInstance3D) or n.multimesh == null or n.material_override == null:
+			continue
+		var mm: MultiMesh = (n as MultiMeshInstance3D).multimesh.duplicate()
+		mm.visible_instance_count = 1
+		mm.set_instance_transform(0, Transform3D(Basis.IDENTITY.scaled(Vector3(2.0, 2.0, 2.0)), Vector3.ZERO))
+		if mm.use_colors:
+			mm.set_instance_color(0, Color(1.0, 1.0, 1.0, 0.0))
+		if mm.use_custom_data:
+			mm.set_instance_custom_data(0, Color(0.0, 0.0, 0.0, 0.0))
+		var mmi := MultiMeshInstance3D.new()
+		mmi.multimesh = mm
+		mmi.material_override = (n as MultiMeshInstance3D).material_override
+		mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+		mmi.position = at
+		out.append(mmi)
+	for wn in VfxWarm.nodes():
+		wn.position = at
+		out.append(wn)
+	return out
