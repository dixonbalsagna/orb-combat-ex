+## The plume rows that matter on the round planet, at spots found on its dry ground (a desert, a forest and mountains by the fine biome the planet really has there): the effects are drawn the same way on the planet as on the arena.
+func _biome_fx_planet() -> void:
+	print("biome effects on the planet")
+	var S := SimCore.createSim()
+	SimCore.newMatch(S, 6)
+	VfxBiome.override_biome = ""
+	var found: Dictionary = {}
+	var step: float = SimConst.W / 2048.0
+	var sx: float = 0.0
+	while sx < SimConst.W and found.size() < 3:
+		var kk: String = VfxBiome.key_at(S, sx)
+		var slot_k: String = "mountains" if (kk == "mountains" or kk == "highland") else kk      # the rock: the arena's mountains, or the planet's highland
+		if (slot_k == "desert" or slot_k == "forest" or slot_k == "mountains") and not found.has(slot_k) and WorldWater.surfaceAt(S, sx) == WorldWater.DRY:
+			found[slot_k] = sx
+		sx += step
+	_check(found.size() == 3, "the planet has a desert, a forest and mountains or highland on dry ground (found %s)" % str(found.keys()))
+	if found.size() < 3:
+		SimCore.dispose(S)
+		return
+	var desert_x: float = float(found["desert"])
+	var forest_x: float = float(found["forest"])
+	var mount_x: float = float(found["mountains"])
+	var crater := func(x: float, e: float): return VfxMock.ev("crater", {"x": x, "y": WorldTerrain.groundY(S, x), "r": 220.0, "depth": 60.0, "energy": e, "cause": "impact", "owner": 0.0, "special": 0.0, "rim": 20.0, "z": 0.0})
+	var run := func(x: float, evs: Array, tier: float) -> VfxHub:
+		var h := VfxHub.new()
+		h.reset(S, 6)
+		h.px_per_unit = 0.3
+		S.fighters[0].tier = tier
+		S.fighters[0].vx = 2000.0
+		_tick(S, h, evs)
+		return h
+	var kinds := func(h: VfxHub, k: int) -> int:
+		return h.debris.bits.filter(func(b): return b.kind == k).size()
+	var hc: VfxHub = run.call(desert_x, [crater.call(desert_x, 14.0)], 3.0)
+	var sp: Dictionary = VfxBiome.spec("desert")
+	var puffs: Array = hc.debris.bits.filter(func(b): return b.kind == VfxDebris.PUFF)
+	var in_art: int = puffs.filter(func(b): return b.col.is_equal_approx(sp["lit"]) or b.col.is_equal_approx(sp["mid"]) or b.col.is_equal_approx(sp["shade"])).size()
+	_check(hc.biomefx.columns == 1 and hc.biomefx.stars == 1, "a crater in the planet's desert: one column and one burst star (%d columns, %d stars)" % [hc.biomefx.columns, hc.biomefx.stars])
+	_check(in_art >= 5, "the planet's desert puffs are Art's desert colours (%d of %d puffs in lit, mid or shade)" % [in_art, puffs.size()])
+	var top := -1e9
+	var foot := 1e9
+	for b in puffs:
+		if b.col.is_equal_approx(sp["lit"]) or b.col.is_equal_approx(sp["mid"]):
+			top = maxf(top, b.y)
+		foot = minf(foot, b.y)
+	_check(top - foot > 80.0, "the column stands up out of the planet's ground (%.0f units from foot to top)" % (top - foot))
+	var h1: VfxHub = run.call(desert_x, [crater.call(desert_x, 14.0)], 1.0)
+	var h4: VfxHub = run.call(desert_x, [crater.call(desert_x, 14.0)], 4.0)
+	var top1 := -1e9
+	var top4 := -1e9
+	for b in h1.debris.bits.filter(func(b): return b.kind == VfxDebris.PUFF):
+		top1 = maxf(top1, b.y)
+	for b in h4.debris.bits.filter(func(b): return b.kind == VfxDebris.PUFF):
+		top4 = maxf(top4, b.y)
+	_check(top4 > top1 + 60.0 and int(h4.biomefx.made.get("chunk", 0)) > int(h1.biomefx.made.get("chunk", 0)) * 1.5, "on the planet tier 4 builds a taller plume and throws well over one and a half times the chunks of tier 1 (top %.0f against %.0f; %d against %d chunks)" % [top4, top1, int(h4.biomefx.made.get("chunk", 0)), int(h1.biomefx.made.get("chunk", 0))])
+	var hb: VfxHub = run.call(forest_x, [VfxMock.ev("bounce", {"actor": 0.0, "x": forest_x, "y": WorldTerrain.groundY(S, forest_x), "z": 0.0, "vn": -1500.0, "surface": "soil", "n": 1})], 2.0)
+	_check(kinds.call(hb, VfxDebris.LEAF) > 1, "a bounce in the planet's forest sheds leaves (%d)" % kinds.call(hb, VfxDebris.LEAF))
+	var hsl: VfxHub = run.call(mount_x, [VfxMock.ev("slide", {"x": mount_x, "x1": mount_x + 900.0, "w": 120.0, "energy": 8.0, "variant": "ground", "z1": 0.0, "owner": 0.0})], 2.0)
+	_check(int(hsl.biomefx.made.get("chunk", 0)) > 3, "a slide's end in the planet's mountains throws rock (%s)" % str(hsl.biomefx.made))
+	var hz: VfxHub = run.call(forest_x, [crater.call(forest_x, 12.0)], 2.0)
+	for k in range(120):
+		_tick(S, hz, [])
+	var stayed: int = kinds.call(hz, VfxDebris.CHUNK)
+	for k in range(420):
+		_tick(S, hz, [])
+	_check(stayed > 0 and kinds.call(hz, VfxDebris.LEAF) == 0 and kinds.call(hz, VfxDebris.CHUNK) == 0, "on the planet debris that lands stays two seconds on (%d chunks), and leaves and chunks are all gone in nine (%d leaves, %d chunks left)" % [stayed, kinds.call(hz, VfxDebris.LEAF), kinds.call(hz, VfxDebris.CHUNK)])
+	SimCore.dispose(S)
 
 
