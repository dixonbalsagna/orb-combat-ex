+	_tick(pd[1], pd[0], [mkcue.call(pd[1], 5)])
+	for k in range(6):
+		_tick(pd[1], pd[0], [])
+	_check(absf(float(pd[0].blastcloud.runs[0]["peak"]) - 0.65) < 1e-9, "in the darkest sky the light's peak is 0.65 of the asked")
