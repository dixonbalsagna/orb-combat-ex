  "stateRules": [
    {
      "_note": "fresh: no meeting yet",
      "state": "fresh",
      "when": {
        "meetings": [
          0,
          0
        ]
      }
    },
    {
      "_note": "reversed: a run of 3 or more has just been broken",
      "state": "reversed",
      "when": {
        "streakEnded": [
          3,
          9999
        ]
      }
    },
    {
      "_note": "reversed: the side that was behind has just won, after at least 3 meetings (two meetings is only a split)",
      "state": "reversed",
      "when": {
        "trailingJustWon": [
          1,
          1
        ],
        "meetings": [
          3,
          9999
        ]
      }
    },
    {
      "_note": "simmering: the last bout ran to the time cap",
      "state": "simmering",
      "when": {
        "lastWasTimecap": [
          1,
          1
        ]
      }
    },
    {
      "_note": "simmering: the last bout scarred or destroyed a planet",
      "state": "simmering",
      "when": {
        "lastScarred": [
          1,
          1
        ]
      }
    },
    {
      "_note": "simmering: they have not met for more than 10 matches",
      "state": "simmering",
      "when": {
        "sinceMet": [
          11,
          9999
        ]
      }
    },
    {
      "_note": "settled: 5 or more meetings and the trailing side did not just win",
      "state": "settled",
      "when": {
        "meetings": [
          5,
          9999
        ],
        "trailingJustWon": [
          0,
          0
        ]
      }
    },
    {
      "_note": "settled: a long-time leader, lead 3 or more, and the trailing side did not just win",
      "state": "settled",
      "when": {
        "lead": [
          3,
          9999
        ],
        "trailingJustWon": [
          0,
          0
        ]
      }
    },
    {
      "_note": "simmering: everything else (1 to 4 meetings, a close score of lead 0 or 1 included)",
      "state": "simmering"
    }
  ],
