  "pairs": [
    {
      "_note": "The launch pair. rivalry and sparring are record-driven and need no roles; grudge is data-driven, and WHO carries the old injury is a placeholder for Orb. The ledger events are placeholders for Orb's canon ledger (events_a seeds grudge); unseen_1 is a deliberate unnamed reference. lesson is left out until Orb names a teacher.",
      "ids": [
        "protagonist",
        "rival"
      ],
      "types": {
        "rivalry": 3,
        "sparring": 1,
        "grudge": 1
      },
      "roles": {
        "grudge": {
          "wronged": "protagonist"
        }
      },
      "events": [
        {
          "id": "ledger_1",
          "kind": "ledger",
          "type": "grudge"
