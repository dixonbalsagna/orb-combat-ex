{
  "schema": "narrative.campaign_templates/1",
  "_about": "PARKED DRAFT (docs/narrative/pending/). The campaign's templates, for docs/design/campaign.md (Orb's hybrid pick, 2026-10-25): the rescue (an ally from the arc's cast flies in), 'Previously on', the training lesson, the guaranteed rematch on fallen ground, threads across episodes, and the cliffhanger cards. Slots only: no new lore or names. Reads the campaign.md section 6 ledger slots; no toll slot; the Cyborg's home_wear reads only his own yard (Legal ln04, ln05). 26 templates, one filled sample each, mapped on the five columns. Claude-written; unmarked by Orb; unscreened by Legal for the campaign (sections 4 and 5.2).",
  "new_slots": {
    "episode": "Which episode of the arc: 1, 2 or 3 (the pilot, the middle, the finale).",
    "arc_boss": "The arc's boss fighter (a roster id) whose home ground ends the arc.",
    "thread": "An open promise carried across episodes: a debt, a grudge, an ally who switched sides, a promised return. A kind and the fighter it names; whole numbers and ids only.",
    "rescued_by": "The ally from the arc's cast who flew in when the player fell (campaign.md 5.1).",
    "lost_episode": "That the last episode was lost, where (a place name) and to whom (a fighter id).",
    "lesson": "What the training stage taught, as a drill name: the beam struggle, the air game, breaking a grab, the guard."
  },
  "columns_map": [
    {
      "column": "1. Cold open",
      "role": "The pair arrive; trouble is already there",
      "families": [
        "arrival"
      ],
      "added": [
        "previously_on (recap, if the last episode was won)",
        "training (replaces the cold open after a lost episode)",
        "threads (a grudge or debt carried in)"
      ]
    },
    {
      "column": "2. Rise",
      "role": "A grudge comes to a head",
      "families": [
        "grudge",
        "rematch"
      ],
      "added": [
        "rematch_fallen (always offered after a lost episode)",
        "threads (debt opens)"
      ]
    },
    {
      "column": "3. Twist",
      "role": "The episode turns",
      "families": [
        "third_party",
        "ally_switches"
      ],
      "added": [
        "rescue (any column, once an episode)",
        "threads (an ally switches back)"
      ]
    },
    {
      "column": "4. Escalation",
      "role": "The stakes rise: a home is threatened",
      "families": [
        "home_threat"
      ],
      "added": [
        "threads (a grudge or debt pays)",
        "rematch_fallen if the ground fell"
      ]
    },
    {
      "column": "5. Climax",
      "role": "The episode's opponent on his home ground",
      "families": [
        "boss_taunt"
      ],
      "added": [
        "threads (a promised return keeps its promise)"
      ]
    },
    {
      "column": "Cliffhanger card",
      "role": "Next time",
      "families": [
        "cliffhanger"
      ],
      "added": [
        "cliff_cards (to be continued, next episode, the finale, an open thread)"
      ]
    },
    {
      "column": "The arc's finale",
      "role": "Replaces column 5 of the last episode",
      "families": [
        "boss_taunt"
      ],
      "added": [
        "cliff_finale (the card before it, at the end of episode 2)",
        "previously_on (the recap that opens episode 3)"
      ]
    }
  ],
  "templates": [
    {
      "id": "resc_arrives",
      "family": "rescue",
      "columns": "any",
      "reads": [
        "rescued_by",
        "opp",
        "place"
      ],
      "when": "The player is knocked out before a life is spent; once an episode",
      "beats": [
        {
          "role": "ally",
          "hook": "arrive",
          "does": "flies in over the horizon"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "greets the newcomer"
        }
      ],
      "note": "The player then plays the ally (campaign.md 5.1)."
    },
    {
      "id": "resc_opp_reacts",
      "family": "rescue",
      "columns": "any",
      "reads": [
        "opp",
        "rescued_by"
      ],
      "when": "Directly after resc_arrives",
      "beats": [
        {
          "role": "opp",
          "hook": "needle",
          "does": "meets the newcomer"
        }
      ],
      "note": ""
    },
    {
      "id": "resc_won_debt",
      "family": "rescue",
      "columns": "next beat gap",
      "reads": [
        "rescued_by",
        "thread"
      ],
      "when": "The ally won the stage",
      "beats": [
        {
          "role": "p1",
          "hook": "after",
          "does": "owes the ally, plainly"
        },
        {
          "role": "ally",
          "hook": "deflect",
          "does": "refuses thanks"
        }
      ],
      "note": "Opens a debt thread."
    },
    {
      "id": "resc_partner_later",
      "family": "rescue",
      "columns": "2 to 4",
      "reads": [
        "rescued_by",
        "episode"
      ],
      "when": "A later stage offers the ally as a partner place",
      "beats": [
        {
          "role": "ally",
          "hook": "offer",
          "does": "offers to fight alongside"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "accepts"
        }
      ],
      "note": ""
    },
    {
      "id": "prev_cold",
      "family": "previously_on",
      "columns": "1 (cold open)",
      "reads": [
        "last",
        "place",
        "home_wear"
      ],
      "when": "Start of an episode after a WON episode",
      "beats": [
        {
          "role": "radio",
          "hook": "recap",
          "does": "last time, in one line"
        },
        {
          "role": "radio",
          "hook": "recap",
          "does": "what still stands, in one line"
        }
      ],
      "note": "A recap is two radio lines, never a toll.",
      "cyborg": {
        "home_wear": "own_yard_only",
        "off_if": "the Cyborg claim is a town or city, not his own yard"
      }
    },
    {
      "id": "prev_lost_card",
      "family": "previously_on",
      "columns": "end of a lost episode",
      "reads": [
        "lost_episode",
        "place",
        "home_wear"
      ],
      "when": "The episode's lives are gone",
      "beats": [
        {
          "role": "radio",
          "hook": "tbc",
          "does": "the lost episode ends on a card"
        }
      ],
      "note": "Place and wear only (ln05).",
      "cyborg": {
        "home_wear": "own_yard_only",
        "off_if": "the Cyborg claim is a town or city, not his own yard"
      }
    },
    {
      "id": "prev_stakes",
      "family": "previously_on",
      "columns": "1 (cold open)",
      "reads": [
        "lost_episode",
        "place",
        "home_wear",
        "opp"
      ],
      "when": "Start of the next episode",
      "beats": [
        {
          "role": "radio",
          "hook": "recap",
          "does": "what the loss did to a place"
        },
        {
          "role": "opp",
          "hook": "holds",
          "does": "the winner holds the ground"
        }
      ],
      "note": "The Cyborg's version reads wear and a thing wrecked only; home_wear only for his own yard; never a toll (ln04, ln05).",
      "cyborg": {
        "home_wear": "own_yard_only",
        "off_if": "the Cyborg claim is a town or city, not his own yard"
      }
    },
    {
      "id": "prev_winner",
      "family": "previously_on",
      "columns": "1 (cold open)",
      "reads": [
        "opp",
        "last"
      ],
      "when": "The fighter who won the lost episode opens the next",
      "beats": [
        {
          "role": "opp",
          "hook": "boast",
          "does": "holds the result over the player"
        }
      ],
      "note": ""
    },
    {
      "id": "prev_hook",
      "family": "previously_on",
      "columns": "1 (cold open)",
      "reads": [
        "lost_episode",
        "lesson"
      ],
      "when": "Before the training stage",
      "beats": [
        {
          "role": "p1",
          "hook": "react",
          "does": "wants to answer the loss"
        }
      ],
      "note": ""
    },
    {
      "id": "train_open",
      "family": "training",
      "columns": "1 (replaces the cold open)",
      "reads": [
        "opp",
        "lesson"
      ],
      "when": "Start of the next episode after a lost one; a 60 to 90 second drill",
      "beats": [
        {
          "role": "opp",
          "hook": "drill",
          "does": "sets the drill, in their voice"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "asks to be taught"
        }
      ],
      "note": "The drill is against what beat the player."
    },
    {
      "id": "train_frame",
      "family": "training",
      "columns": "1 (replaces the cold open)",
      "reads": [
        "lesson"
      ],
      "when": "The drill starts",
      "beats": [
        {
          "role": "radio",
          "hook": "frame",
          "does": "names the drill in one line"
        }
      ],
      "note": ""
    },
    {
      "id": "train_clear",
      "family": "training",
      "columns": "1 (replaces the cold open)",
      "reads": [
        "lesson",
        "opp"
      ],
      "when": "The drill is cleared",
      "beats": [
        {
          "role": "opp",
          "hook": "grudge",
          "does": "grudging nod, never open respect"
        },
        {
          "role": "radio",
          "hook": "frame",
          "does": "names the lesson learned"
        }
      ],
      "note": "The lesson is for this episode only (campaign.md 5.2)."
    },
    {
      "id": "train_retry",
      "family": "training",
      "columns": "1 (replaces the cold open)",
      "reads": [
        "lesson",
        "opp"
      ],
      "when": "The drill is failed",
      "beats": [
        {
          "role": "opp",
          "hook": "needle",
          "does": "tells them what was wrong"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "asks again"
        }
      ],
      "note": ""
    },
    {
      "id": "refall_offer",
      "family": "rematch_fallen",
      "columns": "2 (rise)",
      "reads": [
        "opp",
        "place",
        "home_wear"
      ],
      "when": "After a lost episode, the rise column always offers a rematch with the one who won, on the ground that fell",
      "beats": [
        {
          "role": "radio",
          "hook": "recap",
          "does": "says whose ground, and that it is ruined"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "wants it back"
        }
      ],
      "note": "Place and wear only.",
      "cyborg": {
        "home_wear": "own_yard_only",
        "off_if": "the Cyborg claim is a town or city, not his own yard"
      }
    },
    {
      "id": "refall_claim",
      "family": "rematch_fallen",
      "columns": "2 (rise)",
      "reads": [
        "opp",
        "place",
        "claim"
      ],
      "when": "On arrival at the ruined ground",
      "beats": [
        {
          "role": "opp",
          "hook": "claim",
          "does": "claims the ruins"
        }
      ],
      "note": ""
    },
    {
      "id": "refall_wreck_cyborg",
      "family": "rematch_fallen",
      "columns": "2 (rise)",
      "reads": [
        "opp",
        "wrecked",
        "place"
      ],
      "when": "The Cyborg's version of the above",
      "beats": [
        {
          "role": "opp",
          "hook": "wreck",
          "does": "reads the wreckage as fuel"
