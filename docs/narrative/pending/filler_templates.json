  "title_card_formats": {
    "main": "EPISODE {n}: {title}   (Orb's number and Orb's title)",
    "filler_in_main": "EPISODE {n}.5: {title}   (n = the main episode it follows; a generated title)",
    "standalone_filler_episode": "SIDE STORY: {title}   (no number: it sits outside the season)",
    "filler_arc": "{ARC TITLE} · EPISODE {k} OF 3   (the arc's own short title: The {planet} Special)"
  },
  "title_patterns": {
    "training_day": [
      "A Day at {place}",
      "Training at {place}",
      "The Long Drill"
    ],
    "rivalry_game": [
      "The Bet at {place}",
      "Best of Three",
      "The Game at {place}"
    ],
    "tournament": [
      "The {place} Tournament",
      "Four on the Stage",
      "The Final at {place}"
    ],
    "rescue": [
      "Bring {stranded} Home",
      "Cut Off at {place}",
      "The Far Road"
    ]
  },
  "side_place_callouts": {
    "training_day": [
      "A practice yard on the ring. Spar?",
      "A training ground ahead. Warm up?",
      "Someone is drilling at {place}."
    ],
    "rivalry_game": [
      "A game is on at {place}.",
      "Two rivals, a bet, a side story.",
      "A friendly game ahead. Join?"
    ],
    "tournament": [
      "A tournament on the stage ahead.",
      "Rounds are starting at {place}.",
      "A side story: the stage is open."
    ],
    "rescue": [
      "Someone's stranded at {place}.",
      "A rescue ahead. Fly to it?",
      "A fighter is cut off. Help?"
    ]
  },
  "main_story_slots": {
    "ORB.episode.cold_open": "Orb writes: who, where, what happens.",
    "ORB.episode.rise": "Orb writes.",
    "ORB.episode.twist": "Orb writes.",
    "ORB.episode.escalation": "Orb writes.",
    "ORB.episode.climax": "Orb writes: the climax's opponent and place (at least).",
    "ORB.episode.cliffhanger": "Orb writes the card.",
    "ORB.arc.finale": "Orb writes the finale."
  },
  "samples": [
    {
      "template": "training_day.cold_open",
      "slots": "place=the practice yard, opp=RIVAL",
      "lines": [
        {
          "who": "PROTAGONIST",
          "text": "Training ground! My favourite kind of place!"
        },
        {
          "who": "RIVAL",
          "text": "Don't get excited. Warm-up first."
        }
      ]
    },
    {
      "template": "training_day.rise",
      "slots": "opp=RIVAL",
      "lines": [
        {
          "who": "RIVAL",
          "text": "Your guard's dropping. Fix it."
        },
        {
          "who": "PROTAGONIST",
          "text": "Okay! Show me how!"
        }
      ]
    },
    {
      "template": "training_day.twist",
      "slots": "guest=CYBORG, place=the practice yard",
      "lines": [
        {
          "who": "CYBORG",
          "text": "Training? Is there a wreck to hit?"
        }
      ]
    },
    {
      "template": "training_day.escalation",
      "slots": "place=the practice yard, home_wear=damaged",
      "lines": [
        {
          "who": "RADIO",
          "text": "The practice wall is cracked. Careful."
        },
        {
          "who": "PROTAGONIST",
          "text": "Easy with the wall! Aim at me!"
        }
      ]
    },
    {
      "template": "training_day.climax",
      "slots": "opp=RIVAL",
      "lines": [
        {
          "who": "RIVAL",
          "text": "Final drill. Hit me if you can."
        },
        {
          "who": "PROTAGONIST",
          "text": "Bring it! Best lesson yet!"
        }
      ]
    },
    {
      "template": "training_day.cliffhanger",
      "slots": "next=a harder drill",
      "lines": [
        {
          "who": "RADIO",
          "text": "Class dismissed. Tomorrow, a harder drill."
        }
      ]
    },
    {
      "template": "rivalry_game.cold_open",
      "slots": "opp=RIVAL, contest=best of three",
      "lines": [
        {
          "who": "RIVAL",
          "text": "Best of three. Loser picks the ground."
        },
        {
          "who": "PROTAGONIST",
          "text": "Deal! I'm hungry for a win!"
