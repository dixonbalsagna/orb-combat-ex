{
  "schema": "narrative.filler_templates/1",
  "_about": "PARKED DRAFT (docs/narrative/pending/). Beat templates for the four filler families in docs/design/campaign.md section 1: training_day, rivalry_game, tournament, rescue. Same shape as beat_templates.json (slots, templates, beats, samples). Slots only; no new lore or names; main-story beats are Orb's and appear here only as labelled empty slots. Follows Legal mc01 to mc03, ln05 and c08, and the voice bibles. Claude-written; unmarked by Orb; unscreened by Legal for the filler kinds.",
  "new_slots": {
    "filler_kind": "training_day, rivalry_game, tournament or rescue.",
    "episode_number": "The main episode a filler episode follows, as a whole number n; the card reads n.5. Absent for a standalone filler episode.",
    "side_place": "The place on the ring that shows a side story (its name).",
    "round": "A whole number and its total (round 2 of 3) for a game or a tournament. Never a score of damage or deaths.",
    "contest": "What a rivalry game or a tournament is played for: a clean launch, a race along the ring, a best of three. Never a count of wreckage or of the lost.",
    "stranded": "A cast fighter who is stranded across the ring by wrecked ground or a flooded valley (a rescue). Never a captive and never a victim.",
    "guest": "A cast fighter who drops in to a filler episode."
  },
  "families": [
    "training_day",
    "rivalry_game",
    "tournament",
    "rescue"
  ],
  "columns": [
    "1. Cold open",
    "2. Rise",
    "3. Twist",
    "4. Escalation",
    "5. Climax",
    "Cliffhanger card"
  ],
  "templates": [
    {
      "id": "training_day.cold_open",
      "family": "training_day",
      "column": "1. Cold open",
      "reads": [
        "place",
        "opp",
        "p1"
      ],
      "beats": [
        {
          "role": "p1",
          "hook": "react",
          "does": "enjoys the practice ground"
        },
        {
          "role": "opp",
          "hook": "needle",
          "does": "tells them to warm up"
        }
      ],
      "note": "A practice place, a sparring partner, low stakes."
    },
    {
      "id": "training_day.rise",
      "family": "training_day",
      "column": "2. Rise",
      "reads": [
        "opp",
        "p1"
      ],
      "beats": [
        {
          "role": "opp",
          "hook": "drill",
          "does": "corrects the player's guard"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "asks to be shown"
        }
      ],
      "note": "The Rival's correction is grudging, never open respect."
    },
    {
      "id": "training_day.twist",
      "family": "training_day",
      "column": "3. Twist",
      "reads": [
        "guest",
        "place"
      ],
      "beats": [
        {
          "role": "guest",
          "hook": "drop_in",
          "does": "arrives to watch or join"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "welcomes them"
        }
      ],
      "note": "The Cyborg reads wear and a thing wrecked only, never a toll or a person (ln04, ln05)."
    },
    {
      "id": "training_day.escalation",
      "family": "training_day",
      "column": "4. Escalation",
      "reads": [
        "place",
        "home_wear"
      ],
      "beats": [
        {
          "role": "radio",
          "hook": "report",
          "does": "a practice wall is cracked"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "aims the fight away from it"
        }
      ],
      "note": "Place and wear only.",
      "cyborg": {
        "home_wear": "own_yard_only",
        "off_if": "the Cyborg claim is a town or city, not his own yard"
      }
    },
    {
      "id": "training_day.climax",
      "family": "training_day",
      "column": "5. Climax",
      "reads": [
        "opp",
        "place"
      ],
      "beats": [
        {
          "role": "opp",
          "hook": "claim",
          "does": "sets the last drill"
        },
        {
          "role": "p1",
          "hook": "react",
          "does": "accepts"
        }
      ],
      "note": ""
    },
    {
      "id": "training_day.cliffhanger",
      "family": "training_day",
      "column": "Cliffhanger card",
      "reads": [
        "next"
      ],
      "beats": [
