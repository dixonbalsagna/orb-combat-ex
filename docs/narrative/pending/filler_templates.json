    {
      "template": "rivalry_game.escalation",
      "slots": "opp=RIVAL, round=2 of 3",
      "lines": [
        {
          "who": "RIVAL",
          "text": "Last rounds. Nobody holds back now."
        }
      ]
    },
    {
      "template": "rivalry_game.climax",
      "slots": "opp=RIVAL, round=3 of 3, contest=best of three",
      "lines": [
